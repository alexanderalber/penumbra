// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/water": (kind: "comp.base", params: {"expose": "clock = tank.clock\nfront = tank.front\nside = tank.side\nlid = tank.lid\nfront_top = tank.front_top\nfront_bottom = tank.front_bottom\nside_top = tank.side_top\nside_bottom = tank.side_bottom\nrows = tank.rows\nfill = tank.fill\npond = tank.pond\nlevel = tank.level\nwave = tank.wave\ntile = tank.tile\ncaustic = tank.caustic\ngain = tank.gain\ndeep = tank.deep\nshallow = tank.shallow\nfoam = tank.foam\nshimmer = tank.shimmer\nshimmer_color = tank.shimmer_color\nsize = tank.size\ntexture = texture.file"}),
        "/water/labels": (kind: "tex.in"),
        "/water/out": (kind: "tex.out", inputs: {"in": "tank"}),
        "/water/regions": (kind: "tex.in"),
        "/water/sdf": (kind: "tex.in"),
        "/water/tank": (kind: "tex.shader", params: {"file": "library/water/water.wgsl"}, inputs: {"in0": "regions", "in1": "labels", "in2": "texture", "in3": "sdf"}),
        "/water/texture": (kind: "tex.image", params: {"file": "library/water/water.png"}),
    },
)
