// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/ceiling_lights": (kind: "comp.base", params: {"expose": "presence = controls.value0\nspacing = controls.value1\nperiod = controls.value2\ntrail = controls.value3\napart = controls.value4\nsize = controls.value5\nidle = controls.value6\nfull = controls.value7\nglow = controls.value8\nwarmth = controls.value9\nceiling = controls.value10\nnear = controls.value11\nfar = controls.value12\nline_width = lamp_lines.line_width\nextent = lamps.extent"}, pos: [0.0, 0.0]),
        "/ceiling_lights/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/ceiling_lights/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/ceiling_lights/controls": (kind: "chan.constant", params: {"rows": 13, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 2.0, "name2": "period", "value2": 8.0, "name3": "trail", "value3": 3.0, "name4": "apart", "value4": 2.4, "name5": "size", "value5": 1.0, "name6": "idle", "value6": 0.12, "name7": "full", "value7": 0.8, "name8": "glow", "value8": 1.0, "name9": "warmth", "value9": 0.0, "name10": "ceiling", "value10": 4.0, "name11": "near", "value11": -2.0, "name12": "far", "value12": 14.0}, pos: [-1200.0, 300.0]),
        "/ceiling_lights/lamp_place": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop"}, pos: [-600.0, -100.0]),
        "/ceiling_lights/lamp_scale": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop"}, pos: [-600.0, 30.0]),
        "/ceiling_lights/lamp_shade": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "shade"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop"}, pos: [-600.0, 160.0]),
        "/ceiling_lights/lamp_light": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "light"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop"}, pos: [-600.0, 290.0]),
        "/ceiling_lights/lamp_rays": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "rays"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop"}, pos: [-600.0, 420.0]),
        "/ceiling_lights/lamp_glow": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "glow"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop"}, pos: [-600.0, 550.0]),
        "/ceiling_lights/lamp": (kind: "geo.file", params: {"file": "library/ceiling_lights/lamp.obj", "up": "z"}, pos: [-1000.0, -550.0]),
        "/ceiling_lights/lamp_lines": (kind: "mat.wireframe", params: {"line_width": 1.5}, pos: [-800.0, -450.0]),
        "/ceiling_lights/lamp_wire": (kind: "geo.assign_material", inputs: {"in": "lamp", "mat": "lamp_lines"}, pos: [-600.0, -500.0]),
        "/ceiling_lights/bulb": (kind: "geo.file", params: {"file": "library/ceiling_lights/bulb.obj", "up": "z"}, pos: [-1000.0, -700.0]),
        "/ceiling_lights/bulb_mat": (kind: "mat.constant", params: {"color": [1.0, 1.0, 1.0, 1.0]}, pos: [-800.0, -650.0]),
        "/ceiling_lights/bulb_lit": (kind: "geo.assign_material", inputs: {"in": "bulb", "mat": "bulb_mat"}, pos: [-600.0, -650.0]),
        "/ceiling_lights/rays": (kind: "geo.file", params: {"file": "library/ceiling_lights/rays.obj", "up": "z"}, pos: [-1000.0, -850.0]),
        "/ceiling_lights/rays_wire": (kind: "geo.assign_material", inputs: {"in": "rays", "mat": "lamp_lines"}, pos: [-600.0, -800.0]),
        "/ceiling_lights/lamps": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "lamp_wire", "position": "lamp_place", "scale": "lamp_scale", "color": "lamp_shade"}, pos: [-200.0, -200.0]),
        "/ceiling_lights/bulbs": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "bulb_lit", "position": "lamp_place", "scale": "lamp_scale", "color": "lamp_light"}, pos: [-200.0, -50.0]),
        "/ceiling_lights/beams": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "rays_wire", "position": "lamp_place", "scale": "lamp_rays", "color": "lamp_glow"}, pos: [-200.0, 100.0]),
        "/ceiling_lights/lights": (kind: "geo.merge", inputs: {"in0": "lamps", "in1": "bulbs", "in2": "beams"}, pos: [0.0, 0.0]),
        "/ceiling_lights/out": (kind: "geo.out", inputs: {"in": "lights"}, pos: [200.0, 0.0]),
    },
)
