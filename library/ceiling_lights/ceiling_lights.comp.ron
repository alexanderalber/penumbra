// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/ceiling_lights": (kind: "comp.base", params: {"about": "Two rows of paper lanterns under the ceiling, one on each side of the lane.", "params": "@expose presence = controls.value0\n@expose spacing = controls.value1\n@expose period = controls.value2\n@expose trail = controls.value3\n@expose apart = controls.value4\n@expose size = controls.value5\n@expose idle = controls.value6\n@expose full = controls.value7\n@expose glow = controls.value8\n@expose warmth = controls.value9\n@expose ceiling = controls.value10\n@expose near = controls.value11\n@expose far = controls.value12\n@expose line_width = lamp_lines.line_width\n@expose extent = lamps.extent", "shelf": "music stage/above"}, pos: [0.0, 0.0]),
        "/ceiling_lights/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/ceiling_lights/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/ceiling_lights/controls": (kind: "chan.constant", params: {"rows": 15, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 2.0, "name2": "period", "value2": 8.0, "name3": "trail", "value3": 3.0, "name4": "apart", "value4": 2.4, "name5": "size", "value5": 1.0, "name6": "idle", "value6": 0.12, "name7": "full", "value7": 0.8, "name8": "glow", "value8": 1.0, "name9": "warmth", "value9": 0.0, "name10": "ceiling", "value10": 4.0, "name11": "near", "value11": -2.0, "name12": "far", "value12": 14.0, "name13": "swing", "value13": 7.0, "name14": "calm", "value14": 0.3}, pos: [-1200.0, 300.0]),
        "/ceiling_lights/lamp_place": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop", "swing": "controls:swing", "calm": "controls:calm", "mids": "level:energy_mid"}, pos: [-600.0, -100.0]),
        "/ceiling_lights/lamp_scale": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop", "swing": "controls:swing", "calm": "controls:calm", "mids": "level:energy_mid"}, pos: [-600.0, 30.0]),
        "/ceiling_lights/lamp_shade": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "shade"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop", "swing": "controls:swing", "calm": "controls:calm", "mids": "level:energy_mid"}, pos: [-600.0, 160.0]),
        "/ceiling_lights/lamp_light": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "light"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop", "swing": "controls:swing", "calm": "controls:calm", "mids": "level:energy_mid"}, pos: [-600.0, 290.0]),
        "/ceiling_lights/lamp_aim": (kind: "tex.shader", params: {"file": "library/ceiling_lights/lights.wgsl", "resolution": "custom", "width": 24, "height": 2, "keep_size": true, "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "period": "controls:period", "trail": "controls:trail", "apart": "controls:apart", "size": "controls:size", "idle": "controls:idle", "full": "controls:full", "glow": "controls:glow", "warmth": "controls:warmth", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "beat_index": "bus:beat_index", "beat": "bus:beat", "role": "bus:section_role", "drop": "bus:drop", "swing": "controls:swing", "calm": "controls:calm", "mids": "level:energy_mid"}, pos: [-600.0, 700.0]),
        "/ceiling_lights/mids": (kind: "chan.select", params: {"channels": "energy_mid"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/ceiling_lights/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.3, "fall": 0.8}, inputs: {"in": "mids"}, pos: [-800.0, -150.0]),
        "/ceiling_lights/lamp": (kind: "geo.file", params: {"file": "library/ceiling_lights/lantern.obj", "up": "z"}, pos: [-1000.0, -550.0]),
        "/ceiling_lights/lamp_lines": (kind: "mat.wireframe", params: {"line_width": 1.5}, pos: [-800.0, -450.0]),
        "/ceiling_lights/lamp_wire": (kind: "geo.assign_material", inputs: {"in": "lamp", "mat": "lamp_lines"}, pos: [-600.0, -500.0]),
        "/ceiling_lights/lamps": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "lamp_wire", "position": "lamp_place", "aim": "lamp_aim", "scale": "lamp_scale", "color": "lamp_shade"}, pos: [-200.0, -200.0]),
        "/ceiling_lights/paper": (kind: "geo.file", params: {"file": "library/ceiling_lights/paper.obj", "up": "z"}, pos: [-1000.0, -700.0]),
        "/ceiling_lights/paper_mat": (kind: "mat.constant", pos: [-800.0, -650.0]),
        "/ceiling_lights/paper_fill": (kind: "geo.assign_material", inputs: {"in": "paper", "mat": "paper_mat"}, pos: [-600.0, -650.0]),
        "/ceiling_lights/papers": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "paper_fill", "position": "lamp_place", "aim": "lamp_aim", "scale": "lamp_scale", "color": "lamp_light"}, pos: [-200.0, -50.0]),
        "/ceiling_lights/lights": (kind: "geo.merge", inputs: {"in0": "lamps", "in1": "papers"}, pos: [0.0, 0.0]),
        "/ceiling_lights/out": (kind: "geo.out", inputs: {"in": "lights"}, pos: [200.0, 0.0]),
    },
)
