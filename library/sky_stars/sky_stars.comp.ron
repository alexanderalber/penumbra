// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_stars": (kind: "comp.base", params: {"about": "A night sky of stars over black, for stage_valley.", "params": "@expose presence = stars.presence\n@expose brightness = stars.brightness\n@expose seed = stars.seed\n@expose density = stars.density\n@expose size = stars.size\n@expose twinkle = stars.twinkle\n@expose venus = stars.venus\n@expose venus_x = stars.venus_x\n@expose venus_y = stars.venus_y\n@expose thin = stars.thin\n@expose meteor = meteor_in.value0\n@expose meteor_seed = stars.meteor_seed\n@expose meteor_length = stars.meteor_length\n@expose meteor_time = flight.decay\n@expose trail = stars.trail\n@expose trail_angle = stars.trail_angle\n@expose trail_light = stars.trail_light\n@expose pole_x = stars.pole_x\n@expose pole_y = stars.pole_y", "shelf": "music stage/sky"}),
        "/sky_stars/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/sky_stars/pose": (kind: "chan.in", pos: [-600.0, 150.0]),
        "/sky_stars/meteor_in": (kind: "chan.constant", params: {"rows": 1, "name0": "meteor", "value0": 0.0}, pos: [-800.0, 300.0]),
        "/sky_stars/flight": (kind: "chan.envelope", params: {"mode": "trigger", "attack": 0.0, "decay": 1.0, "sustain": 0.0, "release": 0.0}, inputs: {"in": "meteor_in"}, pos: [-600.0, 300.0]),
        "/sky_stars/stars": (kind: "tex.shader", params: {"file": "library/sky_stars/stars.wgsl", "presence": 1.0, "brightness": 1.0, "seed": 0, "density": 1.0, "size": 0.8, "twinkle": 1.0, "venus": 1.0, "venus_x": -0.32, "venus_y": 0.1, "thin": 0.35, "meteor_seed": 0, "trail": 0.0, "trail_angle": 45.0, "trail_light": 1.0, "pole_x": 0.3, "pole_y": 0.42}, binds: {"meteor_left": "flight:meteor", "eye": "pose:height", "pitch": "pose:pitch", "fov": "pose:fov", "roll": "pose:roll", "side": "pose:side", "reach": "pose:far", "dawn": "pose:dawn", "beats": "bus:travelled", "sparkle": "bus:energy_high"}, pos: [-300.0, 0.0]),
        "/sky_stars/out": (kind: "tex.out", inputs: {"in": "stars"}, pos: [0.0, 0.0]),
    },
)
