// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_animal": (kind: "comp.base", params: {"expose": "presence = controls.value0\nat = controls.value1\nrange = controls.value2\ncycle_min = controls.value3\ncycle_max = controls.value4\nbeats_per_bar = controls.value5\nfast = controls.value6\nside = controls.value7\nlane = controls.value8\nclear = controls.value9\nsize = controls.value10\nseed = controls.value11\ncolor = lines.color\nline_width = lines.line_width"}),
        "/floor_animal/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_animal/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_animal/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "at", "value1": 5.0, "name2": "range", "value2": 1.5, "name3": "cycle_min", "value3": 16.0, "name4": "cycle_max", "value4": 32.0, "name5": "beats_per_bar", "value5": 4.0, "name6": "fast", "value6": 100.0, "name7": "side", "value7": 1.0, "name8": "lane", "value8": 1.6, "name9": "clear", "value9": 1.1, "name10": "size", "value10": 1.0, "name11": "seed", "value11": 1.0}, pos: [-1200.0, 300.0]),
        "/floor_animal/place": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "place", "pose": 0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, -300.0]),
        "/floor_animal/aim": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "aim", "pose": 0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, -170.0]),
        "/floor_animal/scale0": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, -40.0]),
        "/floor_animal/pose0": (kind: "geo.file", params: {"file": "library/floor_animal/pose_0.obj", "up": "z"}, pos: [-600.0, -700.0]),
        "/floor_animal/run0": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose0", "position": "place", "aim": "aim", "scale": "scale0"}, pos: [-400.0, -700.0]),
        "/floor_animal/scale1": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 1}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 90.0]),
        "/floor_animal/pose1": (kind: "geo.file", params: {"file": "library/floor_animal/pose_1.obj", "up": "z"}, pos: [-600.0, -600.0]),
        "/floor_animal/run1": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose1", "position": "place", "aim": "aim", "scale": "scale1"}, pos: [-400.0, -600.0]),
        "/floor_animal/scale2": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 2}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 220.0]),
        "/floor_animal/pose2": (kind: "geo.file", params: {"file": "library/floor_animal/pose_2.obj", "up": "z"}, pos: [-600.0, -500.0]),
        "/floor_animal/run2": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose2", "position": "place", "aim": "aim", "scale": "scale2"}, pos: [-400.0, -500.0]),
        "/floor_animal/scale3": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 3}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 350.0]),
        "/floor_animal/pose3": (kind: "geo.file", params: {"file": "library/floor_animal/pose_3.obj", "up": "z"}, pos: [-600.0, -400.0]),
        "/floor_animal/run3": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose3", "position": "place", "aim": "aim", "scale": "scale3"}, pos: [-400.0, -400.0]),
        "/floor_animal/scale4": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 4}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 480.0]),
        "/floor_animal/pose4": (kind: "geo.file", params: {"file": "library/floor_animal/pose_4.obj", "up": "z"}, pos: [-600.0, -300.0]),
        "/floor_animal/run4": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose4", "position": "place", "aim": "aim", "scale": "scale4"}, pos: [-400.0, -300.0]),
        "/floor_animal/scale5": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 5}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 610.0]),
        "/floor_animal/pose5": (kind: "geo.file", params: {"file": "library/floor_animal/pose_5.obj", "up": "z"}, pos: [-600.0, -200.0]),
        "/floor_animal/run5": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose5", "position": "place", "aim": "aim", "scale": "scale5"}, pos: [-400.0, -200.0]),
        "/floor_animal/scale6": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 6}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 740.0]),
        "/floor_animal/pose6": (kind: "geo.file", params: {"file": "library/floor_animal/pose_6.obj", "up": "z"}, pos: [-600.0, -100.0]),
        "/floor_animal/run6": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose6", "position": "place", "aim": "aim", "scale": "scale6"}, pos: [-400.0, -100.0]),
        "/floor_animal/scale7": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "fast": 100.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "scale", "pose": 7}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "fast": "controls:fast", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled", "bpm": "bus:travel_bpm"}, pos: [-900.0, 870.0]),
        "/floor_animal/pose7": (kind: "geo.file", params: {"file": "library/floor_animal/pose_7.obj", "up": "z"}, pos: [-600.0, 0.0]),
        "/floor_animal/run7": (kind: "geo.tex_instance", params: {"extent": 16.0}, inputs: {"in": "pose7", "position": "place", "aim": "aim", "scale": "scale7"}, pos: [-400.0, 0.0]),
        "/floor_animal/poses": (kind: "geo.merge", inputs: {"in0": "run0", "in1": "run1", "in2": "run2", "in3": "run3", "in4": "run4", "in5": "run5", "in6": "run6", "in7": "run7"}, pos: [-200.0, -350.0]),
        "/floor_animal/lines": (kind: "mat.wireframe", params: {"faces": "hidden", "line_width": 2.5, "color": [1.0, 0.55, 0.95, 1.0]}, pos: [-200.0, -550.0]),
        "/floor_animal/cover_mat": (kind: "mat.constant", params: {"color": [0.0, 0.0, 0.0, 1.0]}, pos: [-200.0, -150.0]),
        "/floor_animal/wire": (kind: "geo.assign_material", inputs: {"in": "poses", "mat": "lines"}, pos: [0.0, -450.0]),
        "/floor_animal/cover": (kind: "geo.assign_material", inputs: {"in": "poses", "mat": "cover_mat"}, pos: [0.0, -250.0]),
        "/floor_animal/horse": (kind: "geo.merge", inputs: {"in0": "wire", "in1": "cover"}, pos: [200.0, -350.0]),
        "/floor_animal/out": (kind: "geo.out", inputs: {"in": "horse"}, pos: [400.0, -350.0]),
    },
)
