// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_galaxy": (kind: "comp.base", params: {"expose": "presence = galaxy.presence\nbrightness = galaxy.brightness\nwarmth = controls.value0\nspin = spin_rate.b\nlift = energy_lift.b\nenergy_curve = energy_curve.b\ntilt = galaxy.tilt\nangle = galaxy.angle\nsize = galaxy.size\ntwist = galaxy.twist\narms = galaxy.arms\nbulge = galaxy.bulge\ndust = galaxy.dust\ncenter = galaxy.center"}),
        "/sky_galaxy/bus": (kind: "chan.in", pos: [-800.0, 0.0]),
        "/sky_galaxy/controls": (kind: "chan.constant", params: {"name0": "warmth", "value0": 0.0}, pos: [-800.0, 300.0]),
        "/sky_galaxy/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-600.0, -100.0]),
        "/sky_galaxy/spin_rate": (kind: "chan.math", params: {"b": 0.5, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-400.0, -100.0]),
        "/sky_galaxy/energy": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-600.0, 50.0]),
        "/sky_galaxy/energy_curve": (kind: "chan.math", params: {"b": 2.5, "op": "power"}, inputs: {"a": "energy"}, pos: [-400.0, 50.0]),
        "/sky_galaxy/energy_lift": (kind: "chan.math", params: {"b": 0.0, "op": "add"}, inputs: {"a": "energy_curve"}, pos: [-200.0, 50.0]),
        "/sky_galaxy/galaxy": (kind: "tex.shader", params: {"angle": -20.0, "arms": 2, "brightness": 0.6, "bulge": 0.09, "center": [0.56, 0.44], "dust": 0.8, "file": "library/sky_galaxy/galaxy.wgsl", "presence": 1.0, "resolution": "custom", "size": 0.8, "tilt": 64.0, "twinkle": 0, "twist": 2.2}, binds: {"energy": "energy_lift:energy_low", "spin": "spin_rate:travelled", "warmth": "controls:warmth"}, pos: [0.0, 0.0]),
        "/sky_galaxy/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}, pos: [-400.0, 250.0]),
        "/sky_galaxy/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}, pos: [-400.0, 350.0]),
        "/sky_galaxy/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}, pos: [-400.0, 450.0]),
        "/sky_galaxy/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}, pos: [-200.0, 300.0]),
        "/sky_galaxy/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}, pos: [-200.0, 400.0]),
        "/sky_galaxy/palette": (kind: "tex.cross", inputs: {"a": "warm", "b": "cold"}, binds: {"cross": "controls:warmth"}, pos: [0.0, 350.0]),
        "/sky_galaxy/tinted": (kind: "tex.composite", params: {"op": "color"}, inputs: {"in0": "galaxy", "in1": "palette"}, pos: [200.0, 100.0]),
        "/sky_galaxy/out": (kind: "tex.out", inputs: {"in": "tinted"}, pos: [400.0, 100.0]),
    },
)
