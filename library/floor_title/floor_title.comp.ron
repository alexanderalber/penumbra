// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_title": (kind: "comp.base", params: {"expose": "presence = glow.presence\ntext = words.text\nsource = glow.source\nwarmth = glow.warmth\nahead = glow.ahead\nevery = glow.every\nlong = glow.long\nwide = glow.wide\nspan = glow.span\nbrightness = glow.brightness\nrim = glow.rim\nbeats_per_bar = glow.beats_per_bar\nfade = glow.fade\ngone = glow.gone"}),
        "/floor_title/bus": (kind: "chan.in", pos: [-1000.0, 0.0]),
        "/floor_title/lane": (kind: "tex.in", pos: [-1000.0, 150.0]),
        "/floor_title/track": (kind: "chan.select", params: {"channels": "track_index"}, inputs: {"in": "bus"}, pos: [-800.0, -300.0]),
        "/floor_title/number": (kind: "chan.math", params: {"op": "add", "b": 1.0}, inputs: {"a": "track"}, pos: [-600.0, -300.0]),
        "/floor_title/words": (kind: "tex.text", params: {"text": "PENUMBRA", "font": "JetBrains Mono", "style": "Bold", "size": 200.0, "color": [1.0, 1.0, 1.0, 1.0], "position": [0.02, 0.5], "align": "left", "width": 2048, "height": 256, "keep_size": true}, pos: [-600.0, -150.0]),
        "/floor_title/track_text": (kind: "tex.text", params: {"text": "TRACK 1", "font": "JetBrains Mono", "style": "Bold", "size": 200.0, "color": [1.0, 1.0, 1.0, 1.0], "position": [0.02, 0.5], "align": "left", "width": 2048, "height": 256, "keep_size": true}, binds: {"text": (node: "number", channel: "track_index", format: "TRACK {.0}")}, pos: [-400.0, -300.0]),
        "/floor_title/measure": (kind: "tex.shader", params: {"file": "library/floor_title/measure.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true}, inputs: {"in0": "words", "in1": "track_text"}, pos: [-200.0, -250.0]),
        "/floor_title/glow": (kind: "tex.shader", params: {"file": "library/floor_title/title.wgsl", "resolution": "custom", "width": 1280, "height": 1024, "keep_size": true, "source": "text", "presence": 1.0, "warmth": 0.0, "ahead": 4.0, "every": 8.0, "long": 4.0, "wide": 0.9, "span": 8.0, "pen": 0.02, "glyph": 0.0586, "brightness": 1.4, "rim": 1.0, "beats_per_bar": 4.0, "left": -10.0, "right": 10.0, "near": -2.0, "far": 14.0, "fade": 7.0, "gone": 11.0}, inputs: {"in0": "lane", "in1": "words", "in2": "track_text", "in3": "measure"}, binds: {"track_bars": "bus:track_bars"}, pos: [0.0, 0.0]),
        "/floor_title/sheet_mat": (kind: "mat.constant", inputs: {"texture": "glow"}, pos: [200.0, 0.0]),
        "/floor_title/plane": (kind: "geo.primitive", params: {"shape": "plane", "size": [20.0, 1.0, 16.0]}, pos: [0.0, -300.0]),
        "/floor_title/sheet": (kind: "geo.assign_material", inputs: {"in": "plane", "mat": "sheet_mat"}, pos: [200.0, -200.0]),
        "/floor_title/lay": (kind: "geo.transform", params: {"rotate": [-90.0, 0.0, 0.0], "translate": [0.0, 6.0, 0.015]}, inputs: {"in": "sheet"}, pos: [400.0, -100.0]),
        "/floor_title/out": (kind: "geo.out", inputs: {"in": "lay"}, pos: [600.0, 0.0]),
    },
)
