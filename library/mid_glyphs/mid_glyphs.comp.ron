// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_glyphs": (kind: "comp.base", params: {"about": "Seven rings of light hanging in the air ahead over the lane of stage_valley, one inside the other.", "expose": "presence = controls.value0\nopen = controls.value1\nopen_at = controls.value2\nopen_full = controls.value3\nsize = controls.value4\nat = controls.value5\nhover = controls.value6\nfollow = controls.value7\nspread = controls.value8\ndepth = controls.value9\ntilt = controls.value10\nturn = controls.value11\nlight = controls.value12\npulse = controls.value13\nwarmth = controls.value14\narrive_bars = controls.value15\nleave_bars = controls.value16\nclose = snap.rise\nhold = snap.fall\nthickness = sizes.thickness\nline_width = ring_lines.line_width\nextent = rings.extent", "shelf": "music stage/mid"}, pos: [0.0, 0.0]),
        "/mid_glyphs/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/mid_glyphs/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/mid_glyphs/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/mid_glyphs/controls": (kind: "chan.constant", params: {"rows": 17, "name0": "presence", "value0": 1.0, "name1": "open", "value1": 0.0, "name2": "open_at", "value2": 0.15, "name3": "open_full", "value3": 0.6, "name4": "size", "value4": 1.0, "name5": "at", "value5": 9.0, "name6": "hover", "value6": 2.2, "name7": "follow", "value7": 0.7, "name8": "spread", "value8": 0.45, "name9": "depth", "value9": 0.8, "name10": "tilt", "value10": 50.0, "name11": "turn", "value11": 96.0, "name12": "light", "value12": 1.0, "name13": "pulse", "value13": 0.25, "name14": "warmth", "value14": 0.0, "name15": "arrive_bars", "value15": 8.0, "name16": "leave_bars", "value16": 2.0}, pos: [-1200.0, 450.0]),
        "/mid_glyphs/drop": (kind: "chan.select", params: {"channels": "drop"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/mid_glyphs/snap": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.25, "fall": 4.0}, inputs: {"in": "drop"}, pos: [-800.0, -150.0]),
        "/mid_glyphs/places": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 32, "height": 16, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "place"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-600.0, -100.0]),
        "/mid_glyphs/heading": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 32, "height": 16, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "aim"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-600.0, 30.0]),
        "/mid_glyphs/sizes": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 32, "height": 16, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "scale", "thickness": 0.01}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-600.0, 160.0]),
        "/mid_glyphs/light": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 32, "height": 16, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "color"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-600.0, 290.0]),
        "/mid_glyphs/memory": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 9, "height": 1, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "memory"}, inputs: {"in0": "lane", "in1": "memory_loop"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-600.0, 420.0]),
        "/mid_glyphs/memory_loop": (kind: "tex.feedback", inputs: {"previous": "memory"}, pos: [-1000.0, 600.0]),
        "/mid_glyphs/segment": (kind: "geo.file", params: {"file": "library/mid_glyphs/segment.obj", "up": "z"}, pos: [-600.0, -450.0]),
        "/mid_glyphs/ring_lines": (kind: "mat.wireframe", params: {"line_width": 2.0, "faces": "open"}, pos: [-600.0, -300.0]),
        "/mid_glyphs/ring_wire": (kind: "geo.assign_material", inputs: {"in": "segment", "mat": "ring_lines"}, pos: [-400.0, -350.0]),
        "/mid_glyphs/rings": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "ring_wire", "position": "places", "aim": "heading", "scale": "sizes", "color": "light"}, pos: [-200.0, 0.0]),
        "/mid_glyphs/ball_place": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 7, "height": 1, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "ball_place"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-300.0, -560.0]),
        "/mid_glyphs/ball_size": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 7, "height": 1, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "ball_size"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-300.0, -480.0]),
        "/mid_glyphs/ball_light": (kind: "tex.shader", params: {"file": "library/mid_glyphs/glyphs.wgsl", "resolution": "custom", "width": 7, "height": 1, "keep_size": true, "presence": 1.0, "open": 0.0, "open_at": 0.15, "open_full": 0.6, "size": 1.0, "at": 9.0, "hover": 2.2, "follow": 0.7, "spread": 0.45, "depth": 0.8, "tilt": 50.0, "turn": 96.0, "light": 1.0, "pulse": 0.25, "warmth": 0.0, "arrive_bars": 8.0, "leave_bars": 2.0, "what": "ball_light"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "open": "controls:open", "open_at": "controls:open_at", "open_full": "controls:open_full", "size": "controls:size", "at": "controls:at", "hover": "controls:hover", "follow": "controls:follow", "spread": "controls:spread", "depth": "controls:depth", "tilt": "controls:tilt", "turn": "controls:turn", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "arrive_bars": "controls:arrive_bars", "leave_bars": "controls:leave_bars", "bar_index": "bus:bar_index", "bar": "bus:bar", "beats": "bus:travelled", "beat": "bus:beat", "swell": "pose:swell", "dawn": "pose:dawn", "eye": "pose:height", "reach": "pose:far", "snap": "snap:drop"}, pos: [-300.0, -400.0]),
        "/mid_glyphs/ball": (kind: "tex.shader", params: {"file": "library/mid_glyphs/ball.wgsl", "resolution": "custom", "width": 64, "height": 64, "keep_size": true}, pos: [-600.0, -760.0]),
        "/mid_glyphs/ball_mat": (kind: "mat.constant", inputs: {"texture": "ball"}, pos: [-400.0, -760.0]),
        "/mid_glyphs/ball_quad": (kind: "geo.file", params: {"file": "library/mid_glyphs/ball.obj", "up": "z"}, pos: [-600.0, -640.0]),
        "/mid_glyphs/ball_model": (kind: "geo.assign_material", inputs: {"in": "ball_quad", "mat": "ball_mat"}, pos: [-300.0, -680.0]),
        "/mid_glyphs/balls": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "ball_model", "position": "ball_place", "scale": "ball_size", "color": "ball_light"}, pos: [-100.0, -400.0]),
        "/mid_glyphs/all": (kind: "geo.merge", inputs: {"in0": "rings", "in1": "balls"}, pos: [0.0, -100.0]),
        "/mid_glyphs/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [0.0, 0.0]),
    },
)
