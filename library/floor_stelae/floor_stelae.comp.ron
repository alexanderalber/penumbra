// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_stelae": (kind: "comp.base", params: {"expose": "presence = controls.value0\nseed = controls.value1\nheight = controls.value2\nwidth = controls.value3\nthick = controls.value4\nlight = controls.value5\npulse = controls.value6\nface = controls.value7\nlane = controls.value8\nclear = controls.value9\nnear = controls.value10\nfar = controls.value11\nwarmth = controls.value12\ngroove = controls.value13\ngroups = controls.value14\nsize = controls.value15\nspread = controls.value16\nscatter = controls.value17\ndisc = controls.value18\nglow_every = controls.value19\nglow_fall = controls.value20\nbase = controls.value21\nsmooth = level.fall\nline_width = rim_lines.line_width"}, pos: [0.0, 0.0]),
        "/floor_stelae/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/floor_stelae/lane": (kind: "tex.in", pos: [-1400.0, 150.0]),
        "/floor_stelae/pose": (kind: "chan.in", pos: [-1400.0, 300.0]),
        "/floor_stelae/controls": (kind: "chan.constant", params: {"rows": 22, "name0": "presence", "value0": 1.0, "name1": "seed", "value1": 0.0, "name2": "tall", "value2": 2.6, "name3": "wide", "value3": 1.0, "name4": "thick", "value4": 0.55, "name5": "light", "value5": 1.0, "name6": "pulse", "value6": 0.25, "name7": "face", "value7": 30.0, "name8": "lane", "value8": 1.6, "name9": "clear", "value9": 1.3, "name10": "near", "value10": -4.0, "name11": "far", "value11": 36.0, "name12": "warmth", "value12": 0.0, "name13": "groove", "value13": 1.0, "name14": "groups", "value14": 0.35, "name15": "size", "value15": 5.0, "name16": "spread", "value16": 1.0, "name17": "scatter", "value17": 2.5, "name18": "disc", "value18": 0.6, "name19": "glow_every", "value19": 4.0, "name20": "glow_fall", "value20": 3.0, "name21": "base", "value21": 0.2}, pos: [-1400.0, 450.0]),
        "/floor_stelae/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1200.0, -150.0]),
        "/floor_stelae/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.5}, inputs: {"in": "bass"}, pos: [-1000.0, -150.0]),
