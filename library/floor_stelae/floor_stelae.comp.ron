// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_stelae": (kind: "comp.base", params: {"expose": "presence = controls.value0\nseed = controls.value1\nheight = controls.value2\nwidth = controls.value3\nthick = controls.value4\nlight = controls.value5\npulse = controls.value6\nface = controls.value7\nlane = controls.value8\nclear = controls.value9\nnear = controls.value10\nfar = controls.value11\nwarmth = controls.value12\nsmooth = level.fall\ngroove = glyphs.groove\nline_width = rim_lines.line_width"}, pos: [0.0, 0.0]),
        "/floor_stelae/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_stelae/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_stelae/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/floor_stelae/controls": (kind: "chan.constant", params: {"rows": 13, "name0": "presence", "value0": 1.0, "name1": "seed", "value1": 0.0, "name2": "tall", "value2": 2.4, "name3": "wide", "value3": 0.9, "name4": "thick", "value4": 0.35, "name5": "light", "value5": 1.0, "name6": "pulse", "value6": 0.25, "name7": "face", "value7": 30.0, "name8": "lane", "value8": 1.6, "name9": "clear", "value9": 1.3, "name10": "near", "value10": -4.0, "name11": "far", "value11": 36.0, "name12": "warmth", "value12": 0.0}, pos: [-1200.0, 450.0]),
        "/floor_stelae/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_stelae/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.5}, inputs: {"in": "bass"}, pos: [-800.0, -150.0]),
        "/floor_stelae/place": (kind: "tex.shader", params: {"file": "library/floor_stelae/stelae.wgsl", "resolution": "custom", "width": 1, "height": 8, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 2.4, "wide": 0.9, "thick": 0.35, "light": 1.0, "pulse": 0.25, "face": 30.0, "lane": 1.6, "clear": 1.3, "near": -4.0, "far": 36.0, "warmth": 0.0, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "wide": "controls:wide", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "face": "controls:face", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, -100.0]),
        "/floor_stelae/aim": (kind: "tex.shader", params: {"file": "library/floor_stelae/stelae.wgsl", "resolution": "custom", "width": 1, "height": 8, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 2.4, "wide": 0.9, "thick": 0.35, "light": 1.0, "pulse": 0.25, "face": 30.0, "lane": 1.6, "clear": 1.3, "near": -4.0, "far": 36.0, "warmth": 0.0, "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "wide": "controls:wide", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "face": "controls:face", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 30.0]),
        "/floor_stelae/size1": (kind: "tex.shader", params: {"file": "library/floor_stelae/stelae.wgsl", "resolution": "custom", "width": 1, "height": 8, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 2.4, "wide": 0.9, "thick": 0.35, "light": 1.0, "pulse": 0.25, "face": 30.0, "lane": 1.6, "clear": 1.3, "near": -4.0, "far": 36.0, "warmth": 0.0, "what": "glyph1"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "wide": "controls:wide", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "face": "controls:face", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 160.0]),
        "/floor_stelae/size2": (kind: "tex.shader", params: {"file": "library/floor_stelae/stelae.wgsl", "resolution": "custom", "width": 1, "height": 8, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 2.4, "wide": 0.9, "thick": 0.35, "light": 1.0, "pulse": 0.25, "face": 30.0, "lane": 1.6, "clear": 1.3, "near": -4.0, "far": 36.0, "warmth": 0.0, "what": "glyph2"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "wide": "controls:wide", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "face": "controls:face", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 290.0]),
        "/floor_stelae/size3": (kind: "tex.shader", params: {"file": "library/floor_stelae/stelae.wgsl", "resolution": "custom", "width": 1, "height": 8, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 2.4, "wide": 0.9, "thick": 0.35, "light": 1.0, "pulse": 0.25, "face": 30.0, "lane": 1.6, "clear": 1.3, "near": -4.0, "far": 36.0, "warmth": 0.0, "what": "glyph3"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "wide": "controls:wide", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "face": "controls:face", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 420.0]),
        "/floor_stelae/light": (kind: "tex.shader", params: {"file": "library/floor_stelae/stelae.wgsl", "resolution": "custom", "width": 1, "height": 8, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 2.4, "wide": 0.9, "thick": 0.35, "light": 1.0, "pulse": 0.25, "face": 30.0, "lane": 1.6, "clear": 1.3, "near": -4.0, "far": 36.0, "warmth": 0.0, "what": "color"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "wide": "controls:wide", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "face": "controls:face", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 550.0]),
        "/floor_stelae/glyphs": (kind: "tex.shader", params: {"file": "library/floor_stelae/glyphs.wgsl", "resolution": "custom", "width": 512, "height": 384, "keep_size": true, "seed": 0, "groove": 0.12, "stroke": 0.045}, binds: {"seed": "controls:seed"}, pos: [-1000.0, -1150.0]),
        "/floor_stelae/face_mat": (kind: "mat.constant", inputs: {"texture": "glyphs"}, pos: [-800.0, -1150.0]),
        "/floor_stelae/light_ramp": (kind: "tex.ramp", params: {"width": 64, "height": 1, "keep_size": true, "shape": "horizontal", "keys": "0 0 0 0\n1 1 1 1"}, pos: [-1000.0, -1000.0]),
        "/floor_stelae/rim_lines": (kind: "mat.wireframe", params: {"line_width": 1.5, "faces": "open"}, inputs: {"texture": "light_ramp"}, pos: [-800.0, -1000.0]),
        "/floor_stelae/edges": (kind: "geo.file", params: {"file": "library/floor_stelae/stela_edges.obj", "up": "z"}, pos: [-1000.0, -850.0]),
        "/floor_stelae/rim": (kind: "geo.assign_material", inputs: {"in": "edges", "mat": "rim_lines"}, pos: [-800.0, -850.0]),
        "/floor_stelae/stone1": (kind: "geo.file", params: {"file": "library/floor_stelae/stela_1.obj", "up": "z"}, pos: [-1000.0, -700.0]),
        "/floor_stelae/face1": (kind: "geo.assign_material", inputs: {"in": "stone1", "mat": "face_mat"}, pos: [-800.0, -700.0]),
        "/floor_stelae/model1": (kind: "geo.merge", inputs: {"in0": "face1", "in1": "rim"}, pos: [-600.0, -700.0]),
        "/floor_stelae/stelae1": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "model1", "position": "place", "aim": "aim", "scale": "size1", "color": "light"}, pos: [-200.0, -200.0]),
        "/floor_stelae/stone2": (kind: "geo.file", params: {"file": "library/floor_stelae/stela_2.obj", "up": "z"}, pos: [-1000.0, -450.0]),
        "/floor_stelae/face2": (kind: "geo.assign_material", inputs: {"in": "stone2", "mat": "face_mat"}, pos: [-800.0, -450.0]),
        "/floor_stelae/model2": (kind: "geo.merge", inputs: {"in0": "face2", "in1": "rim"}, pos: [-600.0, -450.0]),
        "/floor_stelae/stelae2": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "model2", "position": "place", "aim": "aim", "scale": "size2", "color": "light"}, pos: [-200.0, 0.0]),
        "/floor_stelae/stone3": (kind: "geo.file", params: {"file": "library/floor_stelae/stela_3.obj", "up": "z"}, pos: [-1000.0, -200.0]),
        "/floor_stelae/face3": (kind: "geo.assign_material", inputs: {"in": "stone3", "mat": "face_mat"}, pos: [-800.0, -200.0]),
        "/floor_stelae/model3": (kind: "geo.merge", inputs: {"in0": "face3", "in1": "rim"}, pos: [-600.0, -200.0]),
        "/floor_stelae/stelae3": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "model3", "position": "place", "aim": "aim", "scale": "size3", "color": "light"}, pos: [-200.0, 200.0]),
        "/floor_stelae/water_sheet": (kind: "geo.primitive", params: {"shape": "plane", "size": [160.0, 1.0, 160.0]}, pos: [-800.0, 900.0]),
        "/floor_stelae/water_flat": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0], "translate": [0.0, 60.0, 0.0]}, inputs: {"in": "water_sheet"}, pos: [-600.0, 900.0]),
        "/floor_stelae/water_mat": (kind: "mat.occluder", pos: [-800.0, 780.0]),
        "/floor_stelae/water": (kind: "geo.assign_material", inputs: {"in": "water_flat", "mat": "water_mat"}, pos: [-400.0, 900.0]),
        "/floor_stelae/all": (kind: "geo.merge", inputs: {"in0": "stelae1", "in1": "stelae2", "in2": "stelae3", "in3": "water"}, pos: [0.0, 0.0]),
        "/floor_stelae/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [200.0, 0.0]),
    },
)
