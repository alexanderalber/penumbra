// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/reaction_diffusion": (kind: "comp.base", params: {"about": "Reaction-diffusion (Gray-Scott): Turing patterns that grow as coral, a maze, dividing cells (mitosis) or worms, on a mask or everywhere.", "params": "@param preset choice(coral|mitosis|solitons|maze|worms|uskate|holes|loops|letters|word|map) = coral -- the pattern; choosing one writes its values into the params, then they are yours; a new preset starts over, or grows out of the old pattern while morph is on\n@param morph bool = false -- a new preset grows out of the old pattern instead of starting over: feed and kill glide to the new values\n@expose glide = guard.glide\n@param seed int = 1 0..1000 -- another random start; a change starts over\n@param speed float = 1 0.125..4 -- steps per frame as a share of steps; 2 grows twice as fast and costs twice as much\n@param outside choice(off|dead|coral|mitosis|solitons|maze|worms|uskate|holes|loops) = off -- what grows where the mask input is dark; choosing one writes the params of the group outside rates; off: the mask is ignored; dead: nothing grows there, so the pattern lives on the object only\n@expose touch = step.touch\n@expose touch_strength = step.touch_strength\n@param pause bool = false -- holds the pattern as it is\n@group reaction\n@expose feed = guard.feed\n@expose kill = guard.kill\n@expose map = step.map\n@param steps int = 8 1..64 -- steps per frame at speed 1\n@group outside rates\n@expose use_mask = step.use_mask\n@expose outside_feed = guard.outside_feed\n@expose outside_kill = guard.outside_kill\n@expose coverage_in = measure.coverage_in\n@group start\n@param pattern choice(blobs|square|noise|rings|mask|empty) = blobs -- where the reaction starts; blobs: round blobs at random places; square: one square in the middle; noise: small specks; rings: rings around the middle; mask: blobs only where the mask is bright; empty: nothing; a change starts over\n@param size float = 8 1..40 -- blob radius, half the square\'s width, ring width, in texels; a change starts over\n@param density float = 0.35 0..1 -- blobs: share of places with a blob; noise: share of seeded specks; a change starts over\n@group guards\n@expose revive = guard.revive\n@expose revive_after = guard.revive_after\n@expose dead = guard.dead\n@expose stir = guard.stir\n@expose stir_after = guard.stir_after\n@expose still = guard.still\n@expose stir_count = step.stir_count\n@expose stir_size = step.stir_size\n@group look\n@expose colors = show.colors\n@expose top = show.top\n@expose relief = show.relief\n@expose glow = show.glow\n@expose light = show.light\n@expose shine = show.shine\n@expose through = show.through\n@expose marker = show.marker\n@expose mode = show.mode\n@expose mask_blur = soft.size\n@expose out_width = show.width\n@expose out_height = show.height\n@group diffusion\n@expose du = step.du\n@expose dv = step.dv\n@expose dt = step.dt\n@expose edges = step.edges\n@group size\n@param width int = 960 16..4096 -- simulation width in texels; the pattern\'s features are 10 to 20 texels wide, so a larger size gives a finer pattern; a change starts over\n@param height int = 540 16..4096 -- simulation height in texels; a change starts over\n@reset seed pattern size density width height\n@reset preset unless morph\n@preset preset=* feed=0.0545 kill=0.062 map=false steps=8 touch=wipe pattern=blobs size=8 density=0.35 outside=off\n@preset preset=* stir=true stir_after=20 still=0.003 colors=263040 708599 59f2ff top=0.55 through=0\n@preset preset=coral still=0.006 -- branching coral grows from random blobs and fills the surface in about 15 s, then creeps on as a slow labyrinth\n@preset preset=mitosis feed=0.0367 kill=0.0649 colors=0d1c17 57996b 8cffa6 top=0.38 -- spots that divide until they fill the surface, in about a minute\n@preset preset=solitons feed=0.03 kill=0.062 touch=kill colors=magma top=0.38 -- a packed field of still dots; people leave a dark trail that closes again\n@preset preset=maze feed=0.029 kill=0.057 steps=12 pattern=noise colors=1f1f21 b8babf ffffff -- a labyrinth of stripes within 5 s; a person\'s path fills with stripes again\n@preset preset=worms feed=0.078 kill=0.061 steps=12 still=0.005 colors=1c120f 8f5430 ff8c2e -- loose worms, rings and forks on dark ground\n@preset preset=uskate feed=0.062 kill=0.0609 steps=16 top=0.38 -- thin lines and gliding specks on a filled ground\n@preset preset=holes feed=0.039 kill=0.058 steps=12 pattern=noise colors=0d1c17 57996b 8cffa6 -- dark specks in a filled field\n@preset preset=loops feed=0.018 kill=0.051 pattern=rings stir=false colors=plasma -- busy blobs and loops that never settle\n@preset preset=letters pattern=mask density=0.6 stir_after=10 still=0.0005 colors=1c120f 8f5430 ff8c2e through=0.15 outside=dead -- glossy coral tubes only where the mask is bright\n@preset preset=word feed=0.029 kill=0.057 steps=12 pattern=noise colors=1c120f 8f5430 ff8c2e outside=solitons -- a labyrinth where the mask is bright, still dots around it\n@preset preset=map map=true steps=12 pattern=noise density=0.6 stir=false colors=magma -- feed rises from bottom to top and kill from left to right: stripes, spots and chaos side by side\n@preset outside=* use_mask=true outside_feed=0.02 outside_kill=0.09 coverage_in=all\n@preset outside=off use_mask=false -- the mask is ignored: the preset\'s pattern everywhere\n@preset outside=dead coverage_in=mask -- nothing grows where the mask is dark, so the pattern lives on the object only; the coverage counts only there\n@preset outside=coral outside_feed=0.0545 outside_kill=0.062 -- coral where the mask is dark\n@preset outside=mitosis outside_feed=0.0367 outside_kill=0.0649 -- mitosis where the mask is dark\n@preset outside=solitons outside_feed=0.03 outside_kill=0.062 -- solitons where the mask is dark\n@preset outside=maze outside_feed=0.029 outside_kill=0.057 -- maze where the mask is dark\n@preset outside=worms outside_feed=0.078 outside_kill=0.061 -- worms where the mask is dark\n@preset outside=uskate outside_feed=0.062 outside_kill=0.0609 -- uskate where the mask is dark\n@preset outside=holes outside_feed=0.039 outside_kill=0.058 -- holes where the mask is dark\n@preset outside=loops outside_feed=0.018 outside_kill=0.051 -- loops where the mask is dark", "shelf": "simulations"}, pos: [300.0, 0.0]),
        "/reaction_diffusion/activity": (kind: "chan.out", inputs: {"in": "change"}, pos: [1600.0, 200.0]),
        "/reaction_diffusion/activity_back": (kind: "chan.feedback", inputs: {"previous": "change"}, pos: [1600.0, 100.0]),
        "/reaction_diffusion/allowed": (kind: "chan.select", params: {"channels": "allowed"}, inputs: {"in": "numbers"}, pos: [1200.0, 420.0]),
        "/reaction_diffusion/allowed_min": (kind: "chan.math", params: {"b": 0.000001, "op": "max"}, inputs: {"a": "allowed"}, pos: [1400.0, 420.0]),
        "/reaction_diffusion/change": (kind: "chan.select", params: {"channels": "activity"}, inputs: {"in": "numbers"}, pos: [1200.0, 200.0]),
        "/reaction_diffusion/coverage": (kind: "chan.out", inputs: {"in": "share"}, pos: [1800.0, 320.0]),
        "/reaction_diffusion/coverage_back": (kind: "chan.feedback", inputs: {"previous": "share"}, pos: [1800.0, 420.0]),
        "/reaction_diffusion/covered": (kind: "chan.select", params: {"channels": "coverage"}, inputs: {"in": "numbers"}, pos: [1200.0, 320.0]),
        "/reaction_diffusion/guard": (kind: "tex.shader", params: {"feed": 0.0545, "file": "library/reaction_diffusion/guard.wgsl", "format": "32f", "height": 1, "keep_size": true, "kill": 0.062, "outside_feed": 0.02, "outside_kill": 0.09, "resolution": "custom", "still": 0.006, "stir": true, "stir_after": 20, "width": 4}, inputs: {"in0": "guard_loop"}, binds: {"activity": "activity_back:activity", "coverage": "coverage_back:coverage", "morph": "parent.morph", "now": "time:seconds", "pause": "parent.pause"}, pos: [0.0, -280.0]),
        "/reaction_diffusion/guard_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "guard"}, pos: [-200.0, -300.0]),
        "/reaction_diffusion/loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "step"}, pos: [0.0, -100.0]),
        "/reaction_diffusion/mask": (kind: "tex.in", pos: [-600.0, 100.0]),
        "/reaction_diffusion/measure": (kind: "tex.shader", params: {"coverage_in": "all", "file": "library/reaction_diffusion/measure.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "quarter", "in1": "step", "in2": "loop", "in3": "soft"}, pos: [800.0, 300.0]),
        "/reaction_diffusion/numbers": (kind: "chan.from_tex", params: {"components": "rgb", "names": "activity coverage allowed"}, inputs: {"in": "measure"}, pos: [1000.0, 300.0]),
        "/reaction_diffusion/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [750.0, 0.0]),
        "/reaction_diffusion/pace": (kind: "chan.constant", params: {"name0": "steps"}, binds: {"value0": "parent.steps"}, pos: [-400.0, -480.0]),
        "/reaction_diffusion/passes": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "pace"}, binds: {"b": "parent.speed"}, pos: [-200.0, -480.0]),
        "/reaction_diffusion/people": (kind: "tex.in", pos: [-600.0, 250.0]),
        "/reaction_diffusion/quarter": (kind: "tex.resolution", params: {"keep_size": true, "multiply": 0.25}, inputs: {"in": "world"}, pos: [600.0, 380.0]),
        "/reaction_diffusion/seed": (kind: "tex.shader", params: {"file": "library/reaction_diffusion/seed.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "world", "in1": "soft"}, binds: {"density": "parent.density", "pattern": "parent.pattern", "seed": "parent.seed", "size": "parent.size"}, pos: [-200.0, -120.0]),
        "/reaction_diffusion/share": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "covered", "b": "allowed_min"}, pos: [1400.0, 320.0]),
        "/reaction_diffusion/show": (kind: "tex.shader", params: {"colors": "263040 708599 59f2ff", "file": "library/reaction_diffusion/show.wgsl", "keep_size": true, "resolution": "custom", "through": 0, "top": 0.55}, inputs: {"in0": "step", "in1": "soft", "in2": "people"}, pos: [500.0, 0.0]),
        "/reaction_diffusion/soft": (kind: "tex.blur", params: {"size": 6.0}, inputs: {"in": "mask"}, pos: [-400.0, 100.0]),
        "/reaction_diffusion/step": (kind: "tex.shader", params: {"file": "library/reaction_diffusion/step.wgsl", "format": "32f", "keep_size": true, "map": false, "touch": "wipe", "use_mask": false}, inputs: {"in0": "loop", "in1": "soft", "in2": "people", "in3": "seed", "in4": "guard"}, binds: {"bypass": "parent.pause", "iterations": "passes:steps", "pause": "parent.pause"}, pos: [250.0, 0.0]),
        "/reaction_diffusion/time": (kind: "chan.clock", params: {"mode": "free"}, pos: [-400.0, -380.0]),
        "/reaction_diffusion/world": (kind: "tex.constant", params: {"color": [0.0, 0.0, 0.0, 0.0], "keep_size": true}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [-600.0, -50.0]),
    },
)
