// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_palms": (kind: "comp.base", params: {"about": "Wireframe palms in a line on each side of the lane, leaning away from it.", "expose": "presence = controls.value0\nspacing = controls.value1\nsize = controls.value2\nfronds = controls.value3\nsway = controls.value4\ncalm = controls.value5\ndroop = controls.value6\nlane = controls.value7\nclear = controls.value8\nnear = controls.value9\nfar = controls.value10\nbeats_per_bar = controls.value11\nsmooth = level.fall\ncolor = palm_lines.color\nline_width = palm_lines.line_width\nextent = trunks.extent", "shelf": "music stage/floor"}),
        "/floor_palms/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_palms/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_palms/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 2.0, "name2": "size", "value2": 1.0, "name3": "fronds", "value3": 7.0, "name4": "sway", "value4": 14.0, "name5": "calm", "value5": 0.25, "name6": "droop", "value6": 8.0, "name7": "lane", "value7": 1.6, "name8": "clear", "value8": 1.5, "name9": "near", "value9": -2.0, "name10": "far", "value10": 14.0, "name11": "beats_per_bar", "value11": 4.0}, pos: [-1200.0, 300.0]),
        "/floor_palms/mids": (kind: "chan.select", params: {"channels": "energy_mid"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_palms/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.2, "fall": 0.6}, inputs: {"in": "mids"}, pos: [-800.0, -150.0]),
        "/floor_palms/trunk_place": (kind: "tex.shader", params: {"file": "library/floor_palms/palms.wgsl", "resolution": "custom", "width": 2, "height": 16, "keep_size": true, "part": "trunk", "what": "place", "presence": 1.0, "spacing": 2.0, "size": 1.0, "fronds": 7, "sway": 14.0, "calm": 0.25, "droop": 8.0, "lane": 1.6, "clear": 1.5, "near": -2.0, "far": 14.0, "beats_per_bar": 4.0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "size": "controls:size", "fronds": "controls:fronds", "sway": "controls:sway", "calm": "controls:calm", "droop": "controls:droop", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, -100.0]),
        "/floor_palms/trunk_aim": (kind: "tex.shader", params: {"file": "library/floor_palms/palms.wgsl", "resolution": "custom", "width": 2, "height": 16, "keep_size": true, "part": "trunk", "what": "aim", "presence": 1.0, "spacing": 2.0, "size": 1.0, "fronds": 7, "sway": 14.0, "calm": 0.25, "droop": 8.0, "lane": 1.6, "clear": 1.5, "near": -2.0, "far": 14.0, "beats_per_bar": 4.0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "size": "controls:size", "fronds": "controls:fronds", "sway": "controls:sway", "calm": "controls:calm", "droop": "controls:droop", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 30.0]),
        "/floor_palms/trunk_scale": (kind: "tex.shader", params: {"file": "library/floor_palms/palms.wgsl", "resolution": "custom", "width": 2, "height": 16, "keep_size": true, "part": "trunk", "what": "scale", "presence": 1.0, "spacing": 2.0, "size": 1.0, "fronds": 7, "sway": 14.0, "calm": 0.25, "droop": 8.0, "lane": 1.6, "clear": 1.5, "near": -2.0, "far": 14.0, "beats_per_bar": 4.0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "size": "controls:size", "fronds": "controls:fronds", "sway": "controls:sway", "calm": "controls:calm", "droop": "controls:droop", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 160.0]),
        "/floor_palms/frond_place": (kind: "tex.shader", params: {"file": "library/floor_palms/palms.wgsl", "resolution": "custom", "width": 16, "height": 16, "keep_size": true, "part": "frond", "what": "place", "presence": 1.0, "spacing": 2.0, "size": 1.0, "fronds": 7, "sway": 14.0, "calm": 0.25, "droop": 8.0, "lane": 1.6, "clear": 1.5, "near": -2.0, "far": 14.0, "beats_per_bar": 4.0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "size": "controls:size", "fronds": "controls:fronds", "sway": "controls:sway", "calm": "controls:calm", "droop": "controls:droop", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 290.0]),
        "/floor_palms/frond_aim": (kind: "tex.shader", params: {"file": "library/floor_palms/palms.wgsl", "resolution": "custom", "width": 16, "height": 16, "keep_size": true, "part": "frond", "what": "aim", "presence": 1.0, "spacing": 2.0, "size": 1.0, "fronds": 7, "sway": 14.0, "calm": 0.25, "droop": 8.0, "lane": 1.6, "clear": 1.5, "near": -2.0, "far": 14.0, "beats_per_bar": 4.0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "size": "controls:size", "fronds": "controls:fronds", "sway": "controls:sway", "calm": "controls:calm", "droop": "controls:droop", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 420.0]),
        "/floor_palms/frond_scale": (kind: "tex.shader", params: {"file": "library/floor_palms/palms.wgsl", "resolution": "custom", "width": 16, "height": 16, "keep_size": true, "part": "frond", "what": "scale", "presence": 1.0, "spacing": 2.0, "size": 1.0, "fronds": 7, "sway": 14.0, "calm": 0.25, "droop": 8.0, "lane": 1.6, "clear": 1.5, "near": -2.0, "far": 14.0, "beats_per_bar": 4.0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "size": "controls:size", "fronds": "controls:fronds", "sway": "controls:sway", "calm": "controls:calm", "droop": "controls:droop", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 550.0]),
        "/floor_palms/trunk": (kind: "geo.file", params: {"file": "library/floor_palms/trunk.obj", "up": "z"}, pos: [-1000.0, -800.0]),
        "/floor_palms/trunk_wire": (kind: "geo.assign_material", inputs: {"in": "trunk", "mat": "palm_lines"}, pos: [-600.0, -800.0]),
        "/floor_palms/trunk_cover": (kind: "geo.assign_material", inputs: {"in": "trunk", "mat": "cover_mat"}, pos: [-600.0, -950.0]),
        "/floor_palms/trunk_model": (kind: "geo.merge", inputs: {"in0": "trunk_wire", "in1": "trunk_cover"}, pos: [-400.0, -850.0]),
        "/floor_palms/frond": (kind: "geo.file", params: {"file": "library/floor_palms/frond.obj", "up": "z"}, pos: [-1000.0, -650.0]),
        "/floor_palms/frond_wire": (kind: "geo.assign_material", inputs: {"in": "frond", "mat": "palm_lines"}, pos: [-600.0, -650.0]),
        "/floor_palms/frond_cover": (kind: "geo.assign_material", inputs: {"in": "frond", "mat": "cover_mat"}, pos: [-600.0, -800.0]),
        "/floor_palms/frond_model": (kind: "geo.merge", inputs: {"in0": "frond_wire", "in1": "frond_cover"}, pos: [-400.0, -700.0]),
        "/floor_palms/palm_lines": (kind: "mat.wireframe", params: {"faces": "hidden", "line_width": 2.0}, pos: [-800.0, -950.0]),
        "/floor_palms/cover_mat": (kind: "mat.occluder", pos: [-800.0, -1100.0]),
        "/floor_palms/trunks": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "trunk_model", "position": "trunk_place", "aim": "trunk_aim", "scale": "trunk_scale"}, pos: [-200.0, -200.0]),
        "/floor_palms/fronds": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "frond_model", "position": "frond_place", "aim": "frond_aim", "scale": "frond_scale"}, pos: [-200.0, 0.0]),
        "/floor_palms/palms": (kind: "geo.merge", inputs: {"in0": "trunks", "in1": "fronds"}, pos: [0.0, 0.0]),
        "/floor_palms/out": (kind: "geo.out", inputs: {"in": "palms"}, pos: [200.0, 0.0]),
    },
)
