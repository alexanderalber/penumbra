// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_traps": (kind: "comp.base", params: {"about": "Thin red laser beams in the tunnel, a maze with one free corridor.", "params": "@expose presence = controls.value0\n@expose seed = controls.value1\n@expose corridor_bars = controls.value2\n@expose wander = controls.value3\n@expose climb = controls.value4\n@expose middle = controls.value5\n@expose open = controls.value6\n@expose eye = controls.value7\n@expose beams = controls.value8\n@expose spacing = controls.value9\n@expose slant = controls.value10\n@expose brightness = controls.value11\n@expose flicker = controls.value12\n@expose beats_per_bar = controls.value13\n@expose arrive = arrive.rise\n@expose leave = arrive.fall\n@expose color = light.color\n@expose thickness = scale.thickness\n@expose line_width = core_lines.line_width\n@expose glow_width = glow_lines.line_width", "shelf": "music stage/mid"}),
        "/mid_traps/bus": (kind: "chan.in", pos: [-1000.0, 0.0]),
        "/mid_traps/lane": (kind: "tex.in", pos: [-1000.0, 150.0]),
        "/mid_traps/pose": (kind: "chan.in", pos: [-1000.0, 450.0]),
        "/mid_traps/controls": (kind: "chan.constant", params: {"rows": 14, "name0": "presence", "value0": 1.0, "name1": "seed", "value1": 1.0, "name2": "corridor_bars", "value2": 2.0, "name3": "wander", "value3": 1.2, "name4": "climb", "value4": 0.5, "name5": "middle", "value5": 2.0, "name6": "open", "value6": 0.9, "name7": "eye", "value7": 0.6, "name8": "beams", "value8": 2.0, "name9": "spacing", "value9": 1.0, "name10": "slant", "value10": 1.0, "name11": "brightness", "value11": 1.0, "name12": "flicker", "value12": 0.3, "name13": "beats_per_bar", "value13": 4.0}, pos: [-1000.0, 300.0]),
        "/mid_traps/wanted": (kind: "chan.select", params: {"channels": "presence"}, inputs: {"in": "controls"}, pos: [-800.0, 400.0]),
        "/mid_traps/arrive": (kind: "chan.filter", params: {"type": "first_order", "rise": 1.0, "fall": 0.15}, inputs: {"in": "wanted"}, pos: [-700.0, 500.0]),
        "/mid_traps/place": (kind: "tex.shader", params: {"resolution": "custom", "width": 64, "height": 4, "keep_size": true, "file": "library/mid_traps/traps.wgsl", "what": "place"}, inputs: {"in0": "lane"}, binds: {"seed": "controls:seed", "corridor_bars": "controls:corridor_bars", "wander": "controls:wander", "climb": "controls:climb", "middle": "controls:middle", "open": "controls:open", "eye": "controls:eye", "beams": "controls:beams", "spacing": "controls:spacing", "slant": "controls:slant", "brightness": "controls:brightness", "flicker": "controls:flicker", "beats_per_bar": "controls:beats_per_bar", "presence": "arrive:presence", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "eye_height": "pose:height", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 0.0]),
        "/mid_traps/aim": (kind: "tex.shader", params: {"resolution": "custom", "width": 64, "height": 4, "keep_size": true, "file": "library/mid_traps/traps.wgsl", "what": "aim"}, inputs: {"in0": "lane"}, binds: {"seed": "controls:seed", "corridor_bars": "controls:corridor_bars", "wander": "controls:wander", "climb": "controls:climb", "middle": "controls:middle", "open": "controls:open", "eye": "controls:eye", "beams": "controls:beams", "spacing": "controls:spacing", "slant": "controls:slant", "brightness": "controls:brightness", "flicker": "controls:flicker", "beats_per_bar": "controls:beats_per_bar", "presence": "arrive:presence", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "eye_height": "pose:height", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 150.0]),
        "/mid_traps/scale": (kind: "tex.shader", params: {"resolution": "custom", "width": 64, "height": 4, "keep_size": true, "file": "library/mid_traps/traps.wgsl", "what": "scale"}, inputs: {"in0": "lane"}, binds: {"seed": "controls:seed", "corridor_bars": "controls:corridor_bars", "wander": "controls:wander", "climb": "controls:climb", "middle": "controls:middle", "open": "controls:open", "eye": "controls:eye", "beams": "controls:beams", "spacing": "controls:spacing", "slant": "controls:slant", "brightness": "controls:brightness", "flicker": "controls:flicker", "beats_per_bar": "controls:beats_per_bar", "presence": "arrive:presence", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "eye_height": "pose:height", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 300.0]),
        "/mid_traps/light": (kind: "tex.shader", params: {"resolution": "custom", "width": 64, "height": 4, "keep_size": true, "file": "library/mid_traps/traps.wgsl", "what": "light"}, inputs: {"in0": "lane"}, binds: {"seed": "controls:seed", "corridor_bars": "controls:corridor_bars", "wander": "controls:wander", "climb": "controls:climb", "middle": "controls:middle", "open": "controls:open", "eye": "controls:eye", "beams": "controls:beams", "spacing": "controls:spacing", "slant": "controls:slant", "brightness": "controls:brightness", "flicker": "controls:flicker", "beats_per_bar": "controls:beats_per_bar", "presence": "arrive:presence", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "eye_height": "pose:height", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 450.0]),
        "/mid_traps/beam": (kind: "geo.file", params: {"file": "library/mid_traps/beam.obj", "up": "z"}, pos: [-500.0, -300.0]),
        "/mid_traps/core_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-500.0, -150.0]),
        "/mid_traps/glow_lines": (kind: "mat.wireframe", params: {"color": [1.0, 1.0, 1.0, 0.22], "line_width": 7.0}, pos: [-500.0, -450.0]),
        "/mid_traps/core_wire": (kind: "geo.assign_material", inputs: {"in": "beam", "mat": "core_lines"}, pos: [-250.0, -200.0]),
        "/mid_traps/glow_wire": (kind: "geo.assign_material", inputs: {"in": "beam", "mat": "glow_lines"}, pos: [-250.0, -400.0]),
        "/mid_traps/cores": (kind: "geo.tex_instance", params: {"extent": 30.0}, inputs: {"in": "core_wire", "position": "place", "aim": "aim", "scale": "scale", "color": "light"}, pos: [0.0, 0.0]),
        "/mid_traps/glows": (kind: "geo.tex_instance", params: {"extent": 30.0}, inputs: {"in": "glow_wire", "position": "place", "aim": "aim", "scale": "scale", "color": "light"}, pos: [0.0, -250.0]),
        "/mid_traps/beams": (kind: "geo.merge", inputs: {"in0": "cores", "in1": "glows"}, pos: [200.0, 0.0]),
        "/mid_traps/out": (kind: "geo.out", inputs: {"in": "beams"}, pos: [400.0, 0.0]),
        "/mid_traps/corridor_params": (kind: "chan.select", params: {"channels": "seed corridor_bars wander climb middle"}, inputs: {"in": "controls"}, pos: [-800.0, 650.0]),
        "/mid_traps/corridor": (kind: "chan.out", inputs: {"in": "corridor_params"}, pos: [400.0, 650.0]),
    },
)
