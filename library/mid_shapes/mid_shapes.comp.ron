// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_shapes": (kind: "comp.base", params: {"expose": "presence = places.presence\ncount = places.count\nseed = controls.value0\nsize = places.size\nat = places.at\nhover = places.hover\nradius = places.radius\ndepth = places.depth\ntilt = places.tilt\ntight = places.tight\nscatter = places.scatter\nturn = places.turn\nspin = heading.spin\ncolor = lines.color\nline_width = lines.line_width"}, pos: [0.0, -600.0]),
        "/mid_shapes/bus": (kind: "chan.in", pos: [-1000.0, 0.0]),
        "/mid_shapes/lane": (kind: "tex.in", pos: [-1000.0, 150.0]),
        "/mid_shapes/controls": (kind: "chan.constant", params: {"name0": "seed", "value0": 0.0, "rows": 1}, pos: [-1000.0, 300.0]),
        "/mid_shapes/places": (kind: "tex.shader", params: {"file": "library/mid_shapes/formation.wgsl", "what": "place", "resolution": "custom", "width": 8, "height": 1, "keep_size": true, "presence": 1.0, "count": 5, "size": 0.7, "at": 6.0, "hover": 2.7, "radius": 2.4, "depth": 1.2, "tilt": 0.35, "tight": 0.6, "scatter": 3.0, "turn": 0.5}, inputs: {"in0": "lane"}, binds: {"bar_index": "bus:bar_index", "bar": "bus:bar", "build": "bus:build", "drop": "bus:drop"}, pos: [-700.0, 100.0]),
        "/mid_shapes/heading": (kind: "tex.shader", params: {"file": "library/mid_shapes/formation.wgsl", "what": "aim", "resolution": "custom", "width": 8, "height": 1, "keep_size": true, "spin": 0.25}, binds: {"beat_index": "bus:beat_index", "beat": "bus:beat"}, pos: [-700.0, 300.0]),
        "/mid_shapes/lines": (kind: "mat.wireframe", params: {"faces": "hidden", "edges": "polygons", "line_width": 1.5}, pos: [-700.0, -300.0]),
        "/mid_shapes/cover_mat": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-700.0, -450.0]),
        "/mid_shapes/octahedron": (kind: "geo.file", params: {"file": "library/mid_shapes/octahedron.obj", "up": "z"}, pos: [-400.0, -400.0]),
        "/mid_shapes/octahedron_wire": (kind: "geo.assign_material", inputs: {"in": "octahedron", "mat": "lines"}, pos: [-200.0, -450.0]),
        "/mid_shapes/octahedron_cover": (kind: "geo.assign_material", inputs: {"in": "octahedron", "mat": "cover_mat"}, pos: [-200.0, -350.0]),
        "/mid_shapes/octahedron_model": (kind: "geo.merge", inputs: {"in0": "octahedron_wire", "in1": "octahedron_cover"}, pos: [0.0, -400.0]),
        "/mid_shapes/octahedron_sizes": (kind: "tex.shader", params: {"file": "library/mid_shapes/sizes.wgsl", "kind": 0, "seed": 0}, inputs: {"in0": "places"}, binds: {"seed": "controls:seed"}, pos: [-400.0, -250.0]),
        "/mid_shapes/octahedrons": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "octahedron_model", "position": "places", "scale": "octahedron_sizes", "aim": "heading"}, pos: [200.0, -300.0]),
        "/mid_shapes/torus": (kind: "geo.file", params: {"file": "library/mid_shapes/torus.obj", "up": "z"}, pos: [-400.0, -100.0]),
        "/mid_shapes/torus_wire": (kind: "geo.assign_material", inputs: {"in": "torus", "mat": "lines"}, pos: [-200.0, -150.0]),
        "/mid_shapes/torus_cover": (kind: "geo.assign_material", inputs: {"in": "torus", "mat": "cover_mat"}, pos: [-200.0, -50.0]),
        "/mid_shapes/torus_model": (kind: "geo.merge", inputs: {"in0": "torus_wire", "in1": "torus_cover"}, pos: [0.0, -100.0]),
        "/mid_shapes/torus_sizes": (kind: "tex.shader", params: {"file": "library/mid_shapes/sizes.wgsl", "kind": 1, "seed": 0}, inputs: {"in0": "places"}, binds: {"seed": "controls:seed"}, pos: [-400.0, 50.0]),
        "/mid_shapes/tori": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "torus_model", "position": "places", "scale": "torus_sizes", "aim": "heading"}, pos: [200.0, 0.0]),
        "/mid_shapes/icosahedron": (kind: "geo.file", params: {"file": "library/mid_shapes/icosahedron.obj", "up": "z"}, pos: [-400.0, 200.0]),
        "/mid_shapes/icosahedron_wire": (kind: "geo.assign_material", inputs: {"in": "icosahedron", "mat": "lines"}, pos: [-200.0, 150.0]),
        "/mid_shapes/icosahedron_cover": (kind: "geo.assign_material", inputs: {"in": "icosahedron", "mat": "cover_mat"}, pos: [-200.0, 250.0]),
        "/mid_shapes/icosahedron_model": (kind: "geo.merge", inputs: {"in0": "icosahedron_wire", "in1": "icosahedron_cover"}, pos: [0.0, 200.0]),
        "/mid_shapes/icosahedron_sizes": (kind: "tex.shader", params: {"file": "library/mid_shapes/sizes.wgsl", "kind": 2, "seed": 0}, inputs: {"in0": "places"}, binds: {"seed": "controls:seed"}, pos: [-400.0, 350.0]),
        "/mid_shapes/icosahedrons": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "icosahedron_model", "position": "places", "scale": "icosahedron_sizes", "aim": "heading"}, pos: [200.0, 300.0]),
        "/mid_shapes/solids": (kind: "geo.merge", inputs: {"in0": "octahedrons", "in1": "tori", "in2": "icosahedrons"}, pos: [400.0, 0.0]),
        "/mid_shapes/out": (kind: "geo.out", inputs: {"in": "solids"}, pos: [600.0, 0.0]),
    },
)
