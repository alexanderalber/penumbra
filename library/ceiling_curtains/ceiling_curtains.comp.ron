// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/ceiling_curtains": (kind: "comp.base", params: {"expose": "presence = controls.value0\nspacing = controls.value1\nstrips = controls.value2\npitch = controls.value3\nfill = controls.value4\nshort = controls.value5\nlong = controls.value6\nopen = controls.value7\nfoot = controls.value8\nwave = controls.value9\ncalm = controls.value10\nwaves = controls.value11\nflow = controls.value12\nceiling = controls.value13\nnear = controls.value14\nfar = controls.value15\nbeats_per_bar = controls.value16\nsmooth = level.fall\ncolor = cloth_lines.color\nline_width = cloth_lines.line_width\nextent = cloth.extent"}, pos: [0.0, 0.0]),
        "/ceiling_curtains/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/ceiling_curtains/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/ceiling_curtains/controls": (kind: "chan.constant", params: {"rows": 17, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 2.0, "name2": "strips", "value2": 25.0, "name3": "pitch", "value3": 0.5, "name4": "fill", "value4": 0.6, "name5": "short", "value5": 0.7, "name6": "long", "value6": 2.4, "name7": "open", "value7": 2.0, "name8": "foot", "value8": 1.2, "name9": "wave", "value9": 22.0, "name10": "calm", "value10": 0.3, "name11": "waves", "value11": 1.2, "name12": "flow", "value12": 0.25, "name13": "ceiling", "value13": 4.0, "name14": "near", "value14": -2.0, "name15": "far", "value15": 14.0, "name16": "beats_per_bar", "value16": 4.0}, pos: [-1200.0, 300.0]),
        "/ceiling_curtains/mids": (kind: "chan.select", params: {"channels": "energy_mid"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/ceiling_curtains/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.2, "fall": 0.6}, inputs: {"in": "mids"}, pos: [-800.0, -150.0]),
        "/ceiling_curtains/segment_place": (kind: "tex.shader", params: {"file": "library/ceiling_curtains/curtains.wgsl", "resolution": "custom", "width": 32, "height": 48, "keep_size": true, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "strips": "controls:strips", "pitch": "controls:pitch", "fill": "controls:fill", "short": "controls:short", "long": "controls:long", "open": "controls:open", "foot": "controls:foot", "wave": "controls:wave", "calm": "controls:calm", "waves": "controls:waves", "flow": "controls:flow", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, -100.0]),
        "/ceiling_curtains/segment_aim": (kind: "tex.shader", params: {"file": "library/ceiling_curtains/curtains.wgsl", "resolution": "custom", "width": 32, "height": 48, "keep_size": true, "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "strips": "controls:strips", "pitch": "controls:pitch", "fill": "controls:fill", "short": "controls:short", "long": "controls:long", "open": "controls:open", "foot": "controls:foot", "wave": "controls:wave", "calm": "controls:calm", "waves": "controls:waves", "flow": "controls:flow", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 30.0]),
        "/ceiling_curtains/segment_scale": (kind: "tex.shader", params: {"file": "library/ceiling_curtains/curtains.wgsl", "resolution": "custom", "width": 32, "height": 48, "keep_size": true, "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "strips": "controls:strips", "pitch": "controls:pitch", "fill": "controls:fill", "short": "controls:short", "long": "controls:long", "open": "controls:open", "foot": "controls:foot", "wave": "controls:wave", "calm": "controls:calm", "waves": "controls:waves", "flow": "controls:flow", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 160.0]),
        "/ceiling_curtains/segment_hem": (kind: "tex.shader", params: {"file": "library/ceiling_curtains/curtains.wgsl", "resolution": "custom", "width": 32, "height": 48, "keep_size": true, "what": "hem"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "strips": "controls:strips", "pitch": "controls:pitch", "fill": "controls:fill", "short": "controls:short", "long": "controls:long", "open": "controls:open", "foot": "controls:foot", "wave": "controls:wave", "calm": "controls:calm", "waves": "controls:waves", "flow": "controls:flow", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 290.0]),
        "/ceiling_curtains/segment_light": (kind: "tex.shader", params: {"file": "library/ceiling_curtains/curtains.wgsl", "resolution": "custom", "width": 32, "height": 48, "keep_size": true, "what": "light"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "strips": "controls:strips", "pitch": "controls:pitch", "fill": "controls:fill", "short": "controls:short", "long": "controls:long", "open": "controls:open", "foot": "controls:foot", "wave": "controls:wave", "calm": "controls:calm", "waves": "controls:waves", "flow": "controls:flow", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "mid": "level:energy_mid"}, pos: [-600.0, 420.0]),
        "/ceiling_curtains/segment": (kind: "geo.file", params: {"file": "library/ceiling_curtains/segment.obj", "up": "z"}, pos: [-800.0, -500.0]),
        "/ceiling_curtains/cloth_lines": (kind: "mat.wireframe", params: {"color": [1.0, 0.45, 0.85, 1.0], "line_width": 2.5}, pos: [-800.0, -350.0]),
        "/ceiling_curtains/cloth_wire": (kind: "geo.assign_material", inputs: {"in": "segment", "mat": "cloth_lines"}, pos: [-600.0, -400.0]),
        "/ceiling_curtains/hem": (kind: "geo.file", params: {"file": "library/ceiling_curtains/hem.obj", "up": "z"}, pos: [-800.0, -650.0]),
        "/ceiling_curtains/hem_wire": (kind: "geo.assign_material", inputs: {"in": "hem", "mat": "cloth_lines"}, pos: [-600.0, -600.0]),
        "/ceiling_curtains/cloth": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "cloth_wire", "position": "segment_place", "aim": "segment_aim", "scale": "segment_scale", "color": "segment_light"}, pos: [-200.0, 0.0]),
        "/ceiling_curtains/hems": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "hem_wire", "position": "segment_place", "aim": "segment_aim", "scale": "segment_hem", "color": "segment_light"}, pos: [-200.0, 150.0]),
        "/ceiling_curtains/curtains": (kind: "geo.merge", inputs: {"in0": "cloth", "in1": "hems"}, pos: [0.0, 0.0]),
        "/ceiling_curtains/out": (kind: "geo.out", inputs: {"in": "curtains"}, pos: [200.0, 0.0]),
    },
)
