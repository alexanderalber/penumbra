// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sweep": (kind: "comp.base", params: {"about": "A scan line sweeping across everything the scan found, with a fading trail.", "params": "@expose speed = scan.speed\n@expose angle = scan.angle\n@expose line = scan.line\n@expose trail = scan.trail\n@expose color = scan.color\n@expose tint = scan.tint\n@expose pause = scan.pause\n@expose clock = scan.clock", "shelf": "scanned objects"}),
        "/sweep/labels": (kind: "tex.in"),
        "/sweep/out": (kind: "tex.out", inputs: {"in": "scan"}),
        "/sweep/scan": (kind: "tex.shader", params: {"file": "library/sweep/sweep.wgsl"}, inputs: {"in0": "labels"}),
    },
)
