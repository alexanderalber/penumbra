// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/edges": (kind: "comp.base", params: {"about": "Thin glowing lines where two faces meet and round the objects.", "params": "@expose line = lines.line\n@expose color = lines.color\n@expose objects = lines.objects\n@expose glow = lines.glow", "shelf": "scanned objects"}),
        "/edges/labels": (kind: "tex.in"),
        "/edges/lines": (kind: "tex.shader", params: {"file": "library/edges/edges.wgsl"}, inputs: {"in0": "labels"}),
        "/edges/out": (kind: "tex.out", inputs: {"in": "lines"}),
    },
)
