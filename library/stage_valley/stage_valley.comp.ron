// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/stage_valley": (kind: "comp.base", params: {"expose": "warmth = controls.value1\nlift = energy_lift.b\nenergy_curve = energy_curve.b\ndim = sky_base.dim\ndawn = controls.value2\nswell_rise = swell_lag.rise\nswell_fall = swell_lag.fall\nband_height = sky_base.band_height\nband_width = sky_base.band_width\nbars_per_turn = lane_map.bars_per_turn\nswing = lane_map.swing\nturn = lane_map.turn\nstep = controls.value0\nbeats_per_bar = lane_map.beats_per_bar\nstart = fade.start\nend = shape.value4\ngap = gap_memory.gap\ngap_length = lane_map.gap_length\ncamera = preset.row\nglide = glide.rise\npresets = presets.text\nground = lake.ground\nreflection = lake.reflection\nripple = controls.value5\nmist = lake.mist\nshore = lake.shore\nmirror = controls.value3\nmirror_size = controls.value4"}),
        "/stage_valley/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/stage_valley/floor": (kind: "geo.in", pos: [400.0, 300.0]),
        "/stage_valley/mid": (kind: "geo.in", pos: [400.0, 450.0]),
        "/stage_valley/ceiling": (kind: "geo.in", pos: [400.0, 600.0]),
        "/stage_valley/sky": (kind: "tex.in", pos: [800.0, -700.0]),
        "/stage_valley/controls": (kind: "chan.constant", params: {"rows": 6, "name0": "step", "value0": 0.5, "name1": "warmth", "value1": 0.0, "name2": "dawn", "value2": 0.0, "name3": "mirror", "value3": 1.0, "name4": "mirror_size", "value4": 0.5, "name5": "ripple", "value5": 1.0}, pos: [-1400.0, 200.0]),
        "/stage_valley/shape": (kind: "chan.constant", params: {"rows": 5, "name0": "axis", "value0": 0.5, "name1": "walls", "value1": 0.0, "name2": "curve", "value2": 0.0, "name3": "radius", "value3": 0.0, "name4": "far", "value4": 40.0}, pos: [0.0, 1050.0]),
        "/stage_valley/swell_energy": (kind: "chan.select", params: {"channels": "energy"}, inputs: {"in": "bus"}, pos: [-1200.0, -1300.0]),
        "/stage_valley/calm_scale": (kind: "chan.math", params: {"b": -1.6667, "op": "multiply"}, inputs: {"a": "swell_energy"}, pos: [-1000.0, -1300.0]),
        "/stage_valley/calm": (kind: "chan.math", params: {"b": 1.3333, "op": "add"}, inputs: {"a": "calm_scale"}, pos: [-800.0, -1300.0]),
        "/stage_valley/swell_build": (kind: "chan.select", params: {"channels": "build"}, inputs: {"in": "bus"}, pos: [-1200.0, -1150.0]),
        "/stage_valley/build_part": (kind: "chan.math", params: {"b": 0.6, "op": "multiply"}, inputs: {"a": "swell_build"}, pos: [-1000.0, -1150.0]),
        "/stage_valley/tension": (kind: "chan.math", params: {"op": "max"}, inputs: {"a": "calm", "b": "build_part"}, pos: [-600.0, -1250.0]),
        "/stage_valley/tension_top": (kind: "chan.math", params: {"b": 1.0, "op": "min"}, inputs: {"a": "tension"}, pos: [-400.0, -1250.0]),
        "/stage_valley/tension_clamped": (kind: "chan.math", params: {"b": 0.0, "op": "max"}, inputs: {"a": "tension_top"}, pos: [-200.0, -1250.0]),
        "/stage_valley/swell_lag": (kind: "chan.filter", params: {"type": "first_order", "rise": 8.0, "fall": 3.0}, inputs: {"in": "tension_clamped"}, pos: [0.0, -1250.0]),
        "/stage_valley/swell": (kind: "chan.rename", params: {"names": "energy=swell"}, inputs: {"in": "swell_lag"}, pos: [200.0, -1250.0]),
        "/stage_valley/dawn": (kind: "chan.select", params: {"channels": "dawn"}, inputs: {"in": "controls"}, pos: [0.0, 1200.0]),
        "/stage_valley/pose_all": (kind: "chan.merge", inputs: {"in0": "glide", "in1": "shape", "in2": "swell", "in3": "dawn"}, pos: [200.0, 1050.0]),
        "/stage_valley/presets": (kind: "table.text", params: {"format": "csv", "text": "height,pitch,roll,fov,side\n1.2,-1,0,58,0\n1.8,-3,0,54,0\n2.4,-5,0,70,0\n1.6,0,0,50,0\n0.9,1,-4,62,-8\n1.8,-2,5,64,10"}, pos: [-400.0, 800.0]),
        "/stage_valley/sky_base": (kind: "tex.shader", params: {"file": "library/stage_valley/sky.wgsl", "dim": 0.7, "band_height": 0.1, "band_width": 0.9}, binds: {"eye": "glide:height", "pitch": "glide:pitch", "fov": "glide:fov", "roll": "glide:roll", "side": "glide:side", "reach": "shape:far", "dawn": "controls:dawn", "swell": "swell:swell", "energy": "energy_lift:energy_low", "warmth": "controls:warmth"}, pos: [400.0, -700.0]),
        "/stage_valley/sky_over": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "sky_base", "in1": "sky"}, pos: [800.0, -600.0]),
        "/stage_valley/mirror_small": (kind: "tex.resolution", params: {"multiply": 0.25}, inputs: {"in": "sky_over"}, pos: [800.0, -450.0]),
        "/stage_valley/mirror_soft": (kind: "tex.blur", params: {"size": 5.0}, inputs: {"in": "mirror_small"}, pos: [900.0, -350.0]),
        "/stage_valley/lake": (kind: "tex.shader", params: {"file": "library/stage_valley/lake.wgsl", "ground": 1.0, "reflection": 1.0, "ripple": 1.0, "mist": 1.0, "shore": 0.5}, inputs: {"in0": "sky_over", "in1": "lane_map", "in2": "mirror_soft", "in3": "mirror_things"}, binds: {"mirror": "controls:mirror", "ripple": "controls:ripple", "eye": "glide:height", "pitch": "glide:pitch", "fov": "glide:fov", "roll": "glide:roll", "side": "glide:side", "reach": "shape:far", "beats": "bus:travelled", "step": "controls:step", "energy": "energy_lift:energy_low", "warmth": "controls:warmth"}, pos: [1000.0, -400.0]),
        "/stage_valley/scene": (kind: "geo.merge", inputs: {"in0": "floor", "in1": "mid", "in2": "ceiling"}, pos: [600.0, 250.0]),
        "/stage_valley/fade": (kind: "tex.shader", params: {"end": 40.0, "file": "library/stage_valley/fade.wgsl", "start": 12.0}, inputs: {"in0": "render", "in1": "render:data"}, binds: {"end": "shape:far", "eye": "glide:height", "pitch": "glide:pitch", "fov": "glide:fov", "roll": "glide:roll", "side": "glide:side"}, pos: [1000.0, 300.0]),
        "/stage_valley/picture": (kind: "tex.composite", inputs: {"in0": "lake", "in1": "fade"}, pos: [1200.0, -100.0]),
        "/stage_valley/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1200.0, -500.0]),
        "/stage_valley/energy": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1200.0, -900.0]),
        "/stage_valley/energy_curve": (kind: "chan.math", params: {"b": 2.5, "op": "power"}, inputs: {"a": "energy"}, pos: [-1000.0, -900.0]),
        "/stage_valley/energy_lift": (kind: "chan.math", params: {"b": 0.0, "op": "add"}, inputs: {"a": "energy_curve"}, pos: [-800.0, -900.0]),
        "/stage_valley/lane_map": (kind: "tex.shader", params: {"bars_per_turn": 4.0, "beats_per_bar": 4.0, "file": "library/stage_valley/lane.wgsl", "height": 1, "keep_size": true, "resolution": "custom", "swing": 0.9, "turn": 4, "width": 256}, inputs: {"in0": "gap_memory"}, binds: {"beats": "bus:travelled", "drift": "bus:drift", "step": "controls:step"}, pos: [-1000.0, 0.0]),
        "/stage_valley/gap_memory": (kind: "tex.shader", params: {"file": "library/stage_valley/gaps.wgsl", "resolution": "custom", "width": 512, "height": 1, "keep_size": true}, inputs: {"in0": "gap_loop"}, binds: {"beats": "bus:travelled", "step": "controls:step", "far": "shape:far"}, pos: [-1250.0, 150.0]),
        "/stage_valley/gap_loop": (kind: "tex.feedback", inputs: {"previous": "gap_memory"}, pos: [-1450.0, 150.0]),
        "/stage_valley/lane": (kind: "tex.out", inputs: {"in": "lane_map"}, pos: [-800.0, 150.0]),
        "/stage_valley/preset": (kind: "chan.from_table", params: {"row": 0}, inputs: {"in": "presets"}, pos: [-200.0, 800.0]),
        "/stage_valley/glide": (kind: "chan.filter", params: {"type": "critical", "rise": 3.0}, inputs: {"in": "preset"}, pos: [0.0, 800.0]),
        "/stage_valley/angles": (kind: "chan.select", params: {"channels": "pitch side"}, inputs: {"in": "glide"}, pos: [200.0, 700.0]),
        "/stage_valley/radians": (kind: "chan.math", params: {"b": 0.0174533, "op": "multiply"}, inputs: {"a": "angles"}, pos: [400.0, 700.0]),
        "/stage_valley/radians_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "radians"}, pos: [600.0, 650.0]),
        "/stage_valley/tan_third": (kind: "chan.math", params: {"b": 0.33333, "op": "multiply"}, inputs: {"a": "radians_sq"}, pos: [800.0, 650.0]),
        "/stage_valley/tan_factor": (kind: "chan.math", params: {"b": 1.0, "op": "add"}, inputs: {"a": "tan_third"}, pos: [1000.0, 650.0]),
        "/stage_valley/tangent": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "tan_factor"}, pos: [1200.0, 700.0]),
        "/stage_valley/reach": (kind: "chan.math", params: {"b": 10.0, "op": "multiply"}, inputs: {"a": "tangent"}, pos: [1400.0, 700.0]),
        "/stage_valley/eye": (kind: "chan.select", params: {"channels": "height"}, inputs: {"in": "glide"}, pos: [200.0, 850.0]),
        "/stage_valley/look": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "reach", "b": "eye"}, pos: [1600.0, 750.0]),
        "/stage_valley/camera": (kind: "view.camera", params: {"far": 120.0, "fov": 60.0, "position": [0.0, 0.0, 1.2], "target": [0.0, 10.0, 1.15]}, binds: {"position.2": "eye:height", "target.0": "reach:side", "target.2": "look:pitch", "fov": "glide:fov", "roll": "glide:roll"}, pos: [600.0, 450.0]),
        "/stage_valley/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "scene"}, pos: [800.0, 300.0]),
        "/stage_valley/mirror_size": (kind: "chan.select", params: {"channels": "mirror_size"}, inputs: {"in": "controls"}, pos: [-1200.0, 350.0]),
        "/stage_valley/mirror_width": (kind: "chan.math", params: {"b": 1920.0, "op": "multiply"}, inputs: {"a": "mirror_size"}, pos: [-1000.0, 330.0]),
        "/stage_valley/mirror_height": (kind: "chan.math", params: {"b": 1080.0, "op": "multiply"}, inputs: {"a": "mirror_size"}, pos: [-1000.0, 400.0]),
        "/stage_valley/mirror_eye": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "eye"}, pos: [400.0, 950.0]),
        "/stage_valley/mirror_look": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "look"}, pos: [1800.0, 750.0]),
        "/stage_valley/roll": (kind: "chan.select", params: {"channels": "roll"}, inputs: {"in": "glide"}, pos: [200.0, 950.0]),
        "/stage_valley/mirror_roll": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "roll"}, pos: [400.0, 1000.0]),
        "/stage_valley/mirror_camera": (kind: "view.camera", params: {"far": 120.0, "fov": 60.0, "position": [0.0, 0.0, -1.2], "target": [0.0, 10.0, -1.15]}, binds: {"position.2": "mirror_eye:height", "target.0": "reach:side", "target.2": "mirror_look:pitch", "fov": "glide:fov", "roll": "mirror_roll:roll"}, pos: [600.0, 550.0]),
        "/stage_valley/mirror_render": (kind: "tex.render", params: {"keep_size": true, "width": 960, "height": 540}, inputs: {"camera": "mirror_camera", "geo": "scene"}, binds: {"width": "mirror_width:mirror_size", "height": "mirror_height:mirror_size"}, pos: [800.0, 450.0]),
        "/stage_valley/mirror_cut": (kind: "tex.shader", params: {"file": "library/stage_valley/mirror.wgsl", "resolution": "custom", "width": 1920, "height": 1080, "keep_size": true, "start": 12.0, "end": 40.0, "ripple": 1.0}, inputs: {"in0": "mirror_render", "in1": "mirror_render:data", "in2": "lane_map"}, binds: {"eye": "glide:height", "pitch": "glide:pitch", "fov": "glide:fov", "roll": "glide:roll", "side": "glide:side", "end": "shape:far", "reach": "shape:far", "beats": "bus:travelled", "step": "controls:step", "ripple": "controls:ripple"}, pos: [1000.0, 450.0]),
        "/stage_valley/mirror_things": (kind: "tex.blur", params: {"size": 1.0}, inputs: {"in": "mirror_cut"}, pos: [1100.0, 550.0]),
        "/stage_valley/out": (kind: "tex.out", inputs: {"in": "picture"}, pos: [1400.0, -100.0]),
        "/stage_valley/pose": (kind: "chan.out", inputs: {"in": "pose_all"}, pos: [400.0, 1050.0]),
    },
)
