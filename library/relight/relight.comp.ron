// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/relight": (kind: "comp.base", params: {"about": "A lamp that is not there, going round the object.", "params": "@expose radius = lamp.radius\n@expose ribs = lamp.ribs\n@expose speed = lamp.speed\n@expose elevation = lamp.elevation\n@expose ambient = lamp.ambient\n@expose color = lamp.color\n@expose rim = lamp.rim\n@expose clock = lamp.clock\n@expose soften = soft.size", "shelf": "scanned objects"}),
        "/relight/fine": (kind: "tex.in"),
        "/relight/labels": (kind: "tex.in"),
        "/relight/lamp": (kind: "tex.shader", params: {"file": "library/relight/relight.wgsl"}, inputs: {"in0": "labels", "in1": "soft", "in2": "fine", "in3": "wide"}),
        "/relight/out": (kind: "tex.out", inputs: {"in": "lamp"}),
        "/relight/sdf": (kind: "tex.in"),
        "/relight/soft": (kind: "tex.blur", params: {"size": 40.0}, inputs: {"in": "sdf"}),
        "/relight/wide": (kind: "tex.in"),
    },
)
