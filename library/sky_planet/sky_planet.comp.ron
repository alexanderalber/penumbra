// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_planet": (kind: "comp.base", params: {"about": "A planet with a tilted ring over the horizon.", "params": "@expose presence = planet.presence
@expose brightness = planet.brightness
@expose warmth = planet.warmth
@expose size = planet.size
@expose growth = planet.growth
@expose place = planet.place
@expose height = planet.above
@expose rise = planet.rise
@expose tilt = planet.tilt
@expose open = planet.open
@expose bands = planet.bands
@expose spin = planet.spin
@expose breathe = planet.breathe
@expose reach = planet.reach", "shelf": "music stage/sky"}),
        "/sky_planet/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/sky_planet/pose": (kind: "chan.in", pos: [-600.0, 150.0]),
        "/sky_planet/planet": (kind: "tex.shader", params: {"file": "library/sky_planet/planet.wgsl", "resolution": "custom", "presence": 1.0, "brightness": 1.0, "warmth": 0.0, "size": 0.09, "growth": 1.0, "place": -0.42, "above": 0.16, "rise": 0.1, "tilt": 18.0, "open": 0.3, "bands": 7.0, "spin": 0.01, "breathe": 0.0, "reach": 10.0, "axis": 4.0, "radius": 4.0, "far": 20.0, "bend": 0.0}, binds: {"beats": "bus:travelled", "energy": "bus:energy_low", "grow": "bus:track_phase", "eye": "pose:height", "pitch": "pose:pitch", "fov": "pose:fov", "roll": "pose:roll", "side": "pose:side", "bend": "pose:curve", "axis": "pose:axis", "radius": "pose:radius", "far": "pose:far"}, pos: [-300.0, 0.0]),
        "/sky_planet/out": (kind: "tex.out", inputs: {"in": "planet"}, pos: [0.0, 0.0]),
    },
)
