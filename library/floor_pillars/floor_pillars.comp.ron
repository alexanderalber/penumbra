// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_pillars": (kind: "comp.base", params: {"expose": "presence = places.presence\nspacing = places.spacing\nheight = places.tall\nwidth = places.across\nrows = places.rows\ngap = places.gap\npulse = places.pulse\nlane = places.lane\nnear = places.near\nfar = places.far\nbeats_per_bar = places.beats_per_bar\ncolor = pillar_lines.color\nextent = pillars.extent"}),
        "/floor_pillars/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/floor_pillars/lane": (kind: "tex.in", pos: [-600.0, 150.0]),
        "/floor_pillars/places": (kind: "tex.shader", params: {"across": 0.3, "beats_per_bar": 4.0, "far": 14.0, "file": "library/floor_pillars/pillars.wgsl", "gap": 1.2, "height": 32, "keep_size": true, "lane": 1.6, "near": -2.0, "presence": 1.0, "pulse": 0.1, "resolution": "custom", "rows": 2, "spacing": 1.0, "tall": 2.4, "width": 6}, inputs: {"in0": "lane"}, binds: {"beat": "bus:beat", "beats": "bus:travelled", "drift": "bus:drift"}, pos: [-400.0, 100.0]),
        "/floor_pillars/sizes": (kind: "tex.shader", params: {"file": "library/floor_pillars/sizes.wgsl"}, inputs: {"in0": "places"}, pos: [-200.0, 200.0]),
        "/floor_pillars/pillar": (kind: "geo.file", params: {"file": "library/floor_pillars/pillar.obj", "up": "z"}, pos: [-800.0, -300.0]),
        "/floor_pillars/pillar_lines": (kind: "mat.wireframe", params: {"faces": "hidden", "line_width": 2.0}, pos: [-600.0, -150.0]),
        "/floor_pillars/pillar_wire": (kind: "geo.assign_material", inputs: {"in": "pillar", "mat": "pillar_lines"}, pos: [-400.0, -200.0]),
        "/floor_pillars/cover_mat": (kind: "mat.occluder", pos: [-600.0, -320.0]),
        "/floor_pillars/cover": (kind: "geo.assign_material", inputs: {"in": "pillar", "mat": "cover_mat"}, pos: [-400.0, -350.0]),
        "/floor_pillars/model": (kind: "geo.merge", inputs: {"in0": "pillar_wire", "in1": "cover"}, pos: [-200.0, -250.0]),
        "/floor_pillars/pillars": (kind: "geo.tex_instance", params: {"extent": 30.0}, inputs: {"in": "model", "position": "places", "scale": "sizes"}, pos: [0.0, 0.0]),
        "/floor_pillars/out": (kind: "geo.out", inputs: {"in": "pillars"}, pos: [200.0, 0.0]),
    },
)
