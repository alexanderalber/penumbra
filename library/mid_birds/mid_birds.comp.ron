// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_birds": (kind: "comp.base", params: {"expose": "presence = controls.value0\nbirds = controls.value1\nsize = controls.value2\nat = controls.value3\nlow = controls.value4\nhigh = controls.value5\nevery = controls.value6\ncross = controls.value7\ngap = controls.value8\nflap = controls.value9\nphase = controls.value10\nseed = controls.value11\nextent = bodies.extent"}, pos: [0.0, 0.0]),
        "/mid_birds/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/mid_birds/pose": (kind: "chan.in", pos: [-1200.0, 150.0]),
        "/mid_birds/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "birds", "value1": 24.0, "name2": "size", "value2": 0.9, "name3": "at", "value3": 17.0, "name4": "low", "value4": 0.012, "name5": "high", "value5": 0.045, "name6": "every", "value6": 64.0, "name7": "cross", "value7": 48.0, "name8": "gap", "value8": 1.0, "name9": "flap", "value9": 1.0, "name10": "phase", "value10": 0.0, "name11": "seed", "value11": 0.0}, pos: [-1200.0, 300.0]),
        "/mid_birds/place": (kind: "tex.shader", params: {"file": "library/mid_birds/birds.wgsl", "resolution": "custom", "width": 8, "height": 4, "keep_size": true, "presence": 1.0, "birds": 24, "size": 0.9, "at": 17.0, "low": 0.012, "high": 0.045, "every": 64.0, "cross": 48.0, "gap": 1.0, "flap": 1.0, "phase": 0.0, "seed": 0, "what": "place"}, binds: {"presence": "controls:presence", "birds": "controls:birds", "size": "controls:size", "at": "controls:at", "low": "controls:low", "high": "controls:high", "every": "controls:every", "cross": "controls:cross", "gap": "controls:gap", "flap": "controls:flap", "phase": "controls:phase", "seed": "controls:seed", "beats": "bus:travelled", "eye": "pose:height", "side": "pose:side", "reach": "pose:far"}, pos: [-600.0, -100.0]),
        "/mid_birds/aim": (kind: "tex.shader", params: {"file": "library/mid_birds/birds.wgsl", "resolution": "custom", "width": 8, "height": 4, "keep_size": true, "presence": 1.0, "birds": 24, "size": 0.9, "at": 17.0, "low": 0.012, "high": 0.045, "every": 64.0, "cross": 48.0, "gap": 1.0, "flap": 1.0, "phase": 0.0, "seed": 0, "what": "aim"}, binds: {"presence": "controls:presence", "birds": "controls:birds", "size": "controls:size", "at": "controls:at", "low": "controls:low", "high": "controls:high", "every": "controls:every", "cross": "controls:cross", "gap": "controls:gap", "flap": "controls:flap", "phase": "controls:phase", "seed": "controls:seed", "beats": "bus:travelled", "eye": "pose:height", "side": "pose:side", "reach": "pose:far"}, pos: [-600.0, 30.0]),
        "/mid_birds/body_size": (kind: "tex.shader", params: {"file": "library/mid_birds/birds.wgsl", "resolution": "custom", "width": 8, "height": 4, "keep_size": true, "presence": 1.0, "birds": 24, "size": 0.9, "at": 17.0, "low": 0.012, "high": 0.045, "every": 64.0, "cross": 48.0, "gap": 1.0, "flap": 1.0, "phase": 0.0, "seed": 0, "what": "scale"}, binds: {"presence": "controls:presence", "birds": "controls:birds", "size": "controls:size", "at": "controls:at", "low": "controls:low", "high": "controls:high", "every": "controls:every", "cross": "controls:cross", "gap": "controls:gap", "flap": "controls:flap", "phase": "controls:phase", "seed": "controls:seed", "beats": "bus:travelled", "eye": "pose:height", "side": "pose:side", "reach": "pose:far"}, pos: [-600.0, 160.0]),
        "/mid_birds/wing_size": (kind: "tex.shader", params: {"file": "library/mid_birds/birds.wgsl", "resolution": "custom", "width": 8, "height": 4, "keep_size": true, "presence": 1.0, "birds": 24, "size": 0.9, "at": 17.0, "low": 0.012, "high": 0.045, "every": 64.0, "cross": 48.0, "gap": 1.0, "flap": 1.0, "phase": 0.0, "seed": 0, "what": "wings"}, binds: {"presence": "controls:presence", "birds": "controls:birds", "size": "controls:size", "at": "controls:at", "low": "controls:low", "high": "controls:high", "every": "controls:every", "cross": "controls:cross", "gap": "controls:gap", "flap": "controls:flap", "phase": "controls:phase", "seed": "controls:seed", "beats": "bus:travelled", "eye": "pose:height", "side": "pose:side", "reach": "pose:far"}, pos: [-600.0, 290.0]),
        "/mid_birds/black": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-1000.0, -600.0]),
        "/mid_birds/body_model": (kind: "geo.file", params: {"file": "library/mid_birds/body.obj", "up": "z"}, pos: [-1000.0, -500.0]),
        "/mid_birds/body_black": (kind: "geo.assign_material", inputs: {"in": "body_model", "mat": "black"}, pos: [-800.0, -500.0]),
        "/mid_birds/wings_model": (kind: "geo.file", params: {"file": "library/mid_birds/wings.obj", "up": "z"}, pos: [-1000.0, -350.0]),
        "/mid_birds/wings_black": (kind: "geo.assign_material", inputs: {"in": "wings_model", "mat": "black"}, pos: [-800.0, -350.0]),
        "/mid_birds/bodies": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"in": "body_black", "position": "place", "aim": "aim", "scale": "body_size"}, pos: [-200.0, -100.0]),
        "/mid_birds/wings": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"in": "wings_black", "position": "place", "aim": "aim", "scale": "wing_size"}, pos: [-200.0, 100.0]),
        "/mid_birds/all": (kind: "geo.merge", inputs: {"in0": "bodies", "in1": "wings"}, pos: [0.0, 0.0]),
        "/mid_birds/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [200.0, 0.0]),
    },
)
