// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_figure_bust": (kind: "comp.base", params: {"about": "Only head and shoulders, huge over the horizon, a wireframe with glowing eyes.", "params": "@expose presence = figure.presence
@expose brightness = figure.brightness
@expose warmth = figure.warmth
@expose tall = figure.tall
@expose place = figure.place
@expose tube = figure.tube
@expose thickness = figure.thickness
@expose rim = figure.rim
@expose fill = figure.fill
@expose eyes = figure.eyes
@expose reach = figure.reach", "shelf": "music stage/figures"}),
        "/sky_figure_bust/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/sky_figure_bust/pose": (kind: "chan.in", pos: [-600.0, 150.0]),
        "/sky_figure_bust/figure": (kind: "tex.shader", params: {"file": "library/sky_figure_bust/bust.wgsl", "resolution": "custom", "presence": 1.0, "brightness": 1.0, "warmth": 0.0, "place": 0.0, "reach": 10.0, "tall": 0.55, "thickness": 1.4, "rim": 1.0, "fill": 0.06, "eyes": 1.2, "axis": 4.0, "radius": 4.0, "far": 20.0, "bend": 0.0, "tube": 0.7}, binds: {"beats": "bus:travelled", "bar": "bus:bar", "bar_index": "bus:bar_index", "build": "bus:build", "drop": "bus:drop", "role": "bus:section_role", "energy": "bus:energy_low", "eye": "pose:height", "pitch": "pose:pitch", "fov": "pose:fov", "roll": "pose:roll", "side": "pose:side", "bend": "pose:curve", "axis": "pose:axis", "radius": "pose:radius", "far": "pose:far"}, pos: [-300.0, 0.0]),
        "/sky_figure_bust/out": (kind: "tex.out", inputs: {"in": "figure"}, pos: [0.0, 0.0]),
    },
)
