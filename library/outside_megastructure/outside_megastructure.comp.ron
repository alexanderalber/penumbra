// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/outside_megastructure": (kind: "comp.base", params: {"about": "A structure far larger than the tower of stage_ascent, which the climb passes through for a stretch.", "expose": "presence = controls.value0\nwarmth = controls.value1\nbrightness = controls.value2\nstorey = controls.value3\nstorey_beats = controls.value4\norbit = controls.value5\ndistance = controls.value6\nheight = controls.value7\ndrop = controls.value8\nfar_drop = controls.value9\nspin = controls.value10\npulse = controls.value11\nline_width = near_lines.line_width", "shelf": "music stage/above"}),
        "/outside_megastructure/bus": (kind: "chan.in", pos: [-1600.0, 0.0]),
        "/outside_megastructure/pose": (kind: "chan.in", pos: [-1600.0, 600.0]),
        "/outside_megastructure/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "warmth", "value1": 0.0, "name2": "brightness", "value2": 1.0, "name3": "storey", "value3": 3.0, "name4": "storey_beats", "value4": 4.0, "name5": "orbit", "value5": 128.0, "name6": "distance", "value6": 1800.0, "name7": "height", "value7": 380.0, "name8": "drop", "value8": 40.0, "name9": "far_drop", "value9": 2400.0, "name10": "spin", "value10": 2048.0, "name11": "pulse", "value11": 0.5}, pos: [-1600.0, 300.0]),
        "/outside_megastructure/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1400.0, -400.0]),
        "/outside_megastructure/beat": (kind: "chan.select", params: {"channels": "beat"}, inputs: {"in": "bus"}, pos: [-1400.0, -100.0]),
        "/outside_megastructure/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1400.0, 0.0]),
        "/outside_megastructure/presence": (kind: "chan.select", params: {"channels": "presence"}, inputs: {"in": "controls"}, pos: [-1400.0, 300.0]),
        "/outside_megastructure/warmth": (kind: "chan.select", params: {"channels": "warmth"}, inputs: {"in": "controls"}, pos: [-1400.0, 400.0]),
        "/outside_megastructure/curve": (kind: "chan.select", params: {"channels": "curve"}, inputs: {"in": "pose"}, pos: [-1400.0, 600.0]),
        "/outside_megastructure/radius": (kind: "chan.select", params: {"channels": "radius"}, inputs: {"in": "pose"}, pos: [-1400.0, 700.0]),
        "/outside_megastructure/climb_up": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "travelled"}, binds: {"b": "controls:storey"}, pos: [-1200.0, -500.0]),
        "/outside_megastructure/climb": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "climb_up"}, binds: {"b": "controls:storey_beats"}, pos: [-1000.0, -500.0]),
        "/outside_megastructure/wrapped": (kind: "chan.math", params: {"op": "modulo", "b": 36.0}, inputs: {"a": "climb"}, pos: [-800.0, -500.0]),
        "/outside_megastructure/lap": (kind: "chan.math", params: {"op": "modulo"}, inputs: {"a": "travelled"}, binds: {"b": "controls:orbit"}, pos: [-1200.0, -400.0]),
        "/outside_megastructure/lap_share": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "lap"}, binds: {"b": "controls:orbit"}, pos: [-1000.0, -400.0]),
        "/outside_megastructure/turn": (kind: "chan.math", params: {"op": "multiply", "b": -360.0}, inputs: {"a": "lap_share"}, pos: [-800.0, -400.0]),
        "/outside_megastructure/spun": (kind: "chan.math", params: {"op": "modulo"}, inputs: {"a": "travelled"}, binds: {"b": "controls:spin"}, pos: [-1200.0, -300.0]),
        "/outside_megastructure/spin_share": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "spun"}, binds: {"b": "controls:spin"}, pos: [-1000.0, -300.0]),
        "/outside_megastructure/spin": (kind: "chan.math", params: {"op": "multiply", "b": 360.0}, inputs: {"a": "spin_share"}, pos: [-800.0, -300.0]),
        "/outside_megastructure/axis": (kind: "chan.math", params: {"op": "multiply", "b": 0.5}, inputs: {"a": "radius"}, pos: [-1200.0, 700.0]),
        "/outside_megastructure/bent": (kind: "chan.math", params: {"op": "multiply", "b": -1.0}, inputs: {"a": "curve"}, pos: [-1200.0, 600.0]),
        "/outside_megastructure/straight": (kind: "chan.math", params: {"op": "add", "b": 1.0}, inputs: {"a": "bent"}, pos: [-1000.0, 600.0]),
        "/outside_megastructure/there": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "presence", "b": "straight"}, pos: [-800.0, 400.0]),
        "/outside_megastructure/lag": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.3, "fall": 0.3}, inputs: {"in": "there"}, pos: [-600.0, 500.0]),
        "/outside_megastructure/ahead": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "there", "b": "lag"}, pos: [-400.0, 450.0]),
        "/outside_megastructure/ahead_big": (kind: "chan.math", params: {"op": "multiply", "b": 1000.0}, inputs: {"a": "ahead"}, pos: [-200.0, 450.0]),
        "/outside_megastructure/ahead_top": (kind: "chan.math", params: {"op": "min", "b": 1.0}, inputs: {"a": "ahead_big"}, pos: [0.0, 450.0]),
        "/outside_megastructure/way": (kind: "chan.math", params: {"op": "max", "b": -1.0}, inputs: {"a": "ahead_top"}, pos: [200.0, 450.0]),
        "/outside_megastructure/missing": (kind: "chan.math", params: {"op": "add", "b": -1.0}, inputs: {"a": "there"}, pos: [-400.0, 600.0]),
        "/outside_megastructure/missing_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "missing", "b": "missing"}, pos: [-200.0, 600.0]),
        "/outside_megastructure/push": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "way", "b": "missing_sq"}, pos: [400.0, 500.0]),
        "/outside_megastructure/hidden": (kind: "chan.math", params: {"op": "equal", "b": 0.0}, inputs: {"a": "there"}, pos: [-400.0, 750.0]),
        "/outside_megastructure/away": (kind: "chan.math", params: {"op": "multiply", "b": 10000.0}, inputs: {"a": "hidden"}, pos: [-200.0, 750.0]),
        "/outside_megastructure/near_push": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "push"}, binds: {"b": "controls:drop"}, pos: [600.0, 400.0]),
        "/outside_megastructure/near_off": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "near_push", "b": "away"}, pos: [800.0, 400.0]),
        "/outside_megastructure/near_z": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "near_off", "b": "wrapped"}, pos: [1000.0, 400.0]),
        "/outside_megastructure/far_push": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "push"}, binds: {"b": "controls:far_drop"}, pos: [600.0, 600.0]),
        "/outside_megastructure/far_off": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "far_push", "b": "away"}, pos: [800.0, 600.0]),
        "/outside_megastructure/far_z": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "far_off"}, binds: {"b": "controls:height"}, pos: [1000.0, 600.0]),
        "/outside_megastructure/bass_half": (kind: "chan.math", params: {"op": "multiply", "b": 0.5}, inputs: {"a": "bass"}, pos: [-1200.0, 0.0]),
        "/outside_megastructure/bass_part": (kind: "chan.math", params: {"op": "add", "b": 0.55}, inputs: {"a": "bass_half"}, pos: [-1000.0, 0.0]),
        "/outside_megastructure/beat_neg": (kind: "chan.math", params: {"op": "multiply", "b": -1.0}, inputs: {"a": "beat"}, pos: [-1200.0, -100.0]),
        "/outside_megastructure/fall": (kind: "chan.math", params: {"op": "add", "b": 1.0}, inputs: {"a": "beat_neg"}, pos: [-1000.0, -100.0]),
        "/outside_megastructure/fall_4": (kind: "chan.math", params: {"op": "power", "b": 4.0}, inputs: {"a": "fall"}, pos: [-800.0, -100.0]),
        "/outside_megastructure/flash_part": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "fall_4"}, binds: {"b": "controls:pulse"}, pos: [-600.0, -100.0]),
        "/outside_megastructure/flash": (kind: "chan.math", params: {"op": "add", "b": 1.0}, inputs: {"a": "flash_part"}, pos: [-400.0, -100.0]),
        "/outside_megastructure/lit": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "bass_part", "b": "flash"}, pos: [-200.0, -50.0]),
        "/outside_megastructure/lit_there": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "lit", "b": "there"}, pos: [0.0, -50.0]),
        "/outside_megastructure/light": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "lit_there"}, binds: {"b": "controls:brightness"}, pos: [200.0, -50.0]),
        "/outside_megastructure/warm": (kind: "chan.constant", params: {"rows": 12, "name0": "near_red", "value0": 1.53, "name1": "near_green", "value1": 0.756, "name2": "near_blue", "value2": 1.116, "name3": "far_red", "value3": 1.1, "name4": "far_green", "value4": 0.682, "name5": "far_blue", "value5": 0.35200000000000004, "name6": "corona_red", "value6": 1.0, "name7": "corona_green", "value7": 0.8, "name8": "corona_blue", "value8": 0.55, "name9": "core_red", "value9": 1.7, "name10": "core_green", "value10": 1.36, "name11": "core_blue", "value11": 0.935}, pos: [-400.0, -700.0]),
        "/outside_megastructure/shift": (kind: "chan.constant", params: {"rows": 12, "name0": "near_red", "value0": -0.72, "name1": "near_green", "value1": 0.23400000000000012, "name2": "near_blue", "value2": 0.684, "name3": "far_red", "value3": -0.495, "name4": "far_green", "value4": 0.19800000000000006, "name5": "far_blue", "value5": 0.748, "name6": "corona_red", "value6": -0.28, "name7": "corona_green", "value7": 0.09999999999999998, "name8": "corona_blue", "value8": 0.44999999999999996, "name9": "core_red", "value9": -0.47600000000000003, "name10": "core_green", "value10": 0.16999999999999996, "name11": "core_blue", "value11": 0.7649999999999999}, pos: [-400.0, -500.0]),
        "/outside_megastructure/moved": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "shift", "b": "warmth"}, pos: [-200.0, -500.0]),
        "/outside_megastructure/tint": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "moved", "b": "warm"}, pos: [0.0, -600.0]),
        "/outside_megastructure/rgb": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "tint", "b": "light"}, pos: [200.0, -600.0]),
        "/outside_megastructure/near_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, binds: {"color.0": "rgb:near_red", "color.1": "rgb:near_green", "color.2": "rgb:near_blue"}, pos: [600.0, -900.0]),
        "/outside_megastructure/far_lines": (kind: "mat.wireframe", params: {"line_width": 1.5}, binds: {"color.0": "rgb:far_red", "color.1": "rgb:far_green", "color.2": "rgb:far_blue"}, pos: [600.0, -800.0]),
        "/outside_megastructure/corona_lines": (kind: "mat.wireframe", params: {"line_width": 1.5}, binds: {"color.0": "rgb:corona_red", "color.1": "rgb:corona_green", "color.2": "rgb:corona_blue"}, pos: [600.0, -700.0]),
        "/outside_megastructure/core_mat": (kind: "mat.constant", binds: {"color.0": "rgb:core_red", "color.1": "rgb:core_green", "color.2": "rgb:core_blue"}, pos: [600.0, -600.0]),
        "/outside_megastructure/fill_mat": (kind: "mat.occluder", params: {"shows": "black"}, binds: {"opacity": "there:presence"}, pos: [600.0, -500.0]),
        "/outside_megastructure/near_edges_model": (kind: "geo.file", params: {"file": "library/outside_megastructure/near_edges.obj", "up": "z"}, pos: [800.0, -400.0]),
        "/outside_megastructure/near_edges": (kind: "geo.assign_material", inputs: {"in": "near_edges_model", "mat": "near_lines"}, pos: [1000.0, -400.0]),
        "/outside_megastructure/near_fill_model": (kind: "geo.file", params: {"file": "library/outside_megastructure/near_fill.obj", "up": "z"}, pos: [800.0, -300.0]),
        "/outside_megastructure/near_fill": (kind: "geo.assign_material", inputs: {"in": "near_fill_model", "mat": "fill_mat"}, pos: [1000.0, -300.0]),
        "/outside_megastructure/near_parts": (kind: "geo.merge", inputs: {"in0": "near_edges", "in1": "near_fill"}, pos: [1200.0, -300.0]),
        "/outside_megastructure/far_edges_model": (kind: "geo.file", params: {"file": "library/outside_megastructure/far_edges.obj", "up": "z"}, pos: [800.0, -100.0]),
        "/outside_megastructure/far_edges": (kind: "geo.assign_material", inputs: {"in": "far_edges_model", "mat": "far_lines"}, pos: [1000.0, -100.0]),
        "/outside_megastructure/far_fill_model": (kind: "geo.file", params: {"file": "library/outside_megastructure/far_fill.obj", "up": "z"}, pos: [800.0, 0.0]),
        "/outside_megastructure/far_fill": (kind: "geo.assign_material", inputs: {"in": "far_fill_model", "mat": "fill_mat"}, pos: [1000.0, 0.0]),
        "/outside_megastructure/core_model": (kind: "geo.file", params: {"file": "library/outside_megastructure/core.obj", "up": "z"}, pos: [800.0, 100.0]),
        "/outside_megastructure/core": (kind: "geo.assign_material", inputs: {"in": "core_model", "mat": "core_mat"}, pos: [1000.0, 100.0]),
        "/outside_megastructure/corona_model": (kind: "geo.file", params: {"file": "library/outside_megastructure/corona.obj", "up": "z"}, pos: [800.0, 200.0]),
        "/outside_megastructure/corona": (kind: "geo.assign_material", inputs: {"in": "corona_model", "mat": "corona_lines"}, pos: [1000.0, 200.0]),
        "/outside_megastructure/far_parts": (kind: "geo.merge", inputs: {"in0": "far_edges", "in1": "far_fill", "in2": "core", "in3": "corona"}, pos: [1200.0, 200.0]),
        "/outside_megastructure/near_place": (kind: "geo.transform", inputs: {"in": "near_parts"}, binds: {"translate.1": "axis:radius", "translate.2": "near_z:presence", "rotate.2": "turn:travelled"}, pos: [1400.0, -300.0]),
        "/outside_megastructure/far_place": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 28.0]}, inputs: {"in": "far_parts"}, binds: {"translate.1": "controls:distance", "translate.2": "far_z:presence", "rotate.1": "spin:travelled"}, pos: [1400.0, 200.0]),
        "/outside_megastructure/near": (kind: "geo.out", inputs: {"in": "near_place"}, pos: [1600.0, -300.0]),
        "/outside_megastructure/out": (kind: "geo.out", inputs: {"in": "far_place"}, pos: [1600.0, 200.0]),
    },
)
