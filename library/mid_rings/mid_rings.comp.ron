// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_rings": (kind: "comp.base", params: {"about": "Broad rings around the tower of stage_ascent, outside its wall, seen through the open walls.", "params": "@expose presence = controls.value0\n@expose warmth = controls.value1\n@expose brightness = controls.value2\n@expose storey = controls.value3\n@expose storey_beats = controls.value4\n@expose chance = controls.value5\n@expose inner = controls.value6\n@expose outer = controls.value7\n@expose band = controls.value8\n@expose tilt = controls.value9\n@expose orbit = controls.value10\n@expose pulse = controls.value11\n@expose line_width = ring_lines.line_width", "shelf": "music stage/mid"}),
        "/mid_rings/bus": (kind: "chan.in", pos: [-1000.0, 0.0]),
        "/mid_rings/pose": (kind: "chan.in", pos: [-1000.0, 450.0]),
        "/mid_rings/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "warmth", "value1": 0.0, "name2": "brightness", "value2": 1.0, "name3": "storey", "value3": 3.0, "name4": "storey_beats", "value4": 4.0, "name5": "chance", "value5": 0.35, "name6": "inner", "value6": 7.5, "name7": "outer", "value7": 10.0, "name8": "band", "value8": 0.35, "name9": "tilt", "value9": 10.0, "name10": "orbit", "value10": 256.0, "name11": "pulse", "value11": 0.5}, pos: [-1000.0, 250.0]),
        "/mid_rings/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-800.0, -200.0]),
        "/mid_rings/phase": (kind: "chan.math", params: {"b": 1.0, "op": "modulo"}, inputs: {"a": "travelled"}, pos: [-600.0, -250.0]),
        "/mid_rings/whole": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "travelled", "b": "phase"}, pos: [-600.0, -150.0]),
        "/mid_rings/place": (kind: "tex.shader", params: {"resolution": "custom", "width": 12, "height": 1, "keep_size": true, "file": "library/mid_rings/rings.wgsl", "what": "place"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "chance": "controls:chance", "inner": "controls:inner", "outer": "controls:outer", "band": "controls:band", "tilt": "controls:tilt", "orbit": "controls:orbit", "pulse": "controls:pulse", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "beat": "bus:beat", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-400.0, 0.0]),
        "/mid_rings/aim": (kind: "tex.shader", params: {"resolution": "custom", "width": 12, "height": 1, "keep_size": true, "file": "library/mid_rings/rings.wgsl", "what": "aim"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "chance": "controls:chance", "inner": "controls:inner", "outer": "controls:outer", "band": "controls:band", "tilt": "controls:tilt", "orbit": "controls:orbit", "pulse": "controls:pulse", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "beat": "bus:beat", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-400.0, 150.0]),
        "/mid_rings/scale": (kind: "tex.shader", params: {"resolution": "custom", "width": 12, "height": 1, "keep_size": true, "file": "library/mid_rings/rings.wgsl", "what": "scale"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "chance": "controls:chance", "inner": "controls:inner", "outer": "controls:outer", "band": "controls:band", "tilt": "controls:tilt", "orbit": "controls:orbit", "pulse": "controls:pulse", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "beat": "bus:beat", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-400.0, 300.0]),
        "/mid_rings/light": (kind: "tex.shader", params: {"resolution": "custom", "width": 12, "height": 1, "keep_size": true, "file": "library/mid_rings/rings.wgsl", "what": "light"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "chance": "controls:chance", "inner": "controls:inner", "outer": "controls:outer", "band": "controls:band", "tilt": "controls:tilt", "orbit": "controls:orbit", "pulse": "controls:pulse", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "beat": "bus:beat", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-400.0, 450.0]),
        "/mid_rings/ring_model": (kind: "geo.file", params: {"file": "library/mid_rings/ring.obj", "up": "z"}, pos: [-400.0, -450.0]),
        "/mid_rings/ring_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-400.0, -350.0]),
        "/mid_rings/ring_wire": (kind: "geo.assign_material", inputs: {"in": "ring_model", "mat": "ring_lines"}, pos: [-200.0, -400.0]),
        "/mid_rings/fill_model": (kind: "geo.file", params: {"file": "library/mid_rings/ring_fill.obj", "up": "z"}, pos: [-400.0, -650.0]),
        "/mid_rings/fill_mat": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-400.0, -550.0]),
        "/mid_rings/ring_fill": (kind: "geo.assign_material", inputs: {"in": "fill_model", "mat": "fill_mat"}, pos: [-200.0, -600.0]),
        "/mid_rings/edges": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "ring_wire", "position": "place", "aim": "aim", "scale": "scale", "color": "light"}, pos: [0.0, -100.0]),
        "/mid_rings/bands": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "ring_fill", "position": "place", "aim": "aim", "scale": "scale"}, pos: [0.0, 100.0]),
        "/mid_rings/rings": (kind: "geo.merge", inputs: {"in0": "edges", "in1": "bands"}, pos: [200.0, 0.0]),
        "/mid_rings/out": (kind: "geo.out", inputs: {"in": "rings"}, pos: [400.0, 0.0]),
    },
)
