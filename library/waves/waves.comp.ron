// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/waves": (kind: "comp.base", params: {"about": "Ripples on water (wave equation): rain on a pond, a drop on each beat, interference of two sources or behind a double slit, waves bouncing off a mask, a wake.", "params": "@param scene choice(pond|drop|double_slit|two_points|plane|wake|beat|posts) = pond -- what is set up: walls, wave sources, drops, the start, the edges and the look; choosing one writes its values into the params, then they are yours; a new scene starts the water over\n@param speed float = 1 0.125..4 -- water steps per frame as a share of 8; 2 runs the water twice as fast and costs more\n@expose push_strength = step.push_strength\n@expose damping = step.damping\n@param pause bool = false -- holds the water as it is\n@group walls\n@expose shape = walls.shape\n@expose use_mask = walls.use_mask\n@expose at = walls.at\n@expose thick = walls.thick\n@expose gap = walls.gap\n@expose apart = walls.apart\n@expose count = walls.count\n@expose post = walls.post\n@group sources\n@expose source = step.source\n@param wavelength float = 24 6..120 -- of the sources, in texels\n@expose amplitude = step.amplitude\n@expose position = step.position\n@expose spacing = step.spacing\n@group drops\n@expose rain = step.rain\n@expose rate = step.rate\n@expose drop_size = step.drop_size\n@expose rings = step.rings\n@expose drop_strength = step.drop_strength\n@expose calm_drop = pulse.calm_drop\n@expose idle = pulse.idle\n@expose still = pulse.still\n@param start choice(calm|drop|three|line) = calm -- the water at the start: calm: still water; drop: one drop in the middle; three: three drops; line: a straight dent across, at the left third; a change starts the water over\n@param start_size float = 12 2..80 -- radius of the dents at the start (half width of the line), in texels; a change starts the water over\n@param start_rings int = 3 1..8 -- dents per drop at the start: 1 is one smooth dent, more a train of rings; a change starts the water over\n@param start_strength float = 1 -2..2 -- depth of the dents at the start; a change starts the water over\n@group water\n@param wave_speed float = 0.3 0.05..0.85 -- wave speed in texels per step; held at 0.85, above 0.866 it would blow up\n@expose push = step.push\n@expose edges = step.edges\n@expose sponge = step.sponge\n@expose soften = step.soften\n@expose average = step.average\n@group look\n@expose view = show.view\n@expose floor = show.floor\n@expose gain = show.gain\n@expose energy_gain = show.energy_gain\n@expose colors = show.colors\n@expose heat = show.heat\n@expose marker = show.marker\n@expose wall_show = show.wall_show\n@expose cutout = show.cutout\n@expose wall_color = show.wall_color\n@expose marker_color = show.marker_color\n@expose out_width = show.width\n@expose out_height = show.height\n@group surface\n@expose slope = show.slope\n@expose bend = show.bend\n@expose caustics = show.caustics\n@expose clear = show.clear\n@expose deep = show.deep\n@expose sky = show.sky\n@expose glint = show.glint\n@expose sun = show.sun\n@expose tiles = show.tiles\n@group size\n@param width int = 1280 16..4096 -- simulation width in texels; wave speed and drop sizes count in texels, so on a larger size the same waves look smaller and slower; a change starts the water over\n@param height int = 720 16..4096 -- simulation height in texels; a change starts the water over\n@reset scene start start_size start_rings start_strength width height\n@preset scene=* shape=none use_mask=false at=0.35 thick=6 gap=14 apart=70 count=7 post=10\n@preset scene=* source=off wavelength=24 amplitude=0.4 position=[0.2, 0.5] spacing=80\n@preset scene=* rain=off rate=8 drop_size=5 rings=3 drop_strength=1.2 calm_drop=false idle=4 start=calm start_size=12 start_rings=3 start_strength=1\n@preset scene=* wave_speed=0.3 push=off edges=reflect sponge=48 soften=0.005\n@preset scene=* view=water floor=tiles gain=1.5 energy_gain=3 colors=ffcf67 e09f57 c17549 a0513e 773339 572949 4c3d73 5163a2 5f89c3 6fb7e2 80e7ff marker=0\n@preset scene=pond use_mask=true rain=random push=move marker=0.5 -- rain on a tiled pool; the mask input stands in the water and the rings bounce off it; people push the water\n@preset scene=drop drop_size=9 rings=4 drop_strength=1.5 calm_drop=true idle=1.5 start=drop start_size=9 start_rings=4 start_strength=1.5 gain=5 colors=ff8c42 0b0e14 008c8c -- one drop in the middle, a train of rings; once the water has been calm for 1.5 s the next drop falls at a random place\n@preset scene=double_slit shape=double_slit thick=10 gap=70 apart=230 source=plane wavelength=40 wave_speed=0.5 edges=absorb sponge=60 view=height gain=2 energy_gain=6 -- a straight wave from the left runs through two slits; two fans of waves interfere behind the wall\n@preset scene=two_points source=two wavelength=30 amplitude=0.5 position=[0.5, 0.5] spacing=120 wave_speed=0.5 edges=absorb sponge=60 view=height gain=3 colors=ff8c42 0b0e14 008c8c -- two bobbing points: the textbook picture of interference\n@preset scene=plane use_mask=true source=plane wavelength=30 wave_speed=0.5 edges=absorb sponge=60 gain=2 energy_gain=4 -- a straight wave rolls past the mask input: it reflects in front and bends into the shadow behind\n@preset scene=wake calm_drop=true wave_speed=0.25 push=move edges=absorb soften=0.03 gain=2 marker=0.9 -- people moving faster than the waves leave a V on open water; a drop falls after 4 s of calm water\n@preset scene=beat rain=beat drop_size=13 rings=4 drop_strength=1.5 wave_speed=0.35 view=height gain=3 colors=ff8c42 0b0e14 008c8c -- one big drop on each beat of the beat input\n@preset scene=posts shape=pillars post=14 rain=random rate=10 floor=sand -- rain among round posts over a sandy floor", "shelf": "simulations"}, pos: [300.0, 0.0]),
        "/waves/beat": (kind: "chan.in", pos: [-400.0, -300.0]),
        "/waves/energy": (kind: "chan.select", params: {"channels": "b"}, inputs: {"in": "measure"}, pos: [700.0, 200.0]),
        "/waves/loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "step"}, pos: [0.0, -100.0]),
        "/waves/mask": (kind: "tex.in", pos: [-400.0, 100.0]),
        "/waves/measure": (kind: "chan.from_tex", inputs: {"in": "step"}, pos: [500.0, 200.0]),
        "/waves/named": (kind: "chan.rename", params: {"names": "b=ripple"}, inputs: {"in": "root"}, pos: [1100.0, 200.0]),
        "/waves/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [750.0, 0.0]),
        "/waves/pace": (kind: "chan.constant", params: {"name0": "steps", "value0": 8.0}, pos: [-400.0, -480.0]),
        "/waves/passes": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "pace"}, binds: {"b": "parent.speed"}, pos: [-200.0, -480.0]),
        "/waves/people": (kind: "tex.in", pos: [-400.0, 250.0]),
        "/waves/pulse": (kind: "tex.shader", params: {"calm_drop": false, "file": "library/waves/pulse.wgsl", "format": "32f", "height": 1, "idle": 4, "keep_size": true, "resolution": "custom", "width": 3}, inputs: {"in0": "pulse_loop"}, binds: {"beat": "beat:beat", "now": "time:seconds", "pause": "parent.pause", "ripple": "quiet:ripple", "steps": "passes:steps", "wave_speed": "parent.wave_speed", "wavelength": "parent.wavelength"}, pos: [0.0, -280.0]),
        "/waves/pulse_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "pulse"}, pos: [-200.0, -300.0]),
        "/waves/quiet": (kind: "chan.feedback", inputs: {"previous": "named"}, pos: [1300.0, 320.0]),
        "/waves/ripple": (kind: "chan.out", inputs: {"in": "named"}, pos: [1300.0, 200.0]),
        "/waves/root": (kind: "chan.math", params: {"b": 0.5, "op": "power"}, inputs: {"a": "energy"}, pos: [900.0, 200.0]),
        "/waves/seed": (kind: "tex.shader", params: {"file": "library/waves/seed.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "world", "in1": "people"}, binds: {"start": "parent.start", "start_rings": "parent.start_rings", "start_size": "parent.start_size", "start_strength": "parent.start_strength"}, pos: [-200.0, -120.0]),
        "/waves/show": (kind: "tex.shader", params: {"colors": "ffcf67 e09f57 c17549 a0513e 773339 572949 4c3d73 5163a2 5f89c3 6fb7e2 80e7ff", "energy_gain": 3, "file": "library/waves/show.wgsl", "floor": "tiles", "gain": 1.5, "keep_size": true, "marker": 0.5, "resolution": "custom", "view": "water"}, inputs: {"in0": "step", "in1": "walls", "in2": "people"}, pos: [500.0, 0.0]),
        "/waves/step": (kind: "tex.shader", params: {"amplitude": 0.4, "drop_size": 5, "drop_strength": 1.2, "edges": "reflect", "file": "library/waves/step.wgsl", "format": "32f", "keep_size": true, "position": [0.2, 0.5], "push": "move", "rain": "random", "rate": 8, "rings": 3, "soften": 0.005, "source": "off", "spacing": 80, "sponge": 48}, inputs: {"in0": "loop", "in1": "walls", "in2": "people", "in3": "pulse"}, binds: {"iterations": "passes:steps", "pause": "parent.pause", "wave_speed": "parent.wave_speed", "wavelength": "parent.wavelength"}, pos: [250.0, 0.0]),
        "/waves/time": (kind: "chan.clock", params: {"mode": "free"}, pos: [0.0, -380.0]),
        "/waves/walls": (kind: "tex.shader", params: {"apart": 70, "at": 0.35, "count": 7, "file": "library/waves/walls.wgsl", "gap": 14, "keep_size": true, "post": 10, "shape": "none", "thick": 6, "use_mask": true}, inputs: {"in0": "world", "in1": "mask"}, pos: [-200.0, 100.0]),
        "/waves/world": (kind: "tex.constant", params: {"color": [0.0, 0.0, 0.0, 0.0], "keep_size": true}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [-400.0, -50.0]),
    },
)
