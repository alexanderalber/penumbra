// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/furrows": (kind: "comp.base", params: {"about": "Glow from the furrows, as if a candle burned inside.", "params": "@expose gain = glow.gain\n@expose relative = glow.relative\n@expose threshold = glow.threshold\n@expose flicker = glow.flicker\n@expose color = glow.color\n@expose core = glow.core\n@expose crest = glow.crest\n@expose rim = glow.rim", "shelf": "scanned objects"}),
        "/furrows/fine": (kind: "tex.in"),
        "/furrows/glow": (kind: "tex.shader", params: {"file": "library/furrows/furrows.wgsl", "gain": 5.0, "threshold": 0.3, "relative": 1.0}, inputs: {"in0": "fine", "in1": "wide", "in2": "labels", "in3": "sdf"}),
        "/furrows/labels": (kind: "tex.in"),
        "/furrows/out": (kind: "tex.out", inputs: {"in": "glow"}),
        "/furrows/sdf": (kind: "tex.in"),
        "/furrows/wide": (kind: "tex.in"),
    },
)
