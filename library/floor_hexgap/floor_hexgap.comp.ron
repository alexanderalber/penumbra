// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_hexgap": (kind: "comp.base", params: {"about": "Split hexagonal pillars beside the lane.", "expose": "presence = places.presence\nceiling = places.ceiling\nseed = places.seed\nlow = places.low\nhigh = places.high\nnarrow = places.narrow\nwide = places.wide\nspacing = places.spacing\nwidth = controls.value0\nrows = places.rows\ngap = places.gap\npulse = places.pulse\nlane = places.lane\nnear = places.near\nfar = places.far\nbeats_per_bar = places.beats_per_bar\ncolor = hex_lines.color\nline_width = hex_lines.line_width\nextent = pillars.extent", "shelf": "music stage/floor"}),
        "/floor_hexgap/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/floor_hexgap/lane": (kind: "tex.in", pos: [-600.0, 150.0]),
        "/floor_hexgap/controls": (kind: "chan.constant", params: {"rows": 1, "name0": "across", "value0": 0.36}, pos: [-800.0, 250.0]),
        "/floor_hexgap/places": (kind: "tex.shader", params: {"file": "library/floor_hexgap/hexgap.wgsl", "resolution": "custom", "width": 12, "height": 32, "keep_size": true, "presence": 1.0, "ceiling": 4.0, "seed": 1, "low": 1.2, "high": 3.0, "narrow": 0.3, "wide": 1.0, "spacing": 1.0, "beats_per_bar": 4.0, "rows": 2, "gap": 1.2, "pulse": 0.3, "lane": 1.6, "near": -2.0, "far": 14.0}, inputs: {"in0": "lane"}, binds: {"beat": "bus:beat", "beats": "bus:travelled", "drift": "bus:drift", "across": "controls:across"}, pos: [-400.0, 100.0]),
        "/floor_hexgap/sizes": (kind: "tex.shader", params: {"file": "library/floor_hexgap/sizes.wgsl"}, inputs: {"in0": "places"}, binds: {"across": "controls:across"}, pos: [-200.0, 200.0]),
        "/floor_hexgap/hex": (kind: "geo.file", params: {"file": "library/floor_hexgap/hexgap.obj", "up": "z"}, pos: [-800.0, -300.0]),
        "/floor_hexgap/hex_lines": (kind: "mat.wireframe", params: {"faces": "hidden", "line_width": 2.0}, pos: [-600.0, -150.0]),
        "/floor_hexgap/hex_wire": (kind: "geo.assign_material", inputs: {"in": "hex", "mat": "hex_lines"}, pos: [-400.0, -200.0]),
        "/floor_hexgap/cover_mat": (kind: "mat.occluder", pos: [-600.0, -320.0]),
        "/floor_hexgap/cover": (kind: "geo.assign_material", inputs: {"in": "hex", "mat": "cover_mat"}, pos: [-400.0, -350.0]),
        "/floor_hexgap/model": (kind: "geo.merge", inputs: {"in0": "hex_wire", "in1": "cover"}, pos: [-200.0, -250.0]),
        "/floor_hexgap/pillars": (kind: "geo.tex_instance", params: {"extent": 30.0}, inputs: {"in": "model", "position": "places", "scale": "sizes"}, pos: [0.0, 0.0]),
        "/floor_hexgap/out": (kind: "geo.out", inputs: {"in": "pillars"}, pos: [200.0, 0.0]),
    },
)
