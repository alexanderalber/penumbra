// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/glow_rim": (kind: "comp.base", params: {"about": "A faint warm rim on the face the object stands on, flickering with glow.", "params": "@expose clock = rim.clock\n@expose lid = rim.lid\n@expose box = rim.box\n@expose reach = rim.reach\n@expose below = rim.below\n@expose gain = rim.gain\n@expose flicker = rim.flicker\n@expose ignite = rim.ignite\n@expose color = rim.color", "shelf": "scanned objects"}),
        "/glow_rim/labels": (kind: "tex.in"),
        "/glow_rim/out": (kind: "tex.out", inputs: {"in": "rim"}),
        "/glow_rim/regions": (kind: "tex.in"),
        "/glow_rim/rim": (kind: "tex.shader", params: {"file": "library/glow_rim/rim.wgsl"}, inputs: {"in0": "regions", "in1": "sdf", "in2": "labels"}),
        "/glow_rim/sdf": (kind: "tex.in"),
    },
)
