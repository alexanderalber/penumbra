// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_terraces": (kind: "comp.base", params: {"about": "Stepped platforms on the shore of stage_valley with a thin rim of copper light.", "params": "@expose presence = controls.value0\n@expose spacing = controls.value1\n@expose fill = controls.value2\n@expose height = controls.value3\n@expose back = controls.value4\n@expose depth = controls.value5\n@expose pyramids = controls.value6\n@expose pyramid = controls.value7\n@expose face = controls.value8\n@expose rim = controls.value9\n@expose pulse = controls.value10\n@expose lane = controls.value11\n@expose clear = controls.value12\n@expose near = controls.value13\n@expose far = controls.value14\n@expose beats_per_bar = controls.value15\n@expose warmth = controls.value16\n@expose smooth = level.fall\n@expose line_width = rim_lines.line_width\n@expose extent = terraces.extent\n@expose ease = controls.value17\n@expose hold = controls.value18\n@expose tide_bars = controls.value19\n@expose tide_share = controls.value20\n@expose tide = controls.value21", "shelf": "music stage/floor"}, pos: [0.0, 0.0]),
        "/floor_terraces/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_terraces/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_terraces/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/floor_terraces/controls": (kind: "chan.constant", params: {"rows": 22, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 3.0, "name2": "fill", "value2": 0.75, "name3": "tall", "value3": 0.9, "name4": "back", "value4": 2.4, "name5": "depth", "value5": 2.4, "name6": "pyramids", "value6": 0.2, "name7": "pyramid", "value7": 0.75, "name8": "face", "value8": 25.0, "name9": "rim", "value9": 1.0, "name10": "pulse", "value10": 0.3, "name11": "lane", "value11": 1.6, "name12": "clear", "value12": 2.2, "name13": "near", "value13": -4.0, "name14": "far", "value14": 36.0, "name15": "beats_per_bar", "value15": 4.0, "name16": "warmth", "value16": 0.0, "name17": "ease", "value17": 2.0, "name18": "hold", "value18": 9.0, "name19": "tide_bars", "value19": 2.0, "name20": "tide_share", "value20": 0.25, "name21": "tide", "value21": 1.0}, pos: [-1200.0, 450.0]),
        "/floor_terraces/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_terraces/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.5}, inputs: {"in": "bass"}, pos: [-800.0, -150.0]),
        "/floor_terraces/place": (kind: "tex.shader", params: {"ease": 2.0, "hold": 9.0, "tide_bars": 2.0, "tide_share": 0.25, "tide": 1.0, "file": "library/floor_terraces/terraces.wgsl", "resolution": "custom", "width": 4, "height": 12, "keep_size": true, "presence": 1.0, "spacing": 3.0, "fill": 0.75, "tall": 0.9, "back": 2.4, "depth": 2.4, "pyramids": 0.2, "pyramid": 0.75, "face": 25.0, "rim": 1.0, "pulse": 0.3, "lane": 1.6, "clear": 2.2, "near": -4.0, "far": 36.0, "beats_per_bar": 4.0, "warmth": 0.0, "what": "place"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"ease": "controls:ease", "hold": "controls:hold", "tide_bars": "controls:tide_bars", "tide_share": "controls:tide_share", "tide": "controls:tide", "presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "tall": "controls:tall", "back": "controls:back", "depth": "controls:depth", "pyramids": "controls:pyramids", "pyramid": "controls:pyramid", "face": "controls:face", "rim": "controls:rim", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn"}, pos: [-600.0, -100.0]),
        "/floor_terraces/aim": (kind: "tex.shader", params: {"ease": 2.0, "hold": 9.0, "tide_bars": 2.0, "tide_share": 0.25, "tide": 1.0, "file": "library/floor_terraces/terraces.wgsl", "resolution": "custom", "width": 4, "height": 12, "keep_size": true, "presence": 1.0, "spacing": 3.0, "fill": 0.75, "tall": 0.9, "back": 2.4, "depth": 2.4, "pyramids": 0.2, "pyramid": 0.75, "face": 25.0, "rim": 1.0, "pulse": 0.3, "lane": 1.6, "clear": 2.2, "near": -4.0, "far": 36.0, "beats_per_bar": 4.0, "warmth": 0.0, "what": "aim"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"ease": "controls:ease", "hold": "controls:hold", "tide_bars": "controls:tide_bars", "tide_share": "controls:tide_share", "tide": "controls:tide", "presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "tall": "controls:tall", "back": "controls:back", "depth": "controls:depth", "pyramids": "controls:pyramids", "pyramid": "controls:pyramid", "face": "controls:face", "rim": "controls:rim", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn"}, pos: [-600.0, 30.0]),
        "/floor_terraces/terrace_size": (kind: "tex.shader", params: {"ease": 2.0, "hold": 9.0, "tide_bars": 2.0, "tide_share": 0.25, "tide": 1.0, "file": "library/floor_terraces/terraces.wgsl", "resolution": "custom", "width": 4, "height": 12, "keep_size": true, "presence": 1.0, "spacing": 3.0, "fill": 0.75, "tall": 0.9, "back": 2.4, "depth": 2.4, "pyramids": 0.2, "pyramid": 0.75, "face": 25.0, "rim": 1.0, "pulse": 0.3, "lane": 1.6, "clear": 2.2, "near": -4.0, "far": 36.0, "beats_per_bar": 4.0, "warmth": 0.0, "what": "terrace"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"ease": "controls:ease", "hold": "controls:hold", "tide_bars": "controls:tide_bars", "tide_share": "controls:tide_share", "tide": "controls:tide", "presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "tall": "controls:tall", "back": "controls:back", "depth": "controls:depth", "pyramids": "controls:pyramids", "pyramid": "controls:pyramid", "face": "controls:face", "rim": "controls:rim", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn"}, pos: [-600.0, 160.0]),
        "/floor_terraces/pyramid_size": (kind: "tex.shader", params: {"ease": 2.0, "hold": 9.0, "tide_bars": 2.0, "tide_share": 0.25, "tide": 1.0, "file": "library/floor_terraces/terraces.wgsl", "resolution": "custom", "width": 4, "height": 12, "keep_size": true, "presence": 1.0, "spacing": 3.0, "fill": 0.75, "tall": 0.9, "back": 2.4, "depth": 2.4, "pyramids": 0.2, "pyramid": 0.75, "face": 25.0, "rim": 1.0, "pulse": 0.3, "lane": 1.6, "clear": 2.2, "near": -4.0, "far": 36.0, "beats_per_bar": 4.0, "warmth": 0.0, "what": "pyramid"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"ease": "controls:ease", "hold": "controls:hold", "tide_bars": "controls:tide_bars", "tide_share": "controls:tide_share", "tide": "controls:tide", "presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "tall": "controls:tall", "back": "controls:back", "depth": "controls:depth", "pyramids": "controls:pyramids", "pyramid": "controls:pyramid", "face": "controls:face", "rim": "controls:rim", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn"}, pos: [-600.0, 290.0]),
        "/floor_terraces/rim_light": (kind: "tex.shader", params: {"ease": 2.0, "hold": 9.0, "tide_bars": 2.0, "tide_share": 0.25, "tide": 1.0, "file": "library/floor_terraces/terraces.wgsl", "resolution": "custom", "width": 4, "height": 12, "keep_size": true, "presence": 1.0, "spacing": 3.0, "fill": 0.75, "tall": 0.9, "back": 2.4, "depth": 2.4, "pyramids": 0.2, "pyramid": 0.75, "face": 25.0, "rim": 1.0, "pulse": 0.3, "lane": 1.6, "clear": 2.2, "near": -4.0, "far": 36.0, "beats_per_bar": 4.0, "warmth": 0.0, "what": "color"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"ease": "controls:ease", "hold": "controls:hold", "tide_bars": "controls:tide_bars", "tide_share": "controls:tide_share", "tide": "controls:tide", "presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "tall": "controls:tall", "back": "controls:back", "depth": "controls:depth", "pyramids": "controls:pyramids", "pyramid": "controls:pyramid", "face": "controls:face", "rim": "controls:rim", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn"}, pos: [-600.0, 420.0]),
        "/floor_terraces/memory": (kind: "tex.shader", params: {"ease": 2.0, "hold": 9.0, "tide_bars": 2.0, "tide_share": 0.25, "tide": 1.0, "file": "library/floor_terraces/terraces.wgsl", "resolution": "custom", "width": 5, "height": 64, "keep_size": true, "presence": 1.0, "spacing": 3.0, "fill": 0.75, "tall": 0.9, "back": 2.4, "depth": 2.4, "pyramids": 0.2, "pyramid": 0.75, "face": 25.0, "rim": 1.0, "pulse": 0.3, "lane": 1.6, "clear": 2.2, "near": -4.0, "far": 36.0, "beats_per_bar": 4.0, "warmth": 0.0, "what": "memory"}, inputs: {"in0": "lane", "in1": "memory_loop"}, binds: {"ease": "controls:ease", "hold": "controls:hold", "tide_bars": "controls:tide_bars", "tide_share": "controls:tide_share", "tide": "controls:tide", "presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "tall": "controls:tall", "back": "controls:back", "depth": "controls:depth", "pyramids": "controls:pyramids", "pyramid": "controls:pyramid", "face": "controls:face", "rim": "controls:rim", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "near": "controls:near", "far": "controls:far", "beats_per_bar": "controls:beats_per_bar", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn"}, pos: [-800.0, 600.0]),
        "/floor_terraces/memory_loop": (kind: "tex.feedback", inputs: {"previous": "memory"}, pos: [-1000.0, 600.0]),
        "/floor_terraces/light_ramp": (kind: "tex.ramp", params: {"width": 64, "height": 1, "keep_size": true, "shape": "horizontal", "keys": "0 0 0 0\n1 1 1 1"}, pos: [-1000.0, -1000.0]),
        "/floor_terraces/rim_lines": (kind: "mat.wireframe", params: {"line_width": 1.5, "faces": "open"}, inputs: {"texture": "light_ramp"}, pos: [-800.0, -1000.0]),
        "/floor_terraces/fill_mat": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-800.0, -1150.0]),
        "/floor_terraces/terrace_fill": (kind: "geo.file", params: {"file": "library/floor_terraces/terrace_fill.obj", "up": "z"}, pos: [-1000.0, -850.0]),
        "/floor_terraces/terrace_edges": (kind: "geo.file", params: {"file": "library/floor_terraces/terrace_edges.obj", "up": "z"}, pos: [-1000.0, -730.0]),
        "/floor_terraces/terrace_black": (kind: "geo.assign_material", inputs: {"in": "terrace_fill", "mat": "fill_mat"}, pos: [-600.0, -850.0]),
        "/floor_terraces/terrace_rim": (kind: "geo.assign_material", inputs: {"in": "terrace_edges", "mat": "rim_lines"}, pos: [-600.0, -730.0]),
        "/floor_terraces/terrace_model": (kind: "geo.merge", inputs: {"in0": "terrace_black", "in1": "terrace_rim"}, pos: [-400.0, -790.0]),
        "/floor_terraces/pyramid_fill": (kind: "geo.file", params: {"file": "library/floor_terraces/pyramid_fill.obj", "up": "z"}, pos: [-1000.0, -550.0]),
        "/floor_terraces/pyramid_edges": (kind: "geo.file", params: {"file": "library/floor_terraces/pyramid_edges.obj", "up": "z"}, pos: [-1000.0, -430.0]),
        "/floor_terraces/pyramid_black": (kind: "geo.assign_material", inputs: {"in": "pyramid_fill", "mat": "fill_mat"}, pos: [-600.0, -550.0]),
        "/floor_terraces/pyramid_rim": (kind: "geo.assign_material", inputs: {"in": "pyramid_edges", "mat": "rim_lines"}, pos: [-600.0, -430.0]),
        "/floor_terraces/pyramid_model": (kind: "geo.merge", inputs: {"in0": "pyramid_black", "in1": "pyramid_rim"}, pos: [-400.0, -490.0]),
        "/floor_terraces/terraces": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "terrace_model", "position": "place", "aim": "aim", "scale": "terrace_size", "color": "rim_light"}, pos: [-200.0, -200.0]),
        "/floor_terraces/pyramids": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "pyramid_model", "position": "place", "aim": "aim", "scale": "pyramid_size", "color": "rim_light"}, pos: [-200.0, 0.0]),
        "/floor_terraces/all": (kind: "geo.merge", inputs: {"in0": "terraces", "in1": "pyramids"}, pos: [0.0, 0.0]),
        "/floor_terraces/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [200.0, 0.0]),
    },
)
