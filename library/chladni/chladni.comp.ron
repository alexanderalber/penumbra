// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/chladni": (kind: "comp.base", params: {"about": "Chladni figures: sand on a vibrating plate gathers on the nodal lines, a new figure for every tone (cymatics, standing waves, resonance); a square, a round or any shaped plate, driven by a note channel from a pitch tracker.", "params": "@param preset choice(square|gold|circle|ice|shape|ember|motion|lines) = square -- the plate and how it looks: square and gold on a square plate, circle and ice on a round one, shape, ember and motion on the input shape, lines draws the nodal lines; choosing one writes its values into the params, then they are yours; a new preset starts over\n@expose source = pick.source\n@expose lowest = pick.lowest\n@expose figure = pick.figure\n@expose morph = pick.morph\n@expose level = grains.level\n@expose kick = grains.kick\n@expose toss = grains.toss\n@param speed float = 1 0.25..4 -- grain steps per frame as a share of 4; 2 gathers twice as fast and costs more\n@group plate\n@param plate choice(square|circle|shape) = square -- square, circle: a plate whose figures come from a formula; shape: the white of the input shape, simulated as a membrane; a change starts over\n@param membrane_steps int = 1 1..256 -- steps per frame of the membrane, which only the plate shape uses: about 64 let a figure settle within a second; 1 costs least on the other plates\n@expose size = field.size\n@expose turn = field.turn\n@expose detune = pick.detune\n@group look\n@expose view = show.view\n@expose colors = show.colors\n@expose outline = show.outline\n@expose show_plate = show.show_plate\n@expose gain = show.gain\n@expose glow = show.glow\n@expose moving = show.moving\n@expose hot = show.hot\n@expose line_width = show.line_width\n@expose line_color = show.line_color\n@expose plate_color = show.plate_color\n@expose background = show.background\n@group grains\n@expose hop = grains.hop\n@expose drift = grains.drift\n@expose kick_hop = grains.kick_hop\n@expose jitter = grains.jitter\n@expose spread = grains.spread\n@expose toss_time = grains.toss_time\n@group membrane\n@expose damping = membrane.damping\n@expose drive = membrane.drive\n@expose drive_at = membrane.drive_at\n@expose drive_radius = membrane.drive_radius\n@expose average = membrane.average\n@group size\n@param width int = 1920 16..4096 -- width of the sand picture and of the output in pixels; one grain fills one pixel; a change starts over\n@param height int = 1080 16..4096 -- height of the sand picture and of the output in pixels; a change starts over\n@param grains int = 256 1..4096 -- number of grains in units of 1024: 256 is 262 144 grains; a change starts over\n@reset preset plate width height grains\n@preset preset=* plate=square membrane_steps=1 size=0.9 turn=0\n@preset preset=* view=grains colors=05070c 1a2233 5b6b80 c9cfd6 fff6e0 outline=0.35 show_plate=0 gain=0.5 glow=0.35 moving=0.6 hot=[1.0, 0.45, 0.12, 1]\n@preset preset=* line_width=2.5 line_color=[0.95, 0.92, 0.85, 1] plate_color=[0.15, 0.3, 0.6, 1] background=[0.0, 0.0, 0.0, 1]\n@preset preset=square -- light sand on a dark square plate\n@preset preset=gold colors=070401 2b1600 7a4a0a d9a441 fff1c4 -- gold sand on the square plate\n@preset preset=circle plate=circle -- light sand on a round plate: rings and spokes\n@preset preset=ice plate=circle colors=02060a 0a2a40 2b7fa8 9fe3f0 ffffff -- pale blue sand on the round plate\n@preset preset=shape plate=shape membrane_steps=64 outline=0.5 -- light sand on a plate cut to the input shape: lines that follow its outline\n@preset preset=ember plate=shape membrane_steps=64 outline=0.5 colors=080202 3a0c06 9a2c0a f08a24 fff0b0 -- orange sand on the plate cut to the input shape\n@preset preset=motion plate=shape membrane_steps=64 outline=0.5 show_plate=0.8 -- the shaped plate\'s motion in blue under the sand\n@preset preset=lines view=lines -- the nodal lines of the square plate, drawn crisp, no sand", "shelf": "simulations"}, pos: [300.0, 0.0]),
        "/chladni/density": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "deposit"}, pos: [1200.0, 0.0]),
        "/chladni/density_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "density"}, pos: [1200.0, 120.0]),
        "/chladni/deposit": (kind: "tex.scatter", params: {"dead": "blue"}, inputs: {"positions": "grains", "values": "tint"}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [1000.0, -100.0]),
        "/chladni/field": (kind: "tex.shader", params: {"file": "library/chladni/field.wgsl", "keep_size": true, "size": 0.9, "turn": 0}, inputs: {"in0": "field_size", "in1": "pick", "in2": "membrane", "in3": "shape"}, binds: {"cc": "sums:r", "count": "sums:a", "cs": "sums:b", "plate": "parent.plate", "ss": "sums:g"}, pos: [400.0, 100.0]),
        "/chladni/field_size": (kind: "tex.resolution", params: {"keep_size": true}, inputs: {"in": "world"}, pos: [-200.0, 100.0]),
        "/chladni/glow": (kind: "tex.blur", params: {"size": 10.0}, inputs: {"in": "deposit"}, pos: [1200.0, -200.0]),
        "/chladni/grains": (kind: "tex.shader", params: {"file": "library/chladni/grains.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "grains_loop", "in1": "field", "in2": "density_loop", "in3": "pick"}, binds: {"iterations": "passes:steps", "now": "time:seconds"}, pos: [600.0, -100.0]),
        "/chladni/grains_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "grains"}, pos: [400.0, -150.0]),
        "/chladni/membrane": (kind: "tex.shader", params: {"file": "library/chladni/membrane.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "membrane_loop", "in1": "shape", "in2": "pick"}, binds: {"iterations": "parent.membrane_steps", "plate": "parent.plate"}, pos: [200.0, 300.0]),
        "/chladni/membrane_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "membrane_size", "previous": "membrane"}, pos: [0.0, 200.0]),
        "/chladni/membrane_size": (kind: "tex.resolution", params: {"keep_size": true, "multiply": 0.25}, inputs: {"in": "world"}, pos: [-200.0, 200.0]),
        "/chladni/motion": (kind: "chan.out", inputs: {"in": "motion_read"}, pos: [1400.0, -400.0]),
        "/chladni/motion_read": (kind: "chan.from_tex", params: {"names": "- - - motion"}, inputs: {"in": "grains"}, pos: [800.0, -400.0]),
        "/chladni/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [1600.0, -100.0]),
        "/chladni/pace": (kind: "chan.constant", params: {"name0": "steps", "value0": 4.0}, pos: [-400.0, -480.0]),
        "/chladni/passes": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "pace"}, binds: {"b": "parent.speed"}, pos: [-200.0, -480.0]),
        "/chladni/pick": (kind: "tex.shader", params: {"file": "library/chladni/pick.wgsl", "format": "32f", "height": 1, "keep_size": true, "resolution": "custom", "width": 1}, inputs: {"in0": "pick_loop", "in1": "membrane_size"}, binds: {"msteps": "parent.membrane_steps", "note": "tone:note", "now": "time:seconds"}, pos: [0.0, -280.0]),
        "/chladni/pick_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "pick"}, pos: [-200.0, -300.0]),
        "/chladni/products": (kind: "tex.shader", params: {"file": "library/chladni/products.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "membrane"}, pos: [400.0, 400.0]),
        "/chladni/seed": (kind: "tex.shader", params: {"file": "library/chladni/seed.wgsl", "format": "32f", "height": 256, "keep_size": true, "resolution": "custom", "width": 1024}, binds: {"height": "parent.grains"}, pos: [200.0, -150.0]),
        "/chladni/shape": (kind: "tex.in", pos: [-400.0, 300.0]),
        "/chladni/show": (kind: "tex.shader", params: {"background": [0.0, 0.0, 0.0, 1.0], "colors": "05070c 1a2233 5b6b80 c9cfd6 fff6e0", "file": "library/chladni/show.wgsl", "gain": 0.5, "glow": 0.35, "hot": [1.0, 0.45, 0.12, 1.0], "keep_size": true, "line_color": [0.95, 0.92, 0.85, 1.0], "line_width": 2.5, "moving": 0.6, "outline": 0.35, "plate_color": [0.15, 0.3, 0.6, 1.0], "show_plate": 0, "view": "grains"}, inputs: {"in0": "deposit", "in1": "glow", "in2": "field"}, pos: [1400.0, -100.0]),
        "/chladni/sums": (kind: "chan.from_tex", params: {"measure": "sum"}, inputs: {"in": "products"}, pos: [600.0, 400.0]),
        "/chladni/time": (kind: "chan.clock", params: {"mode": "free"}, pos: [0.0, -380.0]),
        "/chladni/tint": (kind: "tex.shader", params: {"file": "library/chladni/tint.wgsl", "keep_size": true}, inputs: {"in0": "grains"}, pos: [800.0, -200.0]),
        "/chladni/tone": (kind: "chan.in", pos: [-400.0, -300.0]),
        "/chladni/world": (kind: "tex.constant", params: {"color": [0.0, 0.0, 0.0, 0.0], "keep_size": true}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [-400.0, 0.0]),
    },
)
