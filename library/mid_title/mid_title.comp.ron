// Lettering that stands at one place over the valley stage's lake, the camera passes under it.
// title.wgsl places and lights it, geo.text makes it, face.wgsl draws the light in its face.
// `shown`: positive while the title can still be seen, for the show input of a geo.merge.
(
    version: 2,
    nodes: {
        "/mid_title": (kind: "comp.base", params: {"about": "Solid lettering over the lake of stage_valley, for a title at the start of a show.", "params": "@expose presence = controls.value0\n@expose at = controls.value1\n@expose distance = controls.value2\n@expose height = controls.value3\n@expose side = controls.value4\n@expose step = controls.value5\n@expose rise = controls.value6\n@expose sink = controls.value7\n@expose behind = controls.value8\n@expose light = controls.value9\n@expose pulse = controls.value10\n@expose warmth = controls.value11\n@expose text = letters.text\n@expose font = letters.font\n@expose style = letters.style\n@expose size = letters.size\n@expose depth = letters.depth\n@expose spacing = letters.spacing\n@expose align = letters.align\n@expose line_width = rim_mat.line_width\n@expose seed = face.seed", "shelf": "music stage/mid"}, pos: [0.0, 0.0]),
        "/mid_title/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/mid_title/pose": (kind: "chan.in", pos: [-1400.0, 150.0]),
        "/mid_title/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "at", "value1": 3.0, "name2": "distance", "value2": 30.0, "name3": "above", "value3": 4.2, "name4": "side", "value4": 0.0, "name5": "step", "value5": 0.5, "name6": "rise", "value6": 3.0, "name7": "sink", "value7": 6.0, "name8": "behind", "value8": 6.0, "name9": "light", "value9": 1.0, "name10": "pulse", "value10": 0.15, "name11": "warmth", "value11": 0.0}, pos: [-1400.0, 300.0]),
        "/mid_title/seconds": (kind: "chan.select", params: {"channels": "seconds"}, inputs: {"in": "bus"}, pos: [-1200.0, 0.0]),
        "/mid_title/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1200.0, 100.0]),
        "/mid_title/beat": (kind: "chan.select", params: {"channels": "beat"}, inputs: {"in": "bus"}, pos: [-1200.0, 200.0]),
        "/mid_title/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1200.0, -150.0]),
        "/mid_title/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.5}, inputs: {"in": "bass"}, pos: [-1000.0, -150.0]),
        "/mid_title/awake": (kind: "chan.math", params: {"op": "max", "b": 1.0}, inputs: {"a": "seconds"}, pos: [-1000.0, 0.0]),
        "/mid_title/pace": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "travelled", "b": "awake"}, pos: [-800.0, 0.0]),
        "/mid_title/floor_pace": (kind: "chan.math", params: {"op": "max", "b": 0.5}, inputs: {"a": "pace"}, pos: [-700.0, 0.0]),
        "/mid_title/speed": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "floor_pace"}, binds: {"b": "controls:step"}, pos: [-600.0, 0.0]),
        "/mid_title/controls_distance": (kind: "chan.select", params: {"channels": "distance"}, inputs: {"in": "controls"}, pos: [-1000.0, 300.0]),
        "/mid_title/reach": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "controls_distance"}, binds: {"b": "controls:behind"}, pos: [-800.0, 300.0]),
        "/mid_title/lasts": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "reach", "b": "speed"}, pos: [-400.0, 100.0]),
        "/mid_title/ends": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "lasts"}, binds: {"b": "controls:at"}, pos: [-200.0, 100.0]),
        "/mid_title/left": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "ends", "b": "seconds"}, pos: [0.0, 100.0]),
        "/mid_title/shown": (kind: "chan.out", inputs: {"in": "left"}, pos: [200.0, 100.0]),
        "/mid_title/place": (kind: "tex.shader", params: {"file": "library/mid_title/title.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 3.0, "distance": 30.0, "above": 4.2, "side": 0.0, "step": 0.5, "rise": 3.0, "sink": 6.0, "behind": 6.0, "light": 1.0, "pulse": 0.15, "warmth": 0.0, "what": "place"}, binds: {"presence": "controls:presence", "at": "controls:at", "distance": "controls:distance", "above": "controls:above", "side": "controls:side", "step": "controls:step", "rise": "controls:rise", "sink": "controls:sink", "behind": "controls:behind", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "seconds": "seconds:seconds", "travelled": "travelled:travelled", "beat": "beat:beat", "bass": "level:energy_low", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, -700.0]),
        "/mid_title/size": (kind: "tex.shader", params: {"file": "library/mid_title/title.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 3.0, "distance": 30.0, "above": 4.2, "side": 0.0, "step": 0.5, "rise": 3.0, "sink": 6.0, "behind": 6.0, "light": 1.0, "pulse": 0.15, "warmth": 0.0, "what": "size"}, binds: {"presence": "controls:presence", "at": "controls:at", "distance": "controls:distance", "above": "controls:above", "side": "controls:side", "step": "controls:step", "rise": "controls:rise", "sink": "controls:sink", "behind": "controls:behind", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "seconds": "seconds:seconds", "travelled": "travelled:travelled", "beat": "beat:beat", "bass": "level:energy_low", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, -580.0]),
        "/mid_title/rim": (kind: "tex.shader", params: {"file": "library/mid_title/title.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 3.0, "distance": 30.0, "above": 4.2, "side": 0.0, "step": 0.5, "rise": 3.0, "sink": 6.0, "behind": 6.0, "light": 1.0, "pulse": 0.15, "warmth": 0.0, "what": "rim"}, binds: {"presence": "controls:presence", "at": "controls:at", "distance": "controls:distance", "above": "controls:above", "side": "controls:side", "step": "controls:step", "rise": "controls:rise", "sink": "controls:sink", "behind": "controls:behind", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "seconds": "seconds:seconds", "travelled": "travelled:travelled", "beat": "beat:beat", "bass": "level:energy_low", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, -460.0]),
        "/mid_title/glow": (kind: "tex.shader", params: {"file": "library/mid_title/title.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 3.0, "distance": 30.0, "above": 4.2, "side": 0.0, "step": 0.5, "rise": 3.0, "sink": 6.0, "behind": 6.0, "light": 1.0, "pulse": 0.15, "warmth": 0.0, "what": "glow"}, binds: {"presence": "controls:presence", "at": "controls:at", "distance": "controls:distance", "above": "controls:above", "side": "controls:side", "step": "controls:step", "rise": "controls:rise", "sink": "controls:sink", "behind": "controls:behind", "light": "controls:light", "pulse": "controls:pulse", "warmth": "controls:warmth", "seconds": "seconds:seconds", "travelled": "travelled:travelled", "beat": "beat:beat", "bass": "level:energy_low", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, -340.0]),
        "/mid_title/letters": (kind: "geo.text", params: {"text": "Title", "font": "Noto Serif", "style": "Regular", "size": 1.0, "depth": 0.2, "spacing": 0.07}, pos: [-800.0, -900.0]),
        "/mid_title/face": (kind: "tex.shader", params: {"file": "library/mid_title/face.wgsl", "resolution": "custom", "width": 1024, "height": 128, "keep_size": true}, binds: {"warmth": "controls:warmth"}, pos: [-1000.0, -1200.0]),
        "/mid_title/face_mat": (kind: "mat.constant", inputs: {"texture": "face"}, pos: [-800.0, -1200.0]),
        "/mid_title/rim_mat": (kind: "mat.wireframe", params: {"line_width": 2.0, "edges": "polygons", "faces": "open"}, pos: [-800.0, -750.0]),
        "/mid_title/body_rim": (kind: "mat.wireframe", params: {"color": [0.3, 0.3, 0.3, 1.0], "line_width": 1.5, "edges": "polygons", "faces": "filled", "fill": [0.0, 0.0, 0.0, 1.0]}, pos: [-800.0, -1050.0]),
        "/mid_title/body_mat": (kind: "geo.assign_material", inputs: {"in": "letters", "mat": "body_rim"}, pos: [-500.0, -1050.0]),
        "/mid_title/front_out": (kind: "geo.transform", params: {"translate": [0.0, -0.006, 0.0]}, inputs: {"in": "letters:front"}, pos: [-650.0, -900.0]),
        "/mid_title/front_mat": (kind: "geo.assign_material", inputs: {"in": "front_out", "mat": "face_mat"}, pos: [-500.0, -900.0]),
        "/mid_title/lines_out": (kind: "geo.transform", params: {"translate": [0.0, -0.012, 0.0]}, inputs: {"in": "letters:front"}, pos: [-650.0, -750.0]),
        "/mid_title/lines_mat": (kind: "geo.assign_material", inputs: {"in": "lines_out", "mat": "rim_mat"}, pos: [-500.0, -750.0]),
        "/mid_title/lines": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"in": "lines_mat", "position": "place", "scale": "size", "color": "rim"}, pos: [-200.0, -750.0]),
        "/mid_title/body": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"in": "body_mat", "position": "place", "scale": "size", "color": "rim"}, pos: [-200.0, -1050.0]),
        "/mid_title/front": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"in": "front_mat", "position": "place", "scale": "size", "color": "glow"}, pos: [-200.0, -900.0]),
        "/mid_title/all": (kind: "geo.merge", inputs: {"in0": "body", "in1": "front", "in2": "lines"}, pos: [0.0, -950.0]),
        "/mid_title/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [200.0, -950.0]),
    },
)
