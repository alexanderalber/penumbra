// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/stage_tunnel": (kind: "comp.base", params: {"expose": "warmth = controls.value1\nlift = energy_lift.b\nenergy_curve = energy_curve.b\nbars_per_turn = lane_map.bars_per_turn\nswing = lane_map.swing\nturn = lane_map.turn\nstep = controls.value0\nbeats_per_bar = controls.value2\nstart = fade.start\nend = shape.value4\ndim = nebula_dim.brightness\ncamera = preset.row\nglide = glide.rise\npresets = presets.text\ngap = lane_map.gap\ngap_length = lane_map.gap_length\nceiling = controls.value3\ntwist = controls.value4\nlines = controls.value5\nline_width = tube_lines.line_width\nroll_up = controls.value6\nroll_bars = controls.value7\nroll_length = controls.value8\npulse = controls.value9\nmarks = marks_light.marks"}),
        "/stage_tunnel/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/stage_tunnel/floor": (kind: "geo.in", pos: [400.0, 300.0]),
        "/stage_tunnel/mid": (kind: "geo.in", pos: [400.0, 450.0]),
        "/stage_tunnel/ceiling": (kind: "geo.in", pos: [400.0, 600.0]),
        "/stage_tunnel/sky": (kind: "tex.in", pos: [800.0, -700.0]),
        "/stage_tunnel/controls": (kind: "chan.constant", params: {"rows": 10, "name0": "step", "value0": 0.5, "name1": "warmth", "value1": 0.0, "name2": "beats_per_bar", "value2": 4.0, "name3": "ceiling", "value3": 8.0, "name4": "twist", "value4": 1.5, "name5": "lines", "value5": 18.0, "name6": "roll_up", "value6": 1.0, "name7": "roll_bars", "value7": 8.0, "name8": "roll_length", "value8": 2.0, "name9": "pulse", "value9": 1.0}, pos: [-1400.0, 200.0]),
        "/stage_tunnel/half": (kind: "chan.math", params: {"b": 0.5, "op": "multiply"}, inputs: {"a": "controls"}, pos: [-1200.0, 300.0]),
        "/stage_tunnel/phase": (kind: "chan.math", params: {"b": 1.0, "op": "modulo"}, inputs: {"a": "travelled"}, pos: [-1000.0, -350.0]),
        "/stage_tunnel/whole": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "travelled", "b": "phase"}, pos: [-800.0, -350.0]),
        "/stage_tunnel/lane_map": (kind: "tex.shader", params: {"bars_per_turn": 2.0, "beats_per_bar": 4.0, "file": "library/stage_tunnel/lane.wgsl", "height": 1, "keep_size": true, "resolution": "custom", "swing": 0.9, "turn": 4, "width": 256, "what": "twist"}, binds: {"beats": "bus:travelled", "drift": "bus:drift", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar"}, pos: [-1000.0, 0.0]),
        "/stage_tunnel/lane_flat": (kind: "tex.shader", params: {"bars_per_turn": 2.0, "beats_per_bar": 4.0, "file": "library/stage_tunnel/lane.wgsl", "height": 1, "keep_size": true, "resolution": "custom", "swing": 0.9, "turn": 4, "width": 256, "what": "lane"}, binds: {"step": "controls:step"}, pos: [-1000.0, 150.0]),
        "/stage_tunnel/lane": (kind: "tex.out", inputs: {"in": "lane_flat"}, pos: [-800.0, 150.0]),
        "/stage_tunnel/rings_place": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "ring_place", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 300.0]),
        "/stage_tunnel/rings_aim": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "ring_aim", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 400.0]),
        "/stage_tunnel/rings_scale": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "ring_scale", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 500.0]),
        "/stage_tunnel/rings_light": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "ring_light", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 600.0]),
        "/stage_tunnel/walls_place": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "wall_place", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 700.0]),
        "/stage_tunnel/walls_aim": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "wall_aim", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 800.0]),
        "/stage_tunnel/walls_scale": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "wall_scale", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 900.0]),
        "/stage_tunnel/lines_place": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "line_place", "resolution": "custom", "width": 64, "height": 24, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1000.0]),
        "/stage_tunnel/lines_aim": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "line_aim", "resolution": "custom", "width": 64, "height": 24, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1100.0]),
        "/stage_tunnel/lines_scale": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "line_scale", "resolution": "custom", "width": 64, "height": 24, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1200.0]),
        "/stage_tunnel/lines_light": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "line_light", "resolution": "custom", "width": 64, "height": 24, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1300.0]),
        "/stage_tunnel/marks_place": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "mark_place", "resolution": "custom", "width": 64, "height": 2, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1400.0]),
        "/stage_tunnel/marks_aim": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "mark_aim", "resolution": "custom", "width": 64, "height": 2, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1500.0]),
        "/stage_tunnel/marks_scale": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "mark_scale", "resolution": "custom", "width": 64, "height": 2, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1600.0]),
        "/stage_tunnel/marks_light": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "what": "mark_light", "resolution": "custom", "width": 64, "height": 2, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "drift": "bus:drift", "bass": "bus:energy_low", "beat": "bus:beat", "bar": "bus:bar", "bar_index": "bus:bar_index", "role": "bus:section_role", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar", "radius": "half:ceiling", "lines": "controls:lines", "twist": "controls:twist", "warmth": "controls:warmth", "roll_up": "controls:roll_up", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "pulse": "controls:pulse"}, pos: [-400.0, 1700.0]),
        "/stage_tunnel/wall_model": (kind: "geo.file", params: {"file": "library/stage_tunnel/wall.obj", "up": "z"}, pos: [-200.0, 400.0]),
        "/stage_tunnel/wall_cover": (kind: "geo.assign_material", inputs: {"in": "wall_model", "mat": "wall_mat"}, pos: [0.0, 400.0]),
        "/stage_tunnel/rings": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "segment_wire", "position": "rings_place", "aim": "rings_aim", "scale": "rings_scale", "color": "rings_light"}, pos: [200.0, 250.0]),
        "/stage_tunnel/walls": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "wall_cover", "position": "walls_place", "aim": "walls_aim", "scale": "walls_scale"}, pos: [200.0, 450.0]),
        "/stage_tunnel/long_lines": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "segment_wire", "position": "lines_place", "aim": "lines_aim", "scale": "lines_scale", "color": "lines_light"}, pos: [200.0, 700.0]),
        "/stage_tunnel/marks": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "segment_wire", "position": "marks_place", "aim": "marks_aim", "scale": "marks_scale", "color": "marks_light"}, pos: [200.0, 850.0]),
        "/stage_tunnel/segment_model": (kind: "geo.file", params: {"file": "library/stage_tunnel/segment.obj", "up": "z"}, pos: [-200.0, 650.0]),
        "/stage_tunnel/tube_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-200.0, 100.0]),
        "/stage_tunnel/wall_mat": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-200.0, 500.0]),
        "/stage_tunnel/segment_wire": (kind: "geo.assign_material", inputs: {"in": "segment_model", "mat": "tube_lines"}, pos: [0.0, 650.0]),
        "/stage_tunnel/scene": (kind: "geo.merge", inputs: {"in0": "rings", "in1": "walls", "in2": "long_lines", "in3": "floor", "in4": "mid", "in5": "ceiling", "in6": "marks"}, pos: [600.0, 250.0]),
        "/stage_tunnel/presets": (kind: "table.text", params: {"format": "csv", "text": "height,pitch,roll,fov,side\n1.8,-3,0,62,0\n2.6,-7,0,58,0\n3.4,-12,0,76,0\n2.0,-2,0,54,0\n1.3,2,-8,66,-10\n2.8,-5,10,68,12"}, pos: [-400.0, 1300.0]),
        "/stage_tunnel/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "scene"}, pos: [800.0, 300.0]),
        "/stage_tunnel/fade": (kind: "tex.shader", params: {"end": 20.0, "file": "library/stage_tunnel/fade.wgsl", "start": 6.0}, binds: {"end": "shape:far"}, inputs: {"in0": "render", "in1": "render:data"}, pos: [1000.0, 300.0]),
        "/stage_tunnel/palette": (kind: "tex.cross", params: {"cross": 0.0}, inputs: {"a": "warm", "b": "cold"}, binds: {"cross": "controls:warmth"}, pos: [0.0, -200.0]),
        "/stage_tunnel/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1200.0, -500.0]),
        "/stage_tunnel/energy": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1200.0, -900.0]),
        "/stage_tunnel/energy_curve": (kind: "chan.math", params: {"b": 2.5, "op": "power"}, inputs: {"a": "energy"}, pos: [-1000.0, -900.0]),
        "/stage_tunnel/energy_lift": (kind: "chan.math", params: {"b": 0.0, "op": "add"}, inputs: {"a": "energy_curve"}, pos: [-800.0, -900.0]),
        "/stage_tunnel/nebula_lift_gain": (kind: "chan.math", params: {"b": 0.7, "op": "multiply"}, inputs: {"a": "energy_lift"}, pos: [-600.0, -900.0]),
        "/stage_tunnel/nebula_lift": (kind: "chan.math", params: {"b": 0.8}, inputs: {"a": "nebula_lift_gain"}, pos: [-400.0, -900.0]),
        "/stage_tunnel/preset": (kind: "chan.from_table", params: {"row": 0}, inputs: {"in": "presets"}, pos: [-200.0, 800.0]),
        "/stage_tunnel/glide": (kind: "chan.filter", params: {"type": "critical", "rise": 1.5}, inputs: {"in": "preset"}, pos: [0.0, 800.0]),
        "/stage_tunnel/angles": (kind: "chan.select", params: {"channels": "pitch side"}, inputs: {"in": "glide"}, pos: [200.0, 700.0]),
        "/stage_tunnel/radians": (kind: "chan.math", params: {"b": 0.0174533, "op": "multiply"}, inputs: {"a": "angles"}, pos: [400.0, 700.0]),
        "/stage_tunnel/radians_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "radians"}, pos: [600.0, 650.0]),
        "/stage_tunnel/tan_third": (kind: "chan.math", params: {"b": 0.33333, "op": "multiply"}, inputs: {"a": "radians_sq"}, pos: [800.0, 650.0]),
        "/stage_tunnel/tan_factor": (kind: "chan.math", params: {"b": 1.0, "op": "add"}, inputs: {"a": "tan_third"}, pos: [1000.0, 650.0]),
        "/stage_tunnel/tangent": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "tan_factor"}, pos: [1200.0, 700.0]),
        "/stage_tunnel/reach": (kind: "chan.math", params: {"b": 10.0, "op": "multiply"}, inputs: {"a": "tangent"}, pos: [1400.0, 700.0]),
        "/stage_tunnel/eye": (kind: "chan.select", params: {"channels": "height"}, inputs: {"in": "glide"}, pos: [200.0, 850.0]),
        "/stage_tunnel/look": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "reach", "b": "eye"}, pos: [1600.0, 750.0]),
        "/stage_tunnel/camera": (kind: "view.camera", params: {"far": 60.0, "fov": 60.0, "position": [0.0, 0.0, 1.5], "target": [0.0, 10.0, 1.15]}, binds: {"position.2": "eye:height", "target.0": "reach:side", "target.2": "look:pitch", "fov": "glide:fov", "roll": "glide:roll"}, pos: [600.0, 450.0]),
        "/stage_tunnel/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}, pos: [-400.0, -300.0]),
        "/stage_tunnel/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}, pos: [-400.0, -200.0]),
        "/stage_tunnel/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}, pos: [-400.0, -100.0]),
        "/stage_tunnel/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}, pos: [-200.0, -250.0]),
        "/stage_tunnel/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}, pos: [-200.0, -150.0]),
        "/stage_tunnel/cloud_drift": (kind: "chan.math", params: {"b": 0.004, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-1000.0, -600.0]),
        "/stage_tunnel/swirl_drift": (kind: "chan.math", params: {"b": 0.002, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-1000.0, -450.0]),
        "/stage_tunnel/clouds": (kind: "tex.noise", params: {"amplitude": 0.8, "frequency": 2.5, "octaves": 7, "offset": 0.3, "roughness": 0.62}, binds: {"translate.2": "cloud_drift:travelled"}, pos: [-800.0, -650.0]),
        "/stage_tunnel/swirl": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 540, "seed": 7, "width": 960}, binds: {"translate.2": "swirl_drift:travelled"}, pos: [-800.0, -500.0]),
        "/stage_tunnel/wisps": (kind: "tex.displace", params: {"extend": "mirror", "weight": [0.08, 0.08]}, inputs: {"in": "clouds", "map": "swirl"}, pos: [-600.0, -600.0]),
        "/stage_tunnel/glow": (kind: "tex.level", params: {"black": 0.15, "gamma": 0.55, "white": 1.3}, inputs: {"in": "wisps"}, binds: {"brightness": "nebula_lift:energy_low"}, pos: [-400.0, -600.0]),
        "/stage_tunnel/star_noise": (kind: "tex.noise", params: {"frequency": 360.0, "octaves": 1}, pos: [-600.0, -450.0]),
        "/stage_tunnel/stars": (kind: "tex.level", params: {"black": 0.86}, inputs: {"in": "star_noise"}, pos: [-400.0, -450.0]),
        "/stage_tunnel/nebula": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "glow", "in1": "stars"}, pos: [-200.0, -550.0]),
        "/stage_tunnel/nebula_tinted": (kind: "tex.composite", params: {"op": "color"}, inputs: {"in0": "nebula", "in1": "palette"}, pos: [200.0, -500.0]),
        "/stage_tunnel/nebula_dim": (kind: "tex.level", params: {"brightness": 0.45}, inputs: {"in": "nebula_tinted"}, pos: [400.0, -500.0]),
        "/stage_tunnel/sky_over": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "nebula_dim", "in1": "sky"}, pos: [1000.0, -550.0]),
        "/stage_tunnel/picture": (kind: "tex.composite", inputs: {"in0": "sky_over", "in1": "fade"}, pos: [1200.0, -100.0]),
        "/stage_tunnel/out": (kind: "tex.out", inputs: {"in": "picture"}, pos: [1400.0, -100.0]),
        "/stage_tunnel/shape": (kind: "chan.constant", params: {"rows": 5, "name0": "axis", "value0": 4.0, "name1": "walls", "value1": 1.0, "name2": "curve", "value2": 1.0, "name3": "radius", "value3": 4.0, "name4": "far", "value4": 20.0}, binds: {"value3": "half:ceiling", "value0": "half:ceiling"}, pos: [0.0, 1050.0]),
        "/stage_tunnel/pose_all": (kind: "chan.merge", inputs: {"in0": "glide", "in1": "shape"}, pos: [200.0, 1050.0]),
        "/stage_tunnel/pose": (kind: "chan.out", inputs: {"in": "pose_all"}, pos: [400.0, 1050.0]),
    },
)
