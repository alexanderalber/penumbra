// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_glider": (kind: "comp.base", params: {"expose": "presence = controls.value1\nat = controls.value0\nbank = steer.bank\nbob = bob.amplitude\nscale = flight.scale\nhover = flight.hover"}),
        "/mid_glider/bus": (kind: "chan.in", pos: [-1000.0, -200.0]),
        "/mid_glider/lane": (kind: "tex.in", pos: [-1000.0, 0.0]),
        "/mid_glider/controls": (kind: "chan.constant", params: {"name0": "at", "name1": "presence", "rows": 2, "value0": 3.0, "value1": 1.0}, pos: [-1000.0, 150.0]),
        "/mid_glider/wanted": (kind: "chan.select", params: {"channels": "presence"}, inputs: {"in": "controls"}, pos: [-1000.0, 450.0]),
        "/mid_glider/arrive": (kind: "chan.filter", params: {"type": "critical", "order": 3, "rise": 2.0}, inputs: {"in": "wanted"}, pos: [-800.0, 400.0]),
        "/mid_glider/steer": (kind: "tex.shader", params: {"at": 3.0, "bank": 1.2, "file": "library/mid_glider/steer.wgsl", "height": 1, "keep_size": true, "presence": 1.0, "resolution": "custom", "width": 1}, inputs: {"in0": "lane"}, binds: {"at": "controls:at", "presence": "arrive:presence"}, pos: [-800.0, 0.0]),
        "/mid_glider/course": (kind: "chan.from_tex", inputs: {"in": "steer"}, pos: [-600.0, 0.0]),
        "/mid_glider/bob": (kind: "chan.lfo", params: {"amplitude": 0.04, "name": "bob", "rate": 0.45}, pos: [-1000.0, 300.0]),
        "/mid_glider/flight": (kind: "tex.shader", params: {"at": 3.0, "bob": 0.0, "file": "library/mid_glider/flight.wgsl", "height": 1, "hover": 1.2, "keep_size": true, "presence": 1.0, "resolution": "custom", "scale": 0.16, "width": 1}, binds: {"at": "controls:at", "bob": "bob:bob", "presence": "arrive:presence"}, pos: [-800.0, 200.0]),
        "/mid_glider/place": (kind: "chan.from_tex", inputs: {"in": "flight"}, pos: [-600.0, 200.0]),
        "/mid_glider/courier": (kind: "geo.file", params: {"file": "library/mid_glider/courier.obj", "up": "z"}, pos: [-600.0, 500.0]),
        "/mid_glider/fan": (kind: "geo.file", params: {"file": "library/mid_glider/fan.obj", "up": "z"}, pos: [-1000.0, 600.0]),
        "/mid_glider/spin": (kind: "chan.lfo", params: {"amplitude": 180.0, "name": "spin", "rate": 2.0, "shape": "saw"}, pos: [-1000.0, 700.0]),
        "/mid_glider/fan_turn": (kind: "geo.transform", inputs: {"in": "fan"}, binds: {"rotate.2": "spin:spin"}, pos: [-800.0, 600.0]),
        "/mid_glider/fan_places": (kind: "table.text", params: {"format": "csv", "text": "tx,ty,tz,rx,sx\n3.15,4.5,-0.32,-3.44,1\n-3.15,4.5,-0.32,-3.44,-1\n3.15,-4.4,-0.32,6.88,-1\n-3.15,-4.4,-0.32,6.88,1"}, pos: [-800.0, 750.0]),
        "/mid_glider/fans": (kind: "geo.instance", inputs: {"in": "fan_turn", "table": "fan_places"}, pos: [-600.0, 650.0]),
        "/mid_glider/craft": (kind: "geo.merge", inputs: {"in0": "courier", "in1": "fans"}, pos: [-400.0, 550.0]),
        "/mid_glider/hull_mat": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-400.0, 400.0]),
        "/mid_glider/ship_lines": (kind: "mat.wireframe", params: {"faces": "hidden", "line_width": 2.0}, pos: [-400.0, 700.0]),
        "/mid_glider/ship_cover": (kind: "geo.assign_material", inputs: {"in": "craft", "mat": "hull_mat"}, pos: [-200.0, 450.0]),
        "/mid_glider/ship_paint": (kind: "geo.assign_material", inputs: {"in": "craft", "mat": "ship_lines"}, pos: [-200.0, 600.0]),
        "/mid_glider/ship_parts": (kind: "geo.merge", inputs: {"in0": "ship_paint", "in1": "ship_cover"}, pos: [0.0, 500.0]),
        "/mid_glider/ship": (kind: "geo.transform", params: {"translate": [0.0, 3.0, 1.2], "uniform": 0.16}, inputs: {"in": "ship_parts"}, binds: {"rotate.1": "course:b", "rotate.2": "course:g", "translate.0": "course:r", "translate.1": "place:r", "translate.2": "place:g", "uniform": "place:b"}, pos: [200.0, 500.0]),
        "/mid_glider/out": (kind: "geo.out", inputs: {"in": "ship"}, pos: [400.0, 500.0]),
    },
)
