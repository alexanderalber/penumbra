// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_city": (kind: "comp.base", params: {"expose": "presence = city.presence
brightness = city.brightness
warmth = city.warmth
seed = city.seed
tall = city.tall
slide = city.slide
windows = city.windows
flicker = city.flicker
edge = city.edge
reach = city.reach"}),
        "/sky_city/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/sky_city/pose": (kind: "chan.in", pos: [-600.0, 150.0]),
        "/sky_city/city": (kind: "tex.shader", params: {"file": "library/sky_city/city.wgsl", "resolution": "custom", "presence": 1.0, "brightness": 1.0, "warmth": 0.0, "seed": 1, "tall": 0.12, "slide": 0.002, "windows": 0.35, "flicker": 0.7, "edge": 0.8, "reach": 10.0}, binds: {"beats": "bus:travelled", "mid": "bus:energy_mid", "eye": "pose:height", "pitch": "pose:pitch", "fov": "pose:fov", "roll": "pose:roll", "side": "pose:side"}, pos: [-300.0, 0.0]),
        "/sky_city/out": (kind: "tex.out", inputs: {"in": "city"}, pos: [0.0, 0.0]),
    },
)
