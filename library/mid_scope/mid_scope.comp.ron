// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_scope": (kind: "comp.base", params: {"expose": "presence = controls.value0\nsegments = controls.value1\nat = controls.value2\nhover = controls.value3\nacross = controls.value4\ntall = controls.value5\ndepth = controls.value6\ngrow = controls.value7\nkick = controls.value8\nsmooth = levels.fall\nthickness = sizes.thickness\ncolor = trace_lines.color\nline_width = trace_lines.line_width"}),
        "/mid_scope/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/mid_scope/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/mid_scope/controls": (kind: "chan.constant", params: {"rows": 9, "name0": "presence", "value0": 1.0, "name1": "segments", "value1": 192.0, "name2": "at", "value2": 6.0, "name3": "hover", "value3": 2.4, "name4": "across", "value4": 1.5, "name5": "tall", "value5": 0.8, "name6": "depth", "value6": 0.15, "name7": "grow", "value7": 0.35, "name8": "kick", "value8": 0.125}, pos: [-1200.0, 300.0]),
        "/mid_scope/bands": (kind: "chan.select", params: {"channels": "energy_low energy_mid energy_high"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/mid_scope/levels": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.15, "fall": 0.5}, inputs: {"in": "bands"}, pos: [-800.0, -150.0]),
        "/mid_scope/places": (kind: "tex.shader", params: {"resolution": "custom", "width": 16, "height": 16, "keep_size": true, "file": "library/mid_scope/trace.wgsl", "what": "place", "presence": 1.0, "segments": 192, "at": 6.0, "hover": 2.4, "across": 1.5, "tall": 0.8, "depth": 0.15, "grow": 0.35, "kick": 0.125}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "segments": "controls:segments", "at": "controls:at", "hover": "controls:hover", "across": "controls:across", "tall": "controls:tall", "depth": "controls:depth", "grow": "controls:grow", "kick": "controls:kick", "low": "levels:energy_low", "mid": "levels:energy_mid", "high": "levels:energy_high", "beat_index": "bus:beat_index", "beat": "bus:beat"}, pos: [-600.0, 0.0]),
        "/mid_scope/heading": (kind: "tex.shader", params: {"resolution": "custom", "width": 16, "height": 16, "keep_size": true, "file": "library/mid_scope/trace.wgsl", "what": "aim", "presence": 1.0, "segments": 192, "at": 6.0, "hover": 2.4, "across": 1.5, "tall": 0.8, "depth": 0.15, "grow": 0.35, "kick": 0.125}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "segments": "controls:segments", "at": "controls:at", "hover": "controls:hover", "across": "controls:across", "tall": "controls:tall", "depth": "controls:depth", "grow": "controls:grow", "kick": "controls:kick", "low": "levels:energy_low", "mid": "levels:energy_mid", "high": "levels:energy_high", "beat_index": "bus:beat_index", "beat": "bus:beat"}, pos: [-600.0, 150.0]),
        "/mid_scope/sizes": (kind: "tex.shader", params: {"resolution": "custom", "width": 16, "height": 16, "keep_size": true, "file": "library/mid_scope/trace.wgsl", "what": "scale", "thickness": 0.01, "presence": 1.0, "segments": 192, "at": 6.0, "hover": 2.4, "across": 1.5, "tall": 0.8, "depth": 0.15, "grow": 0.35, "kick": 0.125}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "segments": "controls:segments", "at": "controls:at", "hover": "controls:hover", "across": "controls:across", "tall": "controls:tall", "depth": "controls:depth", "grow": "controls:grow", "kick": "controls:kick", "low": "levels:energy_low", "mid": "levels:energy_mid", "high": "levels:energy_high", "beat_index": "bus:beat_index", "beat": "bus:beat"}, pos: [-600.0, 300.0]),
        "/mid_scope/segment": (kind: "geo.file", params: {"file": "library/mid_scope/segment.obj", "up": "z"}, pos: [-600.0, -350.0]),
        "/mid_scope/trace_lines": (kind: "mat.wireframe", params: {"color": [0.35, 1.0, 0.5, 1.0], "line_width": 3.0}, pos: [-600.0, -200.0]),
        "/mid_scope/trace_wire": (kind: "geo.assign_material", inputs: {"in": "segment", "mat": "trace_lines"}, pos: [-400.0, -250.0]),
        "/mid_scope/trace": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "trace_wire", "position": "places", "aim": "heading", "scale": "sizes"}, pos: [0.0, 0.0]),
        "/mid_scope/out": (kind: "geo.out", inputs: {"in": "trace"}, pos: [200.0, 0.0]),
    },
)
