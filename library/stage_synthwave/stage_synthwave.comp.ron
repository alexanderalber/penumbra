// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/stage_synthwave": (kind: "comp.base", params: {"about": "A world: the camera flies over a wireframe floor towards a nebula.", "expose": "warmth = palette.cross\nlift = energy_lift.b\nenergy_curve = energy_curve.b\nbars_per_turn = lane_map.bars_per_turn\nswing = lane_map.swing\nturn = lane_map.turn\nstep = controls.value0\nbeats_per_bar = lane_map.beats_per_bar\nstart = fade.start\nend = shape.value4\ndim = nebula_dim.brightness\ncamera = preset.row\nglide = glide.rise\npresets = presets.text
gap = gap_memory.gap
gap_length = lane_map.gap_length
ground = ground.ground\nroll_up = controls.value1", "shelf": "music stage/stages"}),
        "/stage_synthwave/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/stage_synthwave/floor": (kind: "geo.in", pos: [400.0, 300.0]),
        "/stage_synthwave/mid": (kind: "geo.in", pos: [400.0, 450.0]),
        "/stage_synthwave/ceiling": (kind: "geo.in", pos: [400.0, 600.0]),
        "/stage_synthwave/sky": (kind: "tex.in", pos: [800.0, -700.0]),
        "/stage_synthwave/controls": (kind: "chan.constant", params: {"rows": 2, "name0": "step", "value0": 0.5, "name1": "roll_up", "value1": 0.0}, pos: [-1400.0, 200.0]),
        "/stage_synthwave/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1200.0, -500.0]),
        "/stage_synthwave/energy": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1200.0, -900.0]),
        "/stage_synthwave/energy_curve": (kind: "chan.math", params: {"b": 2.5, "op": "power"}, inputs: {"a": "energy"}, pos: [-1000.0, -900.0]),
        "/stage_synthwave/energy_lift": (kind: "chan.math", params: {"b": 0.0, "op": "add"}, inputs: {"a": "energy_curve"}, pos: [-800.0, -900.0]),
        "/stage_synthwave/nebula_lift_gain": (kind: "chan.math", params: {"b": 0.7, "op": "multiply"}, inputs: {"a": "energy_lift"}, pos: [-600.0, -900.0]),
        "/stage_synthwave/nebula_lift": (kind: "chan.math", params: {"b": 0.8}, inputs: {"a": "nebula_lift_gain"}, pos: [-400.0, -900.0]),
        "/stage_synthwave/lane_map": (kind: "tex.shader", params: {"bars_per_turn": 2.0, "beats_per_bar": 4.0, "file": "library/stage_synthwave/lane.wgsl", "height": 1, "keep_size": true, "resolution": "custom", "swing": 0.9, "turn": 4, "width": 256}, inputs: {"in0": "gap_memory"}, binds: {"beats": "bus:travelled", "drift": "bus:drift", "step": "controls:step"}, pos: [-1000.0, 0.0]),
        "/stage_synthwave/gap_memory": (kind: "tex.shader", params: {"file": "library/stage_synthwave/gaps.wgsl", "resolution": "custom", "width": 512, "height": 1, "keep_size": true}, inputs: {"in0": "gap_loop"}, binds: {"beats": "bus:travelled", "step": "controls:step", "far": "shape:far"}, pos: [-1250.0, 150.0]),
        "/stage_synthwave/gap_loop": (kind: "tex.feedback", inputs: {"previous": "gap_memory"}, pos: [-1450.0, 150.0]),
        "/stage_synthwave/lane": (kind: "tex.out", inputs: {"in": "lane_map"}, pos: [-800.0, 150.0]),
        "/stage_synthwave/grid_plane": (kind: "geo.primitive", params: {"cells": 80, "shape": "plane", "size": [40.0, 1.0, 40.0]}, pos: [-200.0, 100.0]),
        "/stage_synthwave/grid_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-200.0, 200.0]),
        "/stage_synthwave/scroll_moved": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "travelled"}, binds: {"b": "controls:step"}, pos: [-200.0, -50.0]),
        "/stage_synthwave/scroll_cell": (kind: "chan.math", params: {"b": 0.5, "op": "modulo"}, inputs: {"a": "scroll_moved"}, pos: [0.0, -50.0]),
        "/stage_synthwave/scroll": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "scroll_cell"}, pos: [200.0, -50.0]),
        "/stage_synthwave/strip": (kind: "geo.file", params: {"file": "library/stage_synthwave/strip.obj", "up": "z"}, pos: [-200.0, 350.0]),
        "/stage_synthwave/strip_wire": (kind: "geo.assign_material", inputs: {"in": "strip", "mat": "grid_lines"}, pos: [0.0, 350.0]),
        "/stage_synthwave/floor_rows": (kind: "tex.shader", params: {"file": "library/stage_synthwave/floor.wgsl", "what": "place", "resolution": "custom", "width": 80, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"scroll": "scroll:travelled", "roll_up": "controls:roll_up"}, pos: [-200.0, 500.0]),
        "/stage_synthwave/floor_sizes": (kind: "tex.shader", params: {"file": "library/stage_synthwave/floor.wgsl", "what": "size", "resolution": "custom", "width": 80, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"scroll": "scroll:travelled", "roll_up": "controls:roll_up"}, pos: [-200.0, 600.0]),
        "/stage_synthwave/floor_light": (kind: "tex.shader", params: {"file": "library/stage_synthwave/floor.wgsl", "what": "light", "resolution": "custom", "width": 80, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"scroll": "scroll:travelled", "roll_up": "controls:roll_up"}, pos: [-200.0, 700.0]),
        "/stage_synthwave/floor_cells": (kind: "geo.tex_instance", params: {"extent": 25.0}, inputs: {"in": "strip_wire", "position": "floor_rows", "scale": "floor_sizes", "color": "floor_light"}, pos: [0.0, 500.0]),
        "/stage_synthwave/floor_grid": (kind: "geo.transform", inputs: {"in": "floor_cells"}, binds: {"translate.1": "scroll:travelled"}, pos: [200.0, 100.0]),
        "/stage_synthwave/ceiling_grid": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0], "translate": [0.0, 0.0, 4.0]}, inputs: {"in": "ceiling_wire"}, binds: {"translate.1": "scroll:travelled"}, pos: [400.0, 100.0]),
        "/stage_synthwave/roll_place": (kind: "tex.shader", params: {"file": "library/stage_synthwave/roll.wgsl", "what": "place", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, binds: {"phase": "phase:travelled", "step": "controls:step", "roll_up": "controls:roll_up"}, pos: [-200.0, 900.0]),
        "/stage_synthwave/roll_aim": (kind: "tex.shader", params: {"file": "library/stage_synthwave/roll.wgsl", "what": "aim", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, binds: {"phase": "phase:travelled", "step": "controls:step", "roll_up": "controls:roll_up"}, pos: [-200.0, 1000.0]),
        "/stage_synthwave/roll_scale": (kind: "tex.shader", params: {"file": "library/stage_synthwave/roll.wgsl", "what": "scale", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, binds: {"phase": "phase:travelled", "step": "controls:step", "roll_up": "controls:roll_up"}, pos: [-200.0, 1100.0]),
        "/stage_synthwave/roll_light": (kind: "tex.shader", params: {"file": "library/stage_synthwave/roll.wgsl", "what": "light", "resolution": "custom", "width": 64, "height": 48, "keep_size": true}, binds: {"phase": "phase:travelled", "step": "controls:step", "roll_up": "controls:roll_up"}, pos: [-200.0, 1200.0]),
        "/stage_synthwave/phase": (kind: "chan.math", params: {"b": 1.0, "op": "modulo"}, inputs: {"a": "travelled"}, pos: [-400.0, 900.0]),
        "/stage_synthwave/roll_model": (kind: "geo.file", params: {"file": "library/stage_synthwave/segment.obj", "up": "z"}, pos: [-200.0, 1300.0]),
        "/stage_synthwave/roll_wire": (kind: "geo.assign_material", inputs: {"in": "roll_model", "mat": "grid_lines"}, pos: [0.0, 1300.0]),
        "/stage_synthwave/roll_lines": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "roll_wire", "position": "roll_place", "aim": "roll_aim", "scale": "roll_scale", "color": "roll_light"}, pos: [200.0, 1100.0]),
        "/stage_synthwave/ceiling_fall": (kind: "chan.math", params: {"b": -5.0, "op": "multiply"}, inputs: {"a": "controls"}, pos: [-200.0, -200.0]),
        "/stage_synthwave/ceiling_left": (kind: "chan.math", params: {"b": 1.0, "op": "add"}, inputs: {"a": "ceiling_fall"}, pos: [0.0, -200.0]),
        "/stage_synthwave/ceiling_fade": (kind: "chan.math", params: {"b": 0.0, "op": "max"}, inputs: {"a": "ceiling_left"}, pos: [200.0, -200.0]),
        "/stage_synthwave/ceiling_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, binds: {"color.0": "ceiling_fade:roll_up", "color.1": "ceiling_fade:roll_up", "color.2": "ceiling_fade:roll_up"}, pos: [-200.0, 0.0]),
        "/stage_synthwave/ceiling_wire": (kind: "geo.assign_material", inputs: {"in": "grid_plane", "mat": "ceiling_lines"}, pos: [200.0, 0.0]),
        "/stage_synthwave/scene": (kind: "geo.merge", inputs: {"in0": "floor_grid", "in1": "ceiling_grid", "in2": "floor", "in3": "mid", "in4": "ceiling", "in5": "roll_lines"}, pos: [600.0, 250.0]),
        "/stage_synthwave/presets": (kind: "table.text", params: {"format": "csv", "text": "height,pitch,roll,fov,side\n1.5,-2,0,60,0\n2.3,-6,0,56,0\n2.9,-10,0,74,0\n2,0,0,50,0\n1.1,3,-5,64,-10\n2.3,-5,6,66,12"}, pos: [-400.0, 800.0]),
        "/stage_synthwave/preset": (kind: "chan.from_table", params: {"row": 0}, inputs: {"in": "presets"}, pos: [-200.0, 800.0]),
        "/stage_synthwave/glide": (kind: "chan.filter", params: {"type": "critical", "rise": 1.5}, inputs: {"in": "preset"}, pos: [0.0, 800.0]),
        "/stage_synthwave/angles": (kind: "chan.select", params: {"channels": "pitch side"}, inputs: {"in": "glide"}, pos: [200.0, 700.0]),
        "/stage_synthwave/radians": (kind: "chan.math", params: {"b": 0.0174533, "op": "multiply"}, inputs: {"a": "angles"}, pos: [400.0, 700.0]),
        "/stage_synthwave/radians_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "radians"}, pos: [600.0, 650.0]),
        "/stage_synthwave/tan_third": (kind: "chan.math", params: {"b": 0.33333, "op": "multiply"}, inputs: {"a": "radians_sq"}, pos: [800.0, 650.0]),
        "/stage_synthwave/tan_factor": (kind: "chan.math", params: {"b": 1.0, "op": "add"}, inputs: {"a": "tan_third"}, pos: [1000.0, 650.0]),
        "/stage_synthwave/tangent": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "tan_factor"}, pos: [1200.0, 700.0]),
        "/stage_synthwave/reach": (kind: "chan.math", params: {"b": 10.0, "op": "multiply"}, inputs: {"a": "tangent"}, pos: [1400.0, 700.0]),
        "/stage_synthwave/eye": (kind: "chan.select", params: {"channels": "height"}, inputs: {"in": "glide"}, pos: [200.0, 850.0]),
        "/stage_synthwave/look": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "reach", "b": "eye"}, pos: [1600.0, 750.0]),
        "/stage_synthwave/camera": (kind: "view.camera", params: {"far": 60.0, "fov": 60.0, "position": [0.0, 0.0, 1.5], "target": [0.0, 10.0, 1.15]}, binds: {"position.2": "eye:height", "target.0": "reach:side", "target.2": "look:pitch", "fov": "glide:fov", "roll": "glide:roll"}, pos: [600.0, 450.0]),
        "/stage_synthwave/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "scene"}, pos: [800.0, 300.0]),
        "/stage_synthwave/fade": (kind: "tex.shader", params: {"end": 10.0, "file": "library/stage_synthwave/fade.wgsl", "start": 4.0}, binds: {"end": "shape:far"}, inputs: {"in0": "render", "in1": "render:data"}, pos: [1000.0, 300.0]),
        "/stage_synthwave/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}, pos: [-400.0, -300.0]),
        "/stage_synthwave/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}, pos: [-400.0, -200.0]),
        "/stage_synthwave/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}, pos: [-400.0, -100.0]),
        "/stage_synthwave/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}, pos: [-200.0, -250.0]),
        "/stage_synthwave/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}, pos: [-200.0, -150.0]),
        "/stage_synthwave/palette": (kind: "tex.cross", params: {"cross": 0.0}, inputs: {"a": "warm", "b": "cold"}, pos: [0.0, -200.0]),
        "/stage_synthwave/cloud_drift": (kind: "chan.math", params: {"b": 0.004, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-1000.0, -600.0]),
        "/stage_synthwave/swirl_drift": (kind: "chan.math", params: {"b": 0.002, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-1000.0, -450.0]),
        "/stage_synthwave/clouds": (kind: "tex.noise", params: {"amplitude": 0.8, "frequency": 2.5, "octaves": 7, "offset": 0.3, "roughness": 0.62}, binds: {"translate.2": "cloud_drift:travelled"}, pos: [-800.0, -650.0]),
        "/stage_synthwave/swirl": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 540, "seed": 7, "width": 960}, binds: {"translate.2": "swirl_drift:travelled"}, pos: [-800.0, -500.0]),
        "/stage_synthwave/wisps": (kind: "tex.displace", params: {"extend": "mirror", "weight": [0.08, 0.08]}, inputs: {"in": "clouds", "map": "swirl"}, pos: [-600.0, -600.0]),
        "/stage_synthwave/glow": (kind: "tex.level", params: {"black": 0.15, "gamma": 0.55, "white": 1.3}, inputs: {"in": "wisps"}, binds: {"brightness": "nebula_lift:energy_low"}, pos: [-400.0, -600.0]),
        "/stage_synthwave/star_noise": (kind: "tex.noise", params: {"frequency": 360.0, "octaves": 1}, pos: [-600.0, -450.0]),
        "/stage_synthwave/stars": (kind: "tex.level", params: {"black": 0.86}, inputs: {"in": "star_noise"}, pos: [-400.0, -450.0]),
        "/stage_synthwave/nebula": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "glow", "in1": "stars"}, pos: [-200.0, -550.0]),
        "/stage_synthwave/nebula_tinted": (kind: "tex.composite", params: {"op": "color"}, inputs: {"in0": "nebula", "in1": "palette"}, pos: [200.0, -500.0]),
        "/stage_synthwave/nebula_dim": (kind: "tex.level", params: {"brightness": 0.45}, inputs: {"in": "nebula_tinted"}, pos: [400.0, -500.0]),
        "/stage_synthwave/sky_over": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "nebula_dim", "in1": "sky"}, pos: [1000.0, -550.0]),
        "/stage_synthwave/ground": (kind: "tex.shader", params: {"file": "library/stage_synthwave/ground.wgsl", "ground": 0.0, "soft": 0.012, "reach": 10.0}, inputs: {"in0": "sky_over"}, binds: {"eye": "glide:height", "pitch": "glide:pitch", "fov": "glide:fov", "roll": "glide:roll", "side": "glide:side"}, pos: [1100.0, -400.0]),
        "/stage_synthwave/picture": (kind: "tex.composite", inputs: {"in0": "ground", "in1": "fade"}, pos: [1200.0, -100.0]),
        "/stage_synthwave/out": (kind: "tex.out", inputs: {"in": "picture"}, pos: [1400.0, -100.0]),
        "/stage_synthwave/shape": (kind: "chan.constant", params: {"rows": 5, "name0": "axis", "value0": 0.5, "name1": "walls", "value1": 0.0, "name2": "curve", "value2": 0.0, "name3": "radius", "value3": 0.0, "name4": "far", "value4": 10.0}, pos: [0.0, 1050.0]),
        "/stage_synthwave/pose_all": (kind: "chan.merge", inputs: {"in0": "glide", "in1": "shape"}, pos: [200.0, 1050.0]),
        "/stage_synthwave/pose": (kind: "chan.out", inputs: {"in": "pose_all"}, pos: [400.0, 1050.0]),
    },
)
