// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_reeds": (kind: "comp.base", params: {"expose": "presence = controls.value0\nspacing = controls.value1\nfill = controls.value2\nsize = controls.value3\nsway = controls.value4\ncalm = controls.value5\nwave = controls.value6\nglint = controls.value7\nlane = controls.value8\nedge = controls.value9\ndepth = controls.value10\nnear = controls.value11\nfar = controls.value12\nsmooth = level.fall\nline_width = reed_lines.line_width\ncolors = shade.keys"}, pos: [0.0, 0.0]),
        "/floor_reeds/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_reeds/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_reeds/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/floor_reeds/controls": (kind: "chan.constant", params: {"rows": 13, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 0.55, "name2": "fill", "value2": 0.8, "name3": "size", "value3": 1.2, "name4": "sway", "value4": 7.0, "name5": "calm", "value5": 0.3, "name6": "wave", "value6": 6.0, "name7": "glint", "value7": 3.0, "name8": "lane", "value8": 1.6, "name9": "edge", "value9": 0.2, "name10": "depth", "value10": 0.7, "name11": "near", "value11": -3.0, "name12": "far", "value12": 30.0}, pos: [-1200.0, 450.0]),
        "/floor_reeds/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_reeds/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.1, "fall": 0.8}, inputs: {"in": "bass"}, pos: [-800.0, -150.0]),
        "/floor_reeds/place": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "presence": 1.0, "spacing": 0.55, "fill": 0.8, "size": 1.2, "sway": 7.0, "calm": 0.3, "wave": 6.0, "glint": 3.0, "lane": 1.6, "edge": 0.2, "depth": 0.7, "near": -3.0, "far": 30.0, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, -100.0]),
        "/floor_reeds/aim": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "presence": 1.0, "spacing": 0.55, "fill": 0.8, "size": 1.2, "sway": 7.0, "calm": 0.3, "wave": 6.0, "glint": 3.0, "lane": 1.6, "edge": 0.2, "depth": 0.7, "near": -3.0, "far": 30.0, "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 30.0]),
        "/floor_reeds/size": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "presence": 1.0, "spacing": 0.55, "fill": 0.8, "size": 1.2, "sway": 7.0, "calm": 0.3, "wave": 6.0, "glint": 3.0, "lane": 1.6, "edge": 0.2, "depth": 0.7, "near": -3.0, "far": 30.0, "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 160.0]),
        "/floor_reeds/glint": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "presence": 1.0, "spacing": 0.55, "fill": 0.8, "size": 1.2, "sway": 7.0, "calm": 0.3, "wave": 6.0, "glint": 3.0, "lane": 1.6, "edge": 0.2, "depth": 0.7, "near": -3.0, "far": 30.0, "what": "color"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 290.0]),
        "/floor_reeds/shade": (kind: "tex.ramp", params: {"width": 1, "height": 64, "keep_size": true, "shape": "vertical", "keys": "0 0.0012 0.0014 0.0018\n0.72 0.0025 0.0030 0.0032\n0.88 0.0030 0.0110 0.0080\n1 0.010 0.060 0.040"}, pos: [-1000.0, -700.0]),
        "/floor_reeds/reed_lines": (kind: "mat.wireframe", params: {"line_width": 1.5, "faces": "open"}, inputs: {"texture": "shade"}, pos: [-800.0, -700.0]),
        "/floor_reeds/clump": (kind: "geo.file", params: {"file": "library/floor_reeds/reeds.obj", "up": "z"}, pos: [-800.0, -850.0]),
        "/floor_reeds/clump_lines": (kind: "geo.assign_material", inputs: {"in": "clump", "mat": "reed_lines"}, pos: [-600.0, -800.0]),
        "/floor_reeds/reeds": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "clump_lines", "position": "place", "aim": "aim", "scale": "size", "color": "glint"}, pos: [-200.0, 0.0]),
        "/floor_reeds/out": (kind: "geo.out", inputs: {"in": "reeds"}, pos: [200.0, 0.0]),
    },
)
