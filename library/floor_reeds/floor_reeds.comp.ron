// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_reeds": (kind: "comp.base", params: {"about": "Plants at the water's edge of stage_valley.", "params": "@expose presence = controls.value0\n@expose spacing = controls.value1\n@expose fill = controls.value2\n@expose size = controls.value3\n@expose sway = controls.value4\n@expose calm = controls.value5\n@expose wave = controls.value6\n@expose glint = controls.value7\n@expose lane = controls.value8\n@expose edge = controls.value9\n@expose depth = controls.value10\n@expose near = controls.value11\n@expose far = controls.value12\n@expose smooth = level.fall\n@expose line_width = reed_lines.line_width\n@expose colors = shade.keys\n@expose colors_rim = rim_shade.keys\n@expose ease = controls.value13\n@expose hold = controls.value14\n@expose stretch = controls.value15\n@expose share_reeds = controls.value16\n@expose share_cattails = controls.value17\n@expose share_sedge = controls.value18\n@expose share_papyrus = controls.value19\n@expose share_agave = controls.value20\n@expose mast = controls.value21\n@expose tufts = controls.value22\n@expose seed = controls.value23
@expose rim_lift = steady.rim_lift", "shelf": "music stage/floor"}, pos: [0.0, 0.0]),
        "/floor_reeds/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_reeds/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_reeds/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/floor_reeds/controls": (kind: "chan.constant", params: {"rows": 24, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 0.55, "name2": "fill", "value2": 0.8, "name3": "size", "value3": 1.2, "name4": "sway", "value4": 7.0, "name5": "calm", "value5": 0.3, "name6": "wave", "value6": 6.0, "name7": "glint", "value7": 3.0, "name8": "lane", "value8": 1.6, "name9": "edge", "value9": 0.2, "name10": "depth", "value10": 0.7, "name11": "near", "value11": -3.0, "name12": "far", "value12": 30.0, "name13": "ease", "value13": 2.0, "name14": "hold", "value14": 9.0, "name15": "stretch", "value15": 9.0, "name16": "share_reeds", "value16": 1.0, "name17": "share_cattails", "value17": 1.0, "name18": "share_sedge", "value18": 1.0, "name19": "share_papyrus", "value19": 1.0, "name20": "share_agave", "value20": 1.0, "name21": "mast", "value21": 0.08, "name22": "tufts", "value22": 0.6, "name23": "seed", "value23": 0.0}, pos: [-1200.0, 450.0]),
        "/floor_reeds/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_reeds/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.1, "fall": 0.8}, inputs: {"in": "bass"}, pos: [-800.0, -150.0]),
        "/floor_reeds/place": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "place"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, -100.0]),
        "/floor_reeds/aim": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "aim"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 50.0]),
        "/floor_reeds/size": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "scale"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 200.0]),
        "/floor_reeds/steady": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "steady", "rim_lift": 1.0}, binds: {"swell": "pose:swell"}, pos: [-600.0, -560.0]),
        "/floor_reeds/glint": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "color"}, inputs: {"in0": "lane", "in1": "memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 350.0]),
        "/floor_reeds/memory_loop": (kind: "tex.feedback", inputs: {"previous": "memory"}, pos: [-1000.0, 600.0]),
        "/floor_reeds/memory": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 5, "height": 128, "keep_size": true, "what": "memory"}, inputs: {"in0": "lane", "in1": "memory_loop"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-800.0, 600.0]),
        "/floor_reeds/tuft_place": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "place", "front": 1.0}, inputs: {"in0": "lane", "in1": "tuft_memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 800.0]),
        "/floor_reeds/tuft_aim": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "aim", "front": 1.0}, inputs: {"in0": "lane", "in1": "tuft_memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 950.0]),
        "/floor_reeds/tuft_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 4, "height": 72, "keep_size": true, "what": "scale", "front": 1.0}, inputs: {"in0": "lane", "in1": "tuft_memory"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-600.0, 1100.0]),
        "/floor_reeds/tuft_memory_loop": (kind: "tex.feedback", inputs: {"previous": "tuft_memory"}, pos: [-1000.0, 1250.0]),
        "/floor_reeds/tuft_memory": (kind: "tex.shader", params: {"file": "library/floor_reeds/reeds.wgsl", "resolution": "custom", "width": 5, "height": 128, "keep_size": true, "what": "memory", "front": 1.0}, inputs: {"in0": "lane", "in1": "tuft_memory_loop"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "fill": "controls:fill", "size": "controls:size", "sway": "controls:sway", "calm": "controls:calm", "wave": "controls:wave", "glint": "controls:glint", "lane": "controls:lane", "edge": "controls:edge", "depth": "controls:depth", "near": "controls:near", "far": "controls:far", "ease": "controls:ease", "hold": "controls:hold", "stretch": "controls:stretch", "share_reeds": "controls:share_reeds", "share_cattails": "controls:share_cattails", "share_sedge": "controls:share_sedge", "share_papyrus": "controls:share_papyrus", "share_agave": "controls:share_agave", "mast": "controls:mast", "tufts": "controls:tufts", "seed": "controls:seed", "beats": "bus:travelled", "bass": "level:energy_low", "swell": "pose:swell"}, pos: [-800.0, 1250.0]),
        "/floor_reeds/shade": (kind: "tex.ramp", params: {"width": 1, "height": 64, "keep_size": true, "shape": "vertical", "keys": "0 0.0012 0.0014 0.0018\n0.72 0.0025 0.0030 0.0032\n0.88 0.0030 0.0110 0.0080\n1 0.010 0.060 0.040"}, pos: [-1000.0, -850.0]),
        "/floor_reeds/rim_shade": (kind: "tex.ramp", params: {"width": 1, "height": 64, "keep_size": true, "shape": "vertical", "keys": "0 0.0025 0.0020 0.0020\n0.6 0.0058 0.0033 0.0022\n0.85 0.014 0.0066 0.0028\n1 0.040 0.017 0.006"}, pos: [-1000.0, -700.0]),
        "/floor_reeds/ramps": (kind: "tex.shader", params: {"file": "library/floor_reeds/ramps.wgsl", "resolution": "custom", "width": 2, "height": 64, "keep_size": true}, inputs: {"in0": "shade", "in1": "rim_shade"}, pos: [-800.0, -780.0]),
        "/floor_reeds/reed_lines": (kind: "mat.wireframe", params: {"line_width": 1.5, "faces": "open"}, inputs: {"texture": "ramps"}, pos: [-600.0, -850.0]),
        "/floor_reeds/body": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-600.0, -700.0]),
        "/floor_reeds/reeds_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/reeds_lines.obj", "up": "z"}, pos: [-600.0, 900.0]),
        "/floor_reeds/reeds_lines_mat": (kind: "geo.assign_material", inputs: {"in": "reeds_lines", "mat": "reed_lines"}, pos: [-400.0, 900.0]),
        "/floor_reeds/reeds_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/pick.wgsl", "resolution": "input", "kind": 0.0}, inputs: {"in0": "size"}, pos: [-300.0, -500.0]),
        "/floor_reeds/reeds": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "reeds_lines_mat", "position": "place", "aim": "aim", "scale": "reeds_size", "color": "glint"}, pos: [0.0, 900.0]),
        "/floor_reeds/cattails_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/cattails_lines.obj", "up": "z"}, pos: [-600.0, 1070.0]),
        "/floor_reeds/cattails_lines_mat": (kind: "geo.assign_material", inputs: {"in": "cattails_lines", "mat": "reed_lines"}, pos: [-400.0, 1070.0]),
        "/floor_reeds/cattails_fill": (kind: "geo.file", params: {"file": "library/floor_reeds/cattails_fill.obj", "up": "z"}, pos: [-600.0, 1130.0]),
        "/floor_reeds/cattails_fill_mat": (kind: "geo.assign_material", inputs: {"in": "cattails_fill", "mat": "body"}, pos: [-400.0, 1130.0]),
        "/floor_reeds/cattails_model": (kind: "geo.merge", inputs: {"in0": "cattails_fill_mat", "in1": "cattails_lines_mat"}, pos: [-200.0, 1070.0]),
        "/floor_reeds/cattails_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/pick.wgsl", "resolution": "input", "kind": 1.0}, inputs: {"in0": "size"}, pos: [-300.0, -400.0]),
        "/floor_reeds/cattails": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "cattails_model", "position": "place", "aim": "aim", "scale": "cattails_size", "color": "glint"}, pos: [0.0, 1070.0]),
        "/floor_reeds/sedge_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/sedge_lines.obj", "up": "z"}, pos: [-600.0, 1240.0]),
        "/floor_reeds/sedge_lines_mat": (kind: "geo.assign_material", inputs: {"in": "sedge_lines", "mat": "reed_lines"}, pos: [-400.0, 1240.0]),
        "/floor_reeds/sedge_fill": (kind: "geo.file", params: {"file": "library/floor_reeds/sedge_fill.obj", "up": "z"}, pos: [-600.0, 1300.0]),
        "/floor_reeds/sedge_fill_mat": (kind: "geo.assign_material", inputs: {"in": "sedge_fill", "mat": "body"}, pos: [-400.0, 1300.0]),
        "/floor_reeds/sedge_model": (kind: "geo.merge", inputs: {"in0": "sedge_fill_mat", "in1": "sedge_lines_mat"}, pos: [-200.0, 1240.0]),
        "/floor_reeds/sedge_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/pick.wgsl", "resolution": "input", "kind": 2.0}, inputs: {"in0": "size"}, pos: [-300.0, -300.0]),
        "/floor_reeds/sedge": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "sedge_model", "position": "place", "aim": "aim", "scale": "sedge_size", "color": "glint"}, pos: [0.0, 1240.0]),
        "/floor_reeds/papyrus_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/papyrus_lines.obj", "up": "z"}, pos: [-600.0, 1410.0]),
        "/floor_reeds/papyrus_lines_mat": (kind: "geo.assign_material", inputs: {"in": "papyrus_lines", "mat": "reed_lines"}, pos: [-400.0, 1410.0]),
        "/floor_reeds/papyrus_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/pick.wgsl", "resolution": "input", "kind": 3.0}, inputs: {"in0": "size"}, pos: [-300.0, -200.0]),
        "/floor_reeds/papyrus": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "papyrus_lines_mat", "position": "place", "aim": "aim", "scale": "papyrus_size", "color": "glint"}, pos: [0.0, 1410.0]),
        "/floor_reeds/agave_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/agave_lines.obj", "up": "z"}, pos: [-600.0, 1580.0]),
        "/floor_reeds/agave_lines_mat": (kind: "geo.assign_material", inputs: {"in": "agave_lines", "mat": "reed_lines"}, pos: [-400.0, 1580.0]),
        "/floor_reeds/agave_fill": (kind: "geo.file", params: {"file": "library/floor_reeds/agave_fill.obj", "up": "z"}, pos: [-600.0, 1640.0]),
        "/floor_reeds/agave_fill_mat": (kind: "geo.assign_material", inputs: {"in": "agave_fill", "mat": "body"}, pos: [-400.0, 1640.0]),
        "/floor_reeds/agave_model": (kind: "geo.merge", inputs: {"in0": "agave_fill_mat", "in1": "agave_lines_mat"}, pos: [-200.0, 1580.0]),
        "/floor_reeds/agave_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/pick.wgsl", "resolution": "input", "kind": 4.0}, inputs: {"in0": "size"}, pos: [-300.0, -100.0]),
        "/floor_reeds/agave": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "agave_model", "position": "place", "aim": "aim", "scale": "agave_size", "color": "steady"}, pos: [0.0, 1580.0]),
        "/floor_reeds/mast_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/mast_lines.obj", "up": "z"}, pos: [-600.0, 1750.0]),
        "/floor_reeds/mast_lines_mat": (kind: "geo.assign_material", inputs: {"in": "mast_lines", "mat": "reed_lines"}, pos: [-400.0, 1750.0]),
        "/floor_reeds/mast_fill": (kind: "geo.file", params: {"file": "library/floor_reeds/mast_fill.obj", "up": "z"}, pos: [-600.0, 1810.0]),
        "/floor_reeds/mast_fill_mat": (kind: "geo.assign_material", inputs: {"in": "mast_fill", "mat": "body"}, pos: [-400.0, 1810.0]),
        "/floor_reeds/mast_model": (kind: "geo.merge", inputs: {"in0": "mast_fill_mat", "in1": "mast_lines_mat"}, pos: [-200.0, 1750.0]),
        "/floor_reeds/mast_size": (kind: "tex.shader", params: {"file": "library/floor_reeds/pick.wgsl", "resolution": "input", "kind": 14.0}, inputs: {"in0": "size"}, pos: [-300.0, 0.0]),
        "/floor_reeds/mast": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "mast_model", "position": "place", "aim": "aim", "scale": "mast_size", "color": "glint"}, pos: [0.0, 1750.0]),
        "/floor_reeds/tufts_lines": (kind: "geo.file", params: {"file": "library/floor_reeds/tufts_lines.obj", "up": "z"}, pos: [-600.0, 1920.0]),
        "/floor_reeds/tufts_lines_mat": (kind: "geo.assign_material", inputs: {"in": "tufts_lines", "mat": "reed_lines"}, pos: [-400.0, 1920.0]),
        "/floor_reeds/tufts": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "tufts_lines_mat", "position": "tuft_place", "aim": "tuft_aim", "scale": "tuft_size", "color": "steady"}, pos: [0.0, 1920.0]),
        "/floor_reeds/all": (kind: "geo.merge", inputs: {"in0": "reeds", "in1": "cattails", "in2": "sedge", "in3": "papyrus", "in4": "agave", "in5": "mast", "in6": "tufts"}, pos: [200.0, 1500.0]),
        "/floor_reeds/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [400.0, 1500.0]),
    },
)
