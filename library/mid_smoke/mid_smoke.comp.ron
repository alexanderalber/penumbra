// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_smoke": (kind: "comp.base", params: {"expose": "presence = controls.value0\nbrightness = controls.value1\ncalm = controls.value2\nveils = controls.value3\nspacing = controls.value4\nwide = controls.value5\ntall = controls.value6\nspread = controls.value7\nwind = controls.value8\nfade = controls.value9\nstart = controls.value10\nend = controls.value11\nnear = controls.value12\nseed = controls.value13\nwarmth = controls.value14\ncover = controls.value15\ncover_swell = controls.value16\ncurl = controls.value17\nspeed = controls.value18\npeak = controls.value19\nextent = veils1.extent"}, pos: [0.0, 0.0]),
        "/mid_smoke/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/mid_smoke/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/mid_smoke/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/mid_smoke/controls": (kind: "chan.constant", params: {"rows": 20, "name0": "presence", "value0": 1.0, "name1": "brightness", "value1": 1.6, "name2": "calm", "value2": 0.58, "name3": "veils", "value3": 12.0, "name4": "spacing", "value4": 3.0, "name5": "wide", "value5": 9.0, "name6": "tall", "value6": 3.0, "name7": "spread", "value7": 3.0, "name8": "wind", "value8": 0.04, "name9": "fade", "value9": 5.0, "name10": "start", "value10": 14.0, "name11": "end", "value11": 38.0, "name12": "near", "value12": -1.0, "name13": "seed", "value13": 0.0, "name14": "warmth", "value14": 0.0, "name15": "cover", "value15": 0.3, "name16": "cover_swell", "value16": 0.24, "name17": "curl", "value17": 1.0, "name18": "speed", "value18": 1.0, "name19": "peak", "value19": 0.82}, pos: [-1200.0, 450.0]),
        "/mid_smoke/smoke": (kind: "tex.shader", params: {"file": "library/mid_smoke/smoke.wgsl", "resolution": "custom", "width": 512, "height": 384, "keep_size": true, "warmth": 0.0, "cover": 0.3, "cover_swell": 0.24, "curl": 1.0, "speed": 1.0, "seed": 0}, binds: {"warmth": "controls:warmth", "cover": "controls:cover", "cover_swell": "controls:cover_swell", "curl": "controls:curl", "speed": "controls:speed", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-1000.0, -700.0]),
        "/mid_smoke/smoke_small": (kind: "tex.resolution", params: {"mode": "custom", "width": 4, "height": 3, "keep_size": true}, inputs: {"in": "smoke"}, pos: [-800.0, -1800.0]),
        "/mid_smoke/aim_ready": (kind: "tex.shader", params: {"file": "library/mid_smoke/wait.wgsl", "resolution": "input"}, inputs: {"in0": "smoke_small", "in1": "aim"}, pos: [-600.0, -1800.0]),
        "/mid_smoke/smoke_mat": (kind: "mat.constant", inputs: {"texture": "smoke"}, pos: [-800.0, -700.0]),
        "/mid_smoke/place": (kind: "tex.shader", params: {"file": "library/mid_smoke/veils.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "brightness": 1.6, "calm": 0.58, "veils": 12, "spacing": 3.0, "wide": 9.0, "tall": 3.0, "spread": 3.0, "wind": 0.04, "fade": 5.0, "start": 14.0, "end": 38.0, "near": -1.0, "seed": 0, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "brightness": "controls:brightness", "calm": "controls:calm", "veils": "controls:veils", "spacing": "controls:spacing", "wide": "controls:wide", "tall": "controls:tall", "spread": "controls:spread", "wind": "controls:wind", "fade": "controls:fade", "start": "controls:start", "end": "controls:end", "near": "controls:near", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, -100.0]),
        "/mid_smoke/aim": (kind: "tex.shader", params: {"file": "library/mid_smoke/veils.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "brightness": 1.6, "calm": 0.58, "veils": 12, "spacing": 3.0, "wide": 9.0, "tall": 3.0, "spread": 3.0, "wind": 0.04, "fade": 5.0, "start": 14.0, "end": 38.0, "near": -1.0, "seed": 0, "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "brightness": "controls:brightness", "calm": "controls:calm", "veils": "controls:veils", "spacing": "controls:spacing", "wide": "controls:wide", "tall": "controls:tall", "spread": "controls:spread", "wind": "controls:wind", "fade": "controls:fade", "start": "controls:start", "end": "controls:end", "near": "controls:near", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, 30.0]),
        "/mid_smoke/light": (kind: "tex.shader", params: {"file": "library/mid_smoke/veils.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "brightness": 1.6, "peak": 0.82, "calm": 0.58, "veils": 12, "spacing": 3.0, "wide": 9.0, "tall": 3.0, "spread": 3.0, "wind": 0.04, "fade": 5.0, "start": 14.0, "end": 38.0, "near": -1.0, "seed": 0, "what": "color"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "brightness": "controls:brightness", "peak": "controls:peak", "calm": "controls:calm", "veils": "controls:veils", "spacing": "controls:spacing", "wide": "controls:wide", "tall": "controls:tall", "spread": "controls:spread", "wind": "controls:wind", "fade": "controls:fade", "start": "controls:start", "end": "controls:end", "near": "controls:near", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, 160.0]),
        "/mid_smoke/size1": (kind: "tex.shader", params: {"file": "library/mid_smoke/veils.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "brightness": 1.6, "calm": 0.58, "veils": 12, "spacing": 3.0, "wide": 9.0, "tall": 3.0, "spread": 3.0, "wind": 0.04, "fade": 5.0, "start": 14.0, "end": 38.0, "near": -1.0, "seed": 0, "what": "scale", "kind": 1}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "brightness": "controls:brightness", "calm": "controls:calm", "veils": "controls:veils", "spacing": "controls:spacing", "wide": "controls:wide", "tall": "controls:tall", "spread": "controls:spread", "wind": "controls:wind", "fade": "controls:fade", "start": "controls:start", "end": "controls:end", "near": "controls:near", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, 290.0]),
        "/mid_smoke/size2": (kind: "tex.shader", params: {"file": "library/mid_smoke/veils.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "brightness": 1.6, "calm": 0.58, "veils": 12, "spacing": 3.0, "wide": 9.0, "tall": 3.0, "spread": 3.0, "wind": 0.04, "fade": 5.0, "start": 14.0, "end": 38.0, "near": -1.0, "seed": 0, "what": "scale", "kind": 2}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "brightness": "controls:brightness", "calm": "controls:calm", "veils": "controls:veils", "spacing": "controls:spacing", "wide": "controls:wide", "tall": "controls:tall", "spread": "controls:spread", "wind": "controls:wind", "fade": "controls:fade", "start": "controls:start", "end": "controls:end", "near": "controls:near", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, 420.0]),
        "/mid_smoke/size3": (kind: "tex.shader", params: {"file": "library/mid_smoke/veils.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "brightness": 1.6, "calm": 0.58, "veils": 12, "spacing": 3.0, "wide": 9.0, "tall": 3.0, "spread": 3.0, "wind": 0.04, "fade": 5.0, "start": 14.0, "end": 38.0, "near": -1.0, "seed": 0, "what": "scale", "kind": 3}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "brightness": "controls:brightness", "calm": "controls:calm", "veils": "controls:veils", "spacing": "controls:spacing", "wide": "controls:wide", "tall": "controls:tall", "spread": "controls:spread", "wind": "controls:wind", "fade": "controls:fade", "start": "controls:start", "end": "controls:end", "near": "controls:near", "seed": "controls:seed", "beats": "bus:travelled", "swell": "pose:swell", "dawn": "pose:dawn"}, pos: [-600.0, 550.0]),
        "/mid_smoke/veil1_model": (kind: "geo.file", params: {"file": "library/mid_smoke/veil1.obj", "up": "z"}, pos: [-800.0, -550.0]),
        "/mid_smoke/veil1_smoke": (kind: "geo.assign_material", inputs: {"in": "veil1_model", "mat": "smoke_mat"}, pos: [-600.0, -550.0]),
        "/mid_smoke/veils1": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "veil1_smoke", "position": "place", "aim": "aim_ready", "scale": "size1", "color": "light"}, pos: [-200.0, -200.0]),
        "/mid_smoke/veil2_model": (kind: "geo.file", params: {"file": "library/mid_smoke/veil2.obj", "up": "z"}, pos: [-800.0, -400.0]),
        "/mid_smoke/veil2_smoke": (kind: "geo.assign_material", inputs: {"in": "veil2_model", "mat": "smoke_mat"}, pos: [-600.0, -400.0]),
        "/mid_smoke/veils2": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "veil2_smoke", "position": "place", "aim": "aim_ready", "scale": "size2", "color": "light"}, pos: [-200.0, 0.0]),
        "/mid_smoke/veil3_model": (kind: "geo.file", params: {"file": "library/mid_smoke/veil3.obj", "up": "z"}, pos: [-800.0, -250.0]),
        "/mid_smoke/veil3_smoke": (kind: "geo.assign_material", inputs: {"in": "veil3_model", "mat": "smoke_mat"}, pos: [-600.0, -250.0]),
        "/mid_smoke/veils3": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "veil3_smoke", "position": "place", "aim": "aim_ready", "scale": "size3", "color": "light"}, pos: [-200.0, 200.0]),
        "/mid_smoke/all": (kind: "geo.merge", inputs: {"in0": "veils1", "in1": "veils2", "in2": "veils3"}, pos: [0.0, 0.0]),
        "/mid_smoke/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [200.0, 0.0]),
    },
)
