// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/stage_ascent": (kind: "comp.base", params: {"expose": "warmth = controls.value1\nlift = energy_lift.b\nenergy_curve = energy_curve.b\nbars_per_turn = lane_map.bars_per_turn\nswing = lane_map.swing\nturn = lane_map.turn\nstep = controls.value0\nbeats_per_bar = controls.value2\nstart = fade.start\nend = shape.value4\ndim = nebula_dim.brightness\ncamera = preset.row\nglide = glide.rise\npresets = presets.text\ngap = controls.value8\ngap_length = controls.value9\nceiling = controls.value3\nstorey_beats = controls.value6\norbit = controls.value7\nradius = controls.value10\ntwist = controls.value4\nlines = controls.value5\nline_width = tower_lines.line_width\nturn_up = controls.value11\ntube_radius = controls.value12\noutside = outside_show.value1"}),
        "/stage_ascent/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/stage_ascent/floor": (kind: "geo.in", pos: [400.0, 300.0]),
        "/stage_ascent/mid": (kind: "geo.in", pos: [400.0, 450.0]),
        "/stage_ascent/ceiling": (kind: "geo.in", pos: [400.0, 600.0]),
        "/stage_ascent/outside": (kind: "geo.in", pos: [400.0, 0.0]),
        "/stage_ascent/sky": (kind: "tex.in", pos: [800.0, -700.0]),
        "/stage_ascent/controls": (kind: "chan.constant", params: {"rows": 13, "name0": "step", "value0": 0.5, "name1": "warmth", "value1": 0.0, "name2": "beats_per_bar", "value2": 4.0, "name3": "ceiling", "value3": 3.0, "name4": "twist", "value4": 1.0, "name5": "lines", "value5": 18.0, "name6": "storey_beats", "value6": 4.0, "name7": "orbit", "value7": 128.0, "name8": "gap", "value8": 0.0, "name9": "gap_length", "value9": 8.0, "name10": "radius", "value10": 6.0, "name11": "turn_up", "value11": 1.0, "name12": "tube_radius", "value12": 4.0}, pos: [-1400.0, 200.0]),
        "/stage_ascent/phase": (kind: "chan.math", params: {"b": 1.0, "op": "modulo"}, inputs: {"a": "travelled"}, pos: [-1000.0, -350.0]),
        "/stage_ascent/whole": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "travelled", "b": "phase"}, pos: [-800.0, -350.0]),
        "/stage_ascent/lane_map": (kind: "tex.shader", params: {"bars_per_turn": 2.0, "beats_per_bar": 4.0, "file": "library/stage_ascent/lane.wgsl", "height": 1, "keep_size": true, "resolution": "custom", "swing": 0.9, "turn": 4, "width": 256, "what": "twist"}, binds: {"beats": "bus:travelled", "drift": "bus:drift", "step": "controls:step", "beats_per_bar": "controls:beats_per_bar"}, pos: [-1000.0, 0.0]),
        "/stage_ascent/lane_flat": (kind: "tex.shader", params: {"bars_per_turn": 2.0, "beats_per_bar": 4.0, "file": "library/stage_ascent/lane.wgsl", "height": 1, "keep_size": true, "resolution": "custom", "swing": 0.9, "turn": 4, "width": 256, "what": "lane"}, binds: {"step": "controls:step"}, pos: [-1000.0, 150.0]),
        "/stage_ascent/lane": (kind: "tex.out", inputs: {"in": "lane_flat"}, pos: [-800.0, 150.0]),
        "/stage_ascent/storeys_place": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "storey_place", "resolution": "custom", "width": 12, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 300.0]),
        "/stage_ascent/storeys_aim": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "storey_aim", "resolution": "custom", "width": 12, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 400.0]),
        "/stage_ascent/storeys_scale": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "storey_scale", "resolution": "custom", "width": 12, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 500.0]),
        "/stage_ascent/storeys_light": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "storey_light", "resolution": "custom", "width": 12, "height": 1, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 600.0]),
        "/stage_ascent/posts_place": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "post_place", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 750.0]),
        "/stage_ascent/posts_aim": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "post_aim", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 850.0]),
        "/stage_ascent/posts_scale": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "post_scale", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 950.0]),
        "/stage_ascent/posts_light": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "post_light", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1050.0]),
        "/stage_ascent/hoops_place": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "hoop_place", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1150.0]),
        "/stage_ascent/hoops_aim": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "hoop_aim", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1250.0]),
        "/stage_ascent/hoops_scale": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "hoop_scale", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1350.0]),
        "/stage_ascent/hoops_light": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "hoop_light", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1450.0]),
        "/stage_ascent/floors_place": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "floor_place", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1550.0]),
        "/stage_ascent/floors_aim": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "floor_aim", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1650.0]),
        "/stage_ascent/floors_scale": (kind: "tex.shader", params: {"file": "library/stage_ascent/ascent.wgsl", "what": "floor_scale", "resolution": "custom", "width": 12, "height": 48, "keep_size": true}, inputs: {"in0": "lane_map"}, binds: {"whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "storey": "controls:ceiling", "storey_beats": "controls:storey_beats", "radius": "controls:radius", "lines": "controls:lines", "twist": "controls:twist", "orbit": "controls:orbit", "warmth": "controls:warmth", "gap": "controls:gap", "gap_length": "controls:gap_length", "turn_up": "controls:turn_up", "tube_radius": "controls:tube_radius", "step": "controls:step"}, pos: [-400.0, 1750.0]),
        "/stage_ascent/storey_model": (kind: "geo.file", params: {"file": "library/stage_ascent/storey.obj", "up": "z"}, pos: [-200.0, 200.0]),
        "/stage_ascent/slab_model": (kind: "geo.file", params: {"file": "library/stage_ascent/piece.obj", "up": "z"}, pos: [-200.0, 400.0]),
        "/stage_ascent/post_model": (kind: "geo.file", params: {"file": "library/stage_ascent/post.obj", "up": "z"}, pos: [-200.0, 650.0]),
        "/stage_ascent/tower_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-200.0, 100.0]),
        "/stage_ascent/slab_mat": (kind: "mat.occluder", params: {"shows": "black"}, pos: [-200.0, 500.0]),
        "/stage_ascent/storey_wire": (kind: "geo.assign_material", inputs: {"in": "storey_model", "mat": "tower_lines"}, pos: [0.0, 200.0]),
        "/stage_ascent/slab_cover": (kind: "geo.assign_material", inputs: {"in": "slab_model", "mat": "slab_mat"}, pos: [0.0, 400.0]),
        "/stage_ascent/post_wire": (kind: "geo.assign_material", inputs: {"in": "post_model", "mat": "tower_lines"}, pos: [0.0, 650.0]),
        "/stage_ascent/hoop_wire": (kind: "geo.assign_material", inputs: {"in": "post_model", "mat": "tower_lines"}, pos: [0.0, 900.0]),
        "/stage_ascent/storeys": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "storey_wire", "position": "storeys_place", "aim": "storeys_aim", "scale": "storeys_scale", "color": "storeys_light"}, pos: [200.0, 250.0]),
        "/stage_ascent/slabs": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "slab_cover", "position": "floors_place", "aim": "floors_aim", "scale": "floors_scale"}, pos: [200.0, 450.0]),
        "/stage_ascent/posts": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "post_wire", "position": "posts_place", "aim": "posts_aim", "scale": "posts_scale", "color": "posts_light"}, pos: [200.0, 700.0]),
        "/stage_ascent/hoops": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "hoop_wire", "position": "hoops_place", "aim": "hoops_aim", "scale": "hoops_scale", "color": "hoops_light"}, pos: [200.0, 900.0]),
        "/stage_ascent/tower": (kind: "geo.merge", inputs: {"in0": "storeys", "in1": "slabs", "in2": "posts", "in3": "hoops"}, pos: [400.0, 100.0]),
        "/stage_ascent/standing": (kind: "geo.transform", binds: {"rotate.0": "lie:turn_up"}, inputs: {"in": "tower"}, pos: [500.0, 100.0]),
        "/stage_ascent/scene": (kind: "geo.merge", inputs: {"in0": "standing", "in1": "floor", "in2": "mid", "in3": "ceiling"}, pos: [600.0, 250.0]),
        "/stage_ascent/presets": (kind: "table.text", params: {"format": "csv", "text": "height,pitch,roll,fov,side\n1.5,8,0,64,0\n1.3,14,0,62,0\n1.7,12,0,80,0\n1.6,3,0,56,0\n1.2,10,-8,66,-10\n1.8,6,10,68,12"}, pos: [-400.0, 1300.0]),
        "/stage_ascent/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "scene"}, pos: [800.0, 300.0]),
        "/stage_ascent/fade": (kind: "tex.shader", params: {"end": 24.0, "file": "library/stage_ascent/fade.wgsl", "start": 8.0}, binds: {"end": "shape:far"}, inputs: {"in0": "render", "in1": "render:data"}, pos: [1000.0, 300.0]),
        "/stage_ascent/palette": (kind: "tex.cross", params: {"cross": 0.0}, inputs: {"a": "warm", "b": "cold"}, binds: {"cross": "controls:warmth"}, pos: [0.0, -200.0]),
        "/stage_ascent/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1200.0, -500.0]),
        "/stage_ascent/energy": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1200.0, -900.0]),
        "/stage_ascent/energy_curve": (kind: "chan.math", params: {"b": 2.5, "op": "power"}, inputs: {"a": "energy"}, pos: [-1000.0, -900.0]),
        "/stage_ascent/energy_lift": (kind: "chan.math", params: {"b": 0.0, "op": "add"}, inputs: {"a": "energy_curve"}, pos: [-800.0, -900.0]),
        "/stage_ascent/nebula_lift_gain": (kind: "chan.math", params: {"b": 0.7, "op": "multiply"}, inputs: {"a": "energy_lift"}, pos: [-600.0, -900.0]),
        "/stage_ascent/nebula_lift": (kind: "chan.math", params: {"b": 0.8}, inputs: {"a": "nebula_lift_gain"}, pos: [-400.0, -900.0]),
        "/stage_ascent/preset": (kind: "chan.from_table", params: {"row": 0}, inputs: {"in": "presets"}, pos: [-200.0, 800.0]),
        "/stage_ascent/glide": (kind: "chan.filter", params: {"type": "critical", "rise": 1.5}, inputs: {"in": "preset"}, pos: [0.0, 800.0]),
        "/stage_ascent/angles": (kind: "chan.select", params: {"channels": "pitch side"}, inputs: {"in": "glide"}, pos: [200.0, 700.0]),
        "/stage_ascent/radians": (kind: "chan.math", params: {"b": 0.0174533, "op": "multiply"}, inputs: {"a": "angles"}, pos: [400.0, 700.0]),
        "/stage_ascent/radians_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "radians"}, pos: [600.0, 650.0]),
        "/stage_ascent/tan_third": (kind: "chan.math", params: {"b": 0.33333, "op": "multiply"}, inputs: {"a": "radians_sq"}, pos: [800.0, 650.0]),
        "/stage_ascent/tan_factor": (kind: "chan.math", params: {"b": 1.0, "op": "add"}, inputs: {"a": "tan_third"}, pos: [1000.0, 650.0]),
        "/stage_ascent/tangent": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "radians", "b": "tan_factor"}, pos: [1200.0, 700.0]),
        "/stage_ascent/reach": (kind: "chan.math", params: {"b": 10.0, "op": "multiply"}, inputs: {"a": "tangent"}, pos: [1400.0, 700.0]),
        "/stage_ascent/eye": (kind: "chan.select", params: {"channels": "height"}, inputs: {"in": "glide"}, pos: [200.0, 850.0]),
        "/stage_ascent/look": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "reach", "b": "eye"}, pos: [1600.0, 750.0]),
        "/stage_ascent/camera": (kind: "view.camera", params: {"far": 60.0, "fov": 60.0, "position": [0.0, 0.0, 1.5], "target": [0.0, 10.0, 1.15]}, binds: {"position.2": "eye:height", "target.0": "reach:side", "target.2": "look:pitch", "fov": "glide:fov", "roll": "glide:roll"}, pos: [600.0, 450.0]),
        "/stage_ascent/outside_camera": (kind: "view.camera", params: {"near": 5.0, "far": 5000.0, "fov": 60.0, "position": [0.0, 0.0, 1.5], "target": [0.0, 10.0, 1.15]}, binds: {"position.2": "eye:height", "target.0": "reach:side", "target.2": "look:pitch", "fov": "glide:fov", "roll": "glide:roll"}, pos: [600.0, 600.0]),
        "/stage_ascent/outside_show": (kind: "chan.constant", params: {"rows": 3, "name0": "sky", "value0": 1.0, "name1": "outside", "value1": 1.0, "name2": "tower", "value2": 1.0}, pos: [1000.0, 0.0]),
        "/stage_ascent/outside_render": (kind: "tex.render", inputs: {"camera": "outside_camera", "geo": "outside"}, pos: [800.0, 150.0]),
        "/stage_ascent/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}, pos: [-400.0, -300.0]),
        "/stage_ascent/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}, pos: [-400.0, -200.0]),
        "/stage_ascent/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}, pos: [-400.0, -100.0]),
        "/stage_ascent/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}, pos: [-200.0, -250.0]),
        "/stage_ascent/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}, pos: [-200.0, -150.0]),
        "/stage_ascent/cloud_drift": (kind: "chan.math", params: {"b": 0.004, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-1000.0, -600.0]),
        "/stage_ascent/swirl_drift": (kind: "chan.math", params: {"b": 0.002, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-1000.0, -450.0]),
        "/stage_ascent/clouds": (kind: "tex.noise", params: {"amplitude": 0.8, "frequency": 2.5, "octaves": 7, "offset": 0.3, "roughness": 0.62}, binds: {"translate.2": "cloud_drift:travelled"}, pos: [-800.0, -650.0]),
        "/stage_ascent/swirl": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 540, "seed": 7, "width": 960}, binds: {"translate.2": "swirl_drift:travelled"}, pos: [-800.0, -500.0]),
        "/stage_ascent/wisps": (kind: "tex.displace", params: {"extend": "mirror", "weight": [0.08, 0.08]}, inputs: {"in": "clouds", "map": "swirl"}, pos: [-600.0, -600.0]),
        "/stage_ascent/glow": (kind: "tex.level", params: {"black": 0.15, "gamma": 0.55, "white": 1.3}, inputs: {"in": "wisps"}, binds: {"brightness": "nebula_lift:energy_low"}, pos: [-400.0, -600.0]),
        "/stage_ascent/star_noise": (kind: "tex.noise", params: {"frequency": 360.0, "octaves": 1}, pos: [-600.0, -450.0]),
        "/stage_ascent/stars": (kind: "tex.level", params: {"black": 0.86}, inputs: {"in": "star_noise"}, pos: [-400.0, -450.0]),
        "/stage_ascent/nebula": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "glow", "in1": "stars"}, pos: [-200.0, -550.0]),
        "/stage_ascent/nebula_tinted": (kind: "tex.composite", params: {"op": "color"}, inputs: {"in0": "nebula", "in1": "palette"}, pos: [200.0, -500.0]),
        "/stage_ascent/nebula_dim": (kind: "tex.level", params: {"brightness": 0.45}, inputs: {"in": "nebula_tinted"}, pos: [400.0, -500.0]),
        "/stage_ascent/sky_over": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "nebula_dim", "in1": "sky"}, pos: [1000.0, -550.0]),
        "/stage_ascent/picture": (kind: "tex.composite", inputs: {"in0": "sky_over", "in1": "outside_render", "in2": "fade", "show": "outside_show"}, pos: [1200.0, -100.0]),
        "/stage_ascent/out": (kind: "tex.out", inputs: {"in": "picture"}, pos: [1400.0, -100.0]),
        "/stage_ascent/shape": (kind: "chan.constant", params: {"rows": 5, "name0": "axis", "value0": 1.5, "name1": "walls", "value1": 1.0, "name2": "curve", "value2": 0.0, "name3": "radius", "value3": 6.0, "name4": "far", "value4": 24.0}, binds: {"value3": "controls:radius", "value2": "curve:turn_up"}, pos: [0.0, 1050.0]),
        "/stage_ascent/pose_all": (kind: "chan.merge", inputs: {"in0": "glide", "in1": "shape"}, pos: [200.0, 1050.0]),
        "/stage_ascent/pose": (kind: "chan.out", inputs: {"in": "pose_all"}, pos: [400.0, 1050.0]),
        "/stage_ascent/turn_share": (kind: "chan.select", params: {"channels": "turn_up"}, inputs: {"in": "controls"}, pos: [-400.0, 1250.0]),
        "/stage_ascent/turn_from": (kind: "chan.math", params: {"b": -0.333333, "op": "add"}, inputs: {"a": "turn_share"}, pos: [-200.0, 1250.0]),
        "/stage_ascent/turn_span": (kind: "chan.math", params: {"b": 1.5, "op": "multiply"}, inputs: {"a": "turn_from"}, pos: [0.0, 1250.0]),
        "/stage_ascent/turn_low": (kind: "chan.math", params: {"b": 0.0, "op": "max"}, inputs: {"a": "turn_span"}, pos: [200.0, 1250.0]),
        "/stage_ascent/turn_part": (kind: "chan.math", params: {"b": 1.0, "op": "min"}, inputs: {"a": "turn_low"}, pos: [400.0, 1250.0]),
        "/stage_ascent/turn_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "turn_part", "b": "turn_part"}, pos: [600.0, 1190.0]),
        "/stage_ascent/turn_back": (kind: "chan.math", params: {"b": -2.0, "op": "multiply"}, inputs: {"a": "turn_part"}, pos: [600.0, 1310.0]),
        "/stage_ascent/turn_bend": (kind: "chan.math", params: {"b": 3.0, "op": "add"}, inputs: {"a": "turn_back"}, pos: [800.0, 1310.0]),
        "/stage_ascent/turned": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "turn_sq", "b": "turn_bend"}, pos: [1000.0, 1250.0]),
        "/stage_ascent/unturned": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "turned"}, pos: [1200.0, 1250.0]),
        "/stage_ascent/curve": (kind: "chan.math", params: {"b": 1.0, "op": "add"}, inputs: {"a": "unturned"}, pos: [1400.0, 1250.0]),
        "/stage_ascent/lie_degrees": (kind: "chan.math", params: {"b": 90.0, "op": "multiply"}, inputs: {"a": "turned"}, pos: [1200.0, 1350.0]),
        "/stage_ascent/lie": (kind: "chan.math", params: {"b": -90.0, "op": "add"}, inputs: {"a": "lie_degrees"}, pos: [1400.0, 1350.0]),
    },
)
