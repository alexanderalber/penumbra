// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/lantern": (kind: "comp.base", params: {"about": "A carved jack-o'-lantern face on a round object, curving with its surface.", "params": "@expose clock = face.clock\n@expose seek = face.seek\n@expose length = face.length\n@expose part = face.part\n@expose mouth = face.mouth\n@expose object = face.object\n@expose lid = face.lid\n@expose bright = face.bright\n@expose core = face.core\n@expose edge = face.edge\n@expose halo = face.halo\n@expose halo_width = face.halo_width\n@expose skin = face.skin\n@expose skin_color = face.skin_color\n@expose spill = face.spill\n@expose spill_radius = face.spill_radius\n@expose flicker = face.flicker\n@expose even = face.even\n@expose even_max = face.even_max\n@expose yaw = face.yaw\n@expose drop = face.drop\n@expose scale = face.scale\n@expose eye_size = face.eye_size\n@expose eye_apart = face.eye_apart\n@expose eye_height = face.eye_height\n@expose look_range = face.look_range\n@expose center = face.center\n@expose size = face.size\n@expose stem = face.stem", "shelf": "scanned objects"}),
        "/lantern/face": (kind: "tex.shader", params: {"file": "library/lantern/lantern.wgsl"}, inputs: {"in0": "labels", "in1": "regions", "in2": "photo"}),
        "/lantern/labels": (kind: "tex.in"),
        "/lantern/out": (kind: "tex.out", inputs: {"in": "face"}),
        "/lantern/photo": (kind: "tex.in"),
        "/lantern/regions": (kind: "tex.in"),
    },
)
