// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/room_lights": (kind: "comp.base", params: {"expose": "pattern = style.row\nwarmth = controls.value0\nintensity = controls.value1\ncolumns = look.columns\nbands = look.bands\nrise = look.rise\ntail = look.tail\nsnap = pulse.b\npatterns = patterns.text\npattern_glide = style_glide.rise\nwidth = look.width\nheight = look.height"}),
        "/room_lights/bus": (kind: "chan.in", pos: [-1400.0, 0.0]),
        "/room_lights/controls": (kind: "chan.constant", params: {"rows": 2, "name0": "warmth", "value0": 0.0, "name1": "intensity", "value1": 1.0}, pos: [-1400.0, 400.0]),
        "/room_lights/patterns": (kind: "table.text", params: {"format": "csv", "text": "stripes,pulse,chase\n1,0,0\n0,1,0\n0,0,1"}, pos: [-1400.0, -300.0]),
        "/room_lights/style": (kind: "chan.from_table", params: {"row": 0}, inputs: {"in": "patterns"}, pos: [-1200.0, -300.0]),
        "/room_lights/style_glide": (kind: "chan.filter", params: {"type": "critical", "rise": 0.4}, inputs: {"in": "style"}, pos: [-1000.0, -300.0]),
        "/room_lights/phase": (kind: "chan.select", params: {"channels": "beat"}, inputs: {"in": "bus"}, pos: [-1200.0, 0.0]),
        "/room_lights/fall": (kind: "chan.math", params: {"op": "multiply", "b": -1.0}, inputs: {"a": "phase"}, pos: [-1000.0, 0.0]),
        "/room_lights/rise": (kind: "chan.math", params: {"op": "add", "b": 1.0}, inputs: {"a": "fall"}, pos: [-800.0, 0.0]),
        "/room_lights/pulse": (kind: "chan.math", params: {"op": "power", "b": 3.0}, inputs: {"a": "rise"}, pos: [-600.0, 0.0]),
        "/room_lights/warm": (kind: "chan.constant", params: {"rows": 6, "name0": "red", "value0": 1.0, "name1": "green", "value1": 0.38, "name2": "blue", "value2": 0.05, "name3": "red2", "value3": 0.85, "name4": "green2", "value4": 0.05, "name5": "blue2", "value5": 0.3}, pos: [-1400.0, 200.0]),
        "/room_lights/mid": (kind: "chan.constant", params: {"rows": 6, "name0": "red", "value0": 1.0, "name1": "green", "value1": 0.12, "name2": "blue", "value2": 0.55, "name3": "red2", "value3": 0.45, "name4": "green2", "value4": 0.04, "name5": "blue2", "value5": 0.85}, pos: [-1400.0, 250.0]),
        "/room_lights/cold": (kind: "chan.constant", params: {"rows": 6, "name0": "red", "value0": 0.1, "name1": "green", "value1": 0.75, "name2": "blue", "value2": 1.0, "name3": "red2", "value3": 0.1, "name4": "green2", "value4": 0.3, "name5": "blue2", "value5": 1.0}, pos: [-1400.0, 300.0]),
        "/room_lights/double": (kind: "chan.math", params: {"op": "multiply", "b": 2.0}, inputs: {"a": "warmth"}, pos: [-1000.0, 450.0]),
        "/room_lights/first": (kind: "chan.math", params: {"op": "min", "b": 1.0}, inputs: {"a": "double"}, pos: [-800.0, 450.0]),
        "/room_lights/beyond": (kind: "chan.math", params: {"op": "subtract", "b": 1.0}, inputs: {"a": "double"}, pos: [-800.0, 500.0]),
        "/room_lights/second": (kind: "chan.math", params: {"op": "max", "b": 0.0}, inputs: {"a": "beyond"}, pos: [-600.0, 500.0]),
        "/room_lights/to_mid": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "mid", "b": "warm"}, pos: [-1200.0, 200.0]),
        "/room_lights/to_cold": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "cold", "b": "mid"}, pos: [-1200.0, 300.0]),
        "/room_lights/step1": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "to_mid", "b": "first"}, pos: [-1000.0, 200.0]),
        "/room_lights/step2": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "to_cold", "b": "second"}, pos: [-1000.0, 300.0]),
        "/room_lights/half_way": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "warm", "b": "step1"}, pos: [-800.0, 200.0]),
        "/room_lights/palette": (kind: "chan.math", params: {"op": "add"}, inputs: {"a": "half_way", "b": "step2"}, pos: [-600.0, 250.0]),
        "/room_lights/warmth": (kind: "chan.select", params: {"channels": "warmth"}, inputs: {"in": "controls"}, pos: [-1200.0, 400.0]),
        "/room_lights/intensity": (kind: "chan.select", params: {"channels": "intensity"}, inputs: {"in": "controls"}, pos: [-1200.0, 500.0]),
        "/room_lights/pump": (kind: "chan.math", params: {"op": "multiply", "b": 0.75}, inputs: {"a": "pulse"}, pos: [-400.0, 100.0]),
        "/room_lights/pump_base": (kind: "chan.math", params: {"op": "add", "b": 0.25}, inputs: {"a": "pump"}, pos: [-200.0, 100.0]),
        "/room_lights/level_raw": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "pump_base", "b": "intensity"}, pos: [0.0, 100.0]),
        "/room_lights/level": (kind: "chan.rename", params: {"names": "beat=level"}, inputs: {"in": "level_raw"}, pos: [200.0, 100.0]),
        "/room_lights/music": (kind: "chan.select", params: {"channels": "build drop phrase"}, inputs: {"in": "bus"}, pos: [-1200.0, 600.0]),
        "/room_lights/all": (kind: "chan.merge", inputs: {"in0": "palette", "in1": "level", "in2": "pulse", "in3": "controls", "in4": "music"}, pos: [400.0, 250.0]),
        "/room_lights/look": (kind: "tex.shader", params: {"file": "library/room_lights/room.wgsl", "resolution": "custom", "width": 1024, "height": 512, "keep_size": true, "columns": 4, "bands": 6.0, "rise": 0.25, "tail": 1.5, "stripes": 1.0, "pulse": 0.0, "chase": 0.0, "intensity": 1.0}, binds: {"stripes": "style_glide:stripes", "pulse": "style_glide:pulse", "chase": "style_glide:chase", "flash": "pulse:beat", "beats": "bus:travelled", "phase": "bus:beat", "beat_index": "bus:beat_index", "bar_index": "bus:bar_index", "phrase_bar": "bus:phrase_bar", "phrase": "bus:phrase", "build": "bus:build", "intensity": "controls:intensity", "red": "palette:red", "green": "palette:green", "blue": "palette:blue", "red2": "palette:red2", "green2": "palette:green2", "blue2": "palette:blue2"}, pos: [0.0, -200.0]),
        "/room_lights/pattern": (kind: "tex.out", inputs: {"in": "look"}, pos: [400.0, -200.0]),
        "/room_lights/colours": (kind: "chan.out", inputs: {"in": "all"}, pos: [600.0, 250.0]),
    },
)
