// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_cracks": (kind: "comp.base", params: {"about": "Glowing cracks in the floor, like lava under a crust.", "params": "@expose presence = glow.presence\n@expose seed = glow.seed\n@expose bass = glow.bass\n@expose cell = glow.cell\n@expose thickness = glow.thickness\n@expose glow = glow.glow\n@expose flow = glow.flow\n@expose pulse = glow.pulse\n@expose color = glow.color\n@expose hot = glow.hot\n@expose brightness = glow.brightness\n@expose lane = glow.lane\n@expose fade = glow.fade\n@expose gone = glow.gone\n@expose smooth = level.fall", "shelf": "music stage/floor"}),
        "/floor_cracks/bus": (kind: "chan.in", pos: [-800.0, 0.0]),
        "/floor_cracks/lane": (kind: "tex.in", pos: [-800.0, 150.0]),
        "/floor_cracks/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-600.0, -150.0]),
        "/floor_cracks/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.3}, inputs: {"in": "bass"}, pos: [-400.0, -150.0]),
        "/floor_cracks/glow": (kind: "tex.shader", params: {"file": "library/floor_cracks/cracks.wgsl", "resolution": "custom", "width": 1280, "height": 1024, "keep_size": true, "presence": 1.0, "seed": 1, "bass": 0.7, "cell": 1.6, "thickness": 0.045, "glow": 0.15, "flow": 0.6, "pulse": 3.0, "brightness": 1.6, "lane": 1.6, "left": -10.0, "right": 10.0, "near": -2.0, "far": 14.0, "fade": 7.0, "gone": 11.0}, inputs: {"in0": "lane"}, binds: {"beats": "bus:travelled", "low": "level:energy_low"}, pos: [-200.0, 0.0]),
        "/floor_cracks/sheet_mat": (kind: "mat.constant", inputs: {"texture": "glow"}, pos: [0.0, 0.0]),
        "/floor_cracks/plane": (kind: "geo.primitive", params: {"shape": "plane", "size": [20.0, 1.0, 16.0]}, pos: [-200.0, -300.0]),
        "/floor_cracks/sheet": (kind: "geo.assign_material", inputs: {"in": "plane", "mat": "sheet_mat"}, pos: [0.0, -200.0]),
        "/floor_cracks/lay": (kind: "geo.transform", params: {"rotate": [-90.0, 0.0, 0.0], "translate": [0.0, 6.0, 0.012]}, inputs: {"in": "sheet"}, pos: [200.0, -100.0]),
        "/floor_cracks/out": (kind: "geo.out", inputs: {"in": "lay"}, pos: [400.0, 0.0]),
    },
)
