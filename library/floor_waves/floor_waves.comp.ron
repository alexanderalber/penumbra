// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_waves": (kind: "comp.base", params: {"expose": "presence = field.presence\nsource = field.source\nseed = field.seed\nheight = field.tall\nbass = field.bass\ncrests = field.crests\nflow = field.flow\nspacing = field.spacing\nspread = field.spread\nlane = field.lane\nfoot = field.foot\nnear = field.near\nfar = field.far\nsmooth = levels.fall\ncolor = wave_lines.color\nline_width = wave_lines.line_width\nextent = waves.extent"}),
        "/floor_waves/bus": (kind: "chan.in", pos: [-1000.0, 0.0]),
        "/floor_waves/lane": (kind: "tex.in", pos: [-1000.0, 150.0]),
        "/floor_waves/bands": (kind: "chan.select", params: {"channels": "energy_low energy_mid energy_high"}, inputs: {"in": "bus"}, pos: [-800.0, -150.0]),
        "/floor_waves/levels": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.1, "fall": 0.4}, inputs: {"in": "bands"}, pos: [-600.0, -150.0]),
        "/floor_waves/field": (kind: "tex.shader", params: {"file": "library/floor_waves/field.wgsl", "resolution": "custom", "width": 65, "height": 48, "keep_size": true, "presence": 1.0, "source": "noise", "seed": 1, "tall": 1.2, "bass": 0.6, "crests": 2.5, "flow": 0.15, "spacing": 0.3, "spread": 20.0, "lane": 1.6, "foot": 1.5, "near": -1.0, "far": 13.0}, inputs: {"in0": "lane"}, binds: {"beats": "bus:travelled", "low": "levels:energy_low", "mid": "levels:energy_mid", "high": "levels:energy_high"}, pos: [-400.0, 0.0]),
        "/floor_waves/places": (kind: "tex.shader", params: {"file": "library/floor_waves/segments.wgsl", "resolution": "custom", "width": 64, "height": 48, "keep_size": true, "what": "place"}, inputs: {"in0": "field"}, pos: [-200.0, -100.0]),
        "/floor_waves/heading": (kind: "tex.shader", params: {"file": "library/floor_waves/segments.wgsl", "resolution": "custom", "width": 64, "height": 48, "keep_size": true, "what": "aim"}, inputs: {"in0": "field"}, pos: [-200.0, 50.0]),
        "/floor_waves/sizes": (kind: "tex.shader", params: {"file": "library/floor_waves/segments.wgsl", "resolution": "custom", "width": 64, "height": 48, "keep_size": true, "what": "scale"}, inputs: {"in0": "field"}, pos: [-200.0, 200.0]),
        "/floor_waves/light": (kind: "tex.shader", params: {"file": "library/floor_waves/segments.wgsl", "resolution": "custom", "width": 64, "height": 48, "keep_size": true, "what": "light"}, inputs: {"in0": "field"}, pos: [-200.0, 350.0]),
        "/floor_waves/segment": (kind: "geo.file", params: {"file": "library/floor_waves/segment.obj", "up": "z"}, pos: [-800.0, -450.0]),
        "/floor_waves/curtain": (kind: "geo.file", params: {"file": "library/floor_waves/curtain.obj", "up": "z"}, pos: [-800.0, -600.0]),
        "/floor_waves/wave_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-600.0, -350.0]),
        "/floor_waves/wave_wire": (kind: "geo.assign_material", inputs: {"in": "segment", "mat": "wave_lines"}, pos: [-400.0, -400.0]),
        "/floor_waves/cover_mat": (kind: "mat.occluder", pos: [-600.0, -550.0]),
        "/floor_waves/cover": (kind: "geo.assign_material", inputs: {"in": "curtain", "mat": "cover_mat"}, pos: [-400.0, -550.0]),
        "/floor_waves/model": (kind: "geo.merge", inputs: {"in0": "wave_wire", "in1": "cover"}, pos: [-200.0, -450.0]),
        "/floor_waves/waves": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "model", "position": "places", "aim": "heading", "scale": "sizes", "color": "light"}, pos: [0.0, 0.0]),
        "/floor_waves/out": (kind: "geo.out", inputs: {"in": "waves"}, pos: [200.0, 0.0]),
    },
)
