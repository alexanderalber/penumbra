// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_gates": (kind: "comp.base", params: {"expose": "presence = controls.value0\nseed = controls.value1\nheight = controls.value2\nthick = controls.value3\nlight = controls.value4\npulse = controls.value5\nlane = controls.value6\nclear = controls.value7\nswing = controls.value8\nevery = controls.value9\nnear = controls.value10\nfar = controls.value11\nwarmth = controls.value12\ngroove = controls.value13\nsmooth = level.fall"}, pos: [0.0, 0.0]),
        "/floor_gates/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_gates/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_gates/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/floor_gates/controls": (kind: "chan.constant", params: {"rows": 14, "name0": "presence", "value0": 1.0, "name1": "seed", "value1": 0.0, "name2": "tall", "value2": 3.8, "name3": "thick", "value3": 0.6, "name4": "light", "value4": 1.0, "name5": "pulse", "value5": 0.25, "name6": "lane", "value6": 1.6, "name7": "clear", "value7": 0.3, "name8": "swing", "value8": 0.9, "name9": "every", "value9": 2.0, "name10": "near", "value10": -6.0, "name11": "far", "value11": 40.0, "name12": "warmth", "value12": 0.0, "name13": "groove", "value13": 1.0}, pos: [-1200.0, 450.0]),
        "/floor_gates/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_gates/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.5}, inputs: {"in": "bass"}, pos: [-800.0, -150.0]),
        "/floor_gates/place": (kind: "tex.shader", params: {"file": "library/floor_gates/gates.wgsl", "resolution": "custom", "width": 1, "height": 6, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 3.8, "thick": 0.6, "light": 1.0, "pulse": 0.25, "lane": 1.6, "clear": 0.3, "swing": 0.9, "every": 2.0, "near": -6.0, "far": 40.0, "warmth": 0.0, "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "swing": "controls:swing", "every": "controls:every", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, -100.0]),
        "/floor_gates/aim": (kind: "tex.shader", params: {"file": "library/floor_gates/gates.wgsl", "resolution": "custom", "width": 1, "height": 6, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 3.8, "thick": 0.6, "light": 1.0, "pulse": 0.25, "lane": 1.6, "clear": 0.3, "swing": 0.9, "every": 2.0, "near": -6.0, "far": 40.0, "warmth": 0.0, "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "swing": "controls:swing", "every": "controls:every", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 30.0]),
        "/floor_gates/size": (kind: "tex.shader", params: {"file": "library/floor_gates/gates.wgsl", "resolution": "custom", "width": 1, "height": 6, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 3.8, "thick": 0.6, "light": 1.0, "pulse": 0.25, "lane": 1.6, "clear": 0.3, "swing": 0.9, "every": 2.0, "near": -6.0, "far": 40.0, "warmth": 0.0, "what": "size"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "swing": "controls:swing", "every": "controls:every", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 160.0]),
        "/floor_gates/rim": (kind: "tex.shader", params: {"file": "library/floor_gates/gates.wgsl", "resolution": "custom", "width": 1, "height": 6, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 3.8, "thick": 0.6, "light": 1.0, "pulse": 0.25, "lane": 1.6, "clear": 0.3, "swing": 0.9, "every": 2.0, "near": -6.0, "far": 40.0, "warmth": 0.0, "what": "rim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "swing": "controls:swing", "every": "controls:every", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 290.0]),
        "/floor_gates/glow": (kind: "tex.shader", params: {"file": "library/floor_gates/gates.wgsl", "resolution": "custom", "width": 1, "height": 6, "keep_size": true, "presence": 1.0, "seed": 0, "tall": 3.8, "thick": 0.6, "light": 1.0, "pulse": 0.25, "lane": 1.6, "clear": 0.3, "swing": 0.9, "every": 2.0, "near": -6.0, "far": 40.0, "warmth": 0.0, "what": "glow"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "seed": "controls:seed", "tall": "controls:tall", "thick": "controls:thick", "light": "controls:light", "pulse": "controls:pulse", "lane": "controls:lane", "clear": "controls:clear", "swing": "controls:swing", "every": "controls:every", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "drift": "bus:drift", "beat": "bus:beat", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 420.0]),
        "/floor_gates/face": (kind: "tex.shader", params: {"file": "library/floor_gates/face.wgsl", "resolution": "custom", "width": 2048, "height": 1024, "keep_size": true, "seed": 0, "groove": 1.0}, binds: {"seed": "controls:seed", "groove": "controls:groove"}, pos: [-1000.0, -900.0]),
        "/floor_gates/face_mat": (kind: "mat.constant", inputs: {"texture": "face"}, pos: [-800.0, -900.0]),
        "/floor_gates/gate_body_file": (kind: "geo.file", params: {"file": "library/floor_gates/gate_body.obj", "up": "z"}, pos: [-1000.0, -700.0]),
        "/floor_gates/gate_body_mat": (kind: "geo.assign_material", inputs: {"in": "gate_body_file", "mat": "face_mat"}, pos: [-800.0, -700.0]),
        "/floor_gates/gate_body": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "gate_body_mat", "position": "place", "aim": "aim", "scale": "size", "color": "rim"}, pos: [-300.0, -200.0]),
        "/floor_gates/gate_face_file": (kind: "geo.file", params: {"file": "library/floor_gates/gate_face.obj", "up": "z"}, pos: [-1000.0, -500.0]),
        "/floor_gates/gate_face_mat": (kind: "geo.assign_material", inputs: {"in": "gate_face_file", "mat": "face_mat"}, pos: [-800.0, -500.0]),
        "/floor_gates/gate_face": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"in": "gate_face_mat", "position": "place", "aim": "aim", "scale": "size", "color": "glow"}, pos: [-300.0, 0.0]),
        "/floor_gates/all": (kind: "geo.merge", inputs: {"in0": "gate_body", "in1": "gate_face"}, pos: [-100.0, 0.0]),
        "/floor_gates/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [100.0, 0.0]),
    },
)
