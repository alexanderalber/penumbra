// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/pulse": (kind: "comp.base", params: {"expose": "speed = beat.speed\nstagger = beat.stagger\nscatter = beat.scatter\ndepth = beat.depth\ncount = colours.count\nc0 = colours.c0\nc1 = colours.c1\nc2 = colours.c2\nc3 = colours.c3\nc4 = colours.c4\npalette = colours.palette\ngain = colours.gain\nbrightness = dim.brightness\nwidth = shapes.width\nheight = shapes.height"}),
        "/pulse/beat": (kind: "tex.shape_content", params: {"mode": "pulse", "speed": 0.1, "stagger": 0.0625, "scatter": 0.0, "depth": 1.0, "variety": 0.7, "color_a": [1.0, 0.75, 0.4, 1.0], "color_b": [0.35, 0.55, 1.0, 1.0]}, inputs: {"id": "shapes:id"}),
        "/pulse/colours": (kind: "tex.shader", params: {"file": "library/pulse/colours.wgsl"}, inputs: {"in0": "masked", "in1": "labels", "in2": "gate"}),
        "/pulse/dim": (kind: "tex.level", params: {"brightness": 0.7}, inputs: {"in": "colours"}),
        "/pulse/faces": (kind: "tex.shader", params: {"file": "library/pulse/faces_only.wgsl"}, inputs: {"in0": "labels"}),
        "/pulse/gate": (kind: "tex.in"),
        "/pulse/labels": (kind: "tex.in"),
        "/pulse/masked": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "beat", "in1": "faces"}),
        "/pulse/out": (kind: "tex.out", inputs: {"in": "dim"}),
        "/pulse/shapes": (kind: "tex.shapes", params: {"width": 1920, "height": 1080, "keep_size": true, "trace_channel": "red", "trace_labels": true, "trace_min_area": 400.0, "trace_tolerance": 2.5}, inputs: {"trace": "labels"}),
    },
)
