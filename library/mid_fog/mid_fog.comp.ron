// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_fog": (kind: "comp.base", params: {"expose": "presence = places.presence\ncount = places.count\nseed = places.seed\nspread = places.spread\nlow = places.low\nhigh = places.high\nsway = places.sway\nnear = places.near\nfar = places.far\nwidth = scale.across\nheight = scale.tall\nbrightness = light.brightness\nquiet = light.quiet\nfade = light.fade\nstart = light.start\nend = light.end\ndetail = wisps.detail\nthickness = wisps.thickness\ncover = wisps.cover\nline_width = bank_lines.line_width\ncolor = bank_lines.color"}),
        "/mid_fog/bus": (kind: "chan.in", pos: [-800.0, 0.0]),
        "/mid_fog/lane": (kind: "tex.in", pos: [-800.0, 150.0]),
        "/mid_fog/places": (kind: "tex.shader", params: {"file": "library/mid_fog/banks.wgsl", "resolution": "custom", "width": 4, "height": 3, "keep_size": true, "presence": 1.0, "count": 8, "seed": 0, "spread": 1.5, "low": 0.8, "high": 2.6, "sway": 0.6, "near": -1.0, "far": 8.0}, inputs: {"in0": "lane"}, binds: {"beats": "bus:travelled"}, pos: [-600.0, 100.0]),
        "/mid_fog/scale": (kind: "tex.shader", params: {"file": "library/mid_fog/look.wgsl", "what": "scale", "across": 6.0, "tall": 1.6}, inputs: {"in0": "places"}, pos: [-400.0, 150.0]),
        "/mid_fog/light": (kind: "tex.shader", params: {"file": "library/mid_fog/look.wgsl", "what": "light", "brightness": 4.0, "quiet": 0.25, "fade": 3.0, "start": 2.5, "end": 7.0}, inputs: {"in0": "places"}, binds: {"bass": "bus:energy_low"}, pos: [-400.0, 250.0]),
        "/mid_fog/wisps": (kind: "tex.shader", params: {"file": "library/mid_fog/wisps.wgsl", "resolution": "custom", "width": 256, "height": 128, "keep_size": true, "detail": 3.0, "thickness": 0.8, "cover": 0.04}, binds: {"drift": "bus:travelled"}, pos: [-800.0, -250.0]),
        "/mid_fog/hatch": (kind: "geo.file", params: {"file": "library/mid_fog/hatch.obj", "up": "z"}, pos: [-600.0, -350.0]),
        "/mid_fog/bank_lines": (kind: "mat.wireframe", params: {"line_width": 1.5}, inputs: {"texture": "wisps"}, pos: [-600.0, -200.0]),
        "/mid_fog/bank_wire": (kind: "geo.assign_material", inputs: {"in": "hatch", "mat": "bank_lines"}, pos: [-400.0, -250.0]),
        "/mid_fog/banks": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "bank_wire", "position": "places", "scale": "scale", "color": "light"}, pos: [0.0, 0.0]),
        "/mid_fog/out": (kind: "geo.out", inputs: {"in": "banks"}, pos: [200.0, 0.0]),
    },
)
