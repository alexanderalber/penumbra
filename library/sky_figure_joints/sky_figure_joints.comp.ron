// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_figure_joints": (kind: "comp.base", params: {"expose": "presence = figure.presence
brightness = figure.brightness
warmth = figure.warmth
tall = figure.tall
place = figure.place
tube = figure.tube
thickness = figure.thickness
dots = figure.dots
bones = figure.bones
pulse = figure.pulse
glow = figure.glow
reach = figure.reach
ring = figure.ring"}),
        "/sky_figure_joints/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/sky_figure_joints/pose": (kind: "chan.in", pos: [-600.0, 150.0]),
        "/sky_figure_joints/figure": (kind: "tex.shader", params: {"file": "library/sky_figure_joints/joints.wgsl", "resolution": "custom", "presence": 1.0, "brightness": 1.0, "warmth": 0.0, "place": 0.0, "reach": 10.0, "ring": 0.17, "tall": 0.42, "thickness": 1.2, "dots": 0.016, "bones": 0.3, "pulse": 1.0, "glow": 1.0}, binds: {"beats": "bus:travelled", "bar": "bus:bar", "bar_index": "bus:bar_index", "build": "bus:build", "drop": "bus:drop", "role": "bus:section_role", "energy": "bus:energy_low", "eye": "pose:height", "pitch": "pose:pitch", "fov": "pose:fov", "roll": "pose:roll", "side": "pose:side", "bend": "pose:curve"}, pos: [-300.0, 0.0]),
        "/sky_figure_joints/out": (kind: "tex.out", inputs: {"in": "figure"}, pos: [0.0, 0.0]),
    },
)
