// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_cenote": (kind: "comp.base", params: {"about": "A low ring of broken rock in stage_valley's lake.", "params": "@expose at1 = controls.value0\n@expose at2 = controls.value1\n@expose at3 = controls.value2\n@expose radius = controls.value3\n@expose rim = controls.value4\n@expose side = controls.value5\n@expose light = controls.value6\n@expose flash = controls.value7\n@expose idle = controls.value8\n@expose decay = controls.value9\n@expose shaft_height = controls.value10\n@expose shaft_light = controls.value11\n@expose near = controls.value12\n@expose far = controls.value13\n@expose warmth = controls.value14\n@expose margin = controls.value15\n@expose smooth = level.fall", "shelf": "music stage/floor"}, pos: [0.0, 0.0]),
        "/floor_cenote/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_cenote/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_cenote/pose": (kind: "chan.in", pos: [-1200.0, 300.0]),
        "/floor_cenote/controls": (kind: "chan.constant", params: {"rows": 16, "name0": "at1", "value0": 0.0, "name1": "at2", "value1": 0.0, "name2": "at3", "value2": 0.0, "name3": "radius", "value3": 5.0, "name4": "rim", "value4": 0.6, "name5": "side", "value5": 0.0, "name6": "light", "value6": 1.0, "name7": "flash", "value7": 3.0, "name8": "idle", "value8": 0.12, "name9": "decay", "value9": 1.5, "name10": "shaft_height", "value10": 18.0, "name11": "shaft_light", "value11": 0.5, "name12": "near", "value12": -14.0, "name13": "far", "value13": 42.0, "name14": "warmth", "value14": 0.0, "name15": "margin", "value15": 2.0}, pos: [-1200.0, 450.0]),
        "/floor_cenote/bass": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/floor_cenote/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.5}, inputs: {"in": "bass"}, pos: [-800.0, -150.0]),
        "/floor_cenote/place_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "place"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, -200.0]),
        "/floor_cenote/size_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "size"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, -80.0]),
        "/floor_cenote/rim_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "rim"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 40.0]),
        "/floor_cenote/wall_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "wall"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 160.0]),
        "/floor_cenote/pool_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "pool"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 280.0]),
        "/floor_cenote/shaft_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "shaft"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 400.0]),
        "/floor_cenote/shaft_light_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "what": "shaft_light"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 520.0]),
        "/floor_cenote/hot_place_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 7, "height": 1, "keep_size": true, "what": "hot_place"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 640.0]),
        "/floor_cenote/hot_size_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 7, "height": 1, "keep_size": true, "what": "hot_size"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 760.0]),
        "/floor_cenote/hot_light_tex": (kind: "tex.shader", params: {"file": "library/floor_cenote/cenote.wgsl", "resolution": "custom", "width": 7, "height": 1, "keep_size": true, "what": "hot_light"}, inputs: {"in0": "lane"}, binds: {"at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "rim": "controls:rim", "side": "controls:side", "light": "controls:light", "flash": "controls:flash", "idle": "controls:idle", "decay": "controls:decay", "shaft_height": "controls:shaft_height", "shaft_light": "controls:shaft_light", "near": "controls:near", "far": "controls:far", "warmth": "controls:warmth", "beats": "bus:travelled", "beat": "bus:beat", "beat_index": "bus:beat_index", "bass": "level:energy_low", "dawn": "pose:dawn", "swell": "pose:swell"}, pos: [-600.0, 880.0]),
        "/floor_cenote/clear": (kind: "tex.shader", params: {"file": "library/floor_cenote/clear.wgsl", "resolution": "custom", "width": 256, "height": 1, "keep_size": true}, inputs: {"in0": "lane"}, binds: {"beats": "bus:travelled", "at1": "controls:at1", "at2": "controls:at2", "at3": "controls:at3", "radius": "controls:radius", "margin": "controls:margin"}, pos: [-600.0, -500.0]),
        "/floor_cenote/cleared": (kind: "tex.out", inputs: {"in": "clear"}, pos: [100.0, -500.0]),
        "/floor_cenote/stone_pic": (kind: "tex.shader", params: {"file": "library/floor_cenote/stone.wgsl", "resolution": "custom", "width": 512, "height": 256, "keep_size": true}, pos: [-1000.0, -1500.0]),
        "/floor_cenote/stone_mat": (kind: "mat.constant", inputs: {"texture": "stone_pic"}, pos: [-800.0, -1500.0]),
        "/floor_cenote/water_pic": (kind: "tex.shader", params: {"file": "library/floor_cenote/pool.wgsl", "resolution": "custom", "width": 1024, "height": 1024, "keep_size": true}, pos: [-1000.0, -1300.0]),
        "/floor_cenote/water_mat": (kind: "mat.constant", inputs: {"texture": "water_pic"}, pos: [-800.0, -1300.0]),
        "/floor_cenote/spot_pic": (kind: "tex.shader", params: {"file": "library/floor_cenote/hot.wgsl", "resolution": "custom", "width": 128, "height": 128, "keep_size": true}, pos: [-1000.0, -1100.0]),
        "/floor_cenote/spot_mat": (kind: "mat.constant", inputs: {"texture": "spot_pic"}, pos: [-800.0, -1100.0]),
        "/floor_cenote/glow_pic": (kind: "tex.shader", params: {"file": "library/floor_cenote/shaft.wgsl", "resolution": "custom", "width": 256, "height": 512, "keep_size": true}, pos: [-1000.0, -900.0]),
        "/floor_cenote/glow_mat": (kind: "mat.constant", inputs: {"texture": "glow_pic"}, pos: [-800.0, -900.0]),
        "/floor_cenote/ring_file": (kind: "geo.file", params: {"file": "library/floor_cenote/ring.obj", "up": "z"}, pos: [-1000.0, -700.0]),
        "/floor_cenote/ring_model": (kind: "geo.assign_material", inputs: {"in": "ring_file", "mat": "stone_mat"}, pos: [-800.0, -700.0]),
        "/floor_cenote/ring": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"position": "place_tex", "scale": "size_tex", "color": "rim_tex", "in": "ring_model"}, pos: [-300.0, -700.0]),
        "/floor_cenote/inner_file": (kind: "geo.file", params: {"file": "library/floor_cenote/inner.obj", "up": "z"}, pos: [-1000.0, -500.0]),
        "/floor_cenote/inner_model": (kind: "geo.assign_material", inputs: {"in": "inner_file", "mat": "stone_mat"}, pos: [-800.0, -500.0]),
        "/floor_cenote/inner": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"position": "place_tex", "scale": "size_tex", "color": "wall_tex", "in": "inner_model"}, pos: [-300.0, -500.0]),
        "/floor_cenote/disc_file": (kind: "geo.file", params: {"file": "library/floor_cenote/pool.obj", "up": "z"}, pos: [-1000.0, -300.0]),
        "/floor_cenote/disc_model": (kind: "geo.assign_material", inputs: {"in": "disc_file", "mat": "water_mat"}, pos: [-800.0, -300.0]),
        "/floor_cenote/disc": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"position": "place_tex", "scale": "size_tex", "color": "pool_tex", "in": "disc_model"}, pos: [-300.0, -300.0]),
        "/floor_cenote/hots_file": (kind: "geo.file", params: {"file": "library/floor_cenote/hot.obj", "up": "z"}, pos: [-1000.0, -100.0]),
        "/floor_cenote/hots_model": (kind: "geo.assign_material", inputs: {"in": "hots_file", "mat": "spot_mat"}, pos: [-800.0, -100.0]),
        "/floor_cenote/hots": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"position": "hot_place_tex", "scale": "hot_size_tex", "color": "hot_light_tex", "in": "hots_model"}, pos: [-300.0, -100.0]),
        "/floor_cenote/beam_file": (kind: "geo.file", params: {"file": "library/floor_cenote/shaft.obj", "up": "z"}, pos: [-1000.0, 100.0]),
        "/floor_cenote/beam_model": (kind: "geo.assign_material", inputs: {"in": "beam_file", "mat": "glow_mat"}, pos: [-800.0, 100.0]),
        "/floor_cenote/beam": (kind: "geo.tex_instance", params: {"extent": 60.0}, inputs: {"position": "place_tex", "scale": "shaft_tex", "color": "shaft_light_tex", "in": "beam_model"}, pos: [-300.0, 100.0]),
        "/floor_cenote/all": (kind: "geo.merge", inputs: {"in0": "ring", "in1": "inner", "in2": "disc", "in3": "hots", "in4": "beam"}, pos: [-100.0, 0.0]),
        "/floor_cenote/out": (kind: "geo.out", inputs: {"in": "all"}, pos: [100.0, 0.0]),
    },
)
