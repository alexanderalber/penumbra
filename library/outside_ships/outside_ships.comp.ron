// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/outside_ships": (kind: "comp.base", params: {"expose": "presence = controls.value0\nwarmth = controls.value1\nbrightness = controls.value2\nships = controls.value3\ncross = controls.value4\nrest = controls.value5\nnear = controls.value6\nfar = controls.value7\nlength = controls.value8\nsink = controls.value9\nstorey = controls.value10\nstorey_beats = controls.value11\nblink = controls.value12\nseed = controls.value13\nline_width = hull_lines.line_width"}),
        "/outside_ships/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/outside_ships/pose": (kind: "chan.in", pos: [-1200.0, 450.0]),
        "/outside_ships/controls": (kind: "chan.constant", params: {"rows": 14, "name0": "presence", "value0": 1.0, "name1": "warmth", "value1": 0.0, "name2": "brightness", "value2": 1.0, "name3": "ships", "value3": 4.0, "name4": "cross", "value4": 384.0, "name5": "rest", "value5": 256.0, "name6": "near", "value6": 150.0, "name7": "far", "value7": 340.0, "name8": "length", "value8": 200.0, "name9": "sink", "value9": 0.15, "name10": "storey", "value10": 3.0, "name11": "storey_beats", "value11": 4.0, "name12": "blink", "value12": 2.0, "name13": "seed", "value13": 0.0}, pos: [-1200.0, 250.0]),
        "/outside_ships/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1000.0, -200.0]),
        "/outside_ships/phase": (kind: "chan.math", params: {"b": 1.0, "op": "modulo"}, inputs: {"a": "travelled"}, pos: [-800.0, -250.0]),
        "/outside_ships/whole": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "travelled", "b": "phase"}, pos: [-800.0, -150.0]),
        "/outside_ships/presence": (kind: "chan.select", params: {"channels": "presence"}, inputs: {"in": "controls"}, pos: [-1000.0, 650.0]),
        "/outside_ships/curve": (kind: "chan.select", params: {"channels": "curve"}, inputs: {"in": "pose"}, pos: [-1000.0, 750.0]),
        "/outside_ships/bent": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "curve"}, pos: [-800.0, 750.0]),
        "/outside_ships/straight": (kind: "chan.math", params: {"b": 1.0}, inputs: {"a": "bent"}, pos: [-600.0, 750.0]),
        "/outside_ships/there": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "presence", "b": "straight"}, pos: [-400.0, 700.0]),
        "/outside_ships/place": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "place"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, -600.0]),
        "/outside_ships/aim": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "aim"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, -480.0]),
        "/outside_ships/size_a": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "size_a"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, -360.0]),
        "/outside_ships/size_b": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "size_b"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, -240.0]),
        "/outside_ships/size_c": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "size_c"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, -120.0]),
        "/outside_ships/edge": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "edge"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, 0.0]),
        "/outside_ships/engine": (kind: "tex.shader", params: {"resolution": "custom", "width": 6, "height": 1, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "engine"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, 120.0]),
        "/outside_ships/light_place": (kind: "tex.shader", params: {"resolution": "custom", "width": 10, "height": 6, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "light_place"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, 240.0]),
        "/outside_ships/light_size": (kind: "tex.shader", params: {"resolution": "custom", "width": 10, "height": 6, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "light_size"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, 360.0]),
        "/outside_ships/light_color": (kind: "tex.shader", params: {"resolution": "custom", "width": 10, "height": 6, "keep_size": true, "file": "library/outside_ships/ships.wgsl", "what": "light_color"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "ships": "controls:ships", "cross": "controls:cross", "rest": "controls:rest", "near": "controls:near", "far": "controls:far", "length": "controls:length", "sink": "controls:sink", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "blink": "controls:blink", "seed": "controls:seed", "whole": "whole:travelled", "phase": "phase:travelled", "bass": "bus:energy_low", "curve": "pose:curve"}, pos: [-500.0, 480.0]),
        "/outside_ships/hull_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-300.0, -900.0]),
        "/outside_ships/fill_mat": (kind: "mat.occluder", params: {"shows": "black"}, binds: {"opacity": "there:presence"}, pos: [-300.0, -800.0]),
        "/outside_ships/glow_mat": (kind: "mat.constant", pos: [-300.0, -700.0]),
        "/outside_ships/light_mat": (kind: "mat.constant", pos: [-300.0, -600.0]),
        "/outside_ships/light_box": (kind: "geo.primitive", params: {"shape": "box"}, pos: [-300.0, -500.0]),
        "/outside_ships/light_lit": (kind: "geo.assign_material", inputs: {"in": "light_box", "mat": "light_mat"}, pos: [-100.0, -500.0]),
        "/outside_ships/lights": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "light_lit", "position": "light_place", "scale": "light_size", "color": "light_color"}, pos: [300.0, 600.0]),
        "/outside_ships/hull_a_model": (kind: "geo.file", params: {"file": "library/outside_ships/hull_a.obj", "up": "z"}, pos: [-100.0, -400.0]),
        "/outside_ships/hull_a": (kind: "geo.assign_material", inputs: {"in": "hull_a_model", "mat": "hull_lines"}, pos: [100.0, -400.0]),
        "/outside_ships/edges_a": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "hull_a", "position": "place", "aim": "aim", "scale": "size_a", "color": "edge"}, pos: [300.0, 0.0]),
        "/outside_ships/fill_a_model": (kind: "geo.file", params: {"file": "library/outside_ships/fill_a.obj", "up": "z"}, pos: [-100.0, -400.0]),
        "/outside_ships/fill_a": (kind: "geo.assign_material", inputs: {"in": "fill_a_model", "mat": "fill_mat"}, pos: [100.0, -400.0]),
        "/outside_ships/fills_a": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "fill_a", "position": "place", "aim": "aim", "scale": "size_a"}, pos: [300.0, 0.0]),
        "/outside_ships/glow_a_model": (kind: "geo.file", params: {"file": "library/outside_ships/glow_a.obj", "up": "z"}, pos: [-100.0, -400.0]),
        "/outside_ships/glow_a": (kind: "geo.assign_material", inputs: {"in": "glow_a_model", "mat": "glow_mat"}, pos: [100.0, -400.0]),
        "/outside_ships/glows_a": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "glow_a", "position": "place", "aim": "aim", "scale": "size_a", "color": "engine"}, pos: [300.0, 0.0]),
        "/outside_ships/hull_b_model": (kind: "geo.file", params: {"file": "library/outside_ships/hull_b.obj", "up": "z"}, pos: [-100.0, -200.0]),
        "/outside_ships/hull_b": (kind: "geo.assign_material", inputs: {"in": "hull_b_model", "mat": "hull_lines"}, pos: [100.0, -200.0]),
        "/outside_ships/edges_b": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "hull_b", "position": "place", "aim": "aim", "scale": "size_b", "color": "edge"}, pos: [300.0, 200.0]),
        "/outside_ships/fill_b_model": (kind: "geo.file", params: {"file": "library/outside_ships/fill_b.obj", "up": "z"}, pos: [-100.0, -200.0]),
        "/outside_ships/fill_b": (kind: "geo.assign_material", inputs: {"in": "fill_b_model", "mat": "fill_mat"}, pos: [100.0, -200.0]),
        "/outside_ships/fills_b": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "fill_b", "position": "place", "aim": "aim", "scale": "size_b"}, pos: [300.0, 200.0]),
        "/outside_ships/glow_b_model": (kind: "geo.file", params: {"file": "library/outside_ships/glow_b.obj", "up": "z"}, pos: [-100.0, -200.0]),
        "/outside_ships/glow_b": (kind: "geo.assign_material", inputs: {"in": "glow_b_model", "mat": "glow_mat"}, pos: [100.0, -200.0]),
        "/outside_ships/glows_b": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "glow_b", "position": "place", "aim": "aim", "scale": "size_b", "color": "engine"}, pos: [300.0, 200.0]),
        "/outside_ships/hull_c_model": (kind: "geo.file", params: {"file": "library/outside_ships/hull_c.obj", "up": "z"}, pos: [-100.0, 0.0]),
        "/outside_ships/hull_c": (kind: "geo.assign_material", inputs: {"in": "hull_c_model", "mat": "hull_lines"}, pos: [100.0, 0.0]),
        "/outside_ships/edges_c": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "hull_c", "position": "place", "aim": "aim", "scale": "size_c", "color": "edge"}, pos: [300.0, 400.0]),
        "/outside_ships/fill_c_model": (kind: "geo.file", params: {"file": "library/outside_ships/fill_c.obj", "up": "z"}, pos: [-100.0, 0.0]),
        "/outside_ships/fill_c": (kind: "geo.assign_material", inputs: {"in": "fill_c_model", "mat": "fill_mat"}, pos: [100.0, 0.0]),
        "/outside_ships/fills_c": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "fill_c", "position": "place", "aim": "aim", "scale": "size_c"}, pos: [300.0, 400.0]),
        "/outside_ships/glow_c_model": (kind: "geo.file", params: {"file": "library/outside_ships/glow_c.obj", "up": "z"}, pos: [-100.0, 0.0]),
        "/outside_ships/glow_c": (kind: "geo.assign_material", inputs: {"in": "glow_c_model", "mat": "glow_mat"}, pos: [100.0, 0.0]),
        "/outside_ships/glows_c": (kind: "geo.tex_instance", params: {"extent": 3000.0}, inputs: {"in": "glow_c", "position": "place", "aim": "aim", "scale": "size_c", "color": "engine"}, pos: [300.0, 400.0]),
        "/outside_ships/fleet": (kind: "geo.merge", inputs: {"in0": "edges_a", "in1": "fills_a", "in2": "glows_a", "in3": "edges_b", "in4": "fills_b", "in5": "glows_b", "in6": "edges_c", "in7": "fills_c", "in8": "glows_c", "in9": "lights"}, pos: [500.0, 0.0]),
        "/outside_ships/out": (kind: "geo.out", inputs: {"in": "fleet"}, pos: [700.0, 0.0]),
    },
)
