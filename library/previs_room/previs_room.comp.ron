// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/previs_room": (kind: "comp.base", params: {"about": "A room seen from the audience, for judging a show without standing in one.", "expose": "width = view.width\nheight = view.height\neye = eye.position\nlook_at = eye.target\nfov = eye.fov\nbrightness = projector.intensity\nwash = wash_gain.b\ndeep = deep_gain.b\nambient = ambient.intensity\nwalls = walls.color\nfloor = floor_mat.color", "shelf": "music stage/stages"}),
        "/previs_room/main": (kind: "tex.in", pos: [-1600.0, -400.0]),
        "/previs_room/pattern": (kind: "tex.in", pos: [-1600.0, 200.0]),
        "/previs_room/colours": (kind: "chan.in", pos: [-1600.0, 800.0]),
        "/previs_room/wall": (kind: "geo.primitive", params: {"shape": "plane", "size": [16.0, 1.0, 6.0]}, pos: [-1200.0, -800.0]),
        "/previs_room/wall_at": (kind: "geo.transform", params: {"translate": [0.0, 2.0, 3.0]}, inputs: {"in": "wall"}, pos: [-1000.0, -800.0]),
        "/previs_room/side_left": (kind: "geo.primitive", params: {"shape": "plane", "size": [12.0, 1.0, 6.0]}, pos: [-1200.0, -700.0]),
        "/previs_room/side_left_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-8.0, -4.0, 3.0]}, inputs: {"in": "side_left"}, pos: [-1000.0, -700.0]),
        "/previs_room/side_right": (kind: "geo.primitive", params: {"shape": "plane", "size": [12.0, 1.0, 6.0]}, pos: [-1200.0, -600.0]),
        "/previs_room/side_right_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, -90.0], "translate": [8.0, -4.0, 3.0]}, inputs: {"in": "side_right"}, pos: [-1000.0, -600.0]),
        "/previs_room/room": (kind: "geo.merge", inputs: {"in0": "wall_at", "in1": "side_left_at", "in2": "side_right_at"}, pos: [-800.0, -700.0]),
        "/previs_room/walls": (kind: "mat.phong", params: {"color": [0.75, 0.74, 0.72, 1.0], "specular": [0.0, 0.0, 0.0, 1.0]}, pos: [-800.0, -600.0]),
        "/previs_room/room_lit": (kind: "geo.assign_material", inputs: {"in": "room", "mat": "walls"}, pos: [-600.0, -700.0]),
        "/previs_room/floor": (kind: "geo.primitive", params: {"shape": "plane", "size": [16.0, 1.0, 12.0]}, pos: [-1200.0, -450.0]),
        "/previs_room/floor_at": (kind: "geo.transform", params: {"rotate": [-90.0, 0.0, 0.0], "translate": [0.0, -4.0, 0.0]}, inputs: {"in": "floor"}, pos: [-1000.0, -450.0]),
        "/previs_room/floor_mat": (kind: "mat.phong", params: {"color": [0.3, 0.3, 0.32, 1.0], "specular": [0.15, 0.15, 0.15, 1.0], "shininess": 24.0}, pos: [-800.0, -400.0]),
        "/previs_room/floor_lit": (kind: "geo.assign_material", inputs: {"in": "floor_at", "mat": "floor_mat"}, pos: [-600.0, -450.0]),
        "/previs_room/band0": (kind: "tex.transform", params: {"scale": [4.0, 1.0], "pivot": [0.125, 0.5], "translate": [0.375, 0.0]}, inputs: {"in": "pattern"}, pos: [-1200.0, 200.0]),
        "/previs_room/column0_mat": (kind: "mat.constant", inputs: {"texture": "band0"}, pos: [-1000.0, 200.0]),
        "/previs_room/column0": (kind: "geo.primitive", params: {"shape": "plane", "size": [0.7, 1.0, 5.2]}, pos: [-1000.0, 250.0]),
        "/previs_room/column0_at": (kind: "geo.transform", params: {"translate": [-6.9, 1.6, 2.6]}, inputs: {"in": "column0"}, pos: [-800.0, 250.0]),
        "/previs_room/column0_lit": (kind: "geo.assign_material", inputs: {"in": "column0_at", "mat": "column0_mat"}, pos: [-600.0, 200.0]),
        "/previs_room/band1": (kind: "tex.transform", params: {"scale": [4.0, 1.0], "pivot": [0.375, 0.5], "translate": [0.125, 0.0]}, inputs: {"in": "pattern"}, pos: [-1200.0, 320.0]),
        "/previs_room/column1_mat": (kind: "mat.constant", inputs: {"texture": "band1"}, pos: [-1000.0, 320.0]),
        "/previs_room/column1": (kind: "geo.primitive", params: {"shape": "plane", "size": [0.7, 1.0, 5.2]}, pos: [-1000.0, 370.0]),
        "/previs_room/column1_at": (kind: "geo.transform", params: {"translate": [-5.7, 1.6, 2.6]}, inputs: {"in": "column1"}, pos: [-800.0, 370.0]),
        "/previs_room/column1_lit": (kind: "geo.assign_material", inputs: {"in": "column1_at", "mat": "column1_mat"}, pos: [-600.0, 320.0]),
        "/previs_room/band2": (kind: "tex.transform", params: {"scale": [4.0, 1.0], "pivot": [0.625, 0.5], "translate": [-0.125, 0.0]}, inputs: {"in": "pattern"}, pos: [-1200.0, 440.0]),
        "/previs_room/column2_mat": (kind: "mat.constant", inputs: {"texture": "band2"}, pos: [-1000.0, 440.0]),
        "/previs_room/column2": (kind: "geo.primitive", params: {"shape": "plane", "size": [0.7, 1.0, 5.2]}, pos: [-1000.0, 490.0]),
        "/previs_room/column2_at": (kind: "geo.transform", params: {"translate": [5.7, 1.6, 2.6]}, inputs: {"in": "column2"}, pos: [-800.0, 490.0]),
        "/previs_room/column2_lit": (kind: "geo.assign_material", inputs: {"in": "column2_at", "mat": "column2_mat"}, pos: [-600.0, 440.0]),
        "/previs_room/band3": (kind: "tex.transform", params: {"scale": [4.0, 1.0], "pivot": [0.875, 0.5], "translate": [-0.375, 0.0]}, inputs: {"in": "pattern"}, pos: [-1200.0, 560.0]),
        "/previs_room/column3_mat": (kind: "mat.constant", inputs: {"texture": "band3"}, pos: [-1000.0, 560.0]),
        "/previs_room/column3": (kind: "geo.primitive", params: {"shape": "plane", "size": [0.7, 1.0, 5.2]}, pos: [-1000.0, 610.0]),
        "/previs_room/column3_at": (kind: "geo.transform", params: {"translate": [6.9, 1.6, 2.6]}, inputs: {"in": "column3"}, pos: [-800.0, 610.0]),
        "/previs_room/column3_lit": (kind: "geo.assign_material", inputs: {"in": "column3_at", "mat": "column3_mat"}, pos: [-600.0, 560.0]),
        "/previs_room/columns": (kind: "geo.merge", inputs: {"in0": "column0_lit", "in1": "column1_lit", "in2": "column2_lit", "in3": "column3_lit"}, pos: [-400.0, 350.0]),
        "/previs_room/scene": (kind: "geo.merge", inputs: {"in0": "room_lit", "in1": "floor_lit", "in2": "columns"}, pos: [-200.0, -300.0]),
        "/previs_room/beamer": (kind: "view.camera", params: {"position": [0.0, -8.0, 3.0], "target": [0.0, 2.0, 3.0], "fov": 30.2}, pos: [-800.0, -200.0]),
        "/previs_room/projector": (kind: "light.projector", params: {"intensity": 1.0, "shadows": false}, inputs: {"camera": "beamer", "texture": "main"}, pos: [-600.0, -250.0]),
        "/previs_room/level": (kind: "chan.select", params: {"channels": "level"}, inputs: {"in": "colours"}, pos: [-1200.0, 800.0]),
        "/previs_room/wash_gain": (kind: "chan.math", params: {"op": "multiply", "b": 1.5}, inputs: {"a": "level"}, pos: [-1000.0, 800.0]),
        "/previs_room/depth": (kind: "chan.select", params: {"channels": "intensity"}, inputs: {"in": "colours"}, pos: [-1200.0, 900.0]),
        "/previs_room/deep_gain": (kind: "chan.math", params: {"op": "multiply", "b": 1.0}, inputs: {"a": "depth"}, pos: [-1000.0, 900.0]),
        "/previs_room/wash_left": (kind: "light.spot", params: {"position": [-7.5, 1.0, 5.8], "target": [-4.5, -7.0, 0.0], "angle": 55.0, "softness": 0.5}, binds: {"color.0": "colours:red", "color.1": "colours:green", "color.2": "colours:blue", "intensity": "wash_gain:level"}, pos: [-800.0, 700.0]),
        "/previs_room/wash_right": (kind: "light.spot", params: {"position": [7.5, 1.0, 5.8], "target": [4.5, -7.0, 0.0], "angle": 55.0, "softness": 0.5}, binds: {"color.0": "colours:red", "color.1": "colours:green", "color.2": "colours:blue", "intensity": "wash_gain:level"}, pos: [-800.0, 760.0]),
        "/previs_room/deep_left": (kind: "light.spot", params: {"position": [-7.2, 1.2, 0.2], "target": [-8.0, -4.0, 4.5], "angle": 60.0, "softness": 0.6}, binds: {"color.0": "colours:red2", "color.1": "colours:green2", "color.2": "colours:blue2", "intensity": "deep_gain:intensity"}, pos: [-800.0, 860.0]),
        "/previs_room/deep_right": (kind: "light.spot", params: {"position": [7.2, 1.2, 0.2], "target": [8.0, -4.0, 4.5], "angle": 60.0, "softness": 0.6}, binds: {"color.0": "colours:red2", "color.1": "colours:green2", "color.2": "colours:blue2", "intensity": "deep_gain:intensity"}, pos: [-800.0, 920.0]),
        "/previs_room/ambient": (kind: "light.ambient", params: {"intensity": 0.04}, pos: [-800.0, 1000.0]),
        "/previs_room/lights": (kind: "light.merge", inputs: {"in0": "projector", "in1": "wash_left", "in2": "wash_right", "in3": "deep_left", "in4": "deep_right", "in5": "ambient"}, pos: [-400.0, 700.0]),
        "/previs_room/eye": (kind: "view.camera", params: {"position": [1.2, -9.5, 1.7], "target": [0.0, 0.0, 2.6], "fov": 55.0}, pos: [-400.0, 0.0]),
        "/previs_room/view": (kind: "tex.render", params: {"width": 1280, "height": 720, "keep_size": true, "background": [0.0, 0.0, 0.0, 1.0]}, inputs: {"geo": "scene", "lights": "lights", "camera": "eye"}, pos: [0.0, -100.0]),
        "/previs_room/out": (kind: "tex.out", inputs: {"in": "view"}, pos: [200.0, -100.0]),
    },
)
