// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/breathe": (kind: "comp.base", params: {"about": "Regions in four colours that breathe slowly one after another.", "params": "@expose count = fields.count\n@expose c0 = fields.c0\n@expose c1 = fields.c1\n@expose c2 = fields.c2\n@expose c3 = fields.c3\n@expose edge = fields.edge\n@expose palette = fields.palette\n@expose gain = fields.gain\n@expose base = fields.base\n@expose period = fields.period\n@expose spread = fields.spread\n@expose fade = fields.fade\n@expose first = fields.first\n@expose every = fields.every\n@expose wipe = fields.wipe\n@expose breadth = fields.breadth\n@expose angle = fields.angle\n@expose turn = fields.turn\n@expose lines = fields.lines\n@expose lift = fields.lift\n@expose clock = fields.clock\n@expose line = fields.line", "shelf": "scanned objects"}),
        "/breathe/fields": (kind: "tex.shader", params: {"file": "library/breathe/breathe.wgsl"}, inputs: {"in0": "regions", "in1": "table", "in2": "outlines"}),
        "/breathe/out": (kind: "tex.out", inputs: {"in": "fields"}),
        "/breathe/outlines": (kind: "tex.in"),
        "/breathe/regions": (kind: "tex.in"),
        "/breathe/table": (kind: "tex.in"),
    },
)
