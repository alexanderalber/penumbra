// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/ceiling_shafts": (kind: "comp.base", params: {"about": "Shafts of light falling slanted from openings in the ceiling, beside the lane.", "params": "@expose presence = controls.value0\n@expose spacing = controls.value1\n@expose beats_per_bar = controls.value2\n@expose size = controls.value3\n@expose narrow = controls.value4\n@expose slant = controls.value5\n@expose outwards = controls.value6\n@expose lane = controls.value7\n@expose clear = controls.value8\n@expose base = controls.value9\n@expose gain = controls.value10\n@expose warmth = controls.value11\n@expose dust = controls.value12\n@expose mote = controls.value13\n@expose fall = controls.value14\n@expose fade = controls.value15\n@expose gone = controls.value16\n@expose ceiling = controls.value17\n@expose near = controls.value18\n@expose far = controls.value19\n@expose smooth = level.fall\n@expose line_width = ray_lines.line_width\n@expose extent = cones_0.extent", "shelf": "music stage/above"}, pos: [0.0, 0.0]),
        "/ceiling_shafts/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/ceiling_shafts/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/ceiling_shafts/controls": (kind: "chan.constant", params: {"rows": 20, "name0": "presence", "value0": 1.0, "name1": "spacing", "value1": 1.0, "name2": "beats_per_bar", "value2": 4.0, "name3": "size", "value3": 1.0, "name4": "narrow", "value4": 0.3, "name5": "slant", "value5": 18.0, "name6": "outwards", "value6": 35.0, "name7": "lane", "value7": 1.6, "name8": "clear", "value8": 0.8, "name9": "base", "value9": 0.5, "name10": "gain", "value10": 1.2, "name11": "warmth", "value11": 0.0, "name12": "dust", "value12": 24.0, "name13": "mote", "value13": 0.025, "name14": "fall", "value14": 0.012, "name15": "fade", "value15": 5.0, "name16": "gone", "value16": 11.0, "name17": "ceiling", "value17": 4.0, "name18": "near", "value18": -2.0, "name19": "far", "value19": 14.0}, pos: [-1200.0, 300.0]),
        "/ceiling_shafts/highs": (kind: "chan.select", params: {"channels": "energy_high"}, inputs: {"in": "bus"}, pos: [-1000.0, -150.0]),
        "/ceiling_shafts/level": (kind: "chan.filter", params: {"type": "first_order", "rise": 0.05, "fall": 0.4}, inputs: {"in": "highs"}, pos: [-800.0, -150.0]),
        "/ceiling_shafts/cone_place": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, -100.0]),
        "/ceiling_shafts/cone_aim": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, 30.0]),
        "/ceiling_shafts/cone_scale": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, 160.0]),
        "/ceiling_shafts/cone_hole": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "hole"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, 290.0]),
        "/ceiling_shafts/cone_light0": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "light", "band": 0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-400.0, -100.0]),
        "/ceiling_shafts/cone_light1": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "light", "band": 1}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-400.0, 30.0]),
        "/ceiling_shafts/cone_light2": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "light", "band": 2}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-400.0, 160.0]),
        "/ceiling_shafts/cone_light3": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 10, "height": 1, "keep_size": true, "part": "cone", "what": "light", "band": 3}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-400.0, 290.0]),
        "/ceiling_shafts/dust_place": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 32, "height": 10, "keep_size": true, "part": "dust", "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, 600.0]),
        "/ceiling_shafts/dust_scale": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 32, "height": 10, "keep_size": true, "part": "dust", "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, 730.0]),
        "/ceiling_shafts/dust_light": (kind: "tex.shader", params: {"file": "library/ceiling_shafts/shafts.wgsl", "resolution": "custom", "width": 32, "height": 10, "keep_size": true, "part": "dust", "what": "light"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "spacing": "controls:spacing", "beats_per_bar": "controls:beats_per_bar", "size": "controls:size", "narrow": "controls:narrow", "slant": "controls:slant", "outwards": "controls:outwards", "lane": "controls:lane", "clear": "controls:clear", "base": "controls:base", "gain": "controls:gain", "warmth": "controls:warmth", "dust": "controls:dust", "mote": "controls:mote", "fall": "controls:fall", "fade": "controls:fade", "gone": "controls:gone", "ceiling": "controls:ceiling", "near": "controls:near", "far": "controls:far", "beats": "bus:travelled", "drift": "bus:drift", "high": "level:energy_high"}, pos: [-600.0, 860.0]),
        "/ceiling_shafts/ray_lines": (kind: "mat.wireframe", params: {"line_width": 1.5}, pos: [-800.0, -450.0]),
        "/ceiling_shafts/rays_0": (kind: "geo.file", params: {"file": "library/ceiling_shafts/rays_0.obj", "up": "z"}, pos: [-1000.0, -550.0]),
        "/ceiling_shafts/rays_0_wire": (kind: "geo.assign_material", inputs: {"in": "rays_0", "mat": "ray_lines"}, pos: [-600.0, -550.0]),
        "/ceiling_shafts/rays_1": (kind: "geo.file", params: {"file": "library/ceiling_shafts/rays_1.obj", "up": "z"}, pos: [-1000.0, -650.0]),
        "/ceiling_shafts/rays_1_wire": (kind: "geo.assign_material", inputs: {"in": "rays_1", "mat": "ray_lines"}, pos: [-600.0, -650.0]),
        "/ceiling_shafts/rays_2": (kind: "geo.file", params: {"file": "library/ceiling_shafts/rays_2.obj", "up": "z"}, pos: [-1000.0, -750.0]),
        "/ceiling_shafts/rays_2_wire": (kind: "geo.assign_material", inputs: {"in": "rays_2", "mat": "ray_lines"}, pos: [-600.0, -750.0]),
        "/ceiling_shafts/hole": (kind: "geo.file", params: {"file": "library/ceiling_shafts/hole.obj", "up": "z"}, pos: [-1000.0, -900.0]),
        "/ceiling_shafts/light_mat": (kind: "mat.constant", params: {"color": [1.0, 1.0, 1.0, 1.0]}, pos: [-800.0, -850.0]),
        "/ceiling_shafts/hole_lit": (kind: "geo.assign_material", inputs: {"in": "hole", "mat": "light_mat"}, pos: [-600.0, -900.0]),
        "/ceiling_shafts/mote": (kind: "geo.file", params: {"file": "library/ceiling_shafts/mote.obj", "up": "z"}, pos: [-1000.0, -1050.0]),
        "/ceiling_shafts/mote_lit": (kind: "geo.assign_material", inputs: {"in": "mote", "mat": "light_mat"}, pos: [-600.0, -1050.0]),
        "/ceiling_shafts/cones_0": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "rays_0_wire", "position": "cone_place", "aim": "cone_aim", "scale": "cone_scale", "color": "cone_light0"}, pos: [-200.0, -400.0]),
        "/ceiling_shafts/cones_1": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "rays_1_wire", "position": "cone_place", "aim": "cone_aim", "scale": "cone_scale", "color": "cone_light1"}, pos: [-200.0, -300.0]),
        "/ceiling_shafts/cones_2": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "rays_2_wire", "position": "cone_place", "aim": "cone_aim", "scale": "cone_scale", "color": "cone_light2"}, pos: [-200.0, -200.0]),
        "/ceiling_shafts/holes": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "hole_lit", "position": "cone_place", "scale": "cone_hole", "color": "cone_light3"}, pos: [-200.0, -50.0]),
        "/ceiling_shafts/motes": (kind: "geo.tex_instance", params: {"extent": 24.0}, inputs: {"in": "mote_lit", "position": "dust_place", "scale": "dust_scale", "color": "dust_light"}, pos: [-200.0, 100.0]),
        "/ceiling_shafts/shafts": (kind: "geo.merge", inputs: {"in0": "cones_0", "in1": "cones_1", "in2": "cones_2", "in3": "holes", "in4": "motes"}, pos: [0.0, 0.0]),
        "/ceiling_shafts/out": (kind: "geo.out", inputs: {"in": "shafts"}, pos: [200.0, 0.0]),
    },
)
