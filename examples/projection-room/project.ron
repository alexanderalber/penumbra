// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/around": (kind: "light.environment", params: {"intensity": 0.6}, inputs: {"texture": "surroundings"}, pos: [960.0, 100.0]),
        "/back": (kind: "geo.primitive", params: {"shape": "plane", "size": [6.0, 1.0, 3.0]}, pos: [0.0, 130.0]),
        "/back_at": (kind: "geo.transform", params: {"translate": [0.0, 2.0, 1.5]}, inputs: {"in": "back"}, pos: [180.0, 130.0]),
        "/ball": (kind: "geo.primitive", params: {"segments": 64, "shape": "sphere", "size": [0.6, 0.6, 0.6]}, pos: [0.0, 550.0]),
        "/ball_at": (kind: "geo.transform", params: {"translate": [0.7, 0.6, 1.3]}, inputs: {"in": "ball"}, pos: [180.0, 550.0]),
        "/ball_lit": (kind: "geo.assign_material", inputs: {"in": "ball_at", "mat": "chrome"}, pos: [540.0, 530.0]),
        "/beamer": (kind: "view.camera", params: {"fov": 38.0, "position": [-0.6, -4.4, 2.0], "target": [-0.4, 2.0, 1.2]}, pos: [760.0, -400.0]),
        "/canopy": (kind: "geo.primitive", params: {"shape": "plane", "size": [1.8, 1.0, 1.8]}, pos: [180.0, 1070.0]),
        "/canopy_at": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0], "translate": [-1.2, 0.3, 2.3]}, inputs: {"in": "canopy"}, pos: [360.0, 1070.0]),
        "/canopy_lit": (kind: "geo.assign_material", inputs: {"in": "canopy_at", "mat": "leaves_mat"}, pos: [540.0, 1000.0]),
        "/chrome": (kind: "mat.pbr", params: {"color": [0.95, 0.95, 0.95, 1.0], "metallic": 1.0, "roughness": 0.05}, pos: [360.0, 470.0]),
        "/content": (kind: "tex.composite", inputs: {"layer1": "content_bg", "layer2": "content_title"}, pos: [760.0, -260.0]),
        "/content_bg": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 720, "speed": 0.15, "width": 1280}, pos: [540.0, -200.0]),
        "/content_title": (kind: "tex.text", params: {"height": 720, "size": 140.0, "text": "penumbra", "width": 1280}, pos: [540.0, -340.0]),
        "/cube": (kind: "geo.primitive", params: {"size": [0.6, 0.6, 0.6]}, pos: [0.0, 800.0]),
        "/cube_at": (kind: "geo.transform", params: {"translate": [-1.2, 0.3, 0.3]}, inputs: {"in": "cube"}, binds: {"rotate.2": "turn"}, pos: [180.0, 760.0]),
        "/cube_lit": (kind: "geo.assign_material", inputs: {"in": "cube_at", "mat": "gold"}, pos: [540.0, 740.0]),
        "/eye": (kind: "view.camera", params: {"fov": 42.0, "position": [4.2, -5.6, 3.0], "target": [-0.3, 0.6, 1.0]}, pos: [1150.0, 200.0]),
        "/floor": (kind: "geo.primitive", params: {"shape": "plane", "size": [6.0, 1.0, 4.0]}, pos: [0.0, 0.0]),
        "/floor_at": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0]}, inputs: {"in": "floor"}, pos: [180.0, 0.0]),
        "/floor_lit": (kind: "geo.assign_material", inputs: {"in": "floor_at", "mat": "floor_mat"}, pos: [540.0, 0.0]),
        "/floor_mat": (kind: "mat.pbr", params: {"color": [0.55, 0.5, 0.45, 1.0], "roughness": 0.3}, pos: [360.0, -100.0]),
        "/glass": (kind: "tex.shader", params: {"file": "stained.wgsl", "glass": 0.55, "height": 840, "width": 600}, pos: [0.0, 1200.0]),
        "/glass_mat": (kind: "mat.pbr", params: {"roughness": 0.08}, inputs: {"texture": "glass"}, pos: [180.0, 1200.0]),
        "/gold": (kind: "mat.pbr", params: {"color": [1.0, 0.71, 0.29, 1.0], "metallic": 1.0, "roughness": 0.25}, pos: [360.0, 640.0]),
        "/leaves_cut": (kind: "tex.threshold", params: {"output": "alpha"}, inputs: {"in": "leaves_noise"}, pos: [180.0, 930.0]),
        "/leaves_mat": (kind: "mat.phong", params: {"color": [0.35, 0.7, 0.3, 1.0], "specular": [0.0, 0.0, 0.0, 1.0]}, inputs: {"texture": "leaves_cut"}, pos: [360.0, 930.0]),
        "/leaves_noise": (kind: "tex.noise", params: {"frequency": 6.0, "height": 512, "speed": 0.05, "width": 512}, pos: [0.0, 930.0]),
        "/lights": (kind: "light.merge", inputs: {"in0": "projector", "in1": "sun_spot", "in2": "window_sun", "in3": "around"}, pos: [1150.0, -100.0]),
        "/pane": (kind: "geo.primitive", params: {"shape": "plane", "size": [1.0, 1.0, 1.4]}, pos: [180.0, 1320.0]),
        "/pane_at": (kind: "geo.transform", params: {"translate": [-1.9, -0.3, 1.0]}, inputs: {"in": "pane"}, pos: [360.0, 1320.0]),
        "/pane_lit": (kind: "geo.assign_material", inputs: {"in": "pane_at", "mat": "glass_mat"}, pos: [540.0, 1250.0]),
        "/pillar": (kind: "geo.primitive", params: {"size": [0.4, 0.4, 1.0]}, pos: [0.0, 420.0]),
        "/pillar_at": (kind: "geo.transform", params: {"translate": [0.7, 0.6, 0.5]}, inputs: {"in": "pillar"}, pos: [180.0, 420.0]),
        "/pillar_lit": (kind: "geo.assign_material", inputs: {"in": "pillar_at", "mat": "stand_mat"}, pos: [540.0, 400.0]),
        "/projector": (kind: "light.projector", params: {"intensity": 1.3}, inputs: {"camera": "beamer", "texture": "content"}, pos: [960.0, -300.0]),
        "/props": (kind: "geo.merge", inputs: {"in0": "pillar_lit", "in1": "ball_lit", "in2": "cube_lit", "in3": "canopy_lit"}, pos: [760.0, 600.0]),
        "/room": (kind: "geo.merge", inputs: {"in0": "back_at", "in1": "side_at"}, pos: [360.0, 180.0]),
        "/room_lit": (kind: "geo.assign_material", inputs: {"in": "room", "mat": "room_mat"}, pos: [540.0, 140.0]),
        "/room_mat": (kind: "mat.phong", params: {"color": [0.8, 0.78, 0.74, 1.0], "specular": [0.0, 0.0, 0.0, 1.0]}, pos: [360.0, 60.0]),
        "/scene": (kind: "geo.merge", inputs: {"in0": "room_lit", "in1": "floor_lit", "in2": "props", "in3": "see_through"}, pos: [960.0, 450.0]),
        "/scrim": (kind: "geo.primitive", params: {"shape": "plane", "size": [2.4, 1.0, 1.5]}, pos: [180.0, 1450.0]),
        "/scrim_at": (kind: "geo.transform", params: {"translate": [-0.4, 1.3, 1.45]}, inputs: {"in": "scrim"}, pos: [360.0, 1450.0]),
        "/scrim_lit": (kind: "geo.assign_material", inputs: {"in": "scrim_at", "mat": "scrim_mat"}, pos: [540.0, 1450.0]),
        "/scrim_mat": (kind: "mat.phong", params: {"color": [1.0, 1.0, 1.0, 0.3], "specular": [0.0, 0.0, 0.0, 1.0]}, pos: [360.0, 1560.0]),
        "/see_through": (kind: "geo.merge", inputs: {"in0": "pane_lit", "in1": "scrim_lit"}, pos: [760.0, 1300.0]),
        "/side": (kind: "geo.primitive", params: {"shape": "plane", "size": [4.0, 1.0, 3.0]}, pos: [0.0, 260.0]),
        "/side_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-3.0, 0.0, 1.5]}, inputs: {"in": "side"}, pos: [180.0, 260.0]),
        "/stand_mat": (kind: "mat.pbr", params: {"color": [0.9, 0.9, 0.9, 1.0], "roughness": 0.45}, pos: [360.0, 330.0]),
        "/sun_spot": (kind: "light.spot", params: {"color": [1.0, 0.92, 0.75, 1.0], "position": [-1.0, -0.2, 4.8], "shadows": true, "softness": 0.3, "target": [-1.2, 0.3, 0.0]}, pos: [960.0, -160.0]),
        "/surroundings": (kind: "tex.shader", params: {"file": "surroundings.wgsl", "height": 512, "width": 1024}, pos: [760.0, 100.0]),
        "/through_beamer": (kind: "tex.render", params: {"height": 720, "width": 1280}, inputs: {"camera": "beamer", "geo": "scene", "lights": "lights"}, pos: [1360.0, 400.0]),
        "/turn": (kind: "chan.lfo", params: {"amplitude": 45.0, "rate": 0.05}, pos: [0.0, 690.0]),
        "/view": (kind: "tex.render", params: {"ao": true}, inputs: {"camera": "eye", "geo": "scene", "lights": "lights"}, pos: [1360.0, 150.0]),
        "/window_sun": (kind: "light.spot", params: {"angle": 18.0, "color": [1.0, 0.85, 0.65, 1.0], "intensity": 3.0, "position": [-4.5, -2.8, 2.6], "shadows": true, "softness": 0.25, "target": [-0.3, 1.3, 0.0]}, pos: [960.0, -40.0]),
    },
)
