// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 1,
    nodes: {
        "/around": (kind: "light.environment", params: {"intensity": 0.6}, inputs: {"texture": "surroundings"}),
        "/back": (kind: "geo.primitive", params: {"shape": "plane", "size": [6.0, 1.0, 3.0]}),
        "/back_at": (kind: "geo.transform", params: {"translate": [0.0, 2.0, 1.5]}, inputs: {"in": "back"}),
        "/ball": (kind: "geo.primitive", params: {"segments": 64, "shape": "sphere", "size": [0.6, 0.6, 0.6]}),
        "/ball_at": (kind: "geo.transform", params: {"translate": [0.7, 0.6, 1.3]}, inputs: {"in": "ball"}),
        "/ball_lit": (kind: "geo.assign_material", inputs: {"in": "ball_at", "mat": "chrome"}),
        "/beamer": (kind: "view.camera", params: {"fov": 38.0, "position": [-0.6, -4.4, 2.0], "target": [-0.4, 2.0, 1.2]}),
        "/canopy": (kind: "geo.primitive", params: {"shape": "plane", "size": [1.8, 1.0, 1.8]}),
        "/canopy_at": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0], "translate": [-1.2, 0.3, 2.3]}, inputs: {"in": "canopy"}),
        "/canopy_lit": (kind: "geo.assign_material", inputs: {"in": "canopy_at", "mat": "leaves_mat"}),
        "/chrome": (kind: "mat.pbr", params: {"color": [0.95, 0.95, 0.95, 1.0], "metallic": 1.0, "roughness": 0.05}),
        "/content": (kind: "tex.composite", inputs: {"layer1": "content_bg", "layer2": "content_title"}),
        "/content_bg": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 720, "speed": 0.15, "width": 1280}),
        "/content_title": (kind: "tex.text", params: {"height": 720, "size": 140.0, "text": "penumbra", "width": 1280}),
        "/cube": (kind: "geo.primitive", params: {"size": [0.6, 0.6, 0.6]}),
        "/cube_at": (kind: "geo.transform", params: {"translate": [-1.2, 0.3, 0.3]}, inputs: {"in": "cube"}, binds: {"rotate.2": "turn"}),
        "/cube_lit": (kind: "geo.assign_material", inputs: {"in": "cube_at", "mat": "gold"}),
        "/eye": (kind: "view.camera", params: {"fov": 42.0, "position": [4.2, -5.6, 3.0], "target": [-0.3, 0.6, 1.0]}),
        "/floor": (kind: "geo.primitive", params: {"shape": "plane", "size": [6.0, 1.0, 4.0]}),
        "/floor_at": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0]}, inputs: {"in": "floor"}),
        "/floor_lit": (kind: "geo.assign_material", inputs: {"in": "floor_at", "mat": "floor_mat"}),
        "/floor_mat": (kind: "mat.pbr", params: {"color": [0.55, 0.5, 0.45, 1.0], "roughness": 0.3}),
        "/glass": (kind: "tex.shader", params: {"file": "stained.wgsl", "glass": 0.55, "height": 840, "width": 600}),
        "/glass_mat": (kind: "mat.pbr", params: {"roughness": 0.08}, inputs: {"texture": "glass"}),
        "/gold": (kind: "mat.pbr", params: {"color": [1.0, 0.71, 0.29, 1.0], "metallic": 1.0, "roughness": 0.25}),
        "/leaves_cut": (kind: "tex.threshold", params: {"output": "alpha"}, inputs: {"in": "leaves_noise"}),
        "/leaves_mat": (kind: "mat.phong", params: {"color": [0.35, 0.7, 0.3, 1.0], "specular": [0.0, 0.0, 0.0, 1.0]}, inputs: {"texture": "leaves_cut"}),
        "/leaves_noise": (kind: "tex.noise", params: {"frequency": 6.0, "height": 512, "speed": 0.05, "width": 512}),
        "/lights": (kind: "light.merge", inputs: {"in0": "projector", "in1": "sun_spot", "in2": "window_sun", "in3": "around"}),
        "/pane": (kind: "geo.primitive", params: {"shape": "plane", "size": [1.0, 1.0, 1.4]}),
        "/pane_at": (kind: "geo.transform", params: {"translate": [-1.9, -0.3, 1.0]}, inputs: {"in": "pane"}),
        "/pane_lit": (kind: "geo.assign_material", inputs: {"in": "pane_at", "mat": "glass_mat"}),
        "/pillar": (kind: "geo.primitive", params: {"size": [0.4, 0.4, 1.0]}),
        "/pillar_at": (kind: "geo.transform", params: {"translate": [0.7, 0.6, 0.5]}, inputs: {"in": "pillar"}),
        "/pillar_lit": (kind: "geo.assign_material", inputs: {"in": "pillar_at", "mat": "stand_mat"}),
        "/projector": (kind: "light.projector", params: {"intensity": 1.3}, inputs: {"camera": "beamer", "texture": "content"}),
        "/props": (kind: "geo.merge", inputs: {"in0": "pillar_lit", "in1": "ball_lit", "in2": "cube_lit", "in3": "canopy_lit"}),
        "/room": (kind: "geo.merge", inputs: {"in0": "back_at", "in1": "side_at"}),
        "/room_lit": (kind: "geo.assign_material", inputs: {"in": "room", "mat": "room_mat"}),
        "/room_mat": (kind: "mat.phong", params: {"color": [0.8, 0.78, 0.74, 1.0], "specular": [0.0, 0.0, 0.0, 1.0]}),
        "/scene": (kind: "geo.merge", inputs: {"in0": "room_lit", "in1": "floor_lit", "in2": "props", "in3": "see_through"}),
        "/scrim": (kind: "geo.primitive", params: {"shape": "plane", "size": [2.4, 1.0, 1.5]}),
        "/scrim_at": (kind: "geo.transform", params: {"translate": [-0.4, 1.3, 1.45]}, inputs: {"in": "scrim"}),
        "/scrim_lit": (kind: "geo.assign_material", inputs: {"in": "scrim_at", "mat": "scrim_mat"}),
        "/scrim_mat": (kind: "mat.phong", params: {"color": [1.0, 1.0, 1.0, 0.3], "specular": [0.0, 0.0, 0.0, 1.0]}),
        "/see_through": (kind: "geo.merge", inputs: {"in0": "pane_lit", "in1": "scrim_lit"}),
        "/side": (kind: "geo.primitive", params: {"shape": "plane", "size": [4.0, 1.0, 3.0]}),
        "/side_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-3.0, 0.0, 1.5]}, inputs: {"in": "side"}),
        "/stand_mat": (kind: "mat.pbr", params: {"color": [0.9, 0.9, 0.9, 1.0], "roughness": 0.45}),
        "/sun_spot": (kind: "light.spot", params: {"color": [1.0, 0.92, 0.75, 1.0], "position": [-1.0, -0.2, 4.8], "shadows": true, "softness": 0.3, "target": [-1.2, 0.3, 0.0]}),
        "/surroundings": (kind: "tex.shader", params: {"file": "surroundings.wgsl", "height": 512, "width": 1024}),
        "/through_beamer": (kind: "tex.render", params: {"height": 720, "width": 1280}, inputs: {"camera": "beamer", "geo": "scene", "lights": "lights"}),
        "/turn": (kind: "chan.lfo", params: {"amplitude": 45.0, "rate": 0.05}),
        "/view": (kind: "tex.render", params: {"ao": true}, inputs: {"camera": "eye", "geo": "scene", "lights": "lights"}),
        "/window_sun": (kind: "light.spot", params: {"angle": 18.0, "color": [1.0, 0.85, 0.65, 1.0], "intensity": 3.0, "position": [-4.5, -2.8, 2.6], "shadows": true, "softness": 0.25, "target": [-0.3, 1.3, 0.0]}),
    },
)
