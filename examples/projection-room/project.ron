// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/around": (kind: "light.environment", params: {"intensity": 0.2}, inputs: {"texture": "surroundings"}, pos: [600.0, 1809.0]),
        "/back": (kind: "geo.primitive", params: {"shape": "plane", "size": [6.0, 1.0, 3.0]}, pos: [0.0, -400.0]),
        "/back_at": (kind: "geo.transform", params: {"translate": [0.0, 2.0, 1.5]}, inputs: {"in": "back"}, pos: [200.0, -400.0]),
        "/ball": (kind: "geo.primitive", params: {"segments": 64, "shape": "sphere", "size": [0.6, 0.6, 0.6]}, pos: [0.0, 691.0]),
        "/ball_at": (kind: "geo.transform", params: {"translate": [0.7, 0.6, 1.3]}, inputs: {"in": "ball"}, pos: [200.0, 691.0]),
        "/ball_lit": (kind: "geo.assign_material", inputs: {"in": "ball_at", "mat": "chrome"}, pos: [400.0, 755.0]),
        "/beamer": (kind: "view.camera", params: {"fov": 38.0, "position": [-0.6, -4.4, 2.0], "target": [-0.4, 2.0, 1.2]}, pos: [400.0, 1494.0]),
        "/chrome": (kind: "mat.pbr", params: {"color": [0.95, 0.95, 0.95, 1.0], "metallic": 1.0, "roughness": 0.05}, pos: [200.0, 820.0]),
        "/content": (kind: "tex.composite", inputs: {"in0": "content_look", "in1": "content_title"}, pos: [400.0, 1566.0]),
        "/content_bg": (kind: "tex.noise", params: {"amplitude": 1.0, "frequency": 3.0, "height": 720, "speed": 0.15, "width": 1280}, pos: [0.0, 1471.0]),
        "/content_look": (kind: "tex.lookup", params: {"palette": "magma"}, inputs: {"in": "content_bg"}, pos: [200.0, 1485.0]),
        "/content_title": (kind: "tex.text", params: {"height": 720, "position": [0.5, 0.3], "size": 180.0, "style": "Bold", "text": "penumbra", "width": 1280}, pos: [200.0, 1613.0]),
        "/cube": (kind: "geo.primitive", params: {"size": [0.6, 0.6, 0.6]}, pos: [0.0, 948.0]),
        "/cube_at": (kind: "geo.transform", params: {"translate": [-1.2, 0.3, 0.3]}, inputs: {"in": "cube"}, binds: {"rotate.2": "turn"}, pos: [200.0, 948.0]),
        "/cube_lit": (kind: "geo.assign_material", inputs: {"in": "cube_at", "mat": "gold"}, pos: [400.0, 1012.0]),
        "/eye": (kind: "view.camera", params: {"fov": 42.0, "position": [4.2, -5.6, 3.0], "target": [-0.3, 0.6, 1.0]}, pos: [800.0, 1775.0]),
        "/floor": (kind: "geo.primitive", params: {"shape": "plane", "size": [6.0, 1.0, 4.0]}, pos: [200.0, 242.0]),
        "/floor_at": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0]}, inputs: {"in": "floor"}, pos: [400.0, 242.0]),
        "/floor_lit": (kind: "geo.assign_material", inputs: {"in": "floor_at", "mat": "floor_mat"}, pos: [600.0, 257.0]),
        "/floor_mat": (kind: "mat.pbr", params: {"color": [0.55, 0.5, 0.45, 1.0], "roughness": 0.3}, pos: [400.0, 370.0]),
        "/glass": (kind: "tex.shader", params: {"file": "stained.wgsl", "glass": 0.55, "height": 840, "width": 600}, pos: [200.0, 1333.0]),
        "/glass_mat": (kind: "mat.pbr", params: {"roughness": 0.08}, inputs: {"texture": "glass"}, pos: [400.0, 1333.0]),
        "/gold": (kind: "mat.pbr", params: {"color": [1.0, 0.71, 0.29, 1.0], "metallic": 1.0, "roughness": 0.25}, pos: [200.0, 1076.0]),
        "/lights": (kind: "light.merge", inputs: {"in0": "projector", "in1": "sun_spot", "in2": "window_sun", "in3": "around"}, pos: [800.0, 1659.0]),
        "/pane": (kind: "geo.primitive", params: {"shape": "plane", "size": [1.0, 1.0, 1.4]}, pos: [200.0, 1205.0]),
        "/pane_at": (kind: "geo.transform", params: {"translate": [-1.9, -0.3, 1.0]}, inputs: {"in": "pane"}, pos: [400.0, 1205.0]),
        "/pane_lit": (kind: "geo.assign_material", inputs: {"in": "pane_at", "mat": "glass_mat"}, pos: [600.0, 1269.0]),
        "/pillar": (kind: "geo.primitive", params: {"size": [0.4, 0.4, 1.0]}, pos: [0.0, 434.0]),
        "/pillar_at": (kind: "geo.transform", params: {"translate": [0.7, 0.6, 0.5]}, inputs: {"in": "pillar"}, pos: [200.0, 434.0]),
        "/pillar_lit": (kind: "geo.assign_material", inputs: {"in": "pillar_at", "mat": "stand_mat"}, pos: [400.0, 499.0]),
        "/projector": (kind: "light.projector", params: {"intensity": 1.2}, inputs: {"camera": "beamer", "texture": "content"}, pos: [600.0, 1581.0]),
        "/props": (kind: "geo.merge", inputs: {"in0": "pillar_lit", "in1": "ball_lit", "in2": "cube_lit"}, pos: [600.0, 767.0]),
        "/room": (kind: "geo.merge", inputs: {"in0": "back_at", "in1": "side_low_at", "in2": "side_top_at", "in3": "side_front_at", "in4": "side_rear_at"}, pos: [400.0, -156.0]),
        "/room_lit": (kind: "geo.assign_material", inputs: {"in": "room", "mat": "room_mat"}, pos: [600.0, -53.0]),
        "/room_mat": (kind: "mat.phong", params: {"color": [0.8, 0.78, 0.74, 1.0], "specular": [0.0, 0.0, 0.0, 1.0]}, pos: [400.0, 24.0]),
        "/scene": (kind: "geo.merge", inputs: {"in0": "room_lit", "in1": "floor_lit", "in2": "props", "in3": "pane_lit"}, pos: [800.0, 529.0]),
        "/side_front": (kind: "geo.primitive", params: {"shape": "plane", "size": [0.1, 1.0, 1.2]}, pos: [0.0, -15.0]),
        "/side_front_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-3.0, -1.95, 1.7]}, inputs: {"in": "side_front"}, pos: [200.0, -15.0]),
        "/side_low": (kind: "geo.primitive", params: {"shape": "plane", "size": [4.0, 1.0, 1.1]}, pos: [0.0, -272.0]),
        "/side_low_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-3.0, 0.0, 0.55]}, inputs: {"in": "side_low"}, pos: [200.0, -272.0]),
        "/side_rear": (kind: "geo.primitive", params: {"shape": "plane", "size": [2.7, 1.0, 1.2]}, pos: [0.0, 114.0]),
        "/side_rear_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-3.0, 0.65, 1.7]}, inputs: {"in": "side_rear"}, pos: [200.0, 114.0]),
        "/side_top": (kind: "geo.primitive", params: {"shape": "plane", "size": [4.0, 1.0, 0.7]}, pos: [0.0, -143.0]),
        "/side_top_at": (kind: "geo.transform", params: {"rotate": [0.0, 0.0, 90.0], "translate": [-3.0, 0.0, 2.65]}, inputs: {"in": "side_top"}, pos: [200.0, -143.0]),
        "/stand_mat": (kind: "mat.pbr", params: {"color": [0.9, 0.9, 0.9, 1.0], "roughness": 0.45}, pos: [200.0, 563.0]),
        "/sun_spot": (kind: "light.spot", params: {"color": [1.0, 0.92, 0.75, 1.0], "intensity": 0.6, "position": [-1.0, -0.2, 4.8], "shadows": true, "softness": 0.3, "target": [-1.2, 0.3, 0.0]}, pos: [600.0, 1665.0]),
        "/surroundings": (kind: "tex.shader", params: {"file": "surroundings.wgsl", "height": 512, "width": 1024}, pos: [400.0, 1781.0]),
        "/through_beamer": (kind: "tex.render", params: {"height": 720, "width": 1280}, inputs: {"camera": "beamer", "geo": "scene", "lights": "lights"}, pos: [1000.0, 1440.0]),
        "/turn": (kind: "chan.lfo", params: {"amplitude": 45.0, "rate": 0.05}, pos: [0.0, 591.0]),
        "/view": (kind: "tex.render", params: {"ao": true}, inputs: {"camera": "eye", "geo": "scene", "lights": "lights"}, pos: [1000.0, 1665.0]),
        "/window_sun": (kind: "light.spot", params: {"angle": 18.0, "color": [1.0, 0.85, 0.65, 1.0], "intensity": 1.2, "position": [-4.5, -3.5, 2.0], "shadows": true, "softness": 0.25, "target": [-0.03, 2.0, 0.28]}, pos: [600.0, 1737.0]),
    },
)
