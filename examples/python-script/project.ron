// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_script": (kind: "ui.note", params: {"height": 155, "text": "# Python script\n`physics` runs `bounce.py`: a ball bouncing in a box under gravity. Module globals keep position and speed from one frame to the next. Out come the channels `x`, `y`, `tx`, `ty`, `bounces`. Needs Python 3.12 or later.\n- `gravity`, `bounce` on `physics`: declared by `PARAMS` in the script\n- Edit `bounce.py` and save: the node reloads it", "width": 560}, pos: [0.0, 430.0]),
        "/about_trail": (kind: "ui.note", params: {"height": 115, "text": "# Ball and trail\n`place` moves the glow from `ball`. Its `translate` is bound to `tx` and `ty`. `loop`, `fade` and `echo` leave a fading trail, as in the feedback example. `view` lays it over `backdrop`.\n- `opacity` on `fade`: closer to 1 for a longer trail", "width": 750}, pos: [0.0, -170.0]),
        "/backdrop": (kind: "tex.ramp", params: {"keys": "0 0.03 0.012 0.045\n0.6 0.006 0.007 0.022\n1 0.002 0.002 0.008", "shape": "vertical"}, pos: [400.0, 0.0]),
        "/ball": (kind: "tex.ramp", params: {"keys": "0 1 0.95 0.75\n0.08 1 0.7 0.25\n0.15 1 0.42 0.06\n0.16 1 0.35 0.04 0.45\n0.24 1 0.25 0.02 0", "shape": "radial"}, pos: [0.0, 182.0]),
        "/echo": (kind: "tex.composite", inputs: {"in0": "fade", "in1": "place"}, pos: [400.0, 128.0]),
        "/fade": (kind: "tex.level", params: {"opacity": 0.9}, inputs: {"in": "loop"}, pos: [200.0, 54.0]),
        "/loop": (kind: "tex.feedback", inputs: {"previous": "echo"}, pos: [0.0, 54.0]),
        "/physics": (kind: "script.python", params: {"file": "bounce.py"}, pos: [0.0, 310.0]),
        "/place": (kind: "tex.transform", params: {"extend": "zero"}, inputs: {"in": "ball"}, binds: {"translate.0": "physics:tx", "translate.1": "physics:ty"}, pos: [200.0, 182.0]),
        "/view": (kind: "tex.composite", inputs: {"in0": "backdrop", "in1": "echo"}, pos: [600.0, 75.0]),
    },
)
