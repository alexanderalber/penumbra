// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/backdrop": (kind: "tex.ramp", params: {"keys": "0 0.03 0.012 0.045\n0.6 0.006 0.007 0.022\n1 0.002 0.002 0.008", "shape": "vertical"}, pos: [600.0, 0.0]),
        "/ball": (kind: "tex.ramp", params: {"keys": "0 1 0.95 0.75\n0.08 1 0.7 0.25\n0.15 1 0.42 0.06\n0.16 1 0.35 0.04 0.45\n0.24 1 0.25 0.02 0", "shape": "radial"}, pos: [0.0, 0.0]),
        "/echo": (kind: "tex.composite", inputs: {"in0": "fade", "in1": "place"}, pos: [600.0, 142.0]),
        "/fade": (kind: "tex.level", params: {"opacity": 0.9}, inputs: {"in": "loop"}, pos: [400.0, 284.0]),
        "/loop": (kind: "tex.feedback", inputs: {"previous": "echo"}, pos: [200.0, 284.0]),
        "/physics": (kind: "script.python", params: {"file": "bounce.py"}, pos: [0.0, 142.0]),
        "/place": (kind: "tex.transform", params: {"extend": "zero"}, inputs: {"in": "ball"}, binds: {"translate.0": "physics:tx", "translate.1": "physics:ty"}, pos: [200.0, 142.0]),
        "/view": (kind: "tex.composite", inputs: {"in0": "backdrop", "in1": "echo"}, pos: [800.0, 0.0]),
    },
)
