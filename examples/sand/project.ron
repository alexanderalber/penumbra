// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 200, "text": "# Falling sand\n`sand` is the library component `sand`. Choose a `scene` on it: the scene writes its values into the params below, then tune any of them.\nKey 0 starts the sand over (`keys` is bound to `sand`\'s `reset`). Click into the editor once so it gets the keys.\nStand-ins: `letters` is the wall input (a scan mask of the object in an installation), `blobs` the source input (tex.blob_track of people), `hole` the drain input (scene `drain`).\n`/out` shows the picture. `sand`\'s channel output `grains` is the number of grains.", "width": 1000}, pos: [-300.0, -360.0]),
        "/blob_a": (kind: "tex.primitive", params: {"fill": [1.0, 0.25, 0.1, 1.0], "shape": "ellipse", "size": [0.035, 0.035]}, binds: {"center.0": "x:x", "center.1": "y:y"}, pos: [-500.0, 60.0]),
        "/blob_b": (kind: "tex.primitive", params: {"fill": [0.1, 0.5, 1.0, 1.0], "shape": "ellipse", "size": [0.035, 0.035]}, binds: {"center.0": "x2:x2", "center.1": "y2:y2"}, pos: [-500.0, 190.0]),
        "/blobs": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "blob_a", "in1": "blob_b"}, pos: [-300.0, 100.0]),
        "/hole": (kind: "tex.primitive", params: {"center": [0.5, 0.97], "shape": "ellipse", "size": [0.25, 0.1]}, pos: [-300.0, 240.0]),
        "/keys": (kind: "chan.keyboard_in", params: {"keys": "0"}, pos: [300.0, 200.0]),
        "/letters": (kind: "tex.text", params: {"position": [0.5, 0.6], "size": 390.0, "style": "Bold", "text": "penumbra"}, pos: [-300.0, -60.0]),
        "/out": (kind: "tex.null", inputs: {"in": "sand/out"}, pos: [600.0, 0.0]),
        "/sand": (kind: "comp.base", params: {"about": "Falling sand, a cellular automaton: grains pour, slide and pile up on walls, run through an hourglass or over pegs; walls from a mask, sand from a source picture.", "params": "@param scene choice(steady|letters|blob|gravity|hourglass|cups|pegs|ramps|drain|mover) = steady -- what is set up: walls, start, where sand comes from, edges, palette; choosing one writes its values into the params, then they are yours; a new scene starts the sand over\n@param seed int = 1 0..1000 -- another random start; a change starts the sand over\n@param steps int = 48 1..64 -- sand steps per frame; fewer is slower sand and costs less\n@expose amount = step.amount\n@expose gravity = step.gravity\n@expose pause = step.pause\n@param colors choice(time|source) = time -- colour of new grains; time: moves along the palette; source: the hue of the source picture\n@group setup\n@expose shape = walls.shape\n@expose object = walls.object\n@expose neck = walls.neck\n@expose slope = walls.slope\n@expose rain = sources.rain\n@expose rain_from = sources.rain_from\n@expose rain_to = sources.rain_to\n@expose blobs = sources.blobs\n@expose pour = step.pour\n@expose edges = step.edges\n@expose drain = step.drain\n@param start choice(empty|band|noise) = empty -- sand at the start; empty: none; band: rows of layered sand from top to bottom; noise: grains everywhere; a change starts the sand over\n@param top float = 0.1 0..1 -- where the band starts, in picture heights from the top; a change starts the sand over\n@param bottom float = 0.4 0..1 -- where the band ends; a change starts the sand over\n@param layers int = 5 1..20 -- colour layers of the band; a change starts the sand over\n@param density float = 1 0..1 -- share of cells that get a grain at the start; a change starts the sand over\n@group grains\n@expose fall = step.fall\n@expose slide = step.slide\n@expose roll = step.roll\n@expose sticky = step.sticky\n@expose in_wall = step.in_wall\n@expose wall_level = walls.level\n@expose cycle = step.cycle\n@expose jitter = step.jitter\n@group look\n@expose palette = show.palette\n@expose wall_fill = show.wall_fill\n@expose outline = show.outline\n@expose gain = show.gain\n@expose variation = show.variation\n@expose shade = show.shade\n@expose depth = show.depth\n@expose grain = show.grain\n@expose buried = show.buried\n@expose marker = show.marker\n@expose background = show.background\n@expose mode = show.mode\n@expose out_width = show.width\n@expose out_height = show.height\n@group size\n@param width int = 640 16..4096 -- simulation width in cells; keep it even; a change starts the sand over\n@param height int = 360 16..4096 -- simulation height in cells; keep it even; a change starts the sand over\n@reset scene seed start top bottom layers density width height\n@preset scene=* shape=none object=true neck=0.022 slope=60 rain=1 rain_from=0 rain_to=1 blobs=0 pour=0.0015 edges=open drain=0 gravity=0\n@preset scene=* start=empty top=0.1 bottom=0.4 layers=5 density=1\n@preset scene=* palette=8a5a2b b97c3c dca25a f2cf8e fff0d0 wall_fill=0.015 outline=0.2\n@preset scene=steady -- rain on the wall input; the floor is open, so as much sand falls out as comes in\n@preset scene=letters rain_from=0.04 rain_to=0.96 edges=closed -- rain on the wall input over a closed floor: heaps on every shape, the floor fills up\n@preset scene=blob rain=0 blobs=1 pour=0.003 palette=ff3b30 ff9500 ffcc00 34c759 00c7be 007aff 5856d6 af52de -- the source input pours sand over the wall input; the floor is open\n@preset scene=gravity rain=0 edges=closed start=band top=0 bottom=0.32 layers=4 palette=9b1d12 e2541c f6a03a ffe29a -- a band of layered sand on the wall input, nothing pours; turn gravity\n@preset scene=hourglass shape=hourglass object=false rain=0 edges=closed start=band top=0.08 bottom=0.44 layers=6 palette=1d3557 457b9d a8dadc f1faee e63946 f4a261 wall_fill=0 outline=0.45 -- layered sand runs through a narrow neck; the wall input is not used\n@preset scene=cups shape=cups object=false rain_from=0.05 rain_to=0.95 palette=9b1d12 e2541c f6a03a ffe29a -- rain into three bowls that overflow\n@preset scene=pegs shape=pegs object=false rain_from=0.45 rain_to=0.55 pour=0.1 palette=ff3b30 ff9500 ffcc00 34c759 00c7be 007aff 5856d6 af52de -- a heavy narrow stream through a board of pins\n@preset scene=ramps shape=ramps object=false rain_from=0.44 rain_to=0.56 -- a narrow rain on a zigzag of shelves\n@preset scene=drain shape=cups object=false pour=0.0006 edges=closed drain=0.5 start=band top=0.75 bottom=1 layers=3 -- rain over bowls and a floor of sand; the drain input swallows sand\n@preset scene=mover shape=bar object=false rain=0 edges=closed start=band top=0.6 bottom=1 layers=4 -- a bar moves through a pile of layered sand", "shelf": "simulations"}, binds: {"reset": "keys:key_0"}, pos: [300.0, 0.0]),
        "/sand/count": (kind: "chan.from_tex", params: {"components": "red", "measure": "sum"}, inputs: {"in": "step"}, pos: [800.0, 300.0]),
        "/sand/depth": (kind: "tex.blur", inputs: {"in": "step"}, pos: [800.0, 160.0]),
        "/sand/drain": (kind: "tex.in", inputs: {"in": "/hole"}, pos: [-250.0, 300.0]),
        "/sand/grains": (kind: "chan.out", inputs: {"in": "name"}, pos: [1200.0, 300.0]),
        "/sand/loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "step"}, pos: [400.0, -60.0]),
        "/sand/name": (kind: "chan.rename", params: {"names": "r=grains"}, inputs: {"in": "count"}, pos: [1000.0, 300.0]),
        "/sand/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [1200.0, 40.0]),
        "/sand/seed": (kind: "tex.shader", params: {"file": "library/sand/seed.wgsl", "keep_size": true, "resolution": "custom"}, inputs: {"in0": "walls"}, binds: {"bottom": "parent.bottom", "density": "parent.density", "height": "parent.height", "layers": "parent.layers", "seed": "parent.seed", "start": "parent.start", "top": "parent.top", "width": "parent.width"}, pos: [200.0, -120.0]),
        "/sand/show": (kind: "tex.shader", params: {"file": "library/sand/show.wgsl", "keep_size": true, "outline": 0.2, "palette": "8a5a2b b97c3c dca25a f2cf8e fff0d0", "resolution": "custom", "wall_fill": 0.015}, inputs: {"in0": "step", "in1": "walls", "in2": "depth", "in3": "sources"}, binds: {"colors": "parent.colors"}, pos: [1000.0, 40.0]),
        "/sand/source": (kind: "tex.in", inputs: {"in": "/blobs"}, pos: [-250.0, 150.0]),
        "/sand/sources": (kind: "tex.shader", params: {"blobs": 0, "file": "library/sand/sources.wgsl", "keep_size": true, "rain": 1, "rain_from": 0, "rain_to": 1, "resolution": "custom"}, inputs: {"in0": "source"}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [0.0, 150.0]),
        "/sand/step": (kind: "tex.shader", params: {"drain": 0, "edges": "open", "file": "library/sand/step.wgsl", "gravity": 0, "keep_size": true, "pour": 0.0015}, inputs: {"in0": "loop", "in1": "walls", "in2": "sources", "in3": "drain"}, binds: {"colors": "parent.colors", "iterations": "parent.steps"}, pos: [600.0, 40.0]),
        "/sand/wall": (kind: "tex.in", inputs: {"in": "/letters"}, pos: [-250.0, 0.0]),
        "/sand/walls": (kind: "tex.shader", params: {"file": "library/sand/walls.wgsl", "keep_size": true, "neck": 0.022, "object": true, "resolution": "custom", "shape": "none", "slope": 60}, inputs: {"in0": "wall"}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [0.0, 0.0]),
        "/x": (kind: "chan.lfo", params: {"amplitude": 0.38, "name": "x", "offset": 0.5, "rate": 0.07}, pos: [-700.0, 60.0]),
        "/x2": (kind: "chan.lfo", params: {"amplitude": 0.38, "name": "x2", "offset": 0.5, "phase": 0.5, "rate": 0.05}, pos: [-700.0, 200.0]),
        "/y": (kind: "chan.lfo", params: {"amplitude": 0.08, "name": "y", "offset": 0.18, "phase": 0.25, "rate": 0.11}, pos: [-700.0, 130.0]),
        "/y2": (kind: "chan.lfo", params: {"amplitude": 0.08, "name": "y2", "offset": 0.2, "rate": 0.09}, pos: [-700.0, 270.0]),
    },
)
