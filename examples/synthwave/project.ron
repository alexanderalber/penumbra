// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 1,
    nodes: {
        "/block": (kind: "geo.assign_material", inputs: {"in": "box", "mat": "block_lines"}),
        "/block_lines": (kind: "mat.wireframe", params: {"color": [1.0, 1.0, 1.0, 1.0], "faces": "hidden", "line_width": 2.0}),
        "/block_places": (kind: "tex.shader", params: {"file": "blocks.wgsl", "height": 20, "keep_size": true, "resolution": "custom", "width": 20}),
        "/block_sizes": (kind: "tex.shader", params: {"file": "blocks.wgsl", "height": 20, "keep_size": true, "output": "scale", "resolution": "custom", "width": 20}),
        "/blocks": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "block", "position": "block_places", "scale": "block_sizes"}),
        "/body": (kind: "tex.shapes", params: {"shapes": "body ellipse 0.43,0.6 0.14,0.37"}),
        "/box": (kind: "geo.primitive"),
        "/camera": (kind: "view.camera", params: {"far": 60.0, "fov": 58.7, "position": [0.0, 0.0, 2.0], "target": [0.0, 10.0, 2.0]}),
        "/ceiling": (kind: "geo.transform", params: {"translate": [0.0, 0.0, 4.0]}, inputs: {"in": "floor"}),
        "/clouds": (kind: "tex.noise", params: {"amplitude": 0.8, "frequency": 2.5, "octaves": 7, "offset": 0.3, "roughness": 0.62, "speed": 0.01}),
        "/swirl": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 540, "octaves": 3, "seed": 7, "speed": 0.02, "width": 960}),
        "/wisps": (kind: "tex.displace", params: {"extend": "mirror", "weight": [0.08, 0.08]}, inputs: {"in": "clouds", "map": "swirl"}),
        "/glow": (kind: "tex.level", params: {"black": 0.15, "gamma": 0.55, "white": 1.3}, inputs: {"in": "wisps"}),
        "/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}),
        "/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}),
        "/fade": (kind: "tex.shader", params: {"end": 10.0, "file": "fade.wgsl", "start": 4.0}, inputs: {"in0": "render", "in1": "render:data"}),
        "/floor": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0], "translate": [0.0, 18.0, 0.0]}, inputs: {"in": "grid"}, binds: {"translate.1": "scroll:scroll"}),
        "/grid": (kind: "geo.assign_material", inputs: {"in": "grid_plane", "mat": "grid_lines"}),
        "/grid_lines": (kind: "mat.wireframe", params: {"color": [1.0, 1.0, 1.0, 1.0], "line_width": 2.0}),
        "/grid_plane": (kind: "geo.primitive", params: {"cells": 80, "shape": "plane", "size": [40.0, 1.0, 40.0]}),
        "/lines": (kind: "tex.composite", params: {"op": "outside"}, inputs: {"layer1": "wobble", "layer2": "fade"}),
        "/nebula": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"layer1": "glow", "layer2": "stars"}),
        "/out": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"layer1": "shaded", "layer2": "lines", "layer3": "outline"}),
        "/outline": (kind: "tex.edge", params: {"mode": "alpha", "strength": 4.0}, inputs: {"in": "wobble"}),
        "/palette": (kind: "tex.cross", inputs: {"a": "warm", "b": "cold"}, binds: {"cross": "season_fade:season"}),
        "/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "scene"}),
        "/scene": (kind: "geo.merge", inputs: {"in0": "floor", "in1": "ceiling", "in2": "blocks"}),
        "/scroll": (kind: "chan.lfo", params: {"amplitude": -0.25, "name": "scroll", "offset": -0.25, "rate": 2.0833333, "shape": "saw"}),
        "/season": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "season", "offset": 0.5, "phase": 0.5, "rate": 0.008333333, "shape": "square"}),
        "/season_fade": (kind: "chan.filter", params: {"fall": 2.0, "rise": 2.0}, inputs: {"in": "season"}),
        "/shaded": (kind: "tex.composite", inputs: {"layer1": "sky", "layer2": "shadow"}),
        "/shadow": (kind: "tex.level", params: {"brightness": 0.0, "opacity": 0.45}, inputs: {"in": "wobble"}),
        "/sky": (kind: "tex.composite", params: {"op": "color"}, inputs: {"layer1": "nebula", "layer2": "palette"}),
        "/squash": (kind: "chan.lfo", params: {"amplitude": 0.06, "name": "squash", "offset": 1.0, "rate": 0.9}),
        "/stars": (kind: "tex.level", params: {"black": 0.86}, inputs: {"in": "star_noise"}),
        "/star_noise": (kind: "tex.noise", params: {"frequency": 360.0, "octaves": 1}),
        "/stretch": (kind: "chan.lfo", params: {"amplitude": 0.06, "name": "stretch", "offset": 1.0, "phase": 0.5, "rate": 0.9}),
        "/tilt": (kind: "chan.lfo", params: {"amplitude": 6.0, "name": "tilt", "rate": 0.37}),
        "/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}),
        "/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}),
        "/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}),
        "/weave": (kind: "chan.noise", params: {"amplitude": 0.12, "frequency": 0.08, "name": "weave"}),
        "/wobble": (kind: "tex.transform", params: {"extend": "zero", "pivot": [0.5, 0.785]}, inputs: {"in": "body"}, binds: {"rotate": "tilt:tilt", "scale.0": "squash:squash", "scale.1": "stretch:stretch", "translate.0": "weave:weave"}),
    },
)
