// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/block": (kind: "geo.assign_material", inputs: {"in": "box", "mat": "block_lines"}, pos: [400.0, 1368.0]),
        "/block_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [200.0, 1433.0]),
        "/block_places": (kind: "tex.shader", params: {"file": "blocks.wgsl", "height": 20, "keep_size": true, "resolution": "custom", "width": 20}, pos: [400.0, 1497.0]),
        "/block_sizes": (kind: "tex.shader", params: {"file": "blocks.wgsl", "height": 20, "keep_size": true, "output": "scale", "resolution": "custom", "width": 20}, pos: [400.0, 1697.0]),
        "/blocks": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "block", "position": "block_places", "scale": "block_sizes"}, pos: [600.0, 1541.0]),
        "/bob": (kind: "chan.lfo", params: {"amplitude": 0.04, "name": "bob", "offset": 1.2, "rate": 0.45}, pos: [0.0, 426.0]),
        "/box": (kind: "geo.primitive", pos: [200.0, 1304.0]),
        "/camera": (kind: "view.camera", params: {"far": 60.0, "fov": 58.7, "position": [0.0, 0.0, 2.0], "target": [0.0, 10.0, 2.0]}, pos: [800.0, 1222.0]),
        "/ceiling": (kind: "geo.transform", params: {"translate": [0.0, 0.0, 4.0]}, inputs: {"in": "floor"}, pos: [600.0, 1061.0]),
        "/clouds": (kind: "tex.noise", params: {"amplitude": 0.8, "frequency": 2.5, "octaves": 7, "offset": 0.3, "roughness": 0.62, "speed": 0.01}, pos: [0.0, 0.0]),
        "/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}, pos: [400.0, 535.0]),
        "/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}, pos: [200.0, 585.0]),
        "/courier": (kind: "geo.file", params: {"file": "courier.obj", "up": "z"}, pos: [0.0, 1800.0]),
        "/course": (kind: "chan.from_tex", inputs: {"in": "steer"}, pos: [1000.0, 1700.0]),
        "/craft": (kind: "geo.merge", inputs: {"in0": "courier", "in1": "fans"}, pos: [600.0, 1850.0]),
        "/facades": (kind: "geo.tex_instance", params: {"extent": 20.0}, inputs: {"in": "wall", "position": "block_places", "scale": "block_sizes"}, pos: [600.0, 1440.0]),
        "/fade": (kind: "tex.shader", params: {"end": 10.0, "file": "fade.wgsl", "start": 4.0}, inputs: {"in0": "render", "in1": "render:data"}, pos: [1200.0, 1148.0]),
        "/fan": (kind: "geo.file", params: {"file": "fan.obj", "up": "z"}, pos: [0.0, 1900.0]),
        "/fan_places": (kind: "table.text", params: {"format": "csv", "text": "tx,ty,tz,rx,sx\n3.15,4.5,-0.32,-3.44,1\n-3.15,4.5,-0.32,-3.44,-1\n3.15,-4.4,-0.32,6.88,-1\n-3.15,-4.4,-0.32,6.88,1"}, pos: [200.0, 2000.0]),
        "/fan_turn": (kind: "geo.transform", inputs: {"in": "fan"}, binds: {"rotate.2": "spin:spin"}, pos: [200.0, 1900.0]),
        "/fans": (kind: "geo.instance", inputs: {"in": "fan_turn", "table": "fan_places"}, pos: [400.0, 1900.0]),
        "/floor": (kind: "geo.transform", params: {"rotate": [90.0, 0.0, 0.0], "translate": [0.0, 18.0, 0.0]}, inputs: {"in": "grid"}, binds: {"translate.1": "scroll:scroll"}, pos: [400.0, 1023.0]),
        "/glow": (kind: "tex.level", params: {"black": 0.15, "gamma": 0.55, "white": 1.3}, inputs: {"in": "wisps"}, pos: [400.0, 64.0]),
        "/grid": (kind: "geo.assign_material", inputs: {"in": "grid_plane", "mat": "grid_lines"}, pos: [200.0, 1032.0]),
        "/grid_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [0.0, 1143.0]),
        "/grid_plane": (kind: "geo.primitive", params: {"cells": 80, "shape": "plane", "size": [40.0, 1.0, 40.0]}, pos: [0.0, 1015.0]),
        "/nebula": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"layer1": "glow", "layer2": "stars"}, pos: [600.0, 145.0]),
        "/out": (kind: "tex.composite", inputs: {"layer1": "sky", "layer2": "fade"}, pos: [1600.0, 876.0]),
        "/palette": (kind: "tex.cross", inputs: {"a": "warm", "b": "cold"}, binds: {"cross": "season_fade:season"}, pos: [600.0, 402.0]),
        "/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "scene"}, pos: [1000.0, 1131.0]),
        "/scene": (kind: "geo.merge", inputs: {"in0": "floor", "in1": "ceiling", "in2": "blocks", "in3": "ship", "in4": "facades"}, pos: [800.0, 1042.0]),
        "/scroll": (kind: "chan.lfo", params: {"amplitude": -0.25, "name": "scroll", "offset": -0.25, "rate": 2.0833333, "shape": "saw"}, pos: [200.0, 783.0]),
        "/season": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "season", "offset": 0.5, "phase": 0.5, "rate": 0.008333333, "shape": "square"}, pos: [200.0, 1625.0]),
        "/season_fade": (kind: "chan.filter", params: {"fall": 2.0, "rise": 2.0}, inputs: {"in": "season"}, pos: [400.0, 1625.0]),
        "/ship": (kind: "geo.transform", params: {"translate": [0.0, 3.2, 1.2], "uniform": 0.16}, inputs: {"in": "ship_parts"}, binds: {"rotate.1": "course:b", "rotate.2": "course:g", "translate.0": "course:r", "translate.2": "bob:bob"}, pos: [1200.0, 1900.0]),
        "/ship_cover": (kind: "geo.assign_material", inputs: {"in": "craft", "mat": "wall_mat"}, pos: [800.0, 1950.0]),
        "/ship_lines": (kind: "mat.wireframe", params: {"faces": "hidden", "line_width": 2.0}, pos: [600.0, 1950.0]),
        "/ship_paint": (kind: "geo.assign_material", inputs: {"in": "craft", "mat": "ship_lines"}, pos: [800.0, 1850.0]),
        "/ship_parts": (kind: "geo.merge", inputs: {"in0": "ship_paint", "in1": "ship_cover"}, pos: [1000.0, 1900.0]),
        "/sky": (kind: "tex.composite", params: {"op": "color"}, inputs: {"layer1": "nebula", "layer2": "palette"}, pos: [800.0, 254.0]),
        "/spin": (kind: "chan.lfo", params: {"amplitude": 180.0, "name": "spin", "rate": 2.0, "shape": "saw"}, pos: [0.0, 2000.0]),
        "/star_noise": (kind: "tex.noise", params: {"frequency": 360.0, "octaves": 1}, pos: [200.0, 193.0]),
        "/stars": (kind: "tex.level", params: {"black": 0.86}, inputs: {"in": "star_noise"}, pos: [400.0, 193.0]),
        "/steer": (kind: "tex.shader", params: {"file": "blocks.wgsl", "height": 1, "keep_size": true, "output": "steer", "resolution": "custom", "width": 1}, pos: [800.0, 1700.0]),
        "/swirl": (kind: "tex.noise", params: {"color": true, "frequency": 2.0, "height": 540, "seed": 7, "speed": 0.02, "width": 960}, pos: [0.0, 128.0]),
        "/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}, pos: [200.0, 456.0]),
        "/wall": (kind: "geo.assign_material", inputs: {"in": "walls", "mat": "wall_mat"}, pos: [400.0, 1240.0]),
        "/wall_mat": (kind: "mat.occluder", pos: [0.0, 1240.0]),
        "/walls": (kind: "geo.primitive", params: {"size": [0.98, 0.98, 0.98]}, pos: [200.0, 1240.0]),
        "/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}, pos: [400.0, 387.0]),
        "/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}, pos: [200.0, 328.0]),
        "/wisps": (kind: "tex.displace", params: {"extend": "mirror", "weight": [0.08, 0.08]}, inputs: {"in": "clouds", "map": "swirl"}, pos: [200.0, 64.0]),
    },
)
