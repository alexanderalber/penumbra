// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_meters": (kind: "ui.note", params: {"height": 115, "text": "# Meters\n`meters` shows the analysis as meters. View it during the sound check. Transparent around the meters: a `tex.composite` lays it over `show`.", "width": 370}, pos: [0.0, 380.0]),
        "/about_picture": (kind: "ui.note", params: {"height": 135, "text": "# Picture\n`cloud` is grey smoke. `colour` maps it through the palette `ice`: a glow out of black. The dashed green lines are bindings from the channels below.\n- `palette` on `colour`: try `fire`, `magma` or `neon`\n- `b` on `punch`: brightness between kicks (0.6). Lower makes the kicks hit harder", "width": 950}, pos: [600.0, -160.0]),
        "/about_shaping": (kind: "ui.note", params: {"height": 175, "text": "# Shaping the channels\n- `smooth` calms `level`, `low`, `high`: `rise` 0.03 s, `fall` 0.4 s\n- `zoom` adds 1. `low` scales `pump`, `high` raises the saturation in `tint`\n- `kick_fade` turns each kick into a flash that fades (`fall` 0.25 s). `punch` adds 0.6 for `bright`\n- `turn` multiplies `bar` (0 to 1 over a bar) by 360: degrees of hue for `tint`", "width": 600}, pos: [600.0, 395.0]),
        "/about_sound": (kind: "ui.note", params: {"height": 135, "text": "# Sound in\n`mic` reads the default input. `device` picks another; Helpers > Audio lists them. `analysis` turns the sound into channels: `level`, `low`, `high`, `kick`, `bar` and more.\n- No microphone: the picture only drifts", "width": 560}, pos: [0.0, -45.0]),
        "/analysis": (kind: "chan.beat_analysis", inputs: {"audio": "mic"}, pos: [200.0, 256.0]),
        "/bands": (kind: "chan.select", params: {"channels": "level low high"}, inputs: {"in": "analysis"}, pos: [400.0, 142.0]),
        "/bar": (kind: "chan.select", params: {"channels": "bar"}, inputs: {"in": "analysis"}, pos: [400.0, 214.0]),
        "/bright": (kind: "tex.level", inputs: {"in": "tint"}, binds: {"brightness": "punch:kick"}, pos: [1400.0, 14.0]),
        "/cloud": (kind: "tex.noise", params: {"amplitude": 1.0, "frequency": 2.0, "octaves": 4, "offset": 0.25, "roughness": 0.55, "speed": 0.3}, pos: [600.0, 0.0]),
        "/colour": (kind: "tex.lookup", params: {"palette": "ice"}, inputs: {"in": "cloud"}, pos: [800.0, 14.0]),
        "/kick": (kind: "chan.select", params: {"channels": "kick"}, inputs: {"in": "analysis"}, pos: [400.0, 298.0]),
        "/kick_fade": (kind: "chan.filter", params: {"fall": 0.25, "rise": 0.0}, inputs: {"in": "kick"}, pos: [600.0, 298.0]),
        "/label": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "position": [0.5, 0.88], "size": 64.0, "style": "Light", "text": "make some noise"}, pos: [1400.0, 203.0]),
        "/meters": (kind: "tex.null", inputs: {"in": "analysis:meters"}, pos: [400.0, 370.0]),
        "/mic": (kind: "audio.device_in", pos: [0.0, 242.0]),
        "/pump": (kind: "tex.transform", params: {"extend": "mirror"}, inputs: {"in": "colour"}, binds: {"scale.0": "zoom:low", "scale.1": "zoom:low"}, pos: [1000.0, 14.0]),
        "/punch": (kind: "chan.math", params: {"b": 0.6}, inputs: {"a": "kick_fade"}, pos: [800.0, 299.0]),
        "/show": (kind: "tex.composite", inputs: {"in0": "bright", "in1": "label"}, pos: [1600.0, 203.0]),
        "/smooth": (kind: "chan.filter", params: {"fall": 0.4, "rise": 0.03}, inputs: {"in": "bands"}, pos: [600.0, 142.0]),
        "/tint": (kind: "tex.hsv", inputs: {"in": "pump"}, binds: {"hue": "turn:bar", "saturation": "zoom:high"}, pos: [1200.0, 14.0]),
        "/turn": (kind: "chan.math", params: {"b": 360.0, "op": "multiply"}, inputs: {"a": "bar"}, pos: [600.0, 214.0]),
        "/zoom": (kind: "chan.math", params: {"b": 1.0}, inputs: {"a": "smooth"}, pos: [800.0, 142.0]),
    },
)
