// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/analysis": (kind: "chan.audio_analysis", inputs: {"audio": "mic"}, pos: [200.0, 0.0]),
        "/bands": (kind: "chan.select", params: {"channels": "level low high"}, inputs: {"in": "analysis"}, pos: [400.0, 0.0]),
        "/bar": (kind: "chan.select", params: {"channels": "bar"}, inputs: {"in": "analysis"}, pos: [400.0, 142.0]),
        "/bright": (kind: "tex.level", inputs: {"in": "tint"}, binds: {"brightness": "punch:kick"}, pos: [1600.0, 0.0]),
        "/cloud": (kind: "tex.noise", params: {"amplitude": 1.0, "frequency": 2.0, "octaves": 4, "offset": 0.25, "roughness": 0.55, "speed": 0.3}, pos: [800.0, 0.0]),
        "/colour": (kind: "tex.lookup", params: {"palette": "ice"}, inputs: {"in": "cloud"}, pos: [1000.0, 0.0]),
        "/kick": (kind: "chan.select", params: {"channels": "kick"}, inputs: {"in": "analysis"}, pos: [400.0, 284.0]),
        "/kick_fade": (kind: "chan.filter", params: {"fall": 0.25, "rise": 0.0}, inputs: {"in": "kick"}, pos: [600.0, 284.0]),
        "/label": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "position": [0.5, 0.88], "size": 64.0, "style": "Light", "text": "make some noise"}, pos: [1600.0, 142.0]),
        "/meters": (kind: "tex.null", inputs: {"in": "analysis:meters"}, pos: [400.0, 426.0]),
        "/mic": (kind: "chan.audio_in", pos: [0.0, 0.0]),
        "/pump": (kind: "tex.transform", params: {"extend": "mirror"}, inputs: {"in": "colour"}, binds: {"scale.0": "zoom:low", "scale.1": "zoom:low"}, pos: [1200.0, 0.0]),
        "/punch": (kind: "chan.math", params: {"b": 0.6}, inputs: {"a": "kick_fade"}, pos: [800.0, 284.0]),
        "/show": (kind: "tex.composite", inputs: {"layer1": "bright", "layer2": "label"}, pos: [1800.0, 0.0]),
        "/smooth": (kind: "chan.filter", params: {"fall": 0.4, "rise": 0.03}, inputs: {"in": "bands"}, pos: [600.0, 0.0]),
        "/tint": (kind: "tex.hsv", inputs: {"in": "pump"}, binds: {"hue": "turn:bar", "saturation": "zoom:high"}, pos: [1400.0, 0.0]),
        "/turn": (kind: "chan.math", params: {"b": 360.0, "op": "multiply"}, inputs: {"a": "bar"}, pos: [600.0, 142.0]),
        "/zoom": (kind: "chan.math", params: {"b": 1.0}, inputs: {"a": "smooth"}, pos: [800.0, 142.0]),
    },
)
