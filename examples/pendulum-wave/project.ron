// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/accent": (kind: "audio.instrument", params: {"level": -20.0, "preset": "kick", "trigger": "both"}, inputs: {"play": "every_other"}, pos: [750.0, 760.0]),
        "/centre": (kind: "chan.select", params: {"channels": "ring0"}, inputs: {"in": "rings"}, pos: [500.0, 560.0]),
        "/every_other": (kind: "chan.lfo", params: {"name": "accent", "rate": 0.625}, pos: [500.0, 760.0]),
        "/formula": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 1.0], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.5, 0.9256], "size": 26.0, "style": "Italic", "text": "R(t) = | (1/100) Σⱼ e^(2i φⱼ(t)) | = sync", "width": 1080}, pos: [1450.0, 875.0]),
        "/kick": (kind: "audio.instrument", params: {"level": -12.0, "preset": "kick", "trigger": "both"}, inputs: {"play": "centre"}, pos: [750.0, 560.0]),
        "/label_r": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.6], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.2824, 0.7777], "size": 26.0, "style": "Italic", "text": "R", "width": 1080}, pos: [1450.0, 0.0]),
        "/label_t": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.6], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.9148, 0.8557], "size": 26.0, "style": "Italic", "text": "t", "width": 1080}, pos: [1450.0, 125.0]),
        "/labels": (kind: "tex.composite", inputs: {"in0": "label_r", "in1": "label_t", "in2": "tick_5", "in3": "tick_3", "in4": "tick_2", "in5": "tick_2_3", "in6": "tick_4_5", "in7": "formula", "in8": "model"}, pos: [1700.0, 500.0]),
        "/mix": (kind: "audio.mix", inputs: {"in0": "pluck", "in1": "kick", "in2": "accent"}, pos: [1000.0, 450.0]),
        "/model": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.9], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.5, 0.9673], "size": 20.0, "style": "Italic", "text": "φⱼ(t) = 2π (80 − kⱼ) t / T,     kⱼ = ring of pendulum j", "width": 1080}, pos: [1450.0, 1000.0]),
        "/out": (kind: "tex.shader", params: {"file": "pendulums.wgsl", "height": 1102, "keep_size": true, "resolution": "custom", "width": 1080}, inputs: {"in0": "labels"}, pos: [1950.0, 500.0]),
        "/pluck": (kind: "audio.instrument", params: {"key": "F", "level": -22.0, "octave": 3, "preset": "pluck", "trigger": "both"}, inputs: {"play": "rings"}, pos: [500.0, 300.0]),
        "/ring0": (kind: "chan.lfo", params: {"name": "ring0", "rate": 1.25}, pos: [0.0, 900.0]),
        "/ring1": (kind: "chan.lfo", params: {"name": "ring1", "rate": 1.234375}, pos: [0.0, 800.0]),
        "/ring2": (kind: "chan.lfo", params: {"name": "ring2", "rate": 1.21875}, pos: [0.0, 700.0]),
        "/ring3": (kind: "chan.lfo", params: {"name": "ring3", "rate": 1.203125}, pos: [0.0, 600.0]),
        "/ring4": (kind: "chan.lfo", params: {"name": "ring4", "rate": 1.1875}, pos: [0.0, 500.0]),
        "/ring5": (kind: "chan.lfo", params: {"name": "ring5", "rate": 1.171875}, pos: [0.0, 400.0]),
        "/ring6": (kind: "chan.lfo", params: {"name": "ring6", "rate": 1.15625}, pos: [0.0, 300.0]),
        "/ring7": (kind: "chan.lfo", params: {"name": "ring7", "rate": 1.140625}, pos: [0.0, 200.0]),
        "/ring8": (kind: "chan.lfo", params: {"name": "ring8", "rate": 1.125}, pos: [0.0, 100.0]),
        "/ring9": (kind: "chan.lfo", params: {"name": "ring9", "rate": 1.109375}, pos: [0.0, 0.0]),
        "/rings": (kind: "chan.merge", inputs: {"in0": "ring9", "in1": "ring8", "in2": "ring7", "in3": "ring6", "in4": "ring5", "in5": "ring4", "in6": "ring3", "in7": "ring2", "in8": "ring1", "in9": "ring0"}, pos: [250.0, 400.0]),
        "/speakers": (kind: "out.audio", inputs: {"in": "mix"}, pos: [1250.0, 450.0]),
        "/tick_2": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.581, 0.8966], "size": 21.0, "style": "Italic", "text": "T/2", "width": 1080}, pos: [1450.0, 500.0]),
        "/tick_2_3": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.6852, 0.8966], "size": 21.0, "style": "Italic", "text": "2T/3", "width": 1080}, pos: [1450.0, 625.0]),
        "/tick_3": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.4769, 0.8966], "size": 21.0, "style": "Italic", "text": "T/3", "width": 1080}, pos: [1450.0, 375.0]),
        "/tick_4_5": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.7685, 0.8966], "size": 21.0, "style": "Italic", "text": "4T/5", "width": 1080}, pos: [1450.0, 750.0]),
        "/tick_5": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.8], "font": "Noto Serif", "height": 1102, "keep_size": true, "position": [0.3935, 0.8966], "size": 21.0, "style": "Italic", "text": "T/5", "width": 1080}, pos: [1450.0, 250.0]),
    },
)
