// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_picture": (kind: "ui.note", params: {"height": 155, "text": "# Picture\n`out` (`pendulums.wgsl`) computes every pendulum from the show time. Picture and sound stay in step.\n- `direction` on `out`: `across` turns the ripples into stripes\n- `colors` on `out`: `viridis`, `fire`, `sea`\n- `swing`, `glow` on `out`: bind a sound level to them", "width": 560}, pos: [200.0, 620.0]),
        "/about_rings": (kind: "ui.note", params: {"height": 135, "text": "# Rings\n`ring0` to `ring7` are sines, one per ring of pendulums. Ring k swings at (56 - k) / 48 Hz. A value passing 0 is a pendulum passing its rest point. All rings meet at 0 s and 24 s. The loop repeats after 48 s.", "width": 450}, pos: [-480.0, 0.0]),
        "/about_sound": (kind: "ui.note", params: {"height": 155, "text": "# Sound\n`notes` plays a note per lane of `rings` each time it passes 0. Lane 0 is `ring7`: corners A3, centre D5. `hat` follows `ring0` through `centre`. `kick` hits on every other hat (`every_other`, half the rate).\n- `key`, `scale`, `preset` on `notes`: try `pluck` or `bell`\n- `gain1`, `gain2` on `mix`: kick and hat. 0 mutes", "width": 560}, pos: [400.0, -150.0]),
        "/centre": (kind: "chan.select", params: {"channels": "ring0"}, inputs: {"in": "rings"}, pos: [400.0, 366.0]),
        "/every_other": (kind: "chan.lfo", params: {"name": "beat", "rate": 0.5833333333333334}, pos: [400.0, 238.0]),
        "/hat": (kind: "audio.instrument", params: {"level": -26.0, "preset": "hat", "trigger": "both"}, inputs: {"play": "centre"}, pos: [600.0, 338.0]),
        "/kick": (kind: "audio.instrument", params: {"level": -14.0, "preset": "kick", "trigger": "both"}, inputs: {"play": "every_other"}, pos: [600.0, 210.0]),
        "/mix": (kind: "audio.mix", inputs: {"in0": "notes", "in1": "kick", "in2": "hat"}, pos: [800.0, 226.0]),
        "/notes": (kind: "audio.instrument", params: {"key": "A", "level": -20.0, "octave": 3, "preset": "mallet", "scale": "minor_pentatonic", "trigger": "both"}, inputs: {"play": "rings"}, pos: [400.0, 110.0]),
        "/out": (kind: "tex.shader", params: {"file": "pendulums.wgsl", "height": 1080, "keep_size": true, "resolution": "custom", "width": 1080}, pos: [0.0, 624.0]),
        "/ring0": (kind: "chan.lfo", params: {"name": "ring0", "rate": 1.1666666666666667}, pos: [0.0, 504.0]),
        "/ring1": (kind: "chan.lfo", params: {"name": "ring1", "rate": 1.1458333333333333}, pos: [0.0, 432.0]),
        "/ring2": (kind: "chan.lfo", params: {"name": "ring2", "rate": 1.125}, pos: [0.0, 360.0]),
        "/ring3": (kind: "chan.lfo", params: {"name": "ring3", "rate": 1.1041666666666667}, pos: [0.0, 288.0]),
        "/ring4": (kind: "chan.lfo", params: {"name": "ring4", "rate": 1.0833333333333333}, pos: [0.0, 216.0]),
        "/ring5": (kind: "chan.lfo", params: {"name": "ring5", "rate": 1.0625}, pos: [0.0, 144.0]),
        "/ring6": (kind: "chan.lfo", params: {"name": "ring6", "rate": 1.0416666666666667}, pos: [0.0, 72.0]),
        "/ring7": (kind: "chan.lfo", params: {"name": "ring7", "rate": 1.0208333333333333}, pos: [0.0, 0.0]),
        "/rings": (kind: "chan.merge", inputs: {"in0": "ring7", "in1": "ring6", "in2": "ring5", "in3": "ring4", "in4": "ring3", "in5": "ring2", "in6": "ring1", "in7": "ring0"}, pos: [200.0, 198.0]),
        "/speakers": (kind: "out.audio", inputs: {"in": "mix"}, pos: [1000.0, 254.0]),
    },
)
