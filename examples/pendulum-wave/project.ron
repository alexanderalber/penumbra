// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/centre": (kind: "chan.select", params: {"channels": "ring0"}, inputs: {"in": "rings"}, pos: [500.0, 560.0]),
        "/every_other": (kind: "chan.lfo", params: {"name": "beat", "rate": 0.5833333333333334}, pos: [500.0, 760.0]),
        "/hat": (kind: "audio.instrument", params: {"level": -26.0, "preset": "hat", "trigger": "both"}, inputs: {"play": "centre"}, pos: [750.0, 560.0]),
        "/kick": (kind: "audio.instrument", params: {"level": -14.0, "preset": "kick", "trigger": "both"}, inputs: {"play": "every_other"}, pos: [750.0, 760.0]),
        "/mix": (kind: "audio.mix", inputs: {"in0": "notes", "in1": "kick", "in2": "hat"}, pos: [1000.0, 450.0]),
        "/notes": (kind: "audio.instrument", params: {"key": "A", "level": -20.0, "octave": 3, "preset": "mallet", "scale": "minor_pentatonic", "trigger": "both"}, inputs: {"play": "rings"}, pos: [500.0, 300.0]),
        "/out": (kind: "tex.shader", params: {"file": "pendulums.wgsl", "height": 1080, "keep_size": true, "resolution": "custom", "width": 1080}, pos: [1250.0, 150.0]),
        "/ring0": (kind: "chan.lfo", params: {"name": "ring0", "rate": 1.1666666666666667}, pos: [0.0, 700.0]),
        "/ring1": (kind: "chan.lfo", params: {"name": "ring1", "rate": 1.1458333333333333}, pos: [0.0, 600.0]),
        "/ring2": (kind: "chan.lfo", params: {"name": "ring2", "rate": 1.125}, pos: [0.0, 500.0]),
        "/ring3": (kind: "chan.lfo", params: {"name": "ring3", "rate": 1.1041666666666667}, pos: [0.0, 400.0]),
        "/ring4": (kind: "chan.lfo", params: {"name": "ring4", "rate": 1.0833333333333333}, pos: [0.0, 300.0]),
        "/ring5": (kind: "chan.lfo", params: {"name": "ring5", "rate": 1.0625}, pos: [0.0, 200.0]),
        "/ring6": (kind: "chan.lfo", params: {"name": "ring6", "rate": 1.0416666666666667}, pos: [0.0, 100.0]),
        "/ring7": (kind: "chan.lfo", params: {"name": "ring7", "rate": 1.0208333333333333}, pos: [0.0, 0.0]),
        "/rings": (kind: "chan.merge", inputs: {"in0": "ring7", "in1": "ring6", "in2": "ring5", "in3": "ring4", "in4": "ring3", "in5": "ring2", "in6": "ring1", "in7": "ring0"}, pos: [250.0, 350.0]),
        "/speakers": (kind: "out.audio", inputs: {"in": "mix"}, pos: [1250.0, 450.0]),
    },
)
