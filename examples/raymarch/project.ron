// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_look": (kind: "ui.note", params: {"height": 200, "text": "# Choosing the look\nDrag the slider on `look`: 0 is the tunnel, 1 the morph, 2 the fractal. Between two numbers `looks` crossfades. A look that is not shown is not cooked.\n- On each shader, leave `speed` and `orbit` alone: changing them live makes the camera jump. Bind `travel` or `phase` instead\n- Keep `power` on `fractal` a whole number", "width": 560}, pos: [1500.0, -420.0]),
        "/about_output": (kind: "ui.note", params: {"height": 160, "text": "# Picture out\n`bright_parts` keeps what is brighter than `black`. `halo` blurs it, and `out` adds it back as a glow.\n- `screen` shows `out`: tick `active` for a window, untick `window` for fullscreen on a display\n- Cheaper: lower `steps` under `look` on each shader, or `width` and `height`", "width": 620}, pos: [2140.0, -180.0]),
        "/about_shaping": (kind: "ui.note", params: {"height": 215, "text": "# Shaping\n- `level`: loudness that falls in 0.45 s, for `energy`\n- `hit`: each kick with a 0.22 s fade, for `flash` and `kick`\n- `flight`: the level summed up. It only grows, so the camera never jumps. For `travel` and `phase`. `b` on `rate` sets how far the music pushes it\n- `orbit`: the level summed into degrees, for `orbit_angle`\n- `soft`: `slow_level` plus 0.45, how softly the morph melts
- `slow_level`, `hue`, `julia`: slow changes", "width": 620}, pos: [740.0, -240.0]),
        "/about_sound": (kind: "ui.note", params: {"height": 180, "text": "# Sound in\n`song` is a placeholder beat built from sound nodes: kick, hat and pluck at 128 BPM. Every 7.5 s the kick stops for 7.5 s. `analysis` hears it the way it would hear a microphone.\n- Real music: add an `audio.device_in` (Tab > audio > device_in) and wire it into `audio` on `analysis`", "width": 500}, pos: [-20.0, -160.0]),
        "/analysis": (kind: "chan.beat_analysis", inputs: {"audio": "song/out"}, pos: [260.0, 214.0]),
        "/bright_parts": (kind: "tex.level", params: {"black": 0.55}, inputs: {"in": "looks"}, pos: [2140.0, 360.0]),
        "/flight": (kind: "chan.integrator", inputs: {"in": "rate"}, pos: [1240.0, 300.0]),
        "/fractal": (kind: "tex.shader", params: {"file": "fractal.wgsl", "keep_size": true, "resolution": "custom"}, binds: {"energy": "level:level", "hue": "hue:hue", "julia": "julia:julia", "kick": "hit:kick", "morph": "slow_level:level", "orbit_angle": "orbit:level", "phase": "flight:level"}, pos: [1600.0, 560.0]),
        "/halo": (kind: "tex.blur", params: {"size": 48.0}, inputs: {"in": "bright_parts"}, pos: [2380.0, 360.0]),
        "/hit": (kind: "chan.filter", params: {"fall": 0.22, "rise": 0.03}, inputs: {"in": "kick_only"}, pos: [760.0, 120.0]),
        "/hue": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "hue", "offset": 0.5, "rate": 0.021}, pos: [1000.0, 540.0]),
        "/julia": (kind: "chan.lfo", params: {"amplitude": 0.35, "name": "julia", "offset": 0.35, "rate": 0.05}, pos: [1000.0, 640.0]),
        "/kick_only": (kind: "chan.select", params: {"channels": "kick"}, inputs: {"in": "analysis"}, pos: [520.0, 200.0]),
        "/level": (kind: "chan.filter", params: {"fall": 0.45, "rise": 0.05}, inputs: {"in": "level_only"}, pos: [760.0, 0.0]),
        "/level_only": (kind: "chan.select", params: {"channels": "level"}, inputs: {"in": "analysis"}, pos: [520.0, 80.0]),
        "/look": (kind: "chan.slider", params: {"label": "look: tunnel, morph, fractal", "max": 2.0, "name": "look", "show": true}, pos: [1600.0, -180.0]),
        "/looks": (kind: "tex.switch", params: {"blend": true, "inactive": "skip"}, inputs: {"in0": "tunnel", "in1": "morph", "in2": "fractal"}, binds: {"index": "look:look"}, pos: [1900.0, 240.0]),
        "/morph": (kind: "tex.shader", params: {"file": "morph.wgsl", "keep_size": true, "resolution": "custom"}, binds: {"blend": "soft:level", "energy": "level:level", "hue": "hue:hue", "kick": "hit:kick", "orbit_angle": "orbit:level", "phase": "flight:level"}, pos: [1600.0, 280.0]),
        "/orbit": (kind: "chan.integrator", params: {"limit": "loop", "max": 180.0, "min": -180.0}, inputs: {"in": "turn_rate"}, pos: [1240.0, 420.0]),
        "/out": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "looks", "in1": "halo"}, pos: [2620.0, 240.0]),
        "/rate": (kind: "chan.math", params: {"b": 1.2, "op": "multiply"}, inputs: {"a": "level"}, pos: [1000.0, 300.0]),
        "/screen": (kind: "out.projector", params: {"active": false, "window": true}, inputs: {"in": "out"}, pos: [2860.0, 240.0]),
        "/slow_level": (kind: "chan.filter", params: {"fall": 4.0, "rise": 1.5}, inputs: {"in": "level_only"}, pos: [760.0, 240.0]),
        "/soft": (kind: "chan.math", params: {"b": 0.45, "op": "add"}, inputs: {"a": "slow_level"}, pos: [1000.0, 180.0]),
        "/song": (kind: "comp.base", pos: [0.0, 200.0]),
        "/song/break": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "kick_on", "offset": 0.5, "rate": 0.06666666666666667, "shape": "square"}, pos: [0.0, 360.0]),
        "/song/hat": (kind: "audio.instrument", params: {"decay": 0.15, "level": -26.0, "preset": "hat"}, inputs: {"play": "hat_time"}, pos: [300.0, 90.0]),
        "/song/hat_time": (kind: "chan.lfo", params: {"name": "hat", "phase": 0.5, "rate": 2.1333333333333333}, pos: [0.0, 90.0]),
        "/song/kick": (kind: "audio.instrument", params: {"level": -8.0, "preset": "kick"}, inputs: {"play": "kick_time"}, pos: [300.0, 0.0]),
        "/song/kick_time": (kind: "chan.lfo", params: {"name": "kick", "rate": 2.1333333333333333}, pos: [0.0, 0.0]),
        "/song/melody": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "note", "offset": 0.5, "rate": 0.17}, pos: [0.0, 270.0]),
        "/song/mix": (kind: "audio.mix", inputs: {"in0": "kick", "in1": "hat", "in2": "pluck"}, binds: {"gain0": "break"}, pos: [600.0, 90.0]),
        "/song/out": (kind: "audio.out", inputs: {"in": "mix"}, pos: [900.0, 90.0]),
        "/song/pluck": (kind: "audio.instrument", params: {"brightness": 0.7, "decay": 0.22, "key": "A", "level": -14.0, "octave": 4, "range": 1.5, "scale": "minor_pentatonic"}, inputs: {"play": "pluck_time"}, binds: {"note": "melody"}, pos: [300.0, 180.0]),
        "/song/pluck_time": (kind: "chan.lfo", params: {"name": "pluck", "rate": 4.266666666666667}, pos: [0.0, 180.0]),
        "/tunnel": (kind: "tex.shader", params: {"file": "tunnel.wgsl", "keep_size": true, "resolution": "custom"}, binds: {"energy": "level:level", "flash": "hit:kick", "hue": "hue:hue", "travel": "flight:level"}, pos: [1600.0, 0.0]),
        "/turn_rate": (kind: "chan.math", params: {"b": 14.0, "op": "multiply"}, inputs: {"a": "level"}, pos: [1000.0, 420.0]),
    },
)
