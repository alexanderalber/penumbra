// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_bodies": (kind: "ui.note", params: {"height": 230, "text": "# The bodies\n`boxes` and `balls` are two groups of `solver`, a `physics.rigid_bodies` with `plane` xz: the bodies stay on the wall that `camera` looks at.\n- Each table of places goes into `table` and `targets`. `pull` on both groups is bound to `form`, a square LFO: 3 s held above the pool, then 8 s free, 8 s held, and so on\n- `stirrer` is a driven bar. `turn`, a saw LFO named `ry`, turns it at 72 degrees a second", "width": 500}, pos: [-560.0, 60.0]),
        "/about_liquid": (kind: "ui.note", params: {"height": 280, "text": "# Bodies in the liquid\n- `solver` draws the bodies through `camera` as `mask` and `velocity`, at the liquid\'s size\n- `solid` puts the bodies\' `mask` and `walls_mask` together. It goes into `obstacles` of `liquid`\n- `velocity` goes into `obstacle_velocity`: the bodies push the water as they move and turn\n- The water does not push the bodies back: they sink to the floor. `damping` 8 on `solver` slows every body, in the air too, to at most 1.2 m/s, so they do not hit the floor hard", "width": 500}, pos: [1320.0, -460.0]),
        "/about_try": (kind: "ui.note", params: {"height": 210, "text": "# Try\n- `damping` on `solver`: at 1.5 the bodies hit the floor fast, and the squeezed water spurts up\n- `rate` on `turn`: a faster stirrer\n- Unwire `obstacle_velocity` of `liquid`: the bodies only take the water\'s place\n- `reset` on `liquid` fills the pool again", "width": 500}, pos: [1760.0, 380.0]),
        "/about_walls": (kind: "ui.note", params: {"height": 190, "text": "# The basin\n`left` and `right` place `wall` twice; `walls` merges them. `walls` goes into `obstacles` of `solver`, so the bodies stay in the basin. `walls_mask` draws the walls white through `camera`, so the liquid sees the same basin", "width": 500}, pos: [-560.0, -260.0]),
        "/ball": (kind: "geo.primitive", params: {"segments": 32, "shape": "sphere"}, pos: [0.0, 300.0]),
        "/ball_look": (kind: "geo.assign_material", inputs: {"in": "ball", "mat": "ball_paint"}, pos: [220.0, 340.0]),
        "/ball_paint": (kind: "mat.constant", params: {"color": [0.95, 0.8, 0.2, 1.0]}, pos: [0.0, 380.0]),
        "/ball_places": (kind: "table.text", params: {"format": "csv", "text": "tx,ty,tz,sx,sy,sz\n-1.25,0,2.15,0.34,0.34,0.34\n-0.25,0,1.7,0.289,0.289,0.289\n0.75,0,2.25,0.323,0.323,0.323\n1.65,0,1.9,0.357,0.357,0.357"}, pos: [220.0, 250.0]),
        "/balls": (kind: "physics.bodies", params: {"bounce": 0.2, "shape": "sphere"}, inputs: {"model": "ball_look", "table": "ball_places", "targets": "ball_places"}, binds: {"pull": "form"}, pos: [440.0, 300.0]),
        "/bar_look": (kind: "geo.assign_material", inputs: {"in": "box", "mat": "bar_paint"}, pos: [440.0, 700.0]),
        "/bar_paint": (kind: "mat.constant", params: {"color": [0.55, 0.6, 0.68, 1.0]}, pos: [220.0, 700.0]),
        "/bodies": (kind: "tex.render", params: {"height": 720, "width": 1280}, inputs: {"camera": "camera", "geo": "solver"}, pos: [1100.0, 260.0]),
        "/box": (kind: "geo.primitive", pos: [0.0, 120.0]),
        "/box_look": (kind: "geo.assign_material", inputs: {"in": "box", "mat": "box_paint"}, pos: [220.0, 160.0]),
        "/box_paint": (kind: "mat.constant", params: {"color": [0.95, 0.45, 0.12, 1.0]}, pos: [0.0, 200.0]),
        "/box_places": (kind: "table.text", params: {"format": "csv", "text": "tx,ty,tz,rx,ry,rz,sx,sy,sz\n-1.7,0,1.85,0,15,0,0.357,0.357,0.357\n-0.75,0,2.05,0,-20,0,0.306,0.306,0.306\n0.3,0,1.8,0,40,0,0.391,0.391,0.391\n1.05,0,2.1,0,0,0,0.289,0.289,0.289"}, pos: [220.0, 60.0]),
        "/boxes": (kind: "physics.bodies", params: {"shape": "box"}, inputs: {"model": "box_look", "table": "box_places", "targets": "box_places"}, binds: {"pull": "form"}, pos: [440.0, 120.0]),
        "/camera": (kind: "view.camera", params: {"position": [0.0, -10.0, 1.5], "projection": "orthographic", "size": 3.0, "target": [0.0, 0.0, 1.5]}, pos: [0.0, -260.0]),
        "/dry": (kind: "tex.composite", inputs: {"in0": "scene", "in1": "bodies"}, pos: [1540.0, 300.0]),
        "/form": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "pull", "offset": 0.5, "phase": 0.3, "rate": 0.0625, "shape": "square"}, pos: [220.0, 440.0]),
        "/left": (kind: "geo.transform", params: {"translate": [-2.57, 0.0, 1.5]}, inputs: {"in": "wall"}, pos: [220.0, -140.0]),
        "/liquid": (kind: "tex.liquid", params: {"height": 720, "particles": 147456, "width": 1280}, inputs: {"fill": "pool", "obstacle_velocity": "solver:velocity", "obstacles": "solid"}, pos: [1320.0, 60.0]),
        "/out": (kind: "tex.composite", inputs: {"in0": "dry", "in1": "liquid"}, pos: [1760.0, 180.0]),
        "/pool": (kind: "tex.shapes", params: {"height": 720, "shapes": "pool rect 0,0.55 1,0.45", "width": 1280}, pos: [880.0, -220.0]),
        "/right": (kind: "geo.transform", params: {"translate": [2.57, 0.0, 1.5]}, inputs: {"in": "wall"}, pos: [220.0, -60.0]),
        "/scene": (kind: "tex.composite", params: {"op": "maximum"}, inputs: {"in0": "sky", "in1": "stone"}, pos: [1320.0, 400.0]),
        "/sky": (kind: "tex.ramp", params: {"height": 720, "keys": "0 0.004 0.005 0.012\n1 0.03 0.045 0.09", "shape": "vertical", "width": 1280}, pos: [1100.0, 360.0]),
        "/solid": (kind: "tex.composite", params: {"op": "maximum"}, inputs: {"in0": "walls_mask", "in1": "solver:mask"}, pos: [1100.0, -60.0]),
        "/solver": (kind: "physics.rigid_bodies", params: {"damping": 8.0, "height": 720, "plane": "xz", "spin_damping": 1.0, "substeps": 2, "width": 1280}, inputs: {"bodies0": "boxes", "bodies1": "balls", "bodies2": "stirrer", "camera": "camera", "obstacles": "walls"}, pos: [880.0, 260.0]),
        "/stirrer": (kind: "physics.bodies", params: {"mode": "driven", "shape": "box"}, inputs: {"model": "bar_look", "table": "stirrer_table"}, pos: [660.0, 640.0]),
        "/stirrer_place": (kind: "chan.constant", params: {"name0": "tx", "name1": "tz", "name2": "sx", "name3": "sz", "rows": 4, "value0": 1.35, "value1": 0.55, "value2": 0.9, "value3": 0.1}, pos: [0.0, 640.0]),
        "/stirrer_row": (kind: "chan.merge", inputs: {"in0": "stirrer_place", "in1": "turn"}, pos: [220.0, 600.0]),
        "/stirrer_table": (kind: "table.from_chan", inputs: {"in": "stirrer_row"}, pos: [440.0, 600.0]),
        "/stone": (kind: "tex.level", params: {"brightness": 0.3}, inputs: {"in": "walls_mask"}, pos: [1100.0, 440.0]),
        "/turn": (kind: "chan.lfo", params: {"amplitude": 180.0, "name": "ry", "offset": 180.0, "rate": 0.2, "shape": "saw"}, pos: [0.0, 560.0]),
        "/wall": (kind: "geo.primitive", params: {"size": [0.3, 1.0, 3.0]}, pos: [0.0, -100.0]),
        "/walls": (kind: "geo.merge", inputs: {"in0": "left", "in1": "right"}, pos: [440.0, -100.0]),
        "/walls_mask": (kind: "tex.render", params: {"height": 720, "width": 1280}, inputs: {"camera": "camera", "geo": "walls_white"}, pos: [880.0, -100.0]),
        "/walls_white": (kind: "geo.assign_material", inputs: {"in": "walls", "mat": "white"}, pos: [660.0, -60.0]),
        "/white": (kind: "mat.constant", pos: [440.0, -10.0]),
    },
)
