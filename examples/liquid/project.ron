// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_look": (kind: "ui.note", params: {"height": 170, "text": "# The look\n- `wet`: the `out` of `liquid` over `scene`, the sky and the grey solids. `out` is transparent around the liquid\n- `glow`: the `foam` output, blurred and added in `out`", "width": 500}, pos: [1100.0, -420.0]),
        "/about_pour": (kind: "ui.note", params: {"height": 200, "text": "# Where it pours from\n- `tap1` to `tap3` pour water onto the word\n- `sand_tap` pours sand onto the shelf at the right. The heap grows to its angle and spills off the shelf\n- `edges` on `liquid` is `open`: what leaves the picture pours again from the emitters. The drain in the basin\'s floor holds the water level", "width": 500}, pos: [-560.0, -420.0]),
        "/about_push": (kind: "ui.note", params: {"height": 260, "text": "# What pushes it\n- `wind` goes into `force`. `turbulence`, a morphing noise, makes the eddies. `gust`, an LFO bound to the red `bias` of `wind`, blows left and right every 12.5 s. Green is 0, so the wind blows sideways only\n- `paddle` goes into `splats`: one row with `x` and `vx` from two LFOs, and `y`. `splat_motion` is `set`, so the water in the paddle\'s radius moves with it", "width": 500}, pos: [-560.0, 250.0]),
        "/about_solid": (kind: "ui.note", params: {"height": 190, "text": "# What it lands on\n`word` and `shapes` (the basin with its drain, and the shelf) are put together in `solid`. White is solid.\n- `solid` goes into `obstacles` of `liquid`\n- `stone` shows the same picture in grey", "width": 500}, pos: [-560.0, -120.0]),
        "/about_try": (kind: "ui.note", params: {"height": 230, "text": "# Try\n- `force` on `liquid`: 0 stops the wind, more blows harder\n- `splat_motion` on `liquid`: `push`, and the paddle only nudges the water\n- `material` on `sand_tap`: `snow`\n- `viscosity` on `liquid`: 0.001 pours like honey\n- `reset` on `liquid` empties it", "width": 500}, pos: [1100.0, 440.0]),
        "/depth": (kind: "chan.constant", params: {"name0": "y", "value0": 0.83}, pos: [0.0, 680.0]),
        "/glow": (kind: "tex.blur", params: {"size": 10.0}, inputs: {"in": "liquid:foam"}, pos: [880.0, 300.0]),
        "/glow_level": (kind: "tex.level", params: {"brightness": 0.6}, inputs: {"in": "glow"}, pos: [1100.0, 300.0]),
        "/gust": (kind: "chan.lfo", params: {"amplitude": 0.002, "name": "gust", "rate": 0.08}, pos: [0.0, 400.0]),
        "/liquid": (kind: "tex.liquid", params: {"edges": "open", "friction": 1.0, "height": 720, "splat_motion": "set", "width": 1280}, inputs: {"emitter0": "tap1", "emitter1": "tap2", "emitter2": "tap3", "emitter3": "sand_tap", "force": "wind", "obstacles": "solid", "splats": "paddle"}, pos: [660.0, 120.0]),
        "/out": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "wet", "in1": "glow_level"}, pos: [1320.0, 120.0]),
        "/paddle": (kind: "table.from_chan", inputs: {"in": "paddle_place"}, pos: [440.0, 590.0]),
        "/paddle_place": (kind: "chan.merge", inputs: {"in0": "sweep", "in1": "sweep_speed", "in2": "depth"}, pos: [220.0, 590.0]),
        "/sand_tap": (kind: "tex.liquid_emitter", params: {"material": "sand", "position": [0.955, 0.02], "speed": 0.4, "width": 0.025}, pos: [220.0, -160.0]),
        "/scene": (kind: "tex.composite", params: {"op": "maximum"}, inputs: {"in0": "sky", "in1": "stone"}, pos: [880.0, -130.0]),
        "/shapes": (kind: "tex.shapes", params: {"height": 720, "shapes": "# the basin: two halves with a drain between them\nbasin poly 0.14,0.56 0.17,0.56 0.23,0.885 0.415,0.885 0.415,0.93 0.20,0.93\nbasin poly 0.76,0.56 0.73,0.56 0.67,0.885 0.485,0.885 0.485,0.93 0.70,0.93\n# the shelf for the sand\nshelf rect 0.89,0.62 0.2,0.025", "width": 1280}, pos: [0.0, 110.0]),
        "/sky": (kind: "tex.ramp", params: {"height": 720, "keys": "0 0.004 0.005 0.012\n1 0.03 0.045 0.09", "shape": "vertical", "width": 1280}, pos: [660.0, -200.0]),
        "/solid": (kind: "tex.composite", params: {"op": "maximum"}, inputs: {"in0": "shapes", "in1": "word"}, pos: [220.0, 50.0]),
        "/stone": (kind: "tex.level", params: {"brightness": 0.32}, inputs: {"in": "solid"}, pos: [440.0, -60.0]),
        "/sweep": (kind: "chan.lfo", params: {"amplitude": 0.17, "name": "x", "offset": 0.45, "rate": 0.12}, pos: [0.0, 520.0]),
        "/sweep_speed": (kind: "chan.lfo", params: {"amplitude": 0.12817698012, "name": "vx", "phase": 0.25, "rate": 0.12}, pos: [0.0, 600.0]),
        "/tap1": (kind: "tex.liquid_emitter", params: {"position": [0.3, 0.17], "speed": 0.45}, pos: [220.0, -400.0]),
        "/tap2": (kind: "tex.liquid_emitter", params: {"position": [0.45, 0.17], "speed": 0.45}, pos: [220.0, -320.0]),
        "/tap3": (kind: "tex.liquid_emitter", params: {"position": [0.6, 0.17], "speed": 0.45}, pos: [220.0, -240.0]),
        "/turbulence": (kind: "tex.noise", params: {"amplitude": 1.0, "frequency": 2.0, "height": 36, "octaves": 2, "offset": 0.0, "speed": 0.5, "width": 64}, pos: [0.0, 260.0]),
        "/wet": (kind: "tex.composite", inputs: {"in0": "scene", "in1": "liquid"}, pos: [1100.0, 40.0]),
        "/wind": (kind: "tex.channel_mix", params: {"blue": [0.0, 0.0, 0.0, 0.0], "green": [0.0, 0.0, 0.0, 0.0], "red": [0.0015, 0.0, 0.0, 0.0]}, inputs: {"in": "turbulence"}, binds: {"bias.0": "gust"}, pos: [220.0, 280.0]),
        "/word": (kind: "tex.text", params: {"height": 720, "position": [0.45, 0.36], "size": 150.0, "style": "Bold", "text": "penumbra", "width": 1280}, pos: [0.0, 0.0]),
    },
)
