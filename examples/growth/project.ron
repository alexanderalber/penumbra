// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 220, "text": "# Growth: frost, branches, colonies\n`growth` is the library component `growth`. Choose a `preset` on it: the preset writes its values into the params below, then tune any of them. A new preset starts over by itself.\nKey 0 starts it over (`keys` is bound to `growth`\'s `reset`). Click into the editor once so it gets the keys. Presets with `auto_restart` start over by themselves when the picture is full.\nStand-ins: `word` is the mask input (a scan mask of the object in an installation), `blob` the heat input (tex.blob_track of the people; frost melts there), `points` the dots input (bright points; preset `dots`).\n`/out` shows the picture. `growth`\'s channel output `coverage` is the share of the area that is covered.", "width": 1050}, pos: [-300.0, -400.0]),
        "/blob": (kind: "tex.primitive", params: {"shape": "ellipse", "size": [0.16, 0.16], "softness": 60.0}, binds: {"center.0": "x:x", "center.1": "y:y"}, pos: [-500.0, 90.0]),
        "/growth": (kind: "comp.base", params: {"about": "Growth: frost crystals that melt where people stand, coral and lightning trees (DLA, diffusion-limited aggregation), lichen, mould and rust colonies; it starts on the edges of a mask.", "params": "@param preset choice(window|snowflake|fern|edges|dots|trail|coral|lightning|lichen|mould|rust) = window -- what grows and how: frost (window, snowflake, fern, edges, dots, trail), branches (coral, lightning), colonies (lichen, mould, rust); choosing one writes its values into the params, then they are yours; a new preset starts over\n@param seed int = 1 0..1000 -- another random start; a change starts over\n@param speed float = 1 0.1..4 -- steps per frame as a share of steps, at least one; 2 grows twice as fast and costs twice as much\n@expose heat = step.heat\n@expose afterglow = step.afterglow\n@expose pause = step.pause\n@group restart\n@param auto_restart bool = false -- starts over by itself once the share full has been covered for hold seconds\n@param full float = 0.97 0..1 -- share of the area that counts as full\n@param hold float = 5 0..120 -- seconds a full picture stays before it starts over\n@group setup\n@param model choice(frost|branch|lichen) = frost -- what grows: frost crystals, a branching tree, spreading colonies; a change starts over\n@param area choice(all|inside|outside) = all -- where it may grow; all: everywhere; inside: only where the mask is bright; outside: only where it is dark\n@param pattern choice(centre|scatter|edges|colonies|bottom|empty) = empty -- what is there at the start; centre: one seed in the middle; scatter, colonies: count seeds at random places; edges: the mask\'s edges; bottom: the bottom row; empty: nothing, seeds come later; a change starts over\n@param count int = 12 1..200 -- seeds of the patterns scatter and colonies; a change starts over\n@param radius float = 4 1..40 -- size of a seed at the start, in texels; a change starts over\n@param steps int = 12 1..64 -- simulation steps per frame at speed 1\n@expose edge_seeds = step.edge_seeds\n@expose dot_seeds = step.dot_seeds\n@expose spawn = step.spawn\n@group frost\n@expose arms = step.arms\n@expose aniso = step.aniso\n@expose latent = step.latent\n@expose noise = step.noise\n@expose dt = step.dt\n@expose zoom = step.zoom\n@expose cool = step.cool\n@expose icecool = step.icecool\n@expose ambient = step.ambient\n@expose spell = step.spell\n@expose spell_depth = step.spell_depth\n@group branch and lichen\n@expose eta = step.eta\n@expose grow = step.grow\n@expose supply = step.supply\n@expose lifespan = step.lifespan\n@expose spread = step.spread\n@expose ragged = step.ragged\n@expose recover = step.recover\n@group look\n@expose through = show.through\n@expose warm = show.warm\n@expose colors = show.colors\n@expose gain = show.gain\n@expose background = show.background\n@expose tint = show.tint\n@expose rim = show.rim\n@expose sparkle = show.sparkle\n@expose spines = show.spines\n@expose spine_width = show.spine_width\n@expose relief = show.relief\n@expose light = show.light\n@expose thicken = show.thicken\n@expose fade = show.fade\n@expose rings = show.rings\n@expose food = show.food\n@expose mode = show.mode\n@expose out_width = show.width\n@expose out_height = show.height\n@group size\n@param width int = 960 16..4096 -- simulation width in texels; a change starts over\n@param height int = 540 16..4096 -- simulation height in texels; a change starts over\n@reset preset seed model pattern count radius width height\n@preset preset=* model=frost area=all pattern=empty count=12 radius=4 steps=12 auto_restart=false full=0.97 hold=5\n@preset preset=* edge_seeds=0 dot_seeds=false spawn=0 heat=1 afterglow=0\n@preset preset=* arms=6 aniso=0.05 latent=2.2 noise=0.3 dt=0.2 zoom=1 cool=0.3 icecool=6 ambient=0 spell=0 spell_depth=1.5\n@preset preset=* eta=1.5 grow=0.05 supply=0.00002 lifespan=0 spread=0.02 ragged=0.8 recover=20\n@preset preset=* through=0.25 warm=0.25 colors=0b2a4a 3a7bd5 9fd8ff ffffff\n@preset preset=window edge_seeds=0.03 spawn=0.03 spell=60 -- window frost: crystals start on the mask\'s edges and here and there, cover the glass in about 20 s, melt in a warm spell every 60 s and grow again; people melt paths\n@preset preset=snowflake pattern=centre steps=32 auto_restart=true full=0.49 hold=20 latent=2 cool=0 heat=0 through=0 warm=0 -- one six-armed crystal from the centre in still, cold air; it stops at about half the picture and starts over 20 s later; people do not melt it\n@preset preset=fern edge_seeds=0.03 arms=4 aniso=0.06 spell=60 -- four-armed, strongly aligned frost from the mask\'s edges only, with warm spells\n@preset preset=edges edge_seeds=0.05 auto_restart=true heat=0 warm=0 -- frost from the mask\'s edges only; it covers everything in about 20 s and starts over; people do not melt it\n@preset preset=dots dot_seeds=true steps=24 auto_restart=true cool=0.1 icecool=0 heat=0 through=0 warm=0 -- one crystal from each bright point of the dots input; people do not melt it\n@preset preset=trail edge_seeds=0.03 spawn=0.03 auto_restart=true full=0.985 -- window frost without warm spells: what people melt is the only change; full, it starts over\n@preset preset=coral model=branch area=outside pattern=bottom steps=16 auto_restart=true full=0.16 edge_seeds=0.5 eta=1 grow=0.03 colors=2a0b12 8c2a2a e86a4a ffc39a fff2e0 -- ragged coral trees from the mask\'s edges and the bottom, not into the mask\n@preset preset=lightning model=branch pattern=centre steps=32 auto_restart=true full=0.05 eta=3 grow=0.3 supply=0.002 heat=0 warm=0 colors=0b1030 3040a0 80a0ff e0e8ff ffffff -- one thin tree from the centre, a Lichtenberg figure; people do not harm it\n@preset preset=lichen model=lichen pattern=colonies count=14 steps=4 spawn=0.5 lifespan=60 heat=0 warm=0 colors=9db35a d9c35a c97a3a 6f9c8a b8b8a0 e0a060 -- 14 colonies spread with growth rings, stop where they meet, die from their centres after about a minute and are grown over; people do not harm them\n@preset preset=mould model=lichen area=inside steps=8 auto_restart=true edge_seeds=0.15 spawn=1 spread=0.06 ragged=0.4 colors=cfd8c0 a8c48a e8e0c8 7a9a6a -- pale colonies inside the mask only; people wipe them away\n@preset preset=rust model=lichen steps=4 auto_restart=true edge_seeds=0.4 spread=0.012 ragged=1 colors=8a3a12 b4561e d07a2a 6a2a10 -- rust patches spread from the mask\'s edges; people wipe them away", "shelf": "simulations"}, binds: {"reset": "keys:key_0"}, pos: [300.0, 0.0]),
        "/growth/allowed": (kind: "chan.select", params: {"channels": "g"}, inputs: {"in": "measure"}, pos: [1000.0, 260.0]),
        "/growth/armed": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "full_now"}, binds: {"b": "parent.auto_restart"}, pos: [1800.0, 340.0]),
        "/growth/cover": (kind: "tex.shader", params: {"file": "library/growth/cover.wgsl", "keep_size": true}, inputs: {"in0": "step", "in1": "mask"}, binds: {"area": "parent.area", "model": "parent.model"}, pos: [600.0, 200.0]),
        "/growth/coverage": (kind: "chan.out", inputs: {"in": "covered"}, pos: [1800.0, 200.0]),
        "/growth/covered": (kind: "chan.select", params: {"channels": "coverage"}, inputs: {"in": "named"}, pos: [1600.0, 200.0]),
        "/growth/dots": (kind: "tex.in", inputs: {"in": "/points"}, pos: [-300.0, 300.0]),
        "/growth/full_hold": (kind: "chan.clock", binds: {"length": "parent.hold", "run": "armed:coverage"}, pos: [2000.0, 340.0]),
        "/growth/full_now": (kind: "chan.math", params: {"op": "above"}, inputs: {"a": "covered"}, binds: {"b": "parent.full"}, pos: [1600.0, 340.0]),
        "/growth/heat": (kind: "tex.in", inputs: {"in": "/blob"}, pos: [-300.0, 150.0]),
        "/growth/loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "step"}, binds: {"reset": "restart:done"}, pos: [150.0, -100.0]),
        "/growth/mask": (kind: "tex.in", inputs: {"in": "/word"}, pos: [-300.0, 0.0]),
        "/growth/measure": (kind: "chan.from_tex", params: {"components": "rgb"}, inputs: {"in": "cover"}, pos: [800.0, 200.0]),
        "/growth/named": (kind: "chan.rename", params: {"names": "r=coverage"}, inputs: {"in": "share"}, pos: [1400.0, 200.0]),
        "/growth/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [850.0, 0.0]),
        "/growth/pace": (kind: "chan.constant", params: {"name0": "steps"}, binds: {"value0": "parent.steps"}, pos: [-50.0, -330.0]),
        "/growth/passes": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "pace"}, binds: {"b": "parent.speed"}, pos: [150.0, -330.0]),
        "/growth/restart": (kind: "chan.feedback", inputs: {"previous": "full_hold"}, pos: [2200.0, 340.0]),
        "/growth/running": (kind: "chan.math", params: {"b": 0.5, "op": "below"}, inputs: {"a": "restart"}, pos: [2200.0, 460.0]),
        "/growth/seed": (kind: "tex.shader", params: {"file": "library/growth/seed.wgsl", "format": "32f", "keep_size": true, "resolution": "custom"}, inputs: {"in0": "mask"}, binds: {"count": "parent.count", "height": "parent.height", "model": "parent.model", "pattern": "parent.pattern", "radius": "parent.radius", "seed": "parent.seed", "width": "parent.width"}, pos: [-50.0, -150.0]),
        "/growth/share": (kind: "chan.math", params: {"op": "divide"}, inputs: {"a": "measure", "b": "allowed"}, pos: [1200.0, 200.0]),
        "/growth/show": (kind: "tex.shader", params: {"colors": "0b2a4a 3a7bd5 9fd8ff ffffff", "file": "library/growth/show.wgsl", "keep_size": true, "resolution": "custom", "through": 0.25, "warm": 0.25}, inputs: {"in0": "step", "in1": "mask", "in2": "heat"}, binds: {"model": "parent.model", "now": "time:seconds"}, pos: [600.0, 0.0]),
        "/growth/step": (kind: "tex.shader", params: {"afterglow": 0, "ambient": 0, "aniso": 0.05, "arms": 6, "cool": 0.3, "dot_seeds": false, "dt": 0.2, "edge_seeds": 0.03, "eta": 1.5, "file": "library/growth/step.wgsl", "format": "32f", "grow": 0.05, "heat": 1, "icecool": 6, "keep_size": true, "latent": 2.2, "lifespan": 0, "noise": 0.3, "ragged": 0.8, "recover": 20, "spawn": 0.03, "spell": 60, "spell_depth": 1.5, "spread": 0.02, "supply": 0.00002, "zoom": 1}, inputs: {"in0": "loop", "in1": "mask", "in2": "heat", "in3": "dots"}, binds: {"area": "parent.area", "iterations": "passes:steps", "model": "parent.model", "now": "time:seconds", "seed": "parent.seed"}, pos: [350.0, 0.0]),
        "/growth/time": (kind: "chan.clock", params: {"mode": "free"}, binds: {"run": "running:done"}, pos: [2400.0, 460.0]),
        "/keys": (kind: "chan.keyboard_in", params: {"keys": "0"}, pos: [300.0, 200.0]),
        "/out": (kind: "tex.null", inputs: {"in": "growth/out"}, pos: [600.0, 0.0]),
        "/points": (kind: "tex.shader", params: {"count": 7, "file": "dots.wgsl", "resolution": "custom", "size": 8.0}, pos: [-300.0, 220.0]),
        "/word": (kind: "tex.text", params: {"size": 360.0, "style": "Bold", "text": "penumbra"}, pos: [-300.0, -60.0]),
        "/x": (kind: "chan.lfo", params: {"amplitude": 0.36, "name": "x", "offset": 0.5, "rate": 0.031}, pos: [-700.0, 60.0]),
        "/y": (kind: "chan.lfo", params: {"amplitude": 0.3, "name": "y", "offset": 0.5, "phase": 0.25, "rate": 0.047}, pos: [-700.0, 130.0]),
    },
)
