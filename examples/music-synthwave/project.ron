        "/stage": (kind: "comp.base", params: {"params": "@expose warmth = palette.cross\n@expose lift = energy_lift.b\n@expose energy_curve = energy_curve.b\n@expose bars_per_turn = lane_map.bars_per_turn\n@expose swing = lane_map.swing\n@expose turn = lane_map.turn\n@expose step = controls.value0\n@expose beats_per_bar = lane_map.beats_per_bar\n@expose start = fade.start\n@expose end = shape.value4\n@expose dim = nebula_dim.brightness\n@expose camera = preset.row\n@expose glide = glide.rise\n@expose presets = presets.text\n@expose gap = gap_memory.gap\n@expose gap_length = lane_map.gap_length\n@expose ground = ground.ground\n@expose roll_up = controls.value1"}, pos: [1200.0, -100.0]),
