        "/tunnel": (kind: "comp.base", params: {"params": "@expose warmth = controls.value1\n@expose lift = energy_lift.b\n@expose energy_curve = energy_curve.b\n@expose bars_per_turn = lane_map.bars_per_turn\n@expose swing = lane_map.swing\n@expose turn = lane_map.turn\n@expose step = controls.value0\n@expose beats_per_bar = controls.value2\n@expose start = fade.start\n@expose end = shape.value4\n@expose dim = nebula_dim.brightness\n@expose camera = preset.row\n@expose glide = glide.rise\n@expose presets = presets.text\n@expose gap = gap_memory.gap\n@expose gap_length = lane_map.gap_length\n@expose ceiling = controls.value3\n@expose twist = controls.value4\n@expose lines = controls.value5\n@expose line_width = tube_lines.line_width\n@expose roll_up = controls.value6\n@expose roll_bars = controls.value7\n@expose roll_length = controls.value8\n@expose pulse = controls.value9\n@expose marks = marks_light.marks\n@expose turn_up = controls.value10\n@expose storey = controls.value11\n@expose storey_beats = controls.value12\n@expose tower_radius = controls.value13\n@expose see_through = controls.value14"}, pos: [1200.0, 150.0]),
