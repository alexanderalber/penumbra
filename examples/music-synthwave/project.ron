        "/mid_slot/lasers/heading": (kind: "tex.shader", params: {"across": 6.0, "axis": -1.0, "count": 9, "file": "library/mid_lasers/beams.wgsl", "height": 1, "keep_size": true, "low": 0.5, "open": 55.0, "origin": 10.0, "presence": 1.0, "reach": -1.0, "resolution": "custom", "round": 0.0, "strobe": true, "sweep": 20.0, "up": 3.2, "what": "aim", "width": 16}, inputs: {"in0": "lane"}, binds: {"across": "controls:across", "axis": "pose:axis", "bar": "bus:bar", "bar_index": "bus:bar_index", "count": "controls:count", "low": "controls:low", "open": "controls:open", "origin": "controls:origin", "presence": "controls:presence", "reach": "controls:reach", "round": "pose:curve", "sweep": "controls:sweep", "up": "controls:up"}, pos: [-700.0, 150.0]),
