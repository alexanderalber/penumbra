        "/mid_slot/mid": (kind: "geo.merge", inputs: {"in0": "particles/out", "in1": "lasers/out", "in2": "equalisers/out", "in3": "glider/out", "show": "mid_show"}, pos: [-636.0, -3987.0]),
        "/mid_slot/mid_out": (kind: "geo.out", inputs: {"in": "mid"}, pos: [-436.0, -3977.0]),
        "/mid_slot/mid_show": (kind: "chan.select", params: {"channels": "particles lasers equalisers"}, inputs: {"in": "arrangement_in"}, pos: [-836.0, -3712.0]),
        "/mid_slot/particles": (kind: "comp.base", params: {"params": "@expose presence = places.presence\n@expose density = places.density\n@expose speed = places.speed\n@expose length = places.length\n@expose spread = places.spread\n@expose near = places.near\n@expose far = places.far\n@expose thickness = sizes.thickness\n@expose busy = busy.fall\n@expose color = streak_lines.color\n@expose line_width = streak_lines.line_width"}, pos: [-836.0, -4128.0]),
        "/mid_slot/particles/bus": (kind: "chan.in", inputs: {"in": "../grid_beats_in"}, pos: [-800.0, 0.0]),
        "/mid_slot/particles/busy": (kind: "chan.filter", params: {"fall": 0.8, "rise": 0.05}, inputs: {"in": "onset"}, pos: [-400.0, -100.0]),
