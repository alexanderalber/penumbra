        "/tunnel/toward_diff": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "toward", "b": "glide"}, pos: [200.0, 950.0]),
        "/tunnel/toward_early": (kind: "chan.math", params: {"b": 3.0, "op": "multiply"}, inputs: {"a": "turn_share"}, pos: [0.0, 1150.0]),
        "/tunnel/toward_part": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "toward_diff"}, binds: {"b": "toward_share:turn_up"}, pos: [400.0, 950.0]),
        "/tunnel/toward_share": (kind: "chan.math", params: {"b": 1.0, "op": "min"}, inputs: {"a": "toward_early"}, pos: [200.0, 1150.0]),
        "/tunnel/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-1200.0, -500.0]),
        "/tunnel/tube_lines": (kind: "mat.wireframe", params: {"line_width": 2.0}, pos: [-200.0, 100.0]),
        "/tunnel/turn_back": (kind: "chan.math", params: {"b": -2.0, "op": "multiply"}, inputs: {"a": "turn_part"}, pos: [600.0, 1310.0]),
        "/tunnel/turn_bend": (kind: "chan.math", params: {"b": 3.0}, inputs: {"a": "turn_back"}, pos: [800.0, 1310.0]),
        "/tunnel/turn_from": (kind: "chan.math", params: {"b": -0.333333}, inputs: {"a": "turn_share"}, pos: [-200.0, 1250.0]),
        "/tunnel/turn_low": (kind: "chan.math", params: {"op": "max"}, inputs: {"a": "turn_span"}, pos: [200.0, 1250.0]),
        "/tunnel/turn_part": (kind: "chan.math", params: {"b": 1.0, "op": "min"}, inputs: {"a": "turn_low"}, pos: [400.0, 1250.0]),
        "/tunnel/turn_share": (kind: "chan.select", params: {"channels": "turn_up"}, inputs: {"in": "controls"}, pos: [-400.0, 1250.0]),
        "/tunnel/turn_span": (kind: "chan.math", params: {"b": 1.5, "op": "multiply"}, inputs: {"a": "turn_from"}, pos: [0.0, 1250.0]),
        "/tunnel/turn_sq": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "turn_part", "b": "turn_part"}, pos: [600.0, 1190.0]),
        "/tunnel/turned": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "turn_sq", "b": "turn_bend"}, pos: [1000.0, 1250.0]),
        "/tunnel/unturned": (kind: "chan.math", params: {"b": -1.0, "op": "multiply"}, inputs: {"a": "turned"}, pos: [1200.0, 1250.0]),
        "/tunnel/view": (kind: "chan.math", inputs: {"a": "glide", "b": "toward_part"}, pos: [600.0, 900.0]),
        "/tunnel/wall_cover": (kind: "geo.assign_material", inputs: {"in": "wall_model", "mat": "wall_mat"}, pos: [0.0, 400.0]),
        "/tunnel/wall_mat": (kind: "mat.occluder", params: {"shows": "black"}, binds: {"opacity": "wall_opacity:see_through"}, pos: [-200.0, 500.0]),
        "/tunnel/wall_model": (kind: "geo.file", params: {"file": "library/stage_tunnel/wall.obj", "up": "z"}, pos: [-200.0, 400.0]),
        "/tunnel/wall_opacity": (kind: "chan.math", params: {"b": 1.0}, inputs: {"a": "see_closed"}, pos: [-400.0, 1850.0]),
        "/tunnel/walls": (kind: "geo.tex_instance", params: {"extent": 40.0}, inputs: {"aim": "walls_aim", "in": "wall_cover", "position": "walls_place", "scale": "walls_scale"}, pos: [200.0, 450.0]),
        "/tunnel/walls_aim": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "height": 48, "keep_size": true, "resolution": "custom", "what": "wall_aim", "width": 64}, inputs: {"in0": "lane_map"}, binds: {"bar": "bus:bar", "bar_index": "bus:bar_index", "bass": "bus:energy_low", "beat": "bus:beat", "beats_per_bar": "controls:beats_per_bar", "drift": "bus:drift", "lines": "controls:lines", "phase": "phase:travelled", "pulse": "controls:pulse", "radius": "half:ceiling", "role": "bus:section_role", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "roll_up": "controls:roll_up", "step": "controls:step", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "tower_radius": "controls:tower_radius", "turn_up": "controls:turn_up", "twist": "controls:twist", "warmth": "controls:warmth", "whole": "whole:travelled"}, pos: [-400.0, 800.0]),
        "/tunnel/walls_place": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "height": 48, "keep_size": true, "resolution": "custom", "what": "wall_place", "width": 64}, inputs: {"in0": "lane_map"}, binds: {"bar": "bus:bar", "bar_index": "bus:bar_index", "bass": "bus:energy_low", "beat": "bus:beat", "beats_per_bar": "controls:beats_per_bar", "drift": "bus:drift", "lines": "controls:lines", "phase": "phase:travelled", "pulse": "controls:pulse", "radius": "half:ceiling", "role": "bus:section_role", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "roll_up": "controls:roll_up", "step": "controls:step", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "tower_radius": "controls:tower_radius", "turn_up": "controls:turn_up", "twist": "controls:twist", "warmth": "controls:warmth", "whole": "whole:travelled"}, pos: [-400.0, 700.0]),
        "/tunnel/walls_scale": (kind: "tex.shader", params: {"file": "library/stage_tunnel/tunnel.wgsl", "height": 48, "keep_size": true, "resolution": "custom", "what": "wall_scale", "width": 64}, inputs: {"in0": "lane_map"}, binds: {"bar": "bus:bar", "bar_index": "bus:bar_index", "bass": "bus:energy_low", "beat": "bus:beat", "beats_per_bar": "controls:beats_per_bar", "drift": "bus:drift", "lines": "controls:lines", "phase": "phase:travelled", "pulse": "controls:pulse", "radius": "half:ceiling", "role": "bus:section_role", "roll_bars": "controls:roll_bars", "roll_length": "controls:roll_length", "roll_up": "controls:roll_up", "step": "controls:step", "storey": "controls:storey", "storey_beats": "controls:storey_beats", "tower_radius": "controls:tower_radius", "turn_up": "controls:turn_up", "twist": "controls:twist", "warmth": "controls:warmth", "whole": "whole:travelled"}, pos: [-400.0, 900.0]),
        "/tunnel/warm": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "warm_keys"}, pos: [-200.0, -250.0]),
        "/tunnel/warm_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.2971 0.0545 0.0402\n0.4710 0.5004 0.2750 0.0682\n1.0000 0.2215 0.0472 0.0305", "width": 256}, pos: [-400.0, -200.0]),
        "/tunnel/whole": (kind: "chan.math", params: {"op": "subtract"}, inputs: {"a": "travelled", "b": "phase"}, pos: [-800.0, -350.0]),
        "/tunnel/wisps": (kind: "tex.displace", params: {"extend": "mirror", "weight": [0.08, 0.08]}, inputs: {"in": "clouds", "map": "swirl"}, pos: [-600.0, -600.0]),
    },
)
