        "/mid_slot/poses_in": (kind: "chan.in", inputs: {"in": "/camera_mix/poses_out"}, pos: [-1036.0, -3857.0]),
        "/music": (kind: "audio.file", params: {"file": "song.mp3", "wait_for_grid": true}, pos: [0.0, -250.0]),
        "/out": (kind: "tex.null", inputs: {"in": "post_slot/post_out"}, pos: [2050.0, -100.0]),
        "/post_slot": (kind: "comp.base", pos: [1800.0, -100.0]),
        "/post_slot/about_post": (kind: "ui.note", params: {"height": 178, "text": "# Over the finished picture\n`scanlines` lays dark lines over the picture of `stages` and flickers on onsets. `hud` comes after it and draws a crosshair, the horizon, the camera\'s height, the bar count and a radar of the track\'s sections.\n\nThe table switches each of them by itself: off in an intro, outro or break, on from a drop.", "width": 480}, pos: [964.0, -3373.0]),
        "/post_slot/grid_beats_in": (kind: "chan.in", inputs: {"in": "/grid_beats"}, pos: [964.0, -3135.0]),
        "/post_slot/hud": (kind: "comp.base", params: {"params": "@expose presence = hud.presence\n@expose warmth = hud.warmth\n@expose brightness = hud.brightness\n@expose thickness = hud.thickness\n@expose flicker = hud.flicker\n@expose decay = flash.fall\n@expose reach = hud.reach\n@expose scale = hud.scale\n@expose beats_per_bar = hud.beats_per_bar"}, pos: [1364.0, -3058.0]),
        "/post_slot/hud/bar_number": (kind: "chan.math", params: {"b": 1.0}, inputs: {"a": "bars"}, pos: [-600.0, 450.0]),
        "/post_slot/hud/bar_text": (kind: "tex.text", params: {"align": "left", "font": "JetBrains Mono", "keep_size": true, "position": [0.026, 0.075], "size": 26.0, "text": "BAR 1"}, binds: {"text": (node: "bar_number", channel: "bar_index", format: "BAR {.0}")}, pos: [-400.0, 450.0]),
        "/post_slot/hud/bars": (kind: "chan.select", params: {"channels": "bar_index"}, inputs: {"in": "bus"}, pos: [-800.0, 450.0]),
        "/post_slot/hud/bus": (kind: "chan.in", inputs: {"in": "../grid_beats_in"}, pos: [-1000.0, 100.0]),
        "/post_slot/hud/flash": (kind: "chan.filter", params: {"fall": 0.15, "rise": 0.0}, inputs: {"in": "onset"}, pos: [-600.0, 100.0]),
        "/post_slot/hud/height_text": (kind: "tex.text", params: {"align": "right", "font": "JetBrains Mono", "keep_size": true, "position": [0.928, 0.5], "size": 26.0, "text": "ALT 1.50"}, binds: {"text": (node: "pose", channel: "height", format: "ALT {.2}")}, pos: [-400.0, 300.0]),
        "/post_slot/hud/hud": (kind: "tex.shader", params: {"beats_per_bar": 4.0, "brightness": 1.0, "file": "library/post_hud/hud.wgsl", "flicker": 0.5, "presence": 1.0, "reach": 10.0, "scale": 0.1, "thickness": 2.0, "warmth": 0.0}, inputs: {"in0": "in", "in1": "height_text", "in2": "bar_text", "in3": "track_text"}, binds: {"bar": "bus:bar", "beats": "bus:travelled", "drop": "bus:drop", "eye": "pose:height", "flash": "flash:onset", "fov": "pose:fov", "phase": "bus:track_phase", "pitch": "pose:pitch", "presence": "/arrangement/table_mix:hud", "roll": "pose:roll", "section": "bus:track_section", "sections": "bus:track_sections", "side": "pose:side", "warmth": "/arrangement/table_mix:warmth"}, pos: [-200.0, -100.0]),
        "/post_slot/hud/in": (kind: "tex.in", inputs: {"in": "../scanlines/out"}, pos: [-800.0, -150.0]),
        "/post_slot/hud/onset": (kind: "chan.select", params: {"channels": "onset"}, inputs: {"in": "bus"}, pos: [-800.0, 100.0]),
        "/post_slot/hud/out": (kind: "tex.out", inputs: {"in": "hud"}, pos: [0.0, -100.0]),
        "/post_slot/hud/pose": (kind: "chan.in", inputs: {"in": "../poses_in"}, pos: [-1000.0, 300.0]),
        "/post_slot/hud/track": (kind: "chan.select", params: {"channels": "track_index"}, inputs: {"in": "bus"}, pos: [-800.0, 600.0]),
        "/post_slot/hud/track_number": (kind: "chan.math", params: {"b": 1.0}, inputs: {"a": "track"}, pos: [-600.0, 600.0]),
        "/post_slot/hud/track_text": (kind: "tex.text", params: {"align": "left", "font": "JetBrains Mono", "keep_size": true, "position": [0.175, 0.94], "size": 26.0, "text": "TRK 1"}, binds: {"text": (node: "track_number", channel: "track_index", format: "TRK {.0}")}, pos: [-400.0, 600.0]),
        "/post_slot/picture_in": (kind: "tex.in", inputs: {"in": "/stages"}, pos: [964.0, -3063.0]),
        "/post_slot/poses_in": (kind: "chan.in", inputs: {"in": "/camera_mix/poses_out"}, pos: [1164.0, -2958.0]),
        "/post_slot/post_out": (kind: "tex.out", inputs: {"in": "hud/out"}, pos: [1564.0, -3072.0]),
        "/post_slot/scanlines": (kind: "comp.base", params: {"params": "@expose presence = lines.presence\n@expose pitch = lines.pitch\n@expose strength = lines.strength\n@expose thickness = lines.thickness\n@expose roll = lines.roll\n@expose flicker = lines.flicker\n@expose decay = flash.fall"}, pos: [1164.0, -3058.0]),
        "/post_slot/scanlines/bus": (kind: "chan.in", inputs: {"in": "../grid_beats_in"}, pos: [-800.0, 100.0]),
        "/post_slot/scanlines/flash": (kind: "chan.filter", params: {"fall": 0.15, "rise": 0.0}, inputs: {"in": "onset"}, pos: [-400.0, 100.0]),
        "/post_slot/scanlines/in": (kind: "tex.in", inputs: {"in": "../picture_in"}, pos: [-600.0, -150.0]),
        "/post_slot/scanlines/lines": (kind: "tex.shader", params: {"file": "library/post_scanlines/scanlines.wgsl", "flicker": 0.35, "pitch": 4.0, "presence": 1.0, "roll": 0.25, "strength": 0.45, "thickness": 0.5}, inputs: {"in0": "in"}, binds: {"beats": "bus:travelled", "flash": "flash:onset", "presence": "/arrangement/table_mix:scanlines"}, pos: [-200.0, -100.0]),
        "/post_slot/scanlines/onset": (kind: "chan.select", params: {"channels": "onset"}, inputs: {"in": "bus"}, pos: [-600.0, 100.0]),
        "/post_slot/scanlines/out": (kind: "tex.out", inputs: {"in": "lines"}, pos: [0.0, -100.0]),
        "/preview": (kind: "out.projector", params: {"active": false, "window": true}, inputs: {"in": "out"}, pos: [2300.0, -100.0]),
        "/sky_slot": (kind: "comp.base", pos: [900.0, -50.0]),
        "/sky_slot/about_slot": (kind: "ui.note", params: {"height": 258, "text": "# Sky slot\nThese elements are pictures. `sky` screens them together and sends the result to both stages. The arrangement shows one at a time. `sky_show` lets only the element on show cook. All but `galaxy` take `poses_in`, so their horizon moves with the camera.\n\nAdd an element: `comp.load` it into this component, wire `grid_beats_in` and `poses_in` into its `bus` and `pose`, wire its output into the next free input of `sky`, add its name to `sky_show` at the same place, add its path to the `beats.arrange` call in the README and run the call.", "width": 480}, pos: [-1617.0, -5404.0]),
        "/sky_slot/arrangement_in": (kind: "chan.in", inputs: {"in": "/arrangement/table_mix_out"}, pos: [-1617.0, -4686.0]),
        "/sky_slot/aurora": (kind: "comp.base", params: {"params": "@expose presence = aurora.presence\n@expose brightness = aurora.brightness\n@expose warmth = aurora.warmth\n@expose bands = aurora.bands\n@expose height = aurora.hang\n@expose speed = aurora.speed\n@expose glow = aurora.glow\n@expose reach = aurora.reach"}, pos: [-1417.0, -4886.0]),
        "/sky_slot/aurora/aurora": (kind: "tex.shader", params: {"bands": 3, "brightness": 1.0, "file": "library/sky_aurora/aurora.wgsl", "glow": 1.0, "hang": 0.22, "presence": 1.0, "resolution": "custom", "speed": 0.02, "warmth": 0.0}, binds: {"beats": "bus:travelled", "energy": "bus:energy_high", "eye": "pose:height", "fov": "pose:fov", "pitch": "pose:pitch", "presence": "/arrangement/table_mix:aurora", "roll": "pose:roll", "side": "pose:side", "warmth": "/arrangement/table_mix:warmth"}, pos: [-300.0, 0.0]),
        "/sky_slot/aurora/bus": (kind: "chan.in", inputs: {"in": "../grid_beats_in"}, pos: [-600.0, 0.0]),
        "/sky_slot/aurora/out": (kind: "tex.out", inputs: {"in": "aurora"}, pos: [0.0, 0.0]),
        "/sky_slot/aurora/pose": (kind: "chan.in", inputs: {"in": "../poses_in"}, pos: [-600.0, 150.0]),
        "/sky_slot/city": (kind: "comp.base", params: {"params": "@expose presence = city.presence\n@expose brightness = city.brightness\n@expose warmth = city.warmth\n@expose seed = city.seed\n@expose tall = city.tall\n@expose slide = city.slide\n@expose windows = city.windows\n@expose flicker = city.flicker\n@expose edge = city.edge\n@expose reach = city.reach\n@expose bend = city.bend"}, pos: [-1417.0, -4786.0]),
        "/sky_slot/city/bus": (kind: "chan.in", inputs: {"in": "../grid_beats_in"}, pos: [-600.0, 0.0]),
        "/sky_slot/city/city": (kind: "tex.shader", params: {"axis": 4.0, "bend": 0.0, "brightness": 1.0, "edge": 0.8, "far": 20.0, "file": "library/sky_city/city.wgsl", "flicker": 0.7, "presence": 1.0, "radius": 4.0, "reach": 10.0, "resolution": "custom", "seed": 1, "slide": 0.002, "tall": 0.12, "warmth": 0.0, "windows": 0.35}, binds: {"axis": "pose:axis", "beats": "bus:travelled", "bend": "pose:curve", "eye": "pose:height", "far": "pose:far", "fov": "pose:fov", "mid": "bus:energy_mid", "pitch": "pose:pitch", "presence": "/arrangement/table_mix:city", "radius": "pose:radius", "roll": "pose:roll", "side": "pose:side", "warmth": "/arrangement/table_mix:warmth"}, pos: [-300.0, 0.0]),
        "/sky_slot/city/out": (kind: "tex.out", inputs: {"in": "city"}, pos: [0.0, 0.0]),
        "/sky_slot/city/pose": (kind: "chan.in", inputs: {"in": "../poses_in"}, pos: [-600.0, 150.0]),
        "/sky_slot/galaxy": (kind: "comp.base", params: {"params": "@expose presence = galaxy.presence\n@expose brightness = galaxy.brightness\n@expose warmth = controls.value0\n@expose spin = spin_rate.b\n@expose lift = energy_lift.b\n@expose energy_curve = energy_curve.b\n@expose tilt = galaxy.tilt\n@expose angle = galaxy.angle\n@expose size = galaxy.size\n@expose twist = galaxy.twist\n@expose arms = galaxy.arms\n@expose bulge = galaxy.bulge\n@expose dust = galaxy.dust\n@expose center = galaxy.center"}, pos: [-1417.0, -5086.0]),
        "/sky_slot/galaxy/bus": (kind: "chan.in", inputs: {"in": "../grid_beats_in"}, pos: [-800.0, 0.0]),
        "/sky_slot/galaxy/cold": (kind: "tex.lookup", inputs: {"in": "tint", "lut": "cold_keys"}, pos: [-200.0, 400.0]),
        "/sky_slot/galaxy/cold_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0.0000 0.0593 0.2472 0.4378\n0.4861 0.6989 0.1031 1.0000\n0.5088 0.6889 0.0613 1.0000\n0.9925 0.1376 0.4325 1.0000", "width": 256}, pos: [-400.0, 450.0]),
        "/sky_slot/galaxy/controls": (kind: "chan.constant", params: {"name0": "warmth"}, binds: {"value0": "/arrangement/table_mix:warmth"}, pos: [-800.0, 300.0]),
        "/sky_slot/galaxy/energy": (kind: "chan.select", params: {"channels": "energy_low"}, inputs: {"in": "bus"}, pos: [-600.0, 50.0]),
        "/sky_slot/galaxy/energy_curve": (kind: "chan.math", params: {"b": 2.5, "op": "power"}, inputs: {"a": "energy"}, pos: [-400.0, 50.0]),
        "/sky_slot/galaxy/energy_lift": (kind: "chan.math", inputs: {"a": "energy_curve"}, binds: {"b": "/lift/build_lift:build"}, pos: [-200.0, 50.0]),
        "/sky_slot/galaxy/galaxy": (kind: "tex.shader", params: {"brightness": 0.6, "file": "library/sky_galaxy/galaxy.wgsl", "resolution": "custom", "twinkle": 0}, binds: {"energy": "energy_lift:energy_low", "presence": "/arrangement/table_mix:galaxy", "spin": "spin_rate:travelled", "warmth": "controls:warmth"}, pos: [0.0, 0.0]),
        "/sky_slot/galaxy/out": (kind: "tex.out", inputs: {"in": "tinted"}, pos: [400.0, 100.0]),
        "/sky_slot/galaxy/palette": (kind: "tex.cross", inputs: {"a": "warm", "b": "cold"}, binds: {"cross": "controls:warmth"}, pos: [0.0, 350.0]),
        "/sky_slot/galaxy/spin_rate": (kind: "chan.math", params: {"b": 0.5, "op": "multiply"}, inputs: {"a": "travelled"}, pos: [-400.0, -100.0]),
        "/sky_slot/galaxy/tint": (kind: "tex.noise", params: {"amplitude": 0.9, "frequency": 0.5, "height": 270, "octaves": 1, "speed": 0.011, "width": 480}, pos: [-400.0, 250.0]),
        "/sky_slot/galaxy/tinted": (kind: "tex.composite", params: {"op": "color"}, inputs: {"in0": "galaxy", "in1": "palette"}, pos: [200.0, 100.0]),
        "/sky_slot/galaxy/travelled": (kind: "chan.select", params: {"channels": "travelled"}, inputs: {"in": "bus"}, pos: [-600.0, -100.0]),
