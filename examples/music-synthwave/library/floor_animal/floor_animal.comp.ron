// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/floor_animal": (kind: "comp.base", params: {"expose": "presence = controls.value0\nat = controls.value1\nrange = controls.value2\ncycle_min = controls.value3\ncycle_max = controls.value4\nbeats_per_bar = controls.value5\nturn = controls.value6\nside = controls.value7\nlane = controls.value8\nclear = controls.value9\nsize = controls.value10\nseed = controls.value11\ncolor = lines.color\nline_width = lines.line_width"}),
        "/floor_animal/bus": (kind: "chan.in", pos: [-1200.0, 0.0]),
        "/floor_animal/lane": (kind: "tex.in", pos: [-1200.0, 150.0]),
        "/floor_animal/controls": (kind: "chan.constant", params: {"rows": 12, "name0": "presence", "value0": 1.0, "name1": "at", "value1": 5.0, "name2": "range", "value2": 1.5, "name3": "cycle_min", "value3": 16.0, "name4": "cycle_max", "value4": 32.0, "name5": "beats_per_bar", "value5": 4.0, "name6": "turn", "value6": 30.0, "name7": "side", "value7": 1.0, "name8": "lane", "value8": 1.6, "name9": "clear", "value9": 1.1, "name10": "size", "value10": 1.0, "name11": "seed", "value11": 1.0}, pos: [-1200.0, 300.0]),
        "/floor_animal/place": (kind: "tex.shader", params: {"file": "library/floor_animal/run.wgsl", "resolution": "custom", "width": 1, "height": 1, "keep_size": true, "presence": 1.0, "at": 5.0, "range": 1.5, "cycle_min": 16.0, "cycle_max": 32.0, "beats_per_bar": 4.0, "turn": 30.0, "side": 1.0, "lane": 1.6, "clear": 1.1, "size": 1.0, "seed": 1, "what": "place", "pose": 0}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "at": "controls:at", "range": "controls:range", "cycle_min": "controls:cycle_min", "cycle_max": "controls:cycle_max", "beats_per_bar": "controls:beats_per_bar", "turn": "controls:turn", "side": "controls:side", "lane": "controls:lane", "clear": "controls:clear", "size": "controls:size", "seed": "controls:seed", "beats": "bus:travelled"}, pos: [-900.0, -300.0]),
