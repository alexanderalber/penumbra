// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/mid_equalisers": (kind: "comp.base", params: {"params": "@expose presence = controls.value0\n@expose warmth = controls.value1\n@expose brightness = controls.value2\n@expose every = controls.value3\n@expose turn = controls.value4\n@expose count = controls.value5\n@expose arc = controls.value6\n@expose cells = controls.value7\n@expose tall = controls.value8\n@expose open = controls.value9\n@expose middle = controls.value10\n@expose gap = controls.value11\n@expose depth = controls.value12\n@expose jitter = controls.value13\n@expose kick = controls.value14\n@expose pump = controls.value15\n@expose beats_per_bar = controls.value16"}),
        "/mid_equalisers/bus": (kind: "chan.in", pos: [-1000.0, 0.0]),
        "/mid_equalisers/lane": (kind: "tex.in", pos: [-1000.0, 150.0]),
        "/mid_equalisers/pose": (kind: "chan.in", pos: [-1000.0, 450.0]),
        "/mid_equalisers/controls": (kind: "chan.constant", params: {"rows": 17, "name0": "presence", "value0": 1.0, "name1": "warmth", "value1": 0.0, "name2": "brightness", "value2": 1.0, "name3": "every", "value3": 2.0, "name4": "turn", "value4": 20.0, "name5": "count", "value5": 32.0, "name6": "arc", "value6": 270.0, "name7": "cells", "value7": 6.0, "name8": "tall", "value8": 1.6, "name9": "open", "value9": 2.0, "name10": "middle", "value10": 2.0, "name11": "gap", "value11": 0.4, "name12": "depth", "value12": 0.05, "name13": "jitter", "value13": 0.5, "name14": "kick", "value14": 0.25, "name15": "pump", "value15": 0.4, "name16": "beats_per_bar", "value16": 4.0}, pos: [-1000.0, 300.0]),
        "/mid_equalisers/place": (kind: "tex.shader", params: {"resolution": "custom", "width": 48, "height": 96, "keep_size": true, "file": "library/mid_equalisers/rings.wgsl", "what": "place"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "every": "controls:every", "turn": "controls:turn", "count": "controls:count", "arc": "controls:arc", "cells": "controls:cells", "tall": "controls:tall", "open": "controls:open", "middle": "controls:middle", "gap": "controls:gap", "depth": "controls:depth", "jitter": "controls:jitter", "kick": "controls:kick", "pump": "controls:pump", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "low": "bus:energy_low", "mid": "bus:energy_mid", "high": "bus:energy_high", "onset": "bus:onset", "beat": "bus:beat", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 0.0]),
        "/mid_equalisers/aim": (kind: "tex.shader", params: {"resolution": "custom", "width": 48, "height": 96, "keep_size": true, "file": "library/mid_equalisers/rings.wgsl", "what": "aim"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "every": "controls:every", "turn": "controls:turn", "count": "controls:count", "arc": "controls:arc", "cells": "controls:cells", "tall": "controls:tall", "open": "controls:open", "middle": "controls:middle", "gap": "controls:gap", "depth": "controls:depth", "jitter": "controls:jitter", "kick": "controls:kick", "pump": "controls:pump", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "low": "bus:energy_low", "mid": "bus:energy_mid", "high": "bus:energy_high", "onset": "bus:onset", "beat": "bus:beat", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 150.0]),
        "/mid_equalisers/scale": (kind: "tex.shader", params: {"resolution": "custom", "width": 48, "height": 96, "keep_size": true, "file": "library/mid_equalisers/rings.wgsl", "what": "scale"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "every": "controls:every", "turn": "controls:turn", "count": "controls:count", "arc": "controls:arc", "cells": "controls:cells", "tall": "controls:tall", "open": "controls:open", "middle": "controls:middle", "gap": "controls:gap", "depth": "controls:depth", "jitter": "controls:jitter", "kick": "controls:kick", "pump": "controls:pump", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "low": "bus:energy_low", "mid": "bus:energy_mid", "high": "bus:energy_high", "onset": "bus:onset", "beat": "bus:beat", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 300.0]),
        "/mid_equalisers/light": (kind: "tex.shader", params: {"resolution": "custom", "width": 48, "height": 96, "keep_size": true, "file": "library/mid_equalisers/rings.wgsl", "what": "light"}, inputs: {"in0": "lane"}, binds: {"presence": "controls:presence", "warmth": "controls:warmth", "brightness": "controls:brightness", "every": "controls:every", "turn": "controls:turn", "count": "controls:count", "arc": "controls:arc", "cells": "controls:cells", "tall": "controls:tall", "open": "controls:open", "middle": "controls:middle", "gap": "controls:gap", "depth": "controls:depth", "jitter": "controls:jitter", "kick": "controls:kick", "pump": "controls:pump", "beats_per_bar": "controls:beats_per_bar", "beats": "bus:travelled", "drift": "bus:drift", "low": "bus:energy_low", "mid": "bus:energy_mid", "high": "bus:energy_high", "onset": "bus:onset", "beat": "bus:beat", "far": "pose:far", "axis": "pose:axis", "radius": "pose:radius", "curve": "pose:curve"}, pos: [-500.0, 450.0]),
        "/mid_equalisers/cell": (kind: "geo.primitive", params: {"shape": "box"}, pos: [-500.0, -300.0]),
        "/mid_equalisers/cell_mat": (kind: "mat.constant", pos: [-500.0, -150.0]),
        "/mid_equalisers/cell_fill": (kind: "geo.assign_material", inputs: {"in": "cell", "mat": "cell_mat"}, pos: [-250.0, -200.0]),
        "/mid_equalisers/cells": (kind: "geo.tex_instance", params: {"extent": 30.0}, inputs: {"in": "cell_fill", "position": "place", "aim": "aim", "scale": "scale", "color": "light"}, pos: [0.0, 0.0]),
        "/mid_equalisers/out": (kind: "geo.out", inputs: {"in": "cells"}, pos: [200.0, 0.0]),
    },
)
