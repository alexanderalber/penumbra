// penumbra component. One component at the top level with everything inside it; add it
// to a project with comp.load or the add dialog.
(
    version: 2,
    nodes: {
        "/sky_city": (kind: "comp.base", params: {"params": "@expose presence = city.presence
@expose brightness = city.brightness
@expose warmth = city.warmth
@expose seed = city.seed
@expose tall = city.tall
@expose slide = city.slide
@expose windows = city.windows
@expose flicker = city.flicker
@expose edge = city.edge
@expose reach = city.reach
@expose bend = city.bend"}),
        "/sky_city/bus": (kind: "chan.in", pos: [-600.0, 0.0]),
        "/sky_city/pose": (kind: "chan.in", pos: [-600.0, 150.0]),
        "/sky_city/city": (kind: "tex.shader", params: {"file": "library/sky_city/city.wgsl", "resolution": "custom", "presence": 1.0, "brightness": 1.0, "warmth": 0.0, "seed": 1, "tall": 0.12, "slide": 0.002, "windows": 0.35, "flicker": 0.7, "edge": 0.8, "reach": 10.0, "bend": 0.0, "axis": 4.0, "radius": 4.0, "far": 20.0}, binds: {"beats": "bus:travelled", "mid": "bus:energy_mid", "eye": "pose:height", "pitch": "pose:pitch", "fov": "pose:fov", "roll": "pose:roll", "side": "pose:side", "bend": "pose:curve", "axis": "pose:axis", "radius": "pose:radius", "far": "pose:far"}, pos: [-300.0, 0.0]),
        "/sky_city/out": (kind: "tex.out", inputs: {"in": "city"}, pos: [0.0, 0.0]),
    },
)
