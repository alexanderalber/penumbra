// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_caption": (kind: "ui.note", params: {"height": 115, "text": "# Caption\n`cue` reads the row of `cues` that `show` is at: its `row` is bound to `step`. `caption` shows the `hour`, formatted `{.0}:00`.", "width": 420}, pos: [800.0, 530.0]),
        "/about_cues": (kind: "ui.note", params: {"height": 175, "text": "# Cues\n`show` lists the cues in `steps`, one per line. A cue with `hold` waits for GO; one with seconds moves on by itself.\n- GO: the space key, the `GO` button or the OSC address `/go`\n- `screen` shows the picture of the cue: `in0` for the first name in `names`, `in1` for the second", "width": 560}, pos: [400.0, -230.0]),
        "/about_go": (kind: "ui.note", params: {"height": 115, "text": "# GO\n`go` is 1 while space (`keys`) is down, and for a frame per press of the OSC address `/go` (`osc`). It is bound to `go` on `show`. A GO during a transition does nothing: a double press skips no cue.", "width": 560}, pos: [-260.0, 40.0]),
        "/about_lock": (kind: "ui.note", params: {"height": 135, "text": "# Before the show\nShow mode (right-click on empty canvas, or Ctrl+Shift+L) refuses edits, saving and project switches. Keys, OSC and GO keep working. After a crash penumbra starts itself again, at the cue that was playing.", "width": 560}, pos: [800.0, 680.0]),
        "/about_looks": (kind: "ui.note", params: {"height": 155, "text": "# Looks\n`dawn` and `night` are ramps, `day` a `tex.primitive` sun, `storm` moving noise. Any picture can be a cue. The end card has no input on `screen`: black.\n- `black` instead of `fade` in `steps`: a dip to black. `cut`: a cut\n- A number instead of `hold`: the cue moves on by itself\n- `mode` `loop` on `show`: starts over after the end card", "width": 600}, pos: [-260.0, 420.0]),
        "/about_osc": (kind: "ui.note", params: {"height": 155, "text": "# OSC\n`go_button` is a `chan.button` named `go`. `desk` sends it as `/go` to port 8000 on this machine, `osc` receives it there. A stand-in for a lighting desk or QLab: each `/go 1` (or `/go` alone) sent to port 8000 moves the show on, since `/go` is a trigger on `osc`.\n- `lan` on `osc`: take OSC from other computers\n- `show` is ticked on `go_button`: its GO button is on the show screen", "width": 600}, pos: [0.0, 800.0]),
        "/caption": (kind: "tex.text", params: {"color": [1.0, 1.0, 1.0, 0.85], "position": [0.5, 0.9], "size": 72.0, "style": "Light"}, binds: {"text": (node: "cue", channel: "hour", format: "{.0}:00")}, pos: [800.0, 372.0]),
        "/cue": (kind: "chan.from_table", inputs: {"in": "cues"}, binds: {"row": "show:step"}, pos: [600.0, 586.0]),
        "/cues": (kind: "table.text", params: {"format": "csv", "text": "cue,hour,rain_db\n1,6,-60\n2,12,-60\n3,17,-10\n4,22,-24\n5,0,-60"}, pos: [400.0, 586.0]),
        "/dawn": (kind: "tex.ramp", params: {"keys": "0 1 0.3 0.06\n0.4 0.5 0.14 0.25\n1 0.02 0.03 0.15", "shape": "vertical"}, pos: [400.0, 72.0]),
        "/day": (kind: "tex.primitive", params: {"background": [0.2, 0.45, 0.9, 1.0], "center": [0.7, 0.3], "fill": [1.0, 0.85, 0.35, 1.0], "shape": "ellipse", "size": [0.3, 0.3], "softness": 30.0}, pos: [400.0, 200.0]),
        "/desk": (kind: "out.osc", params: {"port": 8000, "rate": 60.0}, inputs: {"chans": "go_button"}, pos: [200.0, 715.0]),
        "/go": (kind: "chan.math", params: {"op": "max"}, inputs: {"a": "keys", "b": "osc"}, pos: [200.0, 280.0]),
        "/go_button": (kind: "chan.button", params: {"label": "GO", "name": "go", "show": true}, pos: [0.0, 706.0]),
        "/keys": (kind: "chan.keyboard_in", params: {"keys": "space"}, pos: [0.0, 251.0]),
        "/night": (kind: "tex.ramp", params: {"keys": "0 0.45 0.5 0.7\n0.12 0.1 0.12 0.3\n1 0.004 0.005 0.02", "shape": "radial"}, pos: [400.0, 457.0]),
        "/osc": (kind: "chan.osc_in", params: {"addresses": "", "triggers": "/go"}, pos: [0.0, 323.0]),
        "/out": (kind: "tex.composite", inputs: {"in0": "screen", "in1": "caption"}, pos: [1000.0, 372.0]),
        "/screen": (kind: "tex.sequence", inputs: {"sequence": "show", "in0": "dawn", "in1": "day", "in2": "storm", "in3": "night"}, pos: [600.0, 167.0]),
        "/show": (kind: "chan.sequence", params: {"lead_in": 0.0, "names": "dawn day storm night end", "steps": "# cue   seconds  transition  length\ndawn    hold     fade        3\nday     hold     fade        2\nstorm   8        flash       0.8\nnight   hold     fade        3\nend     hold"}, binds: {"go": "go:key_space"}, pos: [400.0, 0.0]),
        "/storm": (kind: "tex.noise", params: {"amplitude": 0.4, "frequency": 3.0, "octaves": 5, "offset": 0.3, "roughness": 0.6, "speed": 0.6}, pos: [400.0, 329.0]),
    },
)
