// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 130, "text": "# In step\n`clip` and `sound` play the same file and start together. A change of `speed` or `start` on only one of them moves them apart.\nSelect `record` and press its record button to record a movie with the sound.", "width": 460}, pos: [0.0, 376.0]),
        "/about_picture": (kind: "ui.note", params: {"height": 115, "text": "# Picture\n`clip` plays `clip.mp4` over and over (`loop` on). `screen` shows it on a display once its `display` is set; Helpers > Outputs lists them. Until then `screen` warns.", "width": 520}, pos: [0.0, -150.0]),
        "/about_sound": (kind: "ui.note", params: {"height": 115, "text": "# Sound\n`sound` plays the sound of the same file. `speakers` plays it on the default output, with `reverb` 0.2. `device` on `speakers` picks another output.", "width": 440}, pos: [400.0, 150.0]),
        "/about_try": (kind: "ui.note", params: {"height": 160, "text": "# Try\n- `file` on `clip` and `sound`: another MP4 or MOV with AAC sound, the same in both\n- `speed`: bind it on both nodes to one `chan.slider`. They stay in step\n- `position`: bind it on both to one `chan.slider` from 0 to 3.6 to scrub the clip by hand", "width": 460}, pos: [490.0, 376.0]),
        "/clip": (kind: "tex.video_file", params: {"file": "clip.mp4"}, pos: [0.0, 36.0]),
        "/record": (kind: "out.video", inputs: {"in": "clip"}, pos: [200.0, 100.0]),
        "/screen": (kind: "out.projector", inputs: {"in": "clip"}, pos: [200.0, 0.0]),
        "/sound": (kind: "audio.file", params: {"file": "clip.mp4"}, pos: [0.0, 220.0]),
        "/speakers": (kind: "out.audio", inputs: {"in": "sound"}, pos: [200.0, 234.0]),
    },
)
