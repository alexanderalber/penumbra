// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 270, "text": "# Sparks from a word\nParticles are born on the letters of `text`, stirred by a curl noise, blown up by the wind, and drawn three ways: as soft glowing dots, as trails, and as lines between near sparks.\n- `emitter` scatters 20 000 points over the letters\' surface, each with its normal\n- `sparks` gives birth to 8000 particles a second on them; each lives about 2 s\n- `curl` and `wind` add forces. `end` closes the loop: it is wired back into `previous` of `sparks`\n- `fade` colours each spark by `age / life`: pale yellow at birth, dark red and dim as it dies", "width": 520}, pos: [120.0, -160.0]),
        "/about_drawing": (kind: "ui.note", params: {"height": 200, "text": "# Drawing\n- `dots`: a soft sprite at every spark, added to what lies behind\n- `trail` keeps the last 12 places of each spark. `taper` thins it to its tail, `streaks` draws ribbons\n- `few` keeps 5 % of the sparks. `plexus` joins each to up to 3 neighbours within 0.3 m, `strands` darkens the long lines, `web` draws them\n- `render` adds all three; `out` puts them over `background`", "width": 520}, pos: [680.0, -138.0]),
        "/about_try": (kind: "ui.note", params: {"height": 160, "text": "# Try\n- `text` on `text`: another word. The sparks follow its letters\n- `strength` on `wind`: 0 leaves the sparks floating in the curl, 2 blows them up and away\n- `length` on `trail`: 30 gives long streaks", "width": 420}, pos: [2180.0, -180.0]),
        "/background": (kind: "tex.ramp", params: {"keys": "0 0.02 0.022 0.03\n1 0.003 0.003 0.005", "shape": "radial"}, pos: [2600.0, 150.0]),
        "/camera": (kind: "view.camera", params: {"position": [0.0, -6.5, 0.4], "target": [0.2, 0.0, 0.35]}, pos: [2400.0, 390.0]),
        "/curl": (kind: "pts.noise", params: {"amplitude": 1.2, "attribute": "force", "flavour": "curl", "period": 0.5, "speed": 0.3}, inputs: {"in": "sparks"}, pos: [600.0, 152.0]),
        "/dots": (kind: "geo.from_pts", params: {"blend": "add", "size": 0.022, "softness": 1.0}, inputs: {"in": "fade"}, pos: [1400.0, 0.0]),
        "/emitter": (kind: "pts.from_geo", params: {"count": 20000, "mode": "surface"}, inputs: {"in": "text"}, pos: [200.0, 145.0]),
        "/end": (kind: "pts.null", inputs: {"in": "wind"}, pos: [1000.0, 152.0]),
        "/fade": (kind: "pts.math", params: {"expression": "vec4f(mix(vec3f(1.0, 0.7, 0.3), vec3f(0.7, 0.1, 0.03), age / life) * 0.5 * pow(1.0 - age / life, 3.0), 1.0)", "result": "color"}, inputs: {"in": "end"}, pos: [1200.0, 152.0]),
        "/few": (kind: "pts.delete", params: {"by": "random", "share": 0.95}, inputs: {"in": "fade"}, pos: [1400.0, 323.0]),
        "/light": (kind: "light.ambient", pos: [2400.0, 318.0]),
        "/lit": (kind: "geo.assign_material", inputs: {"in": "scene", "mat": "white"}, pos: [2400.0, 190.0]),
        "/out": (kind: "tex.composite", inputs: {"in0": "background", "in1": "render"}, pos: [2800.0, 175.0]),
        "/plexus": (kind: "pts.proximity", params: {"distance": 0.3, "max_lines": 3}, inputs: {"in": "few"}, pos: [1600.0, 323.0]),
        "/render": (kind: "tex.render", inputs: {"camera": "camera", "geo": "lit", "lights": "light"}, pos: [2600.0, 286.0]),
        "/scene": (kind: "geo.merge", inputs: {"in0": "dots", "in1": "streaks", "in2": "web"}, pos: [2200.0, 104.0]),
        "/sparks": (kind: "pts.particles", params: {"along_normal": 0.05, "drag": 0.5, "life_variance": 0.6, "max": 24000, "rate": 8000.0, "spread": 0.03}, inputs: {"previous": "end", "source": "emitter"}, pos: [400.0, 146.0]),
        "/strands": (kind: "pts.math", params: {"expression": "vec4f(color.rgb * (1.0 - span01), 1.0)", "result": "color"}, inputs: {"in": "plexus"}, pos: [1800.0, 323.0]),
        "/streaks": (kind: "geo.from_pts", params: {"blend": "add", "mode": "lines", "width": 0.006}, inputs: {"in": "taper"}, pos: [1800.0, 114.0]),
        "/taper": (kind: "pts.math", params: {"expression": "1.0 - trail", "result": "width"}, inputs: {"in": "trail"}, pos: [1600.0, 128.0]),
        "/text": (kind: "geo.text", params: {"style": "Bold", "text": "penumbra"}, pos: [0.0, 131.0]),
        "/trail": (kind: "pts.trail", params: {"length": 12}, inputs: {"in": "fade"}, pos: [1400.0, 128.0]),
        "/web": (kind: "geo.from_pts", params: {"blend": "add", "mode": "lines", "width": 0.003}, inputs: {"in": "strands"}, pos: [2000.0, 309.0]),
        "/white": (kind: "mat.constant", pos: [2200.0, 236.0]),
        "/wind": (kind: "pts.force", params: {"direction": [0.25, 0.0, 0.7], "kind": "wind", "strength": 0.6}, inputs: {"in": "curl"}, pos: [800.0, 152.0]),
    },
)
