// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/black": (kind: "tex.constant", pos: [0.0, 0.0]),
        "/dark": (kind: "tex.level", params: {"brightness": 0.0}, inputs: {"in": "seed"}, pos: [1000.0, 284.0]),
        "/drift": (kind: "tex.transform", params: {"extend": "zero", "rotate": -0.4, "scale": [1.005, 1.005]}, inputs: {"in": "loop"}, pos: [400.0, 0.0]),
        "/fade": (kind: "tex.level", params: {"brightness": 0.98}, inputs: {"in": "soften"}, pos: [800.0, 0.0]),
        "/glow": (kind: "tex.blur", params: {"size": 10.0}, inputs: {"in": "seed"}, pos: [1000.0, 142.0]),
        "/loop": (kind: "tex.feedback", inputs: {"initial": "black", "previous": "mix"}, pos: [200.0, 0.0]),
        "/mix": (kind: "tex.composite", inputs: {"in0": "shift", "in1": "glow"}, pos: [1200.0, 0.0]),
        "/seed": (kind: "tex.text", params: {"color": [1.0, 0.45, 0.1, 1.0], "size": 120.0, "style": "Bold", "text": "penumbra"}, binds: {"position.0": "x", "position.1": "y"}, pos: [200.0, 142.0]),
        "/shadow": (kind: "tex.blur", params: {"size": 10.0}, inputs: {"in": "dark"}, pos: [1200.0, 284.0]),
        "/shift": (kind: "tex.hsv", params: {"hue": 5.0}, inputs: {"in": "fade"}, pos: [1000.0, 0.0]),
        "/show": (kind: "tex.composite", inputs: {"in0": "black", "in1": "mix", "in2": "shadow", "in3": "seed"}, pos: [1400.0, 0.0]),
        "/soften": (kind: "tex.blur", params: {"size": 2.0}, inputs: {"in": "drift"}, pos: [600.0, 0.0]),
        "/x": (kind: "chan.lfo", params: {"amplitude": 0.3, "name": "x", "offset": 0.5, "rate": 0.17}, pos: [0.0, 142.0]),
        "/y": (kind: "chan.lfo", params: {"amplitude": 0.25, "name": "y", "offset": 0.5, "phase": 0.25, "rate": 0.23}, pos: [0.0, 284.0]),
    },
)
