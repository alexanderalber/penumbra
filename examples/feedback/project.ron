// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_loop": (kind: "ui.note", params: {"height": 155, "text": "# Feedback loop\n`loop` passes on what `mix` made a frame earlier (the dashed wire). Each pass: `drift` zooms and turns, `soften` blurs, `fade` dims, `shift` turns the hue. `mix` lays `glow` on top and hands the result back.\n- `brightness` on `fade`: closer to 1 for longer trails, lower for shorter ones\n- `rotate` on `drift`: positive turns the other way. `scale` below 1: the trails fall inwards\n- `reset` on `loop`: on and off clears the loop", "width": 1150}, pos: [600.0, -180.0]),
        "/about_page": (kind: "ui.note", params: {"height": 135, "text": "# Control page\n`http` serves `www/index.html` at http://localhost:8090/. The page's slider sends `trail`, bound to `brightness` on `fade`. Holding its button sends `clear`, bound to `reset` on `loop`. `xy` sends `x` and `y` back to the page. Until the page sends, `fade` and `loop` warn that `http` has no such channel.", "width": 560}, pos: [600.0, 400.0]),
        "/about_text": (kind: "ui.note", params: {"height": 155, "text": "# Text on top\n`seed` is the text. `x` and `y` are LFOs bound to its `position`: it wanders. `show` draws the sharp text last, over a dark halo (`dark`, `shadow`). The word stays readable on its trail.\n- `size` 0 on `soften`, `seed` instead of `glow` in `mix`: each pass shows as a separate copy", "width": 560}, pos: [0.0, 520.0]),
        "/black": (kind: "tex.constant", pos: [400.0, 0.0]),
        "/dark": (kind: "tex.level", params: {"brightness": 0.0}, inputs: {"in": "seed"}, pos: [400.0, 259.0]),
        "/drift": (kind: "tex.transform", params: {"extend": "zero", "rotate": -0.4, "scale": [1.005, 1.005]}, inputs: {"in": "loop"}, pos: [800.0, 46.0]),
        "/fade": (kind: "tex.level", params: {"brightness": 0.98}, inputs: {"in": "soften"}, binds: {"brightness": "http:trail"}, pos: [1200.0, 46.0]),
        "/http": (kind: "chan.http_in", inputs: {"chans": "xy"}, pos: [400.0, 394.0]),
        "/glow": (kind: "tex.blur", params: {"size": 10.0}, inputs: {"in": "seed"}, pos: [400.0, 130.0]),
        "/loop": (kind: "tex.feedback", inputs: {"initial": "black", "previous": "mix"}, binds: {"reset": "http:clear"}, pos: [600.0, 46.0]),
        "/mix": (kind: "tex.composite", inputs: {"in0": "shift", "in1": "glow"}, pos: [1600.0, 94.0]),
        "/seed": (kind: "tex.text", params: {"color": [1.0, 0.45, 0.1, 1.0], "size": 120.0, "style": "Bold", "text": "penumbra"}, binds: {"position.0": "x", "position.1": "y"}, pos: [200.0, 260.0]),
        "/shadow": (kind: "tex.blur", params: {"size": 10.0}, inputs: {"in": "dark"}, pos: [600.0, 259.0]),
        "/shift": (kind: "tex.hsv", params: {"hue": 5.0}, inputs: {"in": "fade"}, pos: [1400.0, 46.0]),
        "/show": (kind: "tex.composite", inputs: {"in0": "black", "in1": "mix", "in2": "shadow", "in3": "seed"}, pos: [1800.0, 157.0]),
        "/soften": (kind: "tex.blur", params: {"size": 2.0}, inputs: {"in": "drift"}, pos: [1000.0, 46.0]),
        "/x": (kind: "chan.lfo", params: {"amplitude": 0.3, "name": "x", "offset": 0.5, "rate": 0.17}, pos: [0.0, 365.0]),
        "/xy": (kind: "chan.merge", inputs: {"in0": "x", "in1": "y"}, pos: [200.0, 394.0]),
        "/y": (kind: "chan.lfo", params: {"amplitude": 0.25, "name": "y", "offset": 0.5, "phase": 0.25, "rate": 0.23}, pos: [0.0, 437.0]),
    },
)
