// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_figure": (kind: "ui.note", params: {"height": 200, "text": "# The rings\nEach table of places is also wired into `targets` of its group. A spring pulls every body back to the place it started from.\n- `pull` on `balls` and `boxes` switches the spring: 1 holds the rings, 0 lets the bodies fall\n- `form` is a square LFO between 0 and 1. Both `pull` params are bound to it: 8 seconds rings, 8 seconds heap", "width": 500}, pos: [-800.0, 380.0]),
        "/about_ground": (kind: "ui.note", params: {"height": 160, "text": "# Ground and field\n- `ground` is the floor and a ramp. It goes into `obstacles`, so the bodies land on what you see\n- `attractor` is a `physics.field` that pulls every body to a point above the floor. Its `strength` is 0: it is off", "width": 500}, pos: [-800.0, 1260.0]),
        "/about_groups": (kind: "ui.note", params: {"height": 200, "text": "# Two groups in one world\nA `physics.bodies` is one group: a table places its bodies, a model shows them.\n- `balls`: 25 balls. `ball_places` has a row per ball, `ball_look` is the model. `shape` is `sphere`\n- `boxes`: 50 boxes from `box_places` and `box_look`. `shape` is `box`\n`solver` moves both groups. Balls and boxes collide with each other, with `ground` and with the paddle", "width": 500}, pos: [-800.0, 0.0]),
        "/about_paddle": (kind: "ui.note", params: {"height": 200, "text": "# The paddle\n`paddle` is a group with `mode` `driven`: its one body goes where its table says, and pushes what is in its way.\n- `sweep` is an LFO named `tx`, `height` a constant named `tz`\n- `paddle_row` turns the two channels into a table of one row\nThe paddle shoves the heap up the ramp, and the bodies roll back down", "width": 500}, pos: [-800.0, 760.0]),
        "/about_try": (kind: "ui.note", params: {"height": 240, "text": "# Try\n- `strength` on `attractor`: 15 gathers the fallen bodies into one clump, -15 blows them apart\n- `rate` on `form`: how often the rings form. Unbind `pull` on a group and move it by hand\n- `stiffness` on `balls` or `boxes`: 400 snaps the bodies into place, 4 lets them drift there\n- `bounce` on `balls`, `friction` on `boxes`\n- `amplitude` and `rate` on `sweep`: a wider or faster paddle\n- `reset` on `solver` puts every body back to its start", "width": 500}, pos: [1120.0, 1240.0]),
        "/attractor": (kind: "physics.field", params: {"position": [0.5, 0.0, 2.0], "strength": 0.0}, pos: [440.0, 1120.0]),
        "/ball": (kind: "geo.primitive", params: {"segments": 24, "shape": "sphere", "size": [0.45, 0.45, 0.45]}, pos: [0.0, 90.0]),
        "/ball_look": (kind: "geo.assign_material", inputs: {"in": "ball", "mat": "ball_paint"}, pos: [220.0, 150.0]),
        "/ball_paint": (kind: "mat.phong", params: {"color": [0.95, 0.3, 0.12, 1.0]}, pos: [0.0, 220.0]),
        "/ball_places": (kind: "table.text", params: {"format": "csv", "text": "tx,ty,tz\n-0.40,0.00,5.00\n0.18,0.00,4.79\n0.49,0.00,4.26\n0.38,0.00,3.65\n-0.09,0.00,3.25\n-0.71,0.00,3.25\n-1.18,0.00,3.65\n-1.29,0.00,4.26\n-0.98,0.00,4.79\n-0.09,0.00,5.67\n0.49,0.00,5.43\n0.93,0.00,4.99\n1.17,0.00,4.41\n1.17,0.00,3.79\n0.93,0.00,3.21\n0.49,0.00,2.77\n-0.09,0.00,2.53\n-0.71,0.00,2.53\n-1.29,0.00,2.77\n-1.73,0.00,3.21\n-1.97,0.00,3.79\n-1.97,0.00,4.41\n-1.73,0.00,4.99\n-1.29,0.00,5.43\n-0.71,0.00,5.67"}, pos: [220.0, 0.0]),
        "/balls": (kind: "physics.bodies", params: {"bounce": 0.3, "shape": "sphere"}, inputs: {"model": "ball_look", "table": "ball_places", "targets": "ball_places"}, binds: {"pull": "form"}, pos: [440.0, 50.0]),
        "/bar": (kind: "geo.primitive", params: {"size": [0.3, 4.0, 1.0]}, pos: [0.0, 920.0]),
        "/bar_look": (kind: "geo.assign_material", inputs: {"in": "bar", "mat": "bar_paint"}, pos: [220.0, 980.0]),
        "/bar_paint": (kind: "mat.phong", params: {"color": [0.95, 0.75, 0.15, 1.0]}, pos: [0.0, 1050.0]),
        "/box": (kind: "geo.primitive", params: {"size": [0.4, 0.4, 0.4]}, pos: [0.0, 470.0]),
        "/box_look": (kind: "geo.assign_material", inputs: {"in": "box", "mat": "box_paint"}, pos: [220.0, 530.0]),
        "/box_paint": (kind: "mat.phong", params: {"color": [0.1, 0.45, 0.9, 1.0]}, pos: [0.0, 600.0]),
        "/box_places": (kind: "table.text", params: {"format": "csv", "text": "tx,ty,tz\n-0.40,0.00,6.40\n0.25,0.00,6.31\n0.84,0.00,6.03\n1.34,0.00,5.61\n1.69,0.00,5.06\n1.88,0.00,4.43\n1.88,0.00,3.77\n1.69,0.00,3.14\n1.34,0.00,2.59\n0.84,0.00,2.17\n0.25,0.00,1.89\n-0.40,0.00,1.80\n-1.05,0.00,1.89\n-1.64,0.00,2.17\n-2.14,0.00,2.59\n-2.49,0.00,3.14\n-2.68,0.00,3.77\n-2.68,0.00,4.43\n-2.49,0.00,5.06\n-2.14,0.00,5.61\n-1.64,0.00,6.03\n-1.05,0.00,6.31\n-0.06,0.00,7.08\n0.59,0.00,6.93\n1.20,0.00,6.64\n1.72,0.00,6.22\n2.14,0.00,5.70\n2.43,0.00,5.09\n2.58,0.00,4.44\n2.58,0.00,3.76\n2.43,0.00,3.11\n2.14,0.00,2.50\n1.72,0.00,1.98\n1.20,0.00,1.56\n0.59,0.00,1.27\n-0.06,0.00,1.12\n-0.74,0.00,1.12\n-1.39,0.00,1.27\n-2.00,0.00,1.56\n-2.52,0.00,1.98\n-2.94,0.00,2.50\n-3.23,0.00,3.11\n-3.38,0.00,3.76\n-3.38,0.00,4.44\n-3.23,0.00,5.09\n-2.94,0.00,5.70\n-2.52,0.00,6.22\n-2.00,0.00,6.64\n-1.39,0.00,6.93\n-0.74,0.00,7.08"}, pos: [220.0, 380.0]),
        "/boxes": (kind: "physics.bodies", params: {"shape": "box"}, inputs: {"model": "box_look", "table": "box_places", "targets": "box_places"}, binds: {"pull": "form"}, pos: [440.0, 430.0]),
        "/camera": (kind: "view.camera", params: {"position": [0.6, -14.0, 4.6], "target": [0.9, 0.0, 3.0]}, pos: [1120.0, 1070.0]),
        "/floor": (kind: "geo.primitive", params: {"size": [80.0, 80.0, 0.02]}, pos: [0.0, 1260.0]),
        "/form": (kind: "chan.lfo", params: {"amplitude": 0.5, "name": "pull", "offset": 0.5, "phase": 0.3, "rate": 0.0625, "shape": "square"}, pos: [220.0, -140.0]),
        "/ground": (kind: "geo.merge", inputs: {"in0": "floor", "in1": "ramp_tilt"}, pos: [440.0, 1320.0]),
        "/ground_look": (kind: "geo.assign_material", inputs: {"in": "ground", "mat": "ground_paint"}, pos: [680.0, 1380.0]),
        "/ground_paint": (kind: "mat.phong", params: {"color": [0.16, 0.17, 0.2, 1.0]}, pos: [440.0, 1450.0]),
        "/height": (kind: "chan.constant", params: {"name0": "tz", "value0": 0.5}, pos: [-220.0, 880.0]),
        "/lights": (kind: "light.merge", inputs: {"in0": "sky", "in1": "sun"}, pos: [1120.0, 940.0]),
        "/out": (kind: "tex.render", params: {"background": [0.012, 0.015, 0.03, 1.0], "height": 720, "width": 1280}, inputs: {"camera": "camera", "geo": "scene", "lights": "lights"}, pos: [1340.0, 800.0]),
        "/paddle": (kind: "physics.bodies", params: {"mode": "driven", "shape": "box"}, inputs: {"model": "bar_look", "table": "paddle_row"}, pos: [440.0, 860.0]),
        "/paddle_place": (kind: "chan.merge", inputs: {"in0": "sweep", "in1": "height"}, pos: [0.0, 800.0]),
        "/paddle_row": (kind: "table.from_chan", inputs: {"in": "paddle_place"}, pos: [220.0, 790.0]),
        "/ramp": (kind: "geo.primitive", params: {"size": [5.0, 4.0, 3.0]}, pos: [0.0, 1390.0]),
        "/ramp_tilt": (kind: "geo.transform", params: {"rotate": [0.0, 15.0, 0.0], "translate": [-0.8, 0.0, -0.85]}, inputs: {"in": "ramp"}, pos: [220.0, 1390.0]),
        "/scene": (kind: "geo.merge", inputs: {"in0": "solver", "in1": "ground_look"}, pos: [900.0, 700.0]),
        "/sky": (kind: "light.ambient", params: {"intensity": 0.35}, pos: [900.0, 880.0]),
        "/solver": (kind: "physics.rigid_bodies", params: {"damping": 0.5, "spin_damping": 0.5, "substeps": 2}, inputs: {"bodies0": "balls", "bodies1": "boxes", "bodies2": "paddle", "field0": "attractor", "obstacles": "ground"}, pos: [680.0, 640.0]),
        "/sun": (kind: "light.directional", params: {"position": [-6.0, -5.0, 6.0], "shadows": true}, pos: [900.0, 1010.0]),
        "/sweep": (kind: "chan.lfo", params: {"amplitude": 1.8, "name": "tx", "offset": 4.4, "rate": 0.2}, pos: [-220.0, 760.0]),
    },
)
