// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/brightness": (kind: "chan.from_tex", params: {"columns": 128, "components": "luminance"}, inputs: {"in": "picture"}, pos: [250.0, 0.0]),
        "/columns": (kind: "chan.from_tex", params: {"columns": 64, "components": "rgb"}, inputs: {"in": "picture"}, pos: [251.0, 158.0]),
        "/curve": (kind: "tex.from_chan", inputs: {"in": "brightness"}, pos: [500.0, 0.0]),
        "/mean": (kind: "chan.from_tex", params: {"components": "rgb"}, inputs: {"in": "picture"}, pos: [250.0, 360.0]),
        "/noise": (kind: "tex.noise", params: {"amplitude": 0.7, "frequency": 1.5, "height": 720, "speed": 0.25, "width": 1280}, pos: [-200.0, 180.0]),
        "/picture": (kind: "tex.lookup", params: {"palette": "plasma"}, inputs: {"in": "noise"}, pos: [0.0, 180.0]),
        "/strip": (kind: "tex.from_chan", inputs: {"in": "columns"}, pos: [508.0, 202.0]),
        "/swatch": (kind: "tex.constant", params: {"height": 64, "width": 64}, binds: {"color.0": "mean:r", "color.1": "mean:g", "color.2": "mean:b"}, pos: [500.0, 360.0]),
        "/view": (kind: "tex.shader", params: {"file": "view.wgsl"}, inputs: {"in0": "picture", "in1": "curve", "in2": "strip", "in3": "swatch"}, pos: [800.0, 180.0]),
    },
)
