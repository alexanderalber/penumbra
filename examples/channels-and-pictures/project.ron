// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_in": (kind: "ui.note", params: {"height": 155, "text": "# Picture into channels\n`picture` is `noise` coloured through the colormap `plasma`. Each `chan.from_tex` reads it into channels:\n- `brightness`: brightness of 128 columns\n- `columns`: colour of 64 columns (`r`, `g`, `b`)\n- `mean`: the mean colour", "width": 560}, pos: [-200.0, -180.0]),
        "/about_out": (kind: "ui.note", params: {"height": 115, "text": "# Channels into pictures\n`curve` and `strip` (`tex.from_chan`) are one pixel high, one pixel per sample. With `layout` `auto`, `strip` sees `r`, `g`, `b` and makes a colour row. `curve` has one channel and is grey. `swatch` is a constant bound to `mean`.", "width": 560}, pos: [400.0, 390.0]),
        "/about_view": (kind: "ui.note", params: {"height": 155, "text": "# Drawing\n`view` (`view.wgsl`) draws over `picture`: brightness as a curve, column colours as a strip at the bottom, the mean colour as a square top right.\n- `gain` on `view`: stretch of the curve around the mean\n- `palette` on `picture`: try `sea`, `twilight`, `candy`", "width": 480}, pos: [600.0, -100.0]),
        "/brightness": (kind: "chan.from_tex", params: {"columns": 128, "components": "luminance"}, inputs: {"in": "picture"}, pos: [200.0, 28.0]),
        "/columns": (kind: "chan.from_tex", params: {"columns": 64, "components": "rgb"}, inputs: {"in": "picture"}, pos: [200.0, 157.0]),
        "/curve": (kind: "tex.from_chan", inputs: {"in": "brightness"}, pos: [400.0, 0.0]),
        "/mean": (kind: "chan.from_tex", params: {"components": "rgb"}, inputs: {"in": "picture"}, pos: [200.0, 229.0]),
        "/noise": (kind: "tex.noise", params: {"amplitude": 0.7, "frequency": 1.5, "height": 720, "speed": 0.25, "width": 1280}, pos: [-200.0, 50.0]),
        "/picture": (kind: "tex.lookup", params: {"palette": "plasma"}, inputs: {"in": "noise"}, pos: [0.0, 64.0]),
        "/strip": (kind: "tex.from_chan", inputs: {"in": "columns"}, pos: [400.0, 128.0]),
        "/swatch": (kind: "tex.constant", params: {"height": 64, "width": 64}, binds: {"color.0": "mean:r", "color.1": "mean:g", "color.2": "mean:b"}, pos: [400.0, 257.0]),
        "/view": (kind: "tex.shader", params: {"file": "view.wgsl"}, inputs: {"in0": "picture", "in1": "curve", "in2": "strip", "in3": "swatch"}, pos: [600.0, 84.0]),
    },
)
