// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_content": (kind: "ui.note", params: {"height": 110, "text": "# Content\nDrawn once, in the camera's picture: `clouds` coloured by `colours`, with the bright bar `sweep` on top. All three projectors take their share of `content`.", "width": 550}, pos: [0.0, 100.0]),
        "/about_preview": (kind: "ui.note", params: {"height": 110, "text": "# Preview\n`wall` shows the picture as it lands on the wall, seen from the camera. `unblended` is the same without the blend weights: there the overlaps are twice as bright.", "width": 560}, pos: [1400.0, -200.0]),
        "/about_projectors": (kind: "ui.note", params: {"height": 100, "text": "# Per projector\n`share_a` takes projector A's part of `content` through its map `map_a`. `blend_a` fades it in the overlaps by `weight_a`. `proj_a` shows it, evened out by its flat field. B and C below work the same way.", "width": 750}, pos: [600.0, -200.0]),
        "/about_scans": (kind: "ui.note", params: {"height": 90, "text": "# Your own wall\n`scan_a`, `scan_b` and `scan_c` measure the maps on your wall. The steps are in the example's README, under \"Your own wall\".", "width": 520}, pos: [1200.0, 1400.0]),
        "/blend_a": (kind: "tex.blend_weight", inputs: {"in": "share_a", "weight": "weight_a"}, pos: [1000.0, 0.0]),
        "/blend_b": (kind: "tex.blend_weight", inputs: {"in": "share_b", "weight": "weight_b"}, pos: [1000.0, 450.0]),
        "/blend_c": (kind: "tex.blend_weight", inputs: {"in": "share_c", "weight": "weight_c"}, pos: [1000.0, 900.0]),
        "/clouds": (kind: "tex.noise", params: {"frequency": 5.0, "octaves": 3, "seed": 7, "speed": 0.05}, binds: {"translate.0": "drift:drift"}, pos: [0.0, 400.0]),
        "/colours": (kind: "tex.lookup", params: {"palette": "sea"}, inputs: {"in": "clouds"}, pos: [200.0, 400.0]),
        "/content": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "colours", "in1": "sweep"}, pos: [400.0, 500.0]),
        "/drift": (kind: "chan.lfo", params: {"amplitude": 3.0, "name": "drift", "rate": 0.008, "shape": "triangle"}, pos: [0.0, 300.0]),
        "/map_a": (kind: "tex.image_file", params: {"file": "blend/proj_to_cam_0.png"}, pos: [600.0, 120.0]),
        "/map_b": (kind: "tex.image_file", params: {"file": "blend/proj_to_cam_1.png"}, pos: [600.0, 570.0]),
        "/map_c": (kind: "tex.image_file", params: {"file": "blend/proj_to_cam_2.png"}, pos: [600.0, 1020.0]),
        "/proj_a": (kind: "out.projector", inputs: {"black": "proj_a_black", "gain": "proj_a_gain", "in": "blend_a"}, pos: [1200.0, 60.0]),
        "/proj_a_black": (kind: "tex.image_file", params: {"file": "flatfield/black_proj_a.png"}, pos: [1000.0, 270.0]),
        "/proj_a_gain": (kind: "tex.image_file", params: {"file": "flatfield/gain_proj_a.png"}, pos: [1000.0, 140.0]),
        "/proj_b": (kind: "out.projector", inputs: {"black": "proj_b_black", "gain": "proj_b_gain", "in": "blend_b"}, pos: [1200.0, 510.0]),
        "/proj_b_black": (kind: "tex.image_file", params: {"file": "flatfield/black_proj_b.png"}, pos: [1000.0, 720.0]),
        "/proj_b_gain": (kind: "tex.image_file", params: {"file": "flatfield/gain_proj_b.png"}, pos: [1000.0, 590.0]),
        "/proj_c": (kind: "out.projector", inputs: {"black": "proj_c_black", "gain": "proj_c_gain", "in": "blend_c"}, pos: [1200.0, 960.0]),
        "/proj_c_black": (kind: "tex.image_file", params: {"file": "flatfield/black_proj_c.png"}, pos: [1000.0, 1170.0]),
        "/proj_c_gain": (kind: "tex.image_file", params: {"file": "flatfield/gain_proj_c.png"}, pos: [1000.0, 1040.0]),
        "/raw_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "share_a", "map": "wall_to_a"}, pos: [1600.0, 200.0]),
        "/raw_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "share_b", "map": "wall_to_b"}, pos: [1600.0, 650.0]),
        "/raw_c": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "share_c", "map": "wall_to_c"}, pos: [1600.0, 1100.0]),
        "/scan_a": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_a"}, pos: [600.0, 1400.0]),
        "/scan_b": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_b"}, pos: [800.0, 1400.0]),
        "/scan_c": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_c"}, pos: [1000.0, 1400.0]),
        "/seen_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "blend_a", "map": "wall_to_a"}, pos: [1600.0, 60.0]),
        "/seen_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "blend_b", "map": "wall_to_b"}, pos: [1600.0, 510.0]),
        "/seen_c": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "blend_c", "map": "wall_to_c"}, pos: [1600.0, 960.0]),
        "/share_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "content", "map": "map_a"}, pos: [800.0, 0.0]),
        "/share_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "content", "map": "map_b"}, pos: [800.0, 450.0]),
        "/share_c": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "content", "map": "map_c"}, pos: [800.0, 900.0]),
        "/sweep": (kind: "tex.primitive", params: {"center": [0.5, 0.55], "fill": [1.0, 0.95, 0.85, 0.8], "size": [0.08, 0.5], "softness": 48.0}, binds: {"center.0": "sweep_x:x"}, pos: [200.0, 650.0]),
        "/sweep_x": (kind: "chan.lfo", params: {"amplitude": 0.42, "name": "x", "offset": 0.486, "rate": 0.04, "shape": "triangle"}, pos: [0.0, 650.0]),
        "/unblended": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "raw_a", "in1": "raw_b", "in2": "raw_c"}, pos: [1800.0, 700.0]),
        "/wall": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "seen_a", "in1": "seen_b", "in2": "seen_c"}, pos: [1800.0, 510.0]),
        "/wall_to_a": (kind: "tex.image_file", params: {"file": "preview/wall_to_proj_a.exr"}, pos: [1400.0, 200.0]),
        "/wall_to_b": (kind: "tex.image_file", params: {"file": "preview/wall_to_proj_b.exr"}, pos: [1400.0, 650.0]),
        "/wall_to_c": (kind: "tex.image_file", params: {"file": "preview/wall_to_proj_c.exr"}, pos: [1400.0, 1100.0]),
        "/weight_a": (kind: "tex.image_file", params: {"file": "blend/weight_0.png"}, pos: [800.0, 160.0]),
        "/weight_b": (kind: "tex.image_file", params: {"file": "blend/weight_1.png"}, pos: [800.0, 610.0]),
        "/weight_c": (kind: "tex.image_file", params: {"file": "blend/weight_2.png"}, pos: [800.0, 1060.0]),
    },
)
