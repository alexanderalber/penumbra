// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_content": (kind: "ui.note", params: {"height": 135, "text": "# Content\nDrawn once, in the camera's picture: `clouds` coloured by `colours`, with the bright bar `sweep` on top. All three projectors take their share of `content`.", "width": 550}, pos: [0.0, 620.0]),
        "/about_flatfield": (kind: "ui.note", params: {"height": 215, "text": "# Flat field and colour match\n`proj_a_gain` and `proj_a_black` are the flat field from `projector.flatfield`. The gain evens out brightness and colour across the projector. It costs 31 % of the light on this wall. The black lift raises black beside the overlaps to the brighter black inside them. `matrix` and `curves` on `proj_a` are empty: `projector.match` writes them.\n- `display` on `proj_a`: empty, so no window opens\n- `correct` off on `proj_b`: compare on the wall without match and flat field", "width": 560}, pos: [1400.0, 40.0]),
        "/about_preview": (kind: "ui.note", params: {"height": 175, "text": "# Preview\n`wall` shows the picture as it lands on the wall, seen from the camera. `unblended` is the same without the blend weights: there the overlaps are twice as bright.\n- `seen_a` carries `blend_a` back into the camera's picture through `wall_to_a`\n- `raw_a` does the same with `share_a`, before the blend weight", "width": 560}, pos: [1600.0, 980.0]),
        "/about_projectors": (kind: "ui.note", params: {"height": 115, "text": "# Per projector\n`share_a` takes projector A's part of `content` through its map `map_a`. `blend_a` fades it in the overlaps by `weight_a`. `proj_a` shows it, evened out by its flat field. B and C below work the same way.", "width": 750}, pos: [600.0, -260.0]),
        "/about_scans": (kind: "ui.note", params: {"height": 115, "text": "# Your own wall\n`scan_a`, `scan_b` and `scan_c` measure the maps on your wall. The steps are in the example's README, under \"Your own wall\".", "width": 520}, pos: [600.0, 1918.0]),
        "/about_try": (kind: "ui.note", params: {"height": 135, "text": "# Try\n- `rate` on `sweep_x`: a faster sweep. `size` on `sweep`: a wider band\n- `palette` on `colours`: `ember`, `neon`, `magma`, or hex colours\n- `mode` `detail` on `blend_b`: thin lines come from one projector only. Needs the scan's `detail.png` at its `detail` input", "width": 560}, pos: [0.0, 1090.0]),
        "/blend_a": (kind: "tex.blend_weight", inputs: {"in": "share_a", "weight": "weight_a"}, pos: [1000.0, 257.0]),
        "/blend_b": (kind: "tex.blend_weight", inputs: {"in": "share_b", "weight": "weight_b"}, pos: [1000.0, 915.0]),
        "/blend_c": (kind: "tex.blend_weight", inputs: {"in": "share_c", "weight": "weight_c"}, pos: [1000.0, 1485.0]),
        "/clouds": (kind: "tex.noise", params: {"frequency": 5.0, "octaves": 3, "seed": 7, "speed": 0.05}, binds: {"translate.0": "drift:drift"}, pos: [200.0, 799.0]),
        "/colours": (kind: "tex.lookup", params: {"palette": "sea"}, inputs: {"in": "clouds"}, pos: [400.0, 813.0]),
        "/content": (kind: "tex.composite", params: {"op": "screen"}, inputs: {"in0": "colours", "in1": "sweep"}, pos: [600.0, 888.0]),
        "/drift": (kind: "chan.lfo", params: {"amplitude": 3.0, "name": "drift", "rate": 0.008, "shape": "triangle"}, pos: [0.0, 929.0]),
        "/map_a": (kind: "tex.image_file", params: {"file": "blend/proj_to_cam_0.png"}, pos: [600.0, 324.0]),
        "/map_b": (kind: "tex.image_file", params: {"file": "blend/proj_to_cam_1.png"}, pos: [600.0, 1016.0]),
        "/map_c": (kind: "tex.image_file", params: {"file": "blend/proj_to_cam_2.png"}, pos: [600.0, 1424.0]),
        "/proj_a": (kind: "out.projector", inputs: {"black": "proj_a_black", "gain": "proj_a_gain", "in": "blend_a"}, pos: [1200.0, 90.0]),
        "/proj_a_black": (kind: "tex.image_file", params: {"file": "flatfield/black_proj_a.png"}, pos: [1000.0, 128.0]),
        "/proj_a_gain": (kind: "tex.image_file", params: {"file": "flatfield/gain_proj_a.png"}, pos: [1000.0, 0.0]),
        "/proj_b": (kind: "out.projector", inputs: {"black": "proj_b_black", "gain": "proj_b_gain", "in": "blend_b"}, pos: [1200.0, 622.0]),
        "/proj_b_black": (kind: "tex.image_file", params: {"file": "flatfield/black_proj_b.png"}, pos: [1000.0, 520.0]),
        "/proj_b_gain": (kind: "tex.image_file", params: {"file": "flatfield/gain_proj_b.png"}, pos: [1000.0, 391.0]),
        "/proj_c": (kind: "out.projector", inputs: {"black": "proj_c_black", "gain": "proj_c_gain", "in": "blend_c"}, pos: [1200.0, 1685.0]),
        "/proj_c_black": (kind: "tex.image_file", params: {"file": "flatfield/black_proj_c.png"}, pos: [1000.0, 1742.0]),
        "/proj_c_gain": (kind: "tex.image_file", params: {"file": "flatfield/gain_proj_c.png"}, pos: [1000.0, 1614.0]),
        "/raw_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "share_a", "map": "wall_to_a"}, pos: [1000.0, 648.0]),
        "/raw_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "share_b", "map": "wall_to_b"}, pos: [1000.0, 1079.0]),
        "/raw_c": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "share_c", "map": "wall_to_c"}, pos: [1000.0, 1336.0]),
        "/scan_a": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_a"}, pos: [0.0, 1918.0]),
        "/scan_b": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_b"}, pos: [200.0, 1918.0]),
        "/scan_c": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_c"}, pos: [400.0, 1918.0]),
        "/seen_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "blend_a", "map": "wall_to_a"}, pos: [1200.0, 285.0]),
        "/seen_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "blend_b", "map": "wall_to_b"}, pos: [1200.0, 949.0]),
        "/seen_c": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "blend_c", "map": "wall_to_c"}, pos: [1200.0, 1499.0]),
        "/share_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "content", "map": "map_a"}, pos: [800.0, 310.0]),
        "/share_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "content", "map": "map_b"}, pos: [800.0, 969.0]),
        "/share_c": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "content", "map": "map_c"}, pos: [800.0, 1410.0]),
        "/sweep": (kind: "tex.primitive", params: {"center": [0.5, 0.55], "fill": [1.0, 0.95, 0.85, 0.8], "size": [0.08, 0.5], "softness": 48.0}, binds: {"center.0": "sweep_x:x"}, pos: [400.0, 942.0]),
        "/sweep_x": (kind: "chan.lfo", params: {"amplitude": 0.42, "name": "x", "offset": 0.486, "rate": 0.04, "shape": "triangle"}, pos: [200.0, 1521.0]),
        "/unblended": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "raw_a", "in1": "raw_b", "in2": "raw_c"}, pos: [1200.0, 1197.0]),
        "/wall": (kind: "tex.composite", params: {"op": "add"}, inputs: {"in0": "seen_a", "in1": "seen_b", "in2": "seen_c"}, pos: [1400.0, 995.0]),
        "/wall_to_a": (kind: "tex.image_file", params: {"file": "preview/wall_to_proj_a.exr"}, pos: [800.0, 488.0]),
        "/wall_to_b": (kind: "tex.image_file", params: {"file": "preview/wall_to_proj_b.exr"}, pos: [800.0, 1097.0]),
        "/wall_to_c": (kind: "tex.image_file", params: {"file": "preview/wall_to_proj_c.exr"}, pos: [800.0, 1282.0]),
        "/weight_a": (kind: "tex.image_file", params: {"file": "blend/weight_0.png"}, pos: [800.0, 182.0]),
        "/weight_b": (kind: "tex.image_file", params: {"file": "blend/weight_1.png"}, pos: [800.0, 840.0]),
        "/weight_c": (kind: "tex.image_file", params: {"file": "blend/weight_2.png"}, pos: [800.0, 1539.0]),
    },
)
