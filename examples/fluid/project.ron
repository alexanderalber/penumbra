// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/black": (kind: "tex.constant", pos: [400.0, 142.0]),
        "/flow": (kind: "tex.optical_flow", inputs: {"in": "movers"}, pos: [200.0, 0.0]),
        "/fluid": (kind: "tex.fluid", params: {"dye_fade": 8.0, "velocity_fade": 5.0, "vorticity": 0.8}, inputs: {"dye": "movers", "force": "flow", "splats": "track:blobs"}, pos: [400.0, 0.0]),
        "/movers": (kind: "tex.shader", params: {"count": 5, "file": "movers.wgsl", "height": 720, "look": "neon", "width": 1280}, pos: [0.0, 0.0]),
        "/track": (kind: "tex.blob_track", params: {"detect": "bright", "threshold": 0.2}, inputs: {"in": "movers"}, pos: [200.0, 142.0]),
        "/view": (kind: "tex.composite", inputs: {"in0": "black", "in1": "fluid"}, pos: [600.0, 0.0]),
    },
)
