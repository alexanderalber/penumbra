// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 165, "text": "# Stripes that run along the person's path\n- `person` stands in for a depth camera's mask: white where the person is\n- `seen` and `loop` remember when the person was last at each pixel\n- `out` counts stripes at a steady rate from that moment, so lines of equal count are the person's past outlines. Every stripe keeps moving at the same rate. Look at `out`", "width": 800}, pos: [-200.0, 420.0]),
        "/about_camera": (kind: "ui.note", params: {"height": 135, "text": "# With a real depth camera\nThe camera's SDK or a free sender sends the mask through Spout or NDI. Add a `tex.spout_in` or `tex.ndi_in`. Wire it into `in0` of `seen` and `in1` of `out` instead of `person`. A `tex.mapper` in between lines the mask up with the projector.", "width": 560}, pos: [650.0, 420.0]),
        "/about_try": (kind: "ui.note", params: {"height": 175, "text": "# Try\n- `across` 0 on `out`: only the stripes the person leaves\n- `speed` on `out`: every stripe at once\n- `gap` 0 on `out`: colour bands without the black\n- `pace` 0 on `person`: the person stands still and the stripes run on\n- R on `loop`: forget where the person has been", "width": 480}, pos: [1000.0, 160.0]),
        "/black": (kind: "tex.constant", params: {"height": 1080, "width": 1080}, pos: [0.0, 122.0]),
        "/loop": (kind: "tex.feedback", inputs: {"initial": "black", "previous": "seen"}, pos: [200.0, 136.0]),
        "/out": (kind: "tex.shader", params: {"file": "show.wgsl"}, inputs: {"in0": "seen", "in1": "person"}, pos: [800.0, 194.0]),
        "/person": (kind: "tex.shader", params: {"file": "person.wgsl", "height": 1080, "width": 1080}, pos: [200.0, 264.0]),
        "/seen": (kind: "tex.shader", params: {"file": "seen.wgsl"}, inputs: {"in0": "person", "in1": "loop"}, pos: [400.0, 144.0]),
    },
)
