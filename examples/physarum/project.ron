// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 220, "text": "# Physarum (slime mould)\n`physarum` is the library component `physarum`: many agents follow a trail and lay one, and the trail becomes a network of veins. Choose a `preset` on it: the preset writes its values into the params below, then tune any of them. A new preset carries on from the network that is there: the agents change their ways. With `fresh` on, a new preset starts over.\nKey 0 starts it over (`keys` is bound to `physarum`\'s `reset`). Click into the editor once so it gets the keys.\nStand-ins: `word` is the mask input (presets word and walls use it; a scan mask of the object in an installation). `blob`, moved by `x` and `y`, is the people input: `people_mode` says what they do (tex.blob_track in an installation). `points` is the food input: preset network links its dots with veins.\n`/out` shows the picture. The channel outputs `coverage` and `alive` say how much of the area has visible trail and how many agents live.", "width": 1100}, pos: [-400.0, -460.0]),
        "/blob": (kind: "tex.primitive", params: {"keep_size": true, "shape": "ellipse", "size": [0.12, 0.12], "softness": 30.0}, binds: {"center.0": "x:x", "center.1": "y:y"}, pos: [-500.0, 60.0]),
        "/keys": (kind: "chan.keyboard_in", params: {"keys": "0"}, pos: [300.0, 200.0]),
        "/out": (kind: "tex.null", inputs: {"in": "physarum/out"}, pos: [650.0, 0.0]),
        "/physarum": (kind: "comp.base", params: {"about": "Physarum (slime mould): agents lay and follow trails that grow into glowing veins, lace, foam or a network linking points, around or on a mask.", "params": "@param preset choice(lace|veins|foam|dots|spirals|fire|worms|word|walls|network|heading) = lace -- the organism and what the inputs do; choosing one writes its values into the params, then they are yours; a new preset carries on from the network that is there, unless fresh is on\n@param fresh bool = false -- a new preset starts over from its own start instead of the agents changing their ways\n@param seed int = 1 0..1000 -- another random start; a change starts over\n@expose speed = agents.speed\n@expose mask_mode = fields.mask_mode\n@expose people_mode = fields.people_mode\n@expose strength = fields.strength\n@param pause bool = false -- holds agents and trail as they are\n@group organism\n@expose sensor_angle = agents.sensor_angle\n@expose sensor_distance = agents.sensor_distance\n@expose turn_angle = agents.turn_angle\n@expose step_length = agents.step_length\n@expose jitter = agents.jitter\n@expose deposit = trail.deposit\n@expose decay = trail.decay\n@expose diffusion = trail.diffusion\n@group life\n@expose renew = agents.renew\n@expose born = agents.born\n@expose edges = agents.edges\n@param start choice(scatter|disc|ring|centre|line|food) = scatter -- where the agents start; scatter: everywhere; food: on the food input\'s bright spots; a change starts over\n@param radius float = 0.3 0.01..1 -- start disc and ring: radius in picture heights; a change starts over\n@group inputs\n@expose food_rate = fields.food_rate\n@expose pull = fields.pull\n@expose line = fields.line\n@expose level = fields.level\n@expose food_decay = trail.food_decay\n@group look\n@expose colors = show.colors\n@expose heading = show.heading\n@expose gain = show.gain\n@expose contrast = show.contrast\n@expose glow = show.glow\n@expose glow_size = glow.size\n@expose background = show.background\n@expose through = show.through\n@expose marker = show.marker\n@expose food_shown = show.food_shown\n@expose show_inputs = show.show_inputs\n@expose out_width = show.width\n@expose out_height = show.height\n@group outputs\n@expose mark = measure.mark\n@group size\n@param agents int = 256 1..4096 -- number of agents in units of 1024: 256 is 262 144 agents; a change starts over\n@param width int = 960 16..4096 -- simulation width in cells; the network\'s meshes are about the same number of cells wide at any size, so a larger size gives a finer network; a change starts over\n@param height int = 540 16..4096 -- simulation height in cells; a change starts over\n@reset seed start radius agents width height\n@reset preset if fresh\n@preset preset=* sensor_angle=22.5 sensor_distance=9 turn_angle=90 step_length=1 jitter=0 deposit=1 decay=0.1 diffusion=1\n@preset preset=* renew=0 born=anywhere edges=wrap start=scatter mask_mode=off people_mode=attract food_rate=0 gain=0.04 heading=false through=0 food_shown=0\n@preset preset=lace -- fine polygon lace with bright knots; it moves slowly\n@preset preset=veins sensor_angle=40 sensor_distance=30 turn_angle=5 -- long, smooth, branching veins with faint side veins\n@preset preset=foam sensor_angle=70 sensor_distance=20 turn_angle=70 step_length=2 jitter=45 decay=0.15 people_mode=repel -- round cells like soap foam; people push it away\n@preset preset=dots sensor_angle=80 sensor_distance=3 turn_angle=80 decay=0.05 people_mode=repel gain=0.028 -- a dense field of glowing dots that grow fewer and larger over minutes; people push them away\n@preset preset=spirals sensor_angle=90 sensor_distance=25 turn_angle=10 step_length=3 gain=0.028 -- a few knots with rays and long winding veins\n@preset preset=fire sensor_angle=45 sensor_distance=5 turn_angle=10 step_length=3 gain=0.064 -- a restless field of filaments that never settles\n@preset preset=worms sensor_angle=45 sensor_distance=5 turn_angle=10 -- wriggling closed worms that keep changing shape\n@preset preset=word sensor_angle=70 sensor_distance=20 turn_angle=70 step_length=2 jitter=45 decay=0.15 mask_mode=attract -- foam that writes the mask\'s shape in single strokes\n@preset preset=walls mask_mode=wall through=0.5 -- lace that flows around the mask; the mask shows as a grey ground\n@preset preset=network sensor_angle=40 sensor_distance=30 turn_angle=5 renew=0.02 born=food edges=bounce start=food food_rate=5 people_mode=repel gain=0.064 food_shown=0.3 -- veins that link the food input\'s bright points, the classic slime mould picture; agents die and are born again on the food\n@preset preset=heading sensor_angle=40 sensor_distance=30 turn_angle=5 heading=true -- veins coloured by the direction the agents travel", "shelf": "simulations"}, binds: {"reset": "keys:key_0"}, pos: [300.0, 0.0]),
        "/physarum/agents": (kind: "tex.shader", params: {"born": "anywhere", "edges": "wrap", "file": "library/physarum/agents.wgsl", "format": "32f", "jitter": 0, "keep_size": true, "renew": 0, "sensor_angle": 22.5, "sensor_distance": 9, "step_length": 1, "turn_angle": 90}, inputs: {"in0": "agents_loop", "in1": "trail_loop", "in2": "fields"}, binds: {"bypass": "parent.pause", "pause": "parent.pause"}, pos: [200.0, -100.0]),
        "/physarum/agents_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "agents"}, pos: [0.0, -100.0]),
        "/physarum/alive": (kind: "chan.out", inputs: {"in": "counted"}, pos: [1600.0, 440.0]),
        "/physarum/counted": (kind: "chan.select", params: {"channels": "alive"}, inputs: {"in": "numbers"}, pos: [1200.0, 440.0]),
        "/physarum/coverage": (kind: "chan.out", inputs: {"in": "covered"}, pos: [1600.0, 320.0]),
        "/physarum/covered": (kind: "chan.select", params: {"channels": "coverage"}, inputs: {"in": "numbers"}, pos: [1200.0, 320.0]),
        "/physarum/deposit": (kind: "tex.scatter", params: {"dead": "alpha", "edge": "wrap"}, inputs: {"positions": "agents", "values": "tint"}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [600.0, -100.0]),
        "/physarum/fields": (kind: "tex.shader", params: {"file": "library/physarum/fields.wgsl", "food_rate": 0, "format": "32f", "keep_size": true, "mask_mode": "off", "people_mode": "attract"}, inputs: {"in0": "world", "in1": "mask", "in2": "people", "in3": "food"}, pos: [-400.0, 250.0]),
        "/physarum/food": (kind: "tex.in", inputs: {"in": "/points"}, pos: [-600.0, 400.0]),
        "/physarum/glow": (kind: "tex.blur", params: {"size": 12.0}, inputs: {"in": "trail"}, pos: [1000.0, 100.0]),
        "/physarum/mask": (kind: "tex.in", inputs: {"in": "/word"}, pos: [-600.0, 100.0]),
        "/physarum/measure": (kind: "tex.shader", params: {"file": "library/physarum/measure.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "quarter", "in1": "trail", "in2": "deposit"}, pos: [800.0, 380.0]),
        "/physarum/numbers": (kind: "chan.from_tex", params: {"components": "rg", "measure": "sum", "names": "coverage alive"}, inputs: {"in": "measure"}, pos: [1000.0, 380.0]),
        "/physarum/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [1400.0, 0.0]),
        "/physarum/people": (kind: "tex.in", inputs: {"in": "/blob"}, pos: [-600.0, 250.0]),
        "/physarum/quarter": (kind: "tex.resolution", params: {"keep_size": true, "multiply": 0.25}, inputs: {"in": "world"}, pos: [600.0, 380.0]),
        "/physarum/seed": (kind: "tex.shader", params: {"file": "library/physarum/seed.wgsl", "format": "32f", "height": 256, "keep_size": true, "resolution": "custom", "width": 1024}, inputs: {"in0": "world", "in1": "fields"}, binds: {"height": "parent.agents", "radius": "parent.radius", "seed": "parent.seed", "start": "parent.start"}, pos: [-200.0, -120.0]),
        "/physarum/show": (kind: "tex.shader", params: {"file": "library/physarum/show.wgsl", "food_shown": 0, "gain": 0.04, "heading": false, "keep_size": true, "resolution": "custom", "through": 0}, inputs: {"in0": "trail", "in1": "glow", "in2": "people", "in3": "food", "in4": "fields"}, pos: [1200.0, 0.0]),
        "/physarum/tint": (kind: "tex.shader", params: {"file": "library/physarum/tint.wgsl", "keep_size": true}, inputs: {"in0": "agents"}, pos: [400.0, -200.0]),
        "/physarum/trail": (kind: "tex.shader", params: {"decay": 0.1, "deposit": 1, "diffusion": 1, "file": "library/physarum/trail.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "trail_loop", "in1": "deposit", "in2": "fields"}, binds: {"agents": "parent.agents", "bypass": "parent.pause", "pause": "parent.pause"}, pos: [800.0, 0.0]),
        "/physarum/trail_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "trail"}, pos: [600.0, 100.0]),
        "/physarum/world": (kind: "tex.constant", params: {"color": [0.0, 0.0, 0.0, 0.0], "keep_size": true}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [-600.0, -50.0]),
        "/points": (kind: "tex.shader", params: {"file": "points.wgsl", "keep_size": true, "resolution": "custom"}, pos: [-300.0, 200.0]),
        "/word": (kind: "tex.text", params: {"keep_size": true, "size": 360.0, "style": "Bold", "text": "penumbra"}, pos: [-300.0, -100.0]),
        "/x": (kind: "chan.lfo", params: {"amplitude": 0.36, "name": "x", "offset": 0.5, "rate": 0.05}, pos: [-700.0, 40.0]),
        "/y": (kind: "chan.lfo", params: {"amplitude": 0.32, "name": "y", "offset": 0.5, "phase": 0.25, "rate": 0.083}, pos: [-700.0, 110.0]),
    },
)
