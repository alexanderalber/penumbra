// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/background": (kind: "tex.ramp", params: {"keys": "0.0000 0.03533 0.03533 0.03533\n0.1250 0.03080 0.03080 0.03080\n0.2500 0.02663 0.02663 0.02663\n0.3750 0.02281 0.02281 0.02281\n0.5000 0.01933 0.01933 0.01933\n0.6250 0.01618 0.01618 0.01618\n0.7500 0.01335 0.01335 0.01335\n0.8750 0.01084 0.01084 0.01084\n1.0000 0.00862 0.00862 0.00862", "shape": "radial"}, pos: [1200.0, 267.0]),
        "/box": (kind: "geo.primitive", params: {"size": [0.1, 0.6, 0.05]}, pos: [0.0, 0.0]),
        "/ini": (kind: "tex.shader", params: {"file": "ini.wgsl", "height": 256, "keep_size": true, "resolution": "custom", "width": 256}, pos: [0.0, 257.0]),
        "/light": (kind: "light.point", params: {"position": [0.0, -10.0, 0.0]}, pos: [1000.0, 512.0]),
        "/out": (kind: "tex.composite", inputs: {"in0": "background", "in1": "render"}, pos: [1400.0, 341.0]),
        "/palette": (kind: "tex.ramp", params: {"height": 256, "keep_size": true, "palette": "magma", "width": 256}, pos: [800.0, 588.0]),
        "/phong": (kind: "mat.phong", params: {"specular": [0.0, 0.0, 0.0, 1.0]}, pos: [0.0, 128.0]),
        "/pos": (kind: "tex.shader", params: {"file": "pos.wgsl", "keep_size": true}, inputs: {"in0": "pos_last", "in1": "vel_last", "in2": "ini"}, pos: [400.0, 314.0]),
        "/pos_last": (kind: "tex.feedback", inputs: {"initial": "ini", "previous": "pos"}, pos: [200.0, 228.0]),
        "/pulse": (kind: "chan.lfo", params: {"amplitude": 0.67, "name": "pulse", "offset": 1.0, "rate": 1.0416666666666667, "shape": "triangle"}, pos: [600.0, 360.0]),
        "/render": (kind: "tex.render", inputs: {"camera": "render_camera", "geo": "sticks", "lights": "light"}, pos: [1200.0, 395.0]),
        "/render_camera": (kind: "view.camera", params: {"fov": 26.24, "position": [0.0, -15.0, 0.0]}, pos: [1000.0, 642.0]),
        "/scale": (kind: "tex.shader", params: {"file": "scale.wgsl", "keep_size": true}, inputs: {"in0": "vel"}, binds: {"pulse": "pulse:pulse"}, pos: [800.0, 459.0]),
        "/stick": (kind: "geo.assign_material", inputs: {"in": "box", "mat": "phong"}, pos: [200.0, 97.0]),
        "/sticks": (kind: "geo.tex_instance", params: {"extent": 12.0}, inputs: {"aim": "vel", "color": "palette", "in": "stick", "position": "pos", "scale": "scale"}, pos: [1000.0, 380.0]),
        "/still": (kind: "tex.constant", params: {"height": 256, "keep_size": true, "width": 256}, pos: [0.0, 385.0]),
        "/vel": (kind: "tex.shader", params: {"file": "vel.wgsl", "keep_size": true}, inputs: {"in0": "pos", "in1": "vel_last"}, pos: [600.0, 432.0]),
        "/vel_last": (kind: "tex.feedback", inputs: {"initial": "still", "previous": "vel"}, pos: [200.0, 362.0]),
    },
)
