// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 1,
    nodes: {
        "/background": (kind: "tex.ramp", params: {"keys": "0.0000 0.03533 0.03533 0.03533\n0.1250 0.03080 0.03080 0.03080\n0.2500 0.02663 0.02663 0.02663\n0.3750 0.02281 0.02281 0.02281\n0.5000 0.01933 0.01933 0.01933\n0.6250 0.01618 0.01618 0.01618\n0.7500 0.01335 0.01335 0.01335\n0.8750 0.01084 0.01084 0.01084\n1.0000 0.00862 0.00862 0.00862", "shape": "radial"}),
        "/box": (kind: "geo.primitive", params: {"size": [0.1, 0.6, 0.05]}),
        "/ini": (kind: "tex.shader", params: {"file": "ini.wgsl", "height": 256, "keep_size": true, "resolution": "custom", "width": 256}),
        "/light": (kind: "light.point", params: {"position": [0.0, -10.0, 0.0]}),
        "/out": (kind: "tex.composite", inputs: {"layer1": "background", "layer2": "render"}),
        "/palette": (kind: "tex.ramp", params: {"height": 256, "keep_size": true, "keys": "0.0000 0.02178 0.05146 0.06886\n1.0000 1.00000 0.00054 0.00054", "width": 256}),
        "/phong": (kind: "mat.phong", params: {"specular": [0.0, 0.0, 0.0, 1.0]}),
        "/pos": (kind: "tex.shader", params: {"file": "pos.wgsl", "keep_size": true}, inputs: {"in0": "pos_last", "in1": "vel_last", "in2": "ini"}),
        "/pos_last": (kind: "tex.feedback", inputs: {"initial": "ini", "previous": "pos"}),
        "/pulse": (kind: "chan.lfo", params: {"amplitude": 0.67, "name": "pulse", "offset": 1.0, "rate": 1.0416666666666667, "shape": "triangle"}),
        "/render": (kind: "tex.render", params: {"fov": 26.24, "position": [0.0, -15.0, 0.0]}, inputs: {"geo": "sticks", "lights": "light"}),
        "/scale": (kind: "tex.shader", params: {"file": "scale.wgsl", "keep_size": true}, inputs: {"in0": "vel"}, binds: {"pulse": "pulse:pulse"}),
        "/stick": (kind: "geo.material", inputs: {"in": "box", "mat": "phong"}),
        "/sticks": (kind: "geo.texinstance", params: {"extent": 12.0}, inputs: {"aim": "vel", "color": "palette", "in": "stick", "position": "pos", "scale": "scale"}),
        "/still": (kind: "tex.constant", params: {"height": 256, "keep_size": true, "width": 256}),
        "/vel": (kind: "tex.shader", params: {"file": "vel.wgsl", "keep_size": true}, inputs: {"in0": "pos", "in1": "vel_last"}),
        "/vel_last": (kind: "tex.feedback", inputs: {"initial": "still", "previous": "vel"}),
    },
)
