// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 1,
    nodes: {
        "/cam_to_proj_a": (kind: "tex.image", params: {"file": "camera/cam_to_proj_0.png"}),
        "/cam_to_proj_b": (kind: "tex.image", params: {"file": "camera/cam_to_proj_1.png"}),
        "/contour_a": (kind: "tex.contour", params: {"color": [0.0, 0.0, 0.0, 0.6], "mode": "alpha", "thickness": 1.0}, inputs: {"in": "height_a"}),
        "/contour_b": (kind: "tex.contour", params: {"color": [0.0, 0.0, 0.0, 0.6], "mode": "alpha", "thickness": 1.0}, inputs: {"in": "height_b"}),
        "/drift": (kind: "tex.noise", params: {"amplitude": 0.05, "frequency": 10.0, "height": 540, "keep_size": true, "octaves": 4, "offset": 0.0, "seed": 3, "width": 960}),
        "/drifts_a": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"layer1": "height_a", "layer2": "drift"}),
        "/drifts_b": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"layer1": "height_b", "layer2": "drift"}),
        "/height_a": (kind: "tex.image", params: {"file": "relief/height_0.png"}),
        "/height_b": (kind: "tex.image", params: {"file": "relief/height_1.png"}),
        "/land_a": (kind: "tex.lookup", inputs: {"in": "height_a", "lut": "land_keys"}),
        "/land_b": (kind: "tex.lookup", inputs: {"in": "height_b", "lut": "land_keys"}),
        "/land_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 0.02 0.16 0.03\n0.3 0.188 0.402 0.061\n0.55 0.578 0.456 0.102\n0.75 0.305 0.127 0.045\n0.9 0.42 0.4 0.38\n1 0.6 0.6 0.6", "width": 256}),
        "/lines_a": (kind: "tex.composite", inputs: {"layer1": "contour_a", "layer2": "surf_a"}),
        "/lines_b": (kind: "tex.composite", inputs: {"layer1": "contour_b", "layer2": "surf_b"}),
        "/lit_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"layer1": "land_a", "layer2": "shade_a"}),
        "/lit_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"layer1": "land_b", "layer2": "shade_b"}),
        "/lit_room_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"layer1": "seen_a", "layer2": "photo_a"}),
        "/lit_room_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"layer1": "seen_b", "layer2": "photo_b"}),
        "/map_a": (kind: "tex.composite", inputs: {"layer1": "lit_a", "layer2": "snow_a", "layer3": "water_a", "layer4": "lines_a"}),
        "/map_b": (kind: "tex.composite", inputs: {"layer1": "lit_b", "layer2": "snow_b", "layer3": "water_b", "layer4": "lines_b"}),
        "/out_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"layer1": "map_a", "layer2": "weight_a"}),
        "/out_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"layer1": "map_b", "layer2": "weight_b"}),
        "/photo_a": (kind: "tex.image", params: {"file": "camera/photo_0.jpg"}),
        "/photo_b": (kind: "tex.image", params: {"file": "camera/photo_1.jpg"}),
        "/proj_a": (kind: "out.projector", inputs: {"in": "out_a"}),
        "/proj_b": (kind: "out.projector", inputs: {"in": "out_b"}),
        "/room": (kind: "tex.composite", params: {"op": "average"}, inputs: {"layer1": "lit_room_a", "layer2": "lit_room_b"}),
        "/scan_a": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_a"}),
        "/scan_b": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_b"}),
        "/sea_a": (kind: "tex.threshold", params: {"invert": true, "soft": 0.01}, inputs: {"in": "waves_a"}, binds: {"threshold": "tide:tide"}),
        "/sea_b": (kind: "tex.threshold", params: {"invert": true, "soft": 0.01}, inputs: {"in": "waves_b"}, binds: {"threshold": "tide:tide"}),
        "/seen_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "out_a", "map": "cam_to_proj_a"}),
        "/seen_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "out_b", "map": "cam_to_proj_b"}),
        "/shade_a": (kind: "tex.channel_mix", params: {"blue": [1.0, 0.0, 0.0, 0.8], "green": [1.0, 0.0, 0.0, 0.8], "red": [1.0, 0.0, 0.0, 0.8]}, inputs: {"in": "slope_a"}, binds: {"blue.0": "sun_x:sun_x", "blue.1": "sun_y:sun_y", "green.0": "sun_x:sun_x", "green.1": "sun_y:sun_y", "red.0": "sun_x:sun_x", "red.1": "sun_y:sun_y"}),
        "/shade_b": (kind: "tex.channel_mix", params: {"blue": [1.0, 0.0, 0.0, 0.8], "green": [1.0, 0.0, 0.0, 0.8], "red": [1.0, 0.0, 0.0, 0.8]}, inputs: {"in": "slope_b"}, binds: {"blue.0": "sun_x:sun_x", "blue.1": "sun_y:sun_y", "green.0": "sun_x:sun_x", "green.1": "sun_y:sun_y", "red.0": "sun_x:sun_x", "red.1": "sun_y:sun_y"}),
        "/slope_a": (kind: "tex.slope", params: {"offset": 0.0, "strength": 120.0}, inputs: {"in": "smooth_a"}),
        "/slope_b": (kind: "tex.slope", params: {"offset": 0.0, "strength": 120.0}, inputs: {"in": "smooth_b"}),
        "/smooth_a": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "height_a"}),
        "/smooth_b": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "height_b"}),
        "/snow_a": (kind: "tex.lookup", inputs: {"in": "snowfield_a", "lut": "snow_keys"}),
        "/snow_b": (kind: "tex.lookup", inputs: {"in": "snowfield_b", "lut": "snow_keys"}),
        "/snow_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 1 1 1 0\n1 0.95 0.97 1 0.92", "width": 256}),
        "/snowfield_a": (kind: "tex.threshold", params: {"soft": 0.03}, inputs: {"in": "drifts_a"}, binds: {"threshold": "snowline:snowline"}),
        "/snowfield_b": (kind: "tex.threshold", params: {"soft": 0.03}, inputs: {"in": "drifts_b"}, binds: {"threshold": "snowline:snowline"}),
        "/snowline": (kind: "chan.lfo", params: {"amplitude": 0.14, "name": "snowline", "offset": 0.72, "phase": 0.5, "rate": 0.0125}),
        "/sun_x": (kind: "chan.lfo", params: {"name": "sun_x", "rate": 0.05}),
        "/sun_y": (kind: "chan.lfo", params: {"name": "sun_y", "phase": 0.25, "rate": 0.05}),
        "/surf_a": (kind: "tex.contour", params: {"color": [0.8, 0.95, 1.0, 1.0], "interval": 1.0, "mode": "alpha"}, inputs: {"in": "waves_a"}, binds: {"offset": "tide:tide"}),
        "/surf_b": (kind: "tex.contour", params: {"color": [0.8, 0.95, 1.0, 1.0], "interval": 1.0, "mode": "alpha"}, inputs: {"in": "waves_b"}, binds: {"offset": "tide:tide"}),
        "/swell": (kind: "tex.noise", params: {"amplitude": 0.012, "frequency": 14.0, "height": 540, "keep_size": true, "octaves": 2, "offset": 0.0, "speed": 0.6, "width": 960}),
        "/tide": (kind: "chan.lfo", params: {"amplitude": 0.1, "name": "tide", "offset": 0.11, "rate": 0.025}),
        "/upright": (kind: "tex.flip", params: {"flip_y": true, "flop": true}, inputs: {"in": "room"}),
        "/view": (kind: "tex.level", params: {"brightness": 2.0}, inputs: {"in": "upright"}),
        "/water_a": (kind: "tex.lookup", inputs: {"in": "sea_a", "lut": "water_keys"}),
        "/water_b": (kind: "tex.lookup", inputs: {"in": "sea_b", "lut": "water_keys"}),
        "/water_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 0.01 0.06 0.3 0\n1 0.01 0.06 0.3 0.85", "width": 256}),
        "/waves_a": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"layer1": "height_a", "layer2": "swell"}),
        "/waves_b": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"layer1": "height_b", "layer2": "swell"}),
        "/weight_a": (kind: "tex.image", params: {"file": "relief/weight_0.png"}),
        "/weight_b": (kind: "tex.image", params: {"file": "relief/weight_1.png"}),
    },
)
