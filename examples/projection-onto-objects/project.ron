// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/cam_to_proj_a": (kind: "tex.image_file", params: {"file": "camera/cam_to_proj_0.png"}, pos: [1200.0, 531.0]),
        "/cam_to_proj_b": (kind: "tex.image_file", params: {"file": "camera/cam_to_proj_1.png"}, pos: [1200.0, 888.0]),
        "/contour_a": (kind: "tex.contour", params: {"color": [0.0, 0.0, 0.0, 0.6], "mode": "alpha", "smooth": 4.0, "thickness": 1.0}, inputs: {"in": "height_a"}, pos: [200.0, 320.0]),
        "/contour_b": (kind: "tex.contour", params: {"color": [0.0, 0.0, 0.0, 0.6], "mode": "alpha", "smooth": 4.0, "thickness": 1.0}, inputs: {"in": "height_b"}, pos: [200.0, 1336.0]),
        "/drift": (kind: "tex.noise", params: {"amplitude": 0.05, "frequency": 10.0, "height": 540, "keep_size": true, "octaves": 4, "offset": 0.0, "seed": 3, "width": 960}, pos: [0.0, 290.0]),
        "/drifts_a": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_a", "in1": "drift"}, pos: [200.0, 0.0]),
        "/drifts_b": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_b", "in1": "drift"}, pos: [200.0, 596.0]),
        "/height_a": (kind: "tex.image_file", params: {"file": "relief/height_0.png"}, pos: [0.0, 425.0]),
        "/height_b": (kind: "tex.image_file", params: {"file": "relief/height_1.png"}, pos: [0.0, 1150.0]),
        "/land_a": (kind: "tex.lookup", inputs: {"in": "height_a", "lut": "land_keys"}, pos: [200.0, 448.0]),
        "/land_b": (kind: "tex.lookup", inputs: {"in": "height_b", "lut": "land_keys"}, pos: [200.0, 865.0]),
        "/land_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 0.02 0.16 0.03\n0.3 0.188 0.402 0.061\n0.55 0.578 0.456 0.102\n0.75 0.305 0.127 0.045\n0.9 0.42 0.4 0.38\n1 0.6 0.6 0.6", "width": 256}, pos: [0.0, 671.0]),
        "/lines_a": (kind: "tex.composite", inputs: {"in0": "contour_a", "in1": "surf_a"}, pos: [600.0, 797.0]),
        "/lines_b": (kind: "tex.composite", inputs: {"in0": "contour_b", "in1": "surf_b"}, pos: [600.0, 1391.0]),
        "/lit_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "land_a", "in1": "shade_a"}, pos: [800.0, 288.0]),
        "/lit_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "land_b", "in1": "shade_b"}, pos: [800.0, 1216.0]),
        "/lit_room_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "seen_a", "in1": "photo_a"}, pos: [1600.0, 598.0]),
        "/lit_room_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "seen_b", "in1": "photo_b"}, pos: [1600.0, 1026.0]),
        "/map_a": (kind: "tex.composite", inputs: {"in0": "lit_a", "in1": "snow_a", "in2": "water_a", "in3": "lines_a"}, pos: [1000.0, 373.0]),
        "/map_b": (kind: "tex.composite", inputs: {"in0": "lit_b", "in1": "snow_b", "in2": "water_b", "in3": "lines_b"}, pos: [1000.0, 1319.0]),
        "/out_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "map_a", "in1": "weight_a"}, pos: [1200.0, 745.0]),
        "/out_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "map_b", "in1": "weight_b"}, pos: [1200.0, 1400.0]),
        "/photo_a": (kind: "tex.image_file", params: {"file": "camera/photo_0.jpg"}, pos: [1400.0, 645.0]),
        "/photo_b": (kind: "tex.image_file", params: {"file": "camera/photo_1.jpg"}, pos: [1400.0, 1528.0]),
        "/proj_a": (kind: "out.projector", inputs: {"in": "out_a"}, pos: [1400.0, 773.0]),
        "/proj_b": (kind: "out.projector", inputs: {"in": "out_b"}, pos: [1400.0, 1428.0]),
        "/room": (kind: "tex.composite", params: {"op": "average"}, inputs: {"in0": "lit_room_a", "in1": "lit_room_b"}, pos: [1800.0, 864.0]),
        "/scan_a": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_a"}, pos: [0.0, 1876.0]),
        "/scan_b": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_b"}, pos: [200.0, 1876.0]),
        "/sea_a": (kind: "tex.threshold", params: {"invert": true, "soft": 0.01}, inputs: {"in": "waves_a"}, binds: {"threshold": "tide:tide"}, pos: [400.0, 1065.0]),
        "/sea_b": (kind: "tex.threshold", params: {"invert": true, "soft": 0.01}, inputs: {"in": "waves_b"}, binds: {"threshold": "tide:tide"}, pos: [400.0, 1571.0]),
        "/seen_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "out_a", "map": "cam_to_proj_a"}, pos: [1400.0, 517.0]),
        "/seen_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "out_b", "map": "cam_to_proj_b"}, pos: [1400.0, 873.0]),
        "/shade_a": (kind: "tex.channel_mix", params: {"blue": [1.0, 0.0, 0.0, 0.8], "green": [1.0, 0.0, 0.0, 0.8], "red": [1.0, 0.0, 0.0, 0.8]}, inputs: {"in": "slope_a"}, binds: {"blue.0": "sun_x:sun_x", "blue.1": "sun_y:sun_y", "green.0": "sun_x:sun_x", "green.1": "sun_y:sun_y", "red.0": "sun_x:sun_x", "red.1": "sun_y:sun_y"}, pos: [600.0, 216.0]),
        "/shade_b": (kind: "tex.channel_mix", params: {"blue": [1.0, 0.0, 0.0, 0.8], "green": [1.0, 0.0, 0.0, 0.8], "red": [1.0, 0.0, 0.0, 0.8]}, inputs: {"in": "slope_b"}, binds: {"blue.0": "sun_x:sun_x", "blue.1": "sun_y:sun_y", "green.0": "sun_x:sun_x", "green.1": "sun_y:sun_y", "red.0": "sun_x:sun_x", "red.1": "sun_y:sun_y"}, pos: [600.0, 1208.0]),
        "/slope_a": (kind: "tex.slope", params: {"offset": 0.0, "strength": 120.0}, inputs: {"in": "smooth_a"}, pos: [400.0, 152.0]),
        "/slope_b": (kind: "tex.slope", params: {"offset": 0.0, "strength": 120.0}, inputs: {"in": "smooth_b"}, pos: [400.0, 1208.0]),
        "/smooth_a": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "height_a"}, pos: [200.0, 152.0]),
        "/smooth_b": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "height_b"}, pos: [200.0, 1208.0]),
        "/snow_a": (kind: "tex.lookup", inputs: {"in": "snowfield_a", "lut": "snow_keys"}, pos: [600.0, 28.0]),
        "/snow_b": (kind: "tex.lookup", inputs: {"in": "snowfield_b", "lut": "snow_keys"}, pos: [600.0, 593.0]),
        "/snow_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 1 1 1 0\n1 0.95 0.97 1 0.92", "width": 256}, pos: [400.0, 316.0]),
        "/snowfield_a": (kind: "tex.threshold", params: {"soft": 0.03}, inputs: {"in": "drifts_a"}, binds: {"threshold": "snowline:snowline"}, pos: [400.0, 0.0]),
        "/snowfield_b": (kind: "tex.threshold", params: {"soft": 0.03}, inputs: {"in": "drifts_b"}, binds: {"threshold": "snowline:snowline"}, pos: [400.0, 596.0]),
        "/snowline": (kind: "chan.lfo", params: {"amplitude": 0.14, "name": "snowline", "offset": 0.72, "phase": 0.5, "rate": 0.0125}, pos: [200.0, 793.0]),
        "/sun_x": (kind: "chan.lfo", params: {"name": "sun_x", "rate": 0.05}, pos: [400.0, 725.0]),
        "/sun_y": (kind: "chan.lfo", params: {"name": "sun_y", "phase": 0.25, "rate": 0.05}, pos: [400.0, 797.0]),
        "/surf_a": (kind: "tex.contour", params: {"color": [0.8, 0.95, 1.0, 1.0], "interval": 1.0, "mode": "alpha"}, inputs: {"in": "waves_a"}, binds: {"offset": "tide:tide"}, pos: [400.0, 891.0]),
        "/surf_b": (kind: "tex.contour", params: {"color": [0.8, 0.95, 1.0, 1.0], "interval": 1.0, "mode": "alpha"}, inputs: {"in": "waves_b"}, binds: {"offset": "tide:tide"}, pos: [400.0, 1443.0]),
        "/swell": (kind: "tex.noise", params: {"amplitude": 0.012, "frequency": 14.0, "height": 540, "keep_size": true, "octaves": 2, "offset": 0.0, "speed": 0.6, "width": 960}, pos: [0.0, 1278.0]),
        "/tide": (kind: "chan.lfo", params: {"amplitude": 0.1, "name": "tide", "offset": 0.11, "rate": 0.025}, pos: [200.0, 1738.0]),
        "/upright": (kind: "tex.flip", params: {"flip_y": true, "flop": true}, inputs: {"in": "room"}, pos: [2000.0, 864.0]),
        "/view": (kind: "tex.level", params: {"brightness": 2.0}, inputs: {"in": "upright"}, pos: [2200.0, 864.0]),
        "/water_a": (kind: "tex.lookup", inputs: {"in": "sea_a", "lut": "water_keys"}, pos: [600.0, 1079.0]),
        "/water_b": (kind: "tex.lookup", inputs: {"in": "sea_b", "lut": "water_keys"}, pos: [600.0, 1635.0]),
        "/water_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 0.01 0.06 0.3 0\n1 0.01 0.06 0.3 0.85", "width": 256}, pos: [400.0, 1700.0]),
        "/waves_a": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_a", "in1": "swell"}, pos: [200.0, 994.0]),
        "/waves_b": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_b", "in1": "swell"}, pos: [200.0, 1507.0]),
        "/weight_a": (kind: "tex.image_file", params: {"file": "relief/weight_0.png"}, pos: [1000.0, 737.0]),
        "/weight_b": (kind: "tex.image_file", params: {"file": "relief/weight_1.png"}, pos: [1000.0, 1447.0]),
    },
)
