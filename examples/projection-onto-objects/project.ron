// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about_contours": (kind: "ui.note", params: {"height": 155, "text": "# Contour lines\n`contour_a` draws a dark line every twentieth of the height range (`interval` 0.05). `smooth` 4 blurs the height inside the node first. The scan's noise then does not break the lines into wobbles. `lines_a` adds the shore from `surf_a`.\n- `interval` on `contour_a`: more or fewer lines", "width": 580}, pos: [-620.0, 300.0]),
        "/about_land": (kind: "ui.note", params: {"height": 215, "text": "# Land and sun\n`land_a` colours the height through `land_keys`: green valleys, brown slopes, grey rock. `slope_a` measures how steeply the softened height (`smooth_a`) rises. `shade_a` turns that into light from one side. Its weights follow `sun_x` and `sun_y`: once round in 20 s. `lit_a` multiplies the colours by it.\n- `strength` on `slope_a`, `slope_b`: deeper shadows\n- `rate` on `sun_x` and `sun_y`, kept equal: a faster day\n- `keys` on `land_keys`: other colours", "width": 560}, pos: [800.0, 10.0]),
        "/about_out": (kind: "ui.note", params: {"height": 115, "text": "# To the projectors\n`map_a` lays snow, water and lines over the lit land. `out_a` multiplies it by `weight_a`. The wall around the relief stays dark. `proj_a` has no `display` yet: it opens no window until you choose one.", "width": 560}, pos: [1600.0, 270.0]),
        "/about_preview": (kind: "ui.note", params: {"height": 155, "text": "# Preview without projectors\nLook at `view`: the picture as it would land on the relief. `seen_a` moves `out_a` into the camera's picture through `cam_to_proj_a`. `lit_room_a` multiplies it by the camera's photo. `room` averages both projectors, `upright` turns the picture upright, `view` doubles the brightness. Dark spots: the camera saw no projector pixel there.", "width": 560}, pos: [1800.0, 1000.0]),
        "/about_relief": (kind: "ui.note", params: {"height": 135, "text": "# A relief, two projectors\nEvery chain runs twice: `_a` for the lower projector, `_b` for the upper. The maps come from one camera scan, at 960 x 540:\n- `height_a`: height of the relief per projector pixel, 0 to 1\n- `weight_a`: how much light this projector gives where both reach. 0 off the relief", "width": 760}, pos: [0.0, -220.0]),
        "/about_scan": (kind: "ui.note", params: {"height": 115, "text": "# Scanning your own object\n`scan_a` and `scan_b` measure these maps on your object. They name the camera `/cam`, which this project does not have: add a `tex.video_in` named `cam`. The steps are in docs/scanning.md.", "width": 600}, pos: [400.0, 1830.0]),
        "/about_water": (kind: "ui.note", params: {"height": 195, "text": "# Water and snow\n- `waves_a`: the height moved by moving noise (`swell`). `sea_a` is white below `tide`, which rises and falls once in 40 s. `water_a` colours it blue. `surf_a` draws the shore\n- `snowfield_a`: white above `snowline`, on the height roughened by still noise (`drift`). `snow_a` colours it\n- `offset`, `amplitude` on `tide`: how high the water reaches\n- `offset` on `snowline`: where the snow lies. `rate`: how fast it moves", "width": 580}, pos: [-620.0, 950.0]),
        "/cam_to_proj_a": (kind: "tex.image_file", params: {"file": "camera/cam_to_proj_0.png"}, pos: [1200.0, 534.0]),
        "/cam_to_proj_b": (kind: "tex.image_file", params: {"file": "camera/cam_to_proj_1.png"}, pos: [1200.0, 892.0]),
        "/contour_a": (kind: "tex.contour", params: {"color": [0.0, 0.0, 0.0, 0.6], "mode": "alpha", "smooth": 4.0, "thickness": 1.0}, inputs: {"in": "height_a"}, pos: [200.0, 328.0]),
        "/contour_b": (kind: "tex.contour", params: {"color": [0.0, 0.0, 0.0, 0.6], "mode": "alpha", "smooth": 4.0, "thickness": 1.0}, inputs: {"in": "height_b"}, pos: [200.0, 1334.0]),
        "/drift": (kind: "tex.noise", params: {"amplitude": 0.05, "frequency": 10.0, "height": 540, "keep_size": true, "octaves": 4, "offset": 0.0, "seed": 3, "width": 960}, pos: [0.0, 301.0]),
        "/drifts_a": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_a", "in1": "drift"}, pos: [200.0, 0.0]),
        "/drifts_b": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_b", "in1": "drift"}, pos: [200.0, 603.0]),
        "/height_a": (kind: "tex.image_file", params: {"file": "relief/height_0.png"}, pos: [0.0, 435.0]),
        "/height_b": (kind: "tex.image_file", params: {"file": "relief/height_1.png"}, pos: [0.0, 1149.0]),
        "/land_a": (kind: "tex.lookup", inputs: {"in": "height_a", "lut": "land_keys"}, pos: [200.0, 457.0]),
        "/land_b": (kind: "tex.lookup", inputs: {"in": "height_b", "lut": "land_keys"}, pos: [200.0, 868.0]),
        "/land_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 0.02 0.16 0.03\n0.3 0.188 0.402 0.061\n0.55 0.578 0.456 0.102\n0.75 0.305 0.127 0.045\n0.9 0.42 0.4 0.38\n1 0.6 0.6 0.6", "width": 256}, pos: [0.0, 676.0]),
        "/lines_a": (kind: "tex.composite", inputs: {"in0": "contour_a", "in1": "surf_a"}, pos: [600.0, 796.0]),
        "/lines_b": (kind: "tex.composite", inputs: {"in0": "contour_b", "in1": "surf_b"}, pos: [600.0, 1383.0]),
        "/lit_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "land_a", "in1": "shade_a"}, pos: [800.0, 288.0]),
        "/lit_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "land_b", "in1": "shade_b"}, pos: [800.0, 1206.0]),
        "/lit_room_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "seen_a", "in1": "photo_a"}, pos: [1600.0, 594.0]),
        "/lit_room_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "seen_b", "in1": "photo_b"}, pos: [1600.0, 1024.0]),
        "/map_a": (kind: "tex.composite", inputs: {"in0": "lit_a", "in1": "snow_a", "in2": "water_a", "in3": "lines_a"}, pos: [1000.0, 383.0]),
        "/map_b": (kind: "tex.composite", inputs: {"in0": "lit_b", "in1": "snow_b", "in2": "water_b", "in3": "lines_b"}, pos: [1000.0, 1314.0]),
        "/out_a": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "map_a", "in1": "weight_a"}, pos: [1200.0, 748.0]),
        "/out_b": (kind: "tex.composite", params: {"op": "multiply"}, inputs: {"in0": "map_b", "in1": "weight_b"}, pos: [1200.0, 1398.0]),
        "/photo_a": (kind: "tex.image_file", params: {"file": "camera/photo_0.jpg"}, pos: [1400.0, 648.0]),
        "/photo_b": (kind: "tex.image_file", params: {"file": "camera/photo_1.jpg"}, pos: [1400.0, 1526.0]),
        "/proj_a": (kind: "out.projector", inputs: {"in": "out_a"}, pos: [1400.0, 776.0]),
        "/proj_b": (kind: "out.projector", inputs: {"in": "out_b"}, pos: [1400.0, 1426.0]),
        "/room": (kind: "tex.composite", params: {"op": "average"}, inputs: {"in0": "lit_room_a", "in1": "lit_room_b"}, pos: [1800.0, 856.0]),
        "/scan_a": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_a"}, pos: [0.0, 1870.0]),
        "/scan_b": (kind: "tex.scan", params: {"camera": "/cam", "projector": "/proj_b"}, pos: [200.0, 1870.0]),
        "/sea_a": (kind: "tex.threshold", params: {"invert": true, "soft": 0.01}, inputs: {"in": "waves_a"}, binds: {"threshold": "tide:tide"}, pos: [400.0, 1063.0]),
        "/sea_b": (kind: "tex.threshold", params: {"invert": true, "soft": 0.01}, inputs: {"in": "waves_b"}, binds: {"threshold": "tide:tide"}, pos: [400.0, 1565.0]),
        "/seen_a": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "out_a", "map": "cam_to_proj_a"}, pos: [1400.0, 520.0]),
        "/seen_b": (kind: "tex.remap", params: {"extend": "zero"}, inputs: {"in": "out_b", "map": "cam_to_proj_b"}, pos: [1400.0, 878.0]),
        "/shade_a": (kind: "tex.channel_mix", params: {"blue": [1.0, 0.0, 0.0, 0.8], "green": [1.0, 0.0, 0.0, 0.8], "red": [1.0, 0.0, 0.0, 0.8]}, inputs: {"in": "slope_a"}, binds: {"blue.0": "sun_x:sun_x", "blue.1": "sun_y:sun_y", "green.0": "sun_x:sun_x", "green.1": "sun_y:sun_y", "red.0": "sun_x:sun_x", "red.1": "sun_y:sun_y"}, pos: [600.0, 224.0]),
        "/shade_b": (kind: "tex.channel_mix", params: {"blue": [1.0, 0.0, 0.0, 0.8], "green": [1.0, 0.0, 0.0, 0.8], "red": [1.0, 0.0, 0.0, 0.8]}, inputs: {"in": "slope_b"}, binds: {"blue.0": "sun_x:sun_x", "blue.1": "sun_y:sun_y", "green.0": "sun_x:sun_x", "green.1": "sun_y:sun_y", "red.0": "sun_x:sun_x", "red.1": "sun_y:sun_y"}, pos: [600.0, 1206.0]),
        "/slope_a": (kind: "tex.slope", params: {"offset": 0.0, "strength": 120.0}, inputs: {"in": "smooth_a"}, pos: [400.0, 160.0]),
        "/slope_b": (kind: "tex.slope", params: {"offset": 0.0, "strength": 120.0}, inputs: {"in": "smooth_b"}, pos: [400.0, 1206.0]),
        "/smooth_a": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "height_a"}, pos: [200.0, 160.0]),
        "/smooth_b": (kind: "tex.blur", params: {"size": 4.0}, inputs: {"in": "height_b"}, pos: [200.0, 1206.0]),
        "/snow_a": (kind: "tex.lookup", inputs: {"in": "snowfield_a", "lut": "snow_keys"}, pos: [600.0, 31.0]),
        "/snow_b": (kind: "tex.lookup", inputs: {"in": "snowfield_b", "lut": "snow_keys"}, pos: [600.0, 598.0]),
        "/snow_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 1 1 1 0\n1 0.95 0.97 1 0.92", "width": 256}, pos: [400.0, 324.0]),
        "/snowfield_a": (kind: "tex.threshold", params: {"soft": 0.03}, inputs: {"in": "drifts_a"}, binds: {"threshold": "snowline:snowline"}, pos: [400.0, 0.0]),
        "/snowfield_b": (kind: "tex.threshold", params: {"soft": 0.03}, inputs: {"in": "drifts_b"}, binds: {"threshold": "snowline:snowline"}, pos: [400.0, 603.0]),
        "/snowline": (kind: "chan.lfo", params: {"amplitude": 0.14, "name": "snowline", "offset": 0.72, "phase": 0.5, "rate": 0.0125}, pos: [200.0, 796.0]),
        "/sun_x": (kind: "chan.lfo", params: {"name": "sun_x", "rate": 0.05}, pos: [400.0, 731.0]),
        "/sun_y": (kind: "chan.lfo", params: {"name": "sun_y", "phase": 0.25, "rate": 0.05}, pos: [400.0, 803.0]),
        "/surf_a": (kind: "tex.contour", params: {"color": [0.8, 0.95, 1.0, 1.0], "interval": 1.0, "mode": "alpha"}, inputs: {"in": "waves_a"}, binds: {"offset": "tide:tide"}, pos: [400.0, 896.0]),
        "/surf_b": (kind: "tex.contour", params: {"color": [0.8, 0.95, 1.0, 1.0], "interval": 1.0, "mode": "alpha"}, inputs: {"in": "waves_b"}, binds: {"offset": "tide:tide"}, pos: [400.0, 1437.0]),
        "/swell": (kind: "tex.noise", params: {"amplitude": 0.012, "frequency": 14.0, "height": 540, "keep_size": true, "octaves": 2, "offset": 0.0, "speed": 0.6, "width": 960}, pos: [0.0, 1278.0]),
        "/tide": (kind: "chan.lfo", params: {"amplitude": 0.1, "name": "tide", "offset": 0.11, "rate": 0.025}, pos: [200.0, 1726.0]),
        "/upright": (kind: "tex.flip", params: {"flip_y": true, "flop": true}, inputs: {"in": "room"}, pos: [2000.0, 856.0]),
        "/view": (kind: "tex.level", params: {"brightness": 2.0}, inputs: {"in": "upright"}, pos: [2200.0, 856.0]),
        "/water_a": (kind: "tex.lookup", inputs: {"in": "sea_a", "lut": "water_keys"}, pos: [600.0, 1077.0]),
        "/water_b": (kind: "tex.lookup", inputs: {"in": "sea_b", "lut": "water_keys"}, pos: [600.0, 1629.0]),
        "/water_keys": (kind: "tex.ramp", params: {"height": 1, "keep_size": true, "keys": "0 0.01 0.06 0.3 0\n1 0.01 0.06 0.3 0.85", "width": 256}, pos: [400.0, 1693.0]),
        "/waves_a": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_a", "in1": "swell"}, pos: [200.0, 996.0]),
        "/waves_b": (kind: "tex.composite", params: {"op": "subtract"}, inputs: {"in0": "height_b", "in1": "swell"}, pos: [200.0, 1501.0]),
        "/weight_a": (kind: "tex.image_file", params: {"file": "relief/weight_0.png"}, pos: [1000.0, 748.0]),
        "/weight_b": (kind: "tex.image_file", params: {"file": "relief/weight_1.png"}, pos: [1000.0, 1446.0]),
    },
)
