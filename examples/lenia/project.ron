// penumbra project. Written by the app about a second after each change; while the app
// runs, edits to this file are merged into the open project.
(
    version: 2,
    nodes: {
        "/about": (kind: "ui.note", params: {"height": 220, "text": "# Lenia (continuous cellular automata)\n`lenia` is the library component `lenia`: soft creatures that glide, pulse, split and die. Choose a `preset` on it: the preset writes its values into the params below, then tune any of them. A new preset starts over by itself; with `morph` on, the new rules act on the world that is there.\nKey 0 starts it over (`keys` is bound to `lenia`\'s `reset`). Click into the editor once so it gets the keys.\nStand-ins: `word` is the mask input (presets home and word use it; a scan mask of the object in an installation). `blob`, moved by `x` and `y`, is the people input: `people_mode` says what they do (tex.blob_track in an installation).\n`/out` shows the picture. The channel outputs `coverage` and `activity` say how much of the area is alive and how much the world still changes.", "width": 1100}, pos: [-400.0, -700.0]),
        "/blob": (kind: "tex.primitive", params: {"keep_size": true, "shape": "ellipse", "size": [0.12, 0.12], "softness": 30.0}, binds: {"center.0": "x:x", "center.1": "y:y"}, pos: [-500.0, 60.0]),
        "/keys": (kind: "chan.keyboard_in", params: {"keys": "0"}, pos: [300.0, 200.0]),
        "/lenia": (kind: "comp.base", params: {"about": "Lenia, a continuous cellular automaton like SmoothLife and the Game of Life: soft creatures glide, swarm, split and chase each other, on or around a mask.", "params": "@param preset choice(gliders|swarm|tissue|labyrinth|smoothlife|trio|home|word|wake) = gliders -- the creatures and what the inputs do; choosing one writes its values into the params, then they are yours; a new preset starts over, unless morph is on\n@param morph bool = false -- a new preset acts on the world that is there instead of starting over\n@param seed int = 1 0..1000 -- another random start; a change starts over\n@param speed float = 1 0.125..4 -- steps per frame as a share of steps; 2 runs twice as fast and costs twice as much; the creatures stay the same\n@param scale float = 1 0.5..2 -- creature size as a share of radius; a change starts over; the cost grows with its square\n@param people_mode choice(off|spawn|feed|kill|push) = spawn -- what people do; spawn: new creatures appear where they are; feed: life grows there; kill: life dies there; push: life drifts out of their way\n@expose strength = fields.strength\n@expose push = step.push\n@expose mask_mode = fields.mask_mode\n@param pause bool = false -- holds the world as it is\n@group rules\n@param rule choice(lenia|smoothlife|three) = lenia -- lenia: one kind of life, growing where the mean around it is near mu; smoothlife: Rafler\'s SmoothLife rule, a disk and a ring (rings, core, mu and sigma do not act); three: three kinds, each with the lenia rule, each held back by the others; a change starts over\n@param radius float = 17.33 4..40 -- kernel radius: how far a texel looks, in texels of a simulation 288 high, so creatures keep their share of the picture at any size; a change starts over; the cost grows with its square\n@expose rings = step.rings\n@expose core = step.core\n@expose mu = step.mu\n@expose sigma = step.sigma\n@expose dt = step.dt\n@param steps float = 2 0.1..16 -- steps per frame at speed 1; fractions are carried over to the next frame\n@expose outside_size = step.outside_size\n@expose edges = step.edges\n@group start\n@param start choice(patches|noise|one|stamps|mask|empty) = stamps -- the start; patches: square patches of random cells; noise: the whole field random; one: a single patch in the middle; stamps: copies of creature; mask: patches only where the mask is bright; empty: nothing; a change starts over\n@param size float = 6.15 0.5..20 -- patch size in kernel radii; a change starts over\n@param density float = 0.5 0..1 -- share of places with a patch; a change starts over\n@param creature choice(none|glider|ring) = glider -- what start stamps and every drop put down; glider: a crescent that glides under the lenia rule; ring: a ring that glides under the smoothlife rule; none: a disc of random cells; a change starts over\n@group guards\n@expose revive = guard.revive\n@expose revive_after = guard.revive_after\n@expose dead = guard.dead\n@expose auto_restart = guard.auto_restart\n@expose full = guard.full\n@expose hold = guard.hold\n@expose few = guard.few\n@expose refill = guard.refill\n@expose spawn = guard.spawn\n@expose rate = guard.rate\n@expose stir = guard.stir\n@expose stir_after = guard.stir_after\n@expose still = guard.still\n@expose stir_count = step.stir_count\n@group look\n@expose colors = show.colors\n@expose gain = show.gain\n@expose glow = show.glow\n@expose relief = show.relief\n@expose through = show.through\n@expose marker = show.marker\n@expose show_inputs = show.show_inputs\n@expose tint_g = show.tint_g\n@expose tint_b = show.tint_b\n@expose mode = show.mode\n@expose glow_size = halo.size\n@expose out_width = show.width\n@expose out_height = show.height\n@group outputs\n@expose mark = blocks.mark\n@group size\n@param width int = 512 16..4096 -- simulation width in texels; a change starts over\n@param height int = 288 16..4096 -- simulation height in texels; creatures keep their share of it, so a larger size gives finer edges and costs with the fourth power; a change starts over\n@reset seed rule radius start size density creature scale width height\n@reset preset unless morph\n@preset preset=* rule=lenia radius=13 rings=[1, 0, 0] core=bump mu=0.15 sigma=0.015 dt=0.1 steps=2 outside_size=0.6\n@preset preset=* start=patches size=2 density=0.3 creature=none people_mode=off mask_mode=off\n@preset preset=* revive=true revive_after=2 dead=0.001 auto_restart=false full=0.5 hold=2 few=0 refill=0 spawn=0 stir=false stir_after=15 still=0.3\n@preset preset=* colors=050d1f 0d73a6 d9fff2 gain=1 glow=0.8 through=0\n@preset preset=gliders radius=17.33 sigma=0.0145 size=6.15 density=0.5 creature=glider people_mode=spawn revive_after=1 dead=0.0005 auto_restart=true full=0.08 hold=1 gain=1.3 glow=1.4 start=stamps few=0.01 refill=0.5 spawn=0.1 -- crescent gliders cross the field in about 8 s, meet and die; new ones are dropped in when few are left, and where people walk\n@preset preset=swarm radius=14.95 rings=[0.5, 1, 0] sigma=0.02 people_mode=push colors=1a0503 d9400d ffe68c -- a dense field of small cells that jiggle and shuffle; people push a channel through it\n@preset preset=tissue radius=18.2 rings=[0.5, 1, 0.667] mu=0.2 sigma=0.026 dt=0.2 steps=4 size=1.98 density=0.12 people_mode=kill stir=true still=0.15 colors=14031a b21f8c ffbfd9 -- spiky filaments fill the field within 3 s, then reorganise slowly; people kill\n@preset preset=labyrinth sigma=0.017 steps=4 size=1.54 density=0.12 people_mode=kill stir=true colors=030f08 1aa64c ccffb2 -- worms fill the field as a labyrinth; people carve a path that closes behind them; holes are punched in when it stands still\n@preset preset=smoothlife rule=smoothlife dt=1 steps=0.5 start=stamps size=7.38 density=0.4 creature=ring people_mode=spawn dead=0.0005 auto_restart=true full=0.6 few=0.02 refill=0.5 spawn=0.2 colors=0a051f 5940d9 e6d9ff -- ring creatures glide; new ones, dropped in and under people, start colonies that spread and break up again\n@preset preset=trio rule=three rings=[0.5, 1, 0] sigma=0.02 density=0.4 people_mode=push colors=1a0503 d9400d ffe68c -- red, green and blue kinds invade each other in round fronts; people push\n@preset preset=home rule=three rings=[0.5, 1, 0] sigma=0.02 start=mask density=0.6 people_mode=kill mask_mode=home few=0.3 refill=2 colors=1a0503 d9400d ffe68c through=0.15 -- the three kinds live only where the mask is bright and are refilled when less than 30 % of it is alive; people kill\n@preset preset=word sigma=0.017 steps=4 outside_size=0.55 start=noise size=1.54 density=0.12 people_mode=kill mask_mode=rules colors=030f08 1aa64c ccffb2 through=0.1 -- coarse worms where the mask is bright, fine worms around it, so the mask reads by texture alone\n@preset preset=wake radius=17.33 sigma=0.0145 size=6.15 density=0.5 creature=glider people_mode=spawn revive_after=1 dead=0.0005 auto_restart=true full=0.08 hold=1 gain=1.3 glow=1.4 start=empty revive=false refill=0.5 -- an empty field until someone walks; gliders appear behind them and swim off", "shelf": "simulations"}, binds: {"reset": "keys:key_0"}, pos: [300.0, 0.0]),
        "/lenia/activity": (kind: "chan.out", inputs: {"in": "change_named"}, pos: [1450.0, 370.0]),
        "/lenia/blocks": (kind: "tex.shader", params: {"file": "library/lenia/blocks.wgsl", "format": "32f", "height": 18, "keep_size": true, "resolution": "custom", "width": 32}, inputs: {"in0": "step", "in1": "loop", "in2": "fields"}, pos: [450.0, 300.0]),
        "/lenia/change": (kind: "chan.select", params: {"channels": "g"}, inputs: {"in": "numbers"}, pos: [1050.0, 370.0]),
        "/lenia/change_named": (kind: "chan.rename", params: {"names": "g=activity"}, inputs: {"in": "change"}, pos: [1250.0, 370.0]),
        "/lenia/coverage": (kind: "chan.out", inputs: {"in": "covered_named"}, pos: [1450.0, 250.0]),
        "/lenia/covered": (kind: "chan.select", params: {"channels": "r"}, inputs: {"in": "numbers"}, pos: [1050.0, 250.0]),
        "/lenia/covered_named": (kind: "chan.rename", params: {"names": "r=coverage"}, inputs: {"in": "covered"}, pos: [1250.0, 250.0]),
        "/lenia/creatures": (kind: "tex.image_file", params: {"file": "library/lenia/creatures.png"}, pos: [-600.0, 400.0]),
        "/lenia/fields": (kind: "tex.shader", params: {"file": "library/lenia/fields.wgsl", "format": "32f", "keep_size": true, "mask_mode": "off"}, inputs: {"in0": "world", "in1": "mask", "in2": "people"}, pos: [-400.0, 200.0]),
        "/lenia/guard": (kind: "tex.shader", params: {"auto_restart": true, "dead": 0.0005, "few": 0.01, "file": "library/lenia/guard.wgsl", "format": "32f", "full": 0.08, "height": 1, "hold": 1, "keep_size": true, "refill": 0.5, "resolution": "custom", "revive": true, "revive_after": 1, "spawn": 0.1, "still": 0.3, "stir": false, "stir_after": 15, "width": 5}, inputs: {"in0": "guard_loop", "in1": "measure_loop", "in2": "fields", "in3": "state_back"}, binds: {"now": "time:seconds", "pause": "parent.pause", "people_mode": "parent.people_mode", "speed": "parent.speed", "steps": "parent.steps"}, pos: [0.0, -280.0]),
        "/lenia/guard_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "guard"}, pos: [-200.0, -300.0]),
        "/lenia/halo": (kind: "tex.blur", inputs: {"in": "step"}, pos: [450.0, 120.0]),
        "/lenia/loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "seed", "previous": "step"}, pos: [0.0, -100.0]),
        "/lenia/mask": (kind: "tex.in", inputs: {"in": "/word"}, pos: [-600.0, 100.0]),
        "/lenia/measure": (kind: "tex.shader", params: {"file": "library/lenia/measure.wgsl", "format": "32f", "height": 1, "keep_size": true, "resolution": "custom", "width": 1}, inputs: {"in0": "blocks"}, pos: [650.0, 300.0]),
        "/lenia/measure_loop": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "measure"}, pos: [-200.0, -200.0]),
        "/lenia/most": (kind: "chan.math", params: {"b": 0.499}, inputs: {"a": "passes"}, pos: [0.0, -560.0]),
        "/lenia/numbers": (kind: "chan.from_tex", params: {"components": "rgb"}, inputs: {"in": "measure"}, pos: [850.0, 300.0]),
        "/lenia/out": (kind: "tex.out", inputs: {"in": "show"}, pos: [850.0, 0.0]),
        "/lenia/pace": (kind: "chan.constant", params: {"name0": "steps"}, binds: {"value0": "parent.steps"}, pos: [-400.0, -560.0]),
        "/lenia/passes": (kind: "chan.math", params: {"op": "multiply"}, inputs: {"a": "pace"}, binds: {"b": "parent.speed"}, pos: [-200.0, -560.0]),
        "/lenia/people": (kind: "tex.in", inputs: {"in": "/blob"}, pos: [-600.0, 250.0]),
        "/lenia/seed": (kind: "tex.shader", params: {"file": "library/lenia/seed.wgsl", "format": "32f", "keep_size": true}, inputs: {"in0": "world", "in1": "creatures", "in2": "fields", "in3": "guard"}, binds: {"creature": "parent.creature", "density": "parent.density", "radius": "parent.radius", "rule": "parent.rule", "scale": "parent.scale", "seed": "parent.seed", "size": "parent.size", "start": "parent.start"}, pos: [-200.0, -100.0]),
        "/lenia/show": (kind: "tex.shader", params: {"colors": "050d1f 0d73a6 d9fff2", "file": "library/lenia/show.wgsl", "gain": 1.3, "glow": 1.4, "keep_size": true, "resolution": "custom", "through": 0}, inputs: {"in0": "step", "in1": "halo", "in2": "mask", "in3": "people"}, pos: [650.0, 0.0]),
        "/lenia/state_back": (kind: "tex.feedback", params: {"persist": false}, inputs: {"initial": "world", "previous": "step"}, pos: [-200.0, -400.0]),
        "/lenia/step": (kind: "tex.shader", params: {"core": "bump", "dt": 0.1, "file": "library/lenia/step.wgsl", "format": "32f", "keep_size": true, "mu": 0.15, "outside_size": 0.6, "rings": [1.0, 0.0, 0.0], "sigma": 0.0145}, inputs: {"in0": "loop", "in1": "fields", "in2": "guard", "in3": "creatures", "in4": "seed"}, binds: {"creature": "parent.creature", "iterations": "most:steps", "pause": "parent.pause", "people_mode": "parent.people_mode", "radius": "parent.radius", "rule": "parent.rule", "scale": "parent.scale"}, pos: [250.0, 0.0]),
        "/lenia/time": (kind: "chan.clock", params: {"mode": "free"}, pos: [-400.0, -380.0]),
        "/lenia/world": (kind: "tex.constant", params: {"color": [0.0, 0.0, 0.0, 0.0], "keep_size": true}, binds: {"height": "parent.height", "width": "parent.width"}, pos: [-600.0, -50.0]),
        "/out": (kind: "tex.null", inputs: {"in": "lenia/out"}, pos: [650.0, 0.0]),
        "/word": (kind: "tex.text", params: {"keep_size": true, "size": 480.0, "style": "Bold", "text": "LENIA"}, pos: [-300.0, -100.0]),
        "/x": (kind: "chan.lfo", params: {"amplitude": 0.36, "name": "x", "offset": 0.5, "rate": 0.05}, pos: [-700.0, 40.0]),
        "/y": (kind: "chan.lfo", params: {"amplitude": 0.32, "name": "y", "offset": 0.5, "phase": 0.25, "rate": 0.083}, pos: [-700.0, 110.0]),
    },
)
